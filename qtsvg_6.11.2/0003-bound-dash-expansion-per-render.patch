new file mode 100644
index 0000000..0532cd4
--- /dev/null
+++ b/src/svg/qsvgdrawscope_p.h
@@ -0,0 +1,42 @@
+// SPDX-License-Identifier: LicenseRef-Qt-Commercial OR LGPL-3.0-only OR GPL-2.0-only OR GPL-3.0-only
+// Qt-Security score:significant reason:default
+
+
+#ifndef QSVGDRAWSCOPE_P_H
+#define QSVGDRAWSCOPE_P_H
+
+//
+//  W A R N I N G
+//  -------------
+//
+// This file is not part of the Qt API.  It exists purely as an
+// implementation detail.  This header file may change from version to
+// version without notice, or even be removed.
+//
+// We mean it.
+//
+
+#include "qsvgstyle_p.h"
+
+#include <QtGui/private/qstroker_p.h>
+
+#include <optional>
+
+QT_BEGIN_NAMESPACE
+
+// Limits the dash expansion of one draw or bounds pass of an untrusted document:
+// while it lives, all painting on this thread, offscreen images included, spends
+// one allowance, and a scope created inside another one adds none.
+class QSvgRenderBudget::DrawScope
+{
+    Q_DISABLE_COPY_MOVE(DrawScope)
+public:
+    explicit DrawScope(const QSvgExtraStates &states);
+
+private:
+    std::optional<QDashBudget> m_dashBudget;
+};
+
+QT_END_NAMESPACE
+
+#endif // QSVGDRAWSCOPE_P_H
