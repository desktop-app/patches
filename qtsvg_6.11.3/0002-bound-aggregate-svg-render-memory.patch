+// Bytes allocateImage() allocates for a 32-bit primitive image, or 0 where it refuses the size
+// and the primitive gives up at that point with a null result.
+static qint64 allocatableImageBytes(QSize size)
+{
+    const qint64 bytes = QSvgRenderBudget::imageBytes(size, QImage::Format_ARGB32_Premultiplied);
+    const int mbLimit = QImageReader::allocationLimit();
+    if (bytes <= 0 || (mbLimit && bytes > qint64(mbLimit) * (1 << 20)))
+        return 0;
+    return bytes;
+}
+
+// Storage a primitive allocates while it runs, besides its sources: the result and up to two
+// detached copies of shared sources (non-const scanLine()), or for a nonzero blur the result,
+// a scale-only copy and 32 byte ColorValues: 1024 inline plus, above 1024 pixels, one per pixel.
+static qint64 filterWorkspaceBytes(const QSvgFeFilterPrimitive *filter, QPainter *p,
+                                   const QRectF &itemBounds, const QRectF &filterBounds,
+                                   QtSvg::UnitTypes primitiveUnits, QtSvg::UnitTypes filterUnits,
+                                   qint64 largestSourceBytes)
+{
+    const qint64 resultBytes = allocatableImageBytes(filter->globalSubRegion(
+            p, itemBounds, filterBounds, primitiveUnits, filterUnits).toRect().size());
+    qint64 bytes = 0;
+    if (filter->type() != QSvgNode::FeGaussianblur) {
+        if (resultBytes == 0)
+            return 0;
+        if (qMulOverflow(largestSourceBytes, qint64(2), &bytes)
+                || qAddOverflow(bytes, resultBytes, &bytes)) {
+            return -1;
+        }
+        return bytes;
+    }
+
+    const QSvgFeGaussianBlur *blur = static_cast<const QSvgFeGaussianBlur *>(filter);
+    if (blur->stdDeviationX() == 0 && blur->stdDeviationY() == 0)
+        return 0;
+    const QTransform &xf = p->transform();
+    const QTransform scale = QTransform::fromScale(qHypot(xf.m11(), xf.m21()),
+                                                   qHypot(xf.m12(), xf.m22()));
+    const QRect tempRect = scale.mapRect(filter->localSubRegion(
+            itemBounds, filterBounds, primitiveUnits, filterUnits)).toRect();
+    const qint64 tempBytes = allocatableImageBytes(tempRect.size());
+    if (tempBytes == 0)
+        return 0;
+    constexpr qint64 tableInlineEntries = 32 * 32;
+    constexpr qint64 tableEntryBytes = 32;
+    const qint64 tempPixels = qint64(tempRect.width()) * tempRect.height();
+    qint64 tableEntries = tableInlineEntries;
+    if ((tempPixels > tableInlineEntries && qAddOverflow(tableEntries, tempPixels, &tableEntries))
+            || qMulOverflow(tableEntries, tableEntryBytes, &bytes)
+            || qAddOverflow(bytes, tempBytes, &bytes)
+            || qAddOverflow(bytes, resultBytes, &bytes)) {
+        return -1;
+    }
+    return bytes;
+}
