 QT_BEGIN_NAMESPACE
 
+// Dash loop iterations one render may run and the geometry its dashes may add
+// downstream, see QDashBudget. A draw nested in another one on the same thread
+// spends the outer allowances.
+static constexpr qint64 renderingMaxDashSteps = 65536;
+static constexpr qint64 renderingMaxDashGeometry = qint64(1) << 20;
+
