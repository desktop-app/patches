+                Call::Seqno => Reply::Json(
+                    200,
+                    serde_json::json!({
+                        "ok": true,
+                        "result": {
+                            "exit_code": 0,
+                            "stack": [["num", format!("{:#x}", self.account.seqno)]]
+                        }
+                    }),
+                ),
+                Call::Emulate(_) => self
+                    .emulations
+                    .lock()
+                    .expect("emulation lock")
+                    .pop_front()
+                    .expect("a scripted emulation answer"),
+                Call::Unexpected(_) => {
+                    return Err(HttpHostError::Failed {
+                        kind: HttpHostErrorKind::Other,
+                        diagnostic: "unexpected scripted request".to_owned(),
+                    });
+                }
+            };
+            self.respond(&request, reply)
