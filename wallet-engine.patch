+    /// A companion that fails, skips, is malformed or does not match the
+    /// operation leaves the refusal without a fee, and so does an operation
+    /// whose own fee components cannot be composed. Below the balance the raw
+    /// skipped fee keeps only the default refusal at and above it.
+    #[test]
+    fn an_unproved_companion_leaves_the_refusal_without_a_fee() {
+        type Case = (&'static str, fn(&str) -> Reply, Option<fn(&str) -> Reply>);
+        let cases: [Case; 18] = [
+            (
+                "companion offline",
+                |a| answer(a, W4_SKIPPED_EMPTY),
+                Some(|_| Reply::Offline),
+            ),
+            (
+                "companion rejected before execution",
+                |a| answer(a, W4_SKIPPED_EMPTY),
+                Some(rejection),
+            ),
+            (
+                "companion malformed",
+                |a| answer(a, W4_SKIPPED_EMPTY),
+                Some(|_| Reply::Malformed),
+            ),
+            (
+                "companion fee missing",
+                |a| answer(a, W4_SKIPPED_EMPTY),
+                Some(|a| {
+                    edited(a, W4_ZERO_EMPTY, |root| {
+                        let _ = root.as_object_mut().expect("root").remove("total_fees");
+                    })
+                }),
+            ),
+            (
+                "companion action fee malformed",
+                |a| answer(a, W4_SKIPPED_EMPTY),
+                Some(|a| {
+                    edited(a, W4_ZERO_EMPTY, |root| {
+                        root["description"]["action"]["total_action_fees"] = "-1".into();
+                    })
+                }),
+            ),
+            (
+                "companion counters missing",
+                |a| answer(a, W4_SKIPPED_EMPTY),
+                Some(|a| {
+                    edited(a, W4_ZERO_EMPTY, |root| {
+                        let _ = root["description"]["action"]
+                            .as_object_mut()
+                            .expect("action")
+                            .remove("msgs_created");
+                    })
+                }),
+            ),
+            (
+                "companion skipped",
+                |a| answer(a, W4_SKIPPED_EMPTY),
+                Some(|a| answer(a, W4_SKIPPED_EMPTY)),
+            ),
+            (
+                "companion keeping mode 2 skips",
+                |a| answer(a, W4_SKIPPED_EMPTY),
+                Some(|a| answer(a, W4_ZERO_EMPTY_KEPT_MODE)),
+            ),
+            (
+                "companion rejected",
+                |a| answer(a, W4_SKIPPED_EMPTY),
+                Some(|a| {
+                    edited(a, W4_ZERO_EMPTY, |root| {
+                        root["description"]["compute_ph"]["success"] = false.into();
+                        root["description"]["compute_ph"]["exit_code"] = 33.into();
+                    })
+                }),
+            ),
+            (
+                "companion of another wallet",
+                |a| answer(a, W4_SKIPPED_EMPTY),
+                Some(|_| answer(DESTINATION_B, W4_ZERO_EMPTY)),
+            ),
+            (
+                "gas mismatch",
+                |a| answer(a, W4_SKIPPED_EMPTY),
+                Some(|a| {
+                    answer(
+                        a,
+                        Root {
+                            gas_used: W4_ZERO_EMPTY.gas_used + 1,
+                            ..W4_ZERO_EMPTY
+                        },
+                    )
+                }),
+            ),
+            (
+                "storage mismatch",
+                |a| answer(a, W4_SKIPPED_EMPTY),
+                Some(|a| {
+                    answer(
+                        a,
+                        Root {
+                            storage_fees: W4_ZERO_EMPTY.storage_fees + 1,
+                            ..W4_ZERO_EMPTY
+                        },
+                    )
+                }),
+            ),
+            (
+                "block mismatch",
+                |a| answer(a, W4_SKIPPED_EMPTY),
+                Some(|a| {
+                    answer(
+                        a,
+                        Root {
+                            block: W4_ZERO_EMPTY.block + 1,
+                            ..W4_ZERO_EMPTY
+                        },
+                    )
+                }),
+            ),
+            (
+                "companion storage phase without its fee",
+                |a| answer(a, W4_SKIPPED_EMPTY),
+                Some(|a| {
+                    edited(a, W4_ZERO_EMPTY, |root| {
+                        root["description"]["storage_ph"] =
+                            serde_json::json!({ "status_change": "unchanged" });
+                    })
+                }),
+            ),
+            (
+                "action fee above the operation's total",
+                |a| {
+                    answer(
+                        a,
+                        Root {
+                            total_fees: 1_000,
+                            ..W4_SKIPPED_EMPTY
+                        },
+                    )
+                },
+                Some(|a| answer(a, W4_ZERO_EMPTY)),
+            ),
+            (
+                "operation gas malformed",
+                |a| {
+                    edited(a, W4_SKIPPED_EMPTY, |root| {
+                        root["description"]["compute_ph"]["gas_used"] = "3.5e3".into();
+                    })
+                },
+                None,
+            ),
+            (
+                "operation storage phase without its fee",
+                |a| {
+                    edited(a, W4_SKIPPED_EMPTY, |root| {
+                        root["description"]["storage_ph"] =
+                            serde_json::json!({ "status_change": "unchanged" });
+                    })
+                },
+                None,
+            ),
+            (
+                "operation storage phase malformed",
+                |a| {
+                    edited(a, W4_SKIPPED_EMPTY, |root| {
+                        root["description"]["storage_ph"] = "26".into();
+                    })
+                },
+                None,
+            ),
+        ];
+        for (label, operation, companion) in cases {
+            let (result, scripted) = run(
+                W4,
+                single(1_000_000_000, None, Shape::Empty, true),
+                |address| {
+                    let mut replies = vec![operation(address)];
+                    replies.extend(companion.map(|companion| companion(address)));
+                    replies
+                },
+            );
+            assert_eq!(result, Err(short(W4, 1_000_000_000, None, None)), "{label}");
+            let expected = if companion.is_some() {
+                with_companion(W4_SKIPPED_EMPTY.block)
+            } else {
+                UNTIL_OPERATION.to_vec()
+            };
+            assert_eq!(scripted.http.calls(), expected, "{label}");
+        }
+
+        // Not above the balance, with the captured skipped rows: no fee is
+        // ever attached; the raw skipped fee keeps the default refusal only.
+        let raw = W4_EARLIER_SKIPPED.total_fees;
+        let rows = [
+            (700_663_173, rejected(NONE_CREATED)),
+            (
+                W4.balance - raw,
+                short_for_fees(W4, W4.balance - raw, raw, None, None),
+            ),
+        ];
+        for (value, expected) in rows {
+            let (result, scripted) = run(W4, single(value, None, Shape::Empty, true), |address| {
+                vec![answer(address, W4_EARLIER_SKIPPED), Reply::Offline]
+            });
+            assert_eq!(result, Err(expected), "{value}");
+            assert_eq!(
+                scripted.http.calls(),
+                with_companion(W4_EARLIER_SKIPPED.block)
+            );
+        }
+    }
