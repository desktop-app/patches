+/// Reads a `(Maybe Grams)` fee that the protocol stores only when nonzero:
+/// an absent or `null` value is zero, any other value reads as
+/// [`lenient_unsigned`] does.
+fn maybe_nanograms(value: &serde_json::Value) -> Option<BigUint> {
+    if value.is_null() {
+        Some(BigUint::default())
+    } else {
+        lenient_unsigned(value)
+    }
+}
+
+/// Reads a nonnegative integer that Toncenter encodes as a JSON number or as
+/// a canonical decimal string; any other value is unusable.
+fn lenient_unsigned(value: &serde_json::Value) -> Option<BigUint> {
+    match value {
+        serde_json::Value::Number(number) => number.as_u64().map(BigUint::from),
+        serde_json::Value::String(text) => UnsignedDecimalString::try_from(text.as_str())
+            .ok()
+            .map(UnsignedDecimalString::into_biguint),
+        serde_json::Value::Null
+        | serde_json::Value::Bool(_)
+        | serde_json::Value::Array(_)
+        | serde_json::Value::Object(_) => None,
+    }
+}
