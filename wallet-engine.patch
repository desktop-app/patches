+        let mut pair_modes = Vec::new();
+
+        for (mode, external_refusal, internal_refusal) in SIGNING_MODE_CASES {
+            let served = [Served::call(Some(mode))];
+            let request = served_request(&served);
+
+            let external = refusal(fixture.external(&request)).map(|prepared| {
+                fixture.signed_modes(&prepared.signed_boc, Delivery::External, &served)
+            });
+            assert_eq!(
+                external,
+                expected_signing(mode, external_refusal),
+                "external form, mode {mode}"
+            );
+            let internal = refusal(fixture.internal(&request)).map(|prepared| {
+                fixture.signed_modes(&prepared.signed_boc, Delivery::Internal, &served)
+            });
+            assert_eq!(
+                internal,
+                expected_signing(mode, internal_refusal),
+                "internal form, mode {mode}"
+            );
+            // The pair always builds an external BOC as well, so it follows the external rule.
+            let pair = refusal(fixture.pair(&request)).map(|(external, internal)| {
+                let modes = fixture.signed_modes(&external.signed_boc, Delivery::External, &served);
+                assert_eq!(
+                    fixture.signed_modes(&internal.signed_boc, Delivery::Internal, &served),
+                    modes
+                );
+                modes
+            });
+            assert_eq!(
+                pair,
+                expected_signing(mode, external_refusal),
+                "pair, mode {mode}"
+            );
+
+            for (outcome, accepted) in [
+                (external.is_ok(), &mut external_modes),
+                (internal.is_ok(), &mut internal_modes),
+                (pair.is_ok(), &mut pair_modes),
+            ] {
+                if outcome {
+                    accepted.push(mode);
+                }
+            }
+        }
+
+        assert_eq!(external_modes, [2, 3, 18, 19]);
+        assert_eq!(internal_modes, [0, 1, 2, 3, 16, 17, 18, 19]);
+        assert_eq!(pair_modes, [2, 3, 18, 19]);
+    }
