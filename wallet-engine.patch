+        };
+        let state_init = &active.state_init;
+        assert_eq!(state_init.library.len(), 2);
+
+        // the same StateInit on its own, as a message carries it
+        let state_init_boc = state_init.to_boc()?;
+        let parsed = StateInit::from_boc(state_init_boc.clone())?;
+        assert_eq!(&parsed, state_init);
+        assert_eq!(parsed.to_boc()?, state_init_boc);
+
+        Ok(())
     }
 }
diff --git a/vendor/ton/src/tlb_adapters/node_budget.rs b/vendor/ton/src/tlb_adapters/node_budget.rs
new file mode 100644
index 0000000..7a1a981
--- /dev/null
+++ b/vendor/ton/src/tlb_adapters/node_budget.rs
@@ -0,0 +1,100 @@
+//! Work bound for the recursive readers of untrusted cell trees (`Hashmap`, `BinTree`).
+//!
+//! Cells form a DAG: a few dozen cells whose two references point at the same child
+//! describe a tree with 2^depth distinct paths. A reader that follows every path has to
+//! bound its own work, the size of the BoC it was given bounds nothing.
+
+use std::cell::Cell;
+use ton_core::bail_ton_core_data;
+use ton_core::errors::TonCoreError;
+
+/// Nodes (forks and leaves) that one outermost read may visit, dictionaries nested in its
+/// values included. A complete 15-bit dictionary (the widest key space of the fixed-size
+/// dictionaries in a transaction, `out_msgs`) has 2^16 - 1 nodes.
+pub(crate) const MAX_WALK_NODES: usize = 1 << 16;
+
+thread_local! {
+    // (reads active on this thread, nodes left for the outermost of them)
+    static WALK: Cell<(usize, usize)> = const { Cell::new((0, 0)) };
+}
+
+/// Scope of one read. A read started inside another one (a dictionary in a dictionary
+/// value) draws from the budget of the outermost read, so nesting can't multiply it.
+pub(crate) struct WalkBudget(());
+
+impl WalkBudget {
+    pub(crate) fn enter() -> Self {
+        WALK.with(|walk| {
+            let (depth, left) = walk.get();
+            walk.set(if depth == 0 {
+                (1, MAX_WALK_NODES)
+            } else {
+                (depth + 1, left)
+            });
+        });
+        Self(())
+    }
+
+    /// Accounts one visited node, fails when the budget of the outermost read is spent.
+    pub(crate) fn visit_node(&self) -> Result<(), TonCoreError> {
+        WALK.with(|walk| {
+            let (depth, left) = walk.get();
+            let Some(left) = left.checked_sub(1) else {
+                bail_ton_core_data!(
+                    "Too many nodes on the paths of a dict: limit is {MAX_WALK_NODES}"
+                );
+            };
+            walk.set((depth, left));
+            Ok(())
+        })
+    }
+}
+
+impl Drop for WalkBudget {
+    fn drop(&mut self) {
+        WALK.with(|walk| {
+            let (depth, left) = walk.get();
+            walk.set((depth.saturating_sub(1), left));
+        });
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn spend(budget: &WalkBudget, nodes: usize) -> Result<(), TonCoreError> {
+        (0..nodes).try_for_each(|_| budget.visit_node())
+    }
+
+    #[test]
+    fn test_walk_budget_is_per_outermost_read() -> anyhow::Result<()> {
+        for _ in 0..2 {
+            let budget = WalkBudget::enter();
+            spend(&budget, MAX_WALK_NODES)?;
+            assert!(budget.visit_node().is_err());
+        }
+        Ok(())
+    }
+
+    #[test]
+    fn test_walk_budget_is_shared_with_nested_reads() -> anyhow::Result<()> {
+        let outer = WalkBudget::enter();
+        spend(&outer, MAX_WALK_NODES - 10)?;
+        {
+            let nested = WalkBudget::enter();
+            spend(&nested, 7)?;
+        }
+        {
+            let nested = WalkBudget::enter();
+            spend(&nested, 3)?;
+            assert!(nested.visit_node().is_err());
+        }
+        assert!(outer.visit_node().is_err());
+        drop(outer);
+
+        let next = WalkBudget::enter();
+        spend(&next, MAX_WALK_NODES)?;
+        Ok(())
+    }
+}
