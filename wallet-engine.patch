+/// How the root wallet transaction delivered the requested outgoing messages.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(super) enum MessageCreation {
+    /// It created every message and skipped none.
+    Every,
+    /// It created none of them.
+    Nothing,
+    /// Any other delivery, such as only some of the messages.
+    Partial,
+}
+
+/// How the root wallet transaction's action phase handled its actions.
+///
+/// Read leniently from the answer: unusable counters leave this absent and
+/// never change how the rest of the answer parses.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
