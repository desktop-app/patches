+    /// Decodes a complete signed wallet BOC with the vendored readers alone.
+    ///
+    /// The envelope must address `source` and deploy nothing; each action
+    /// message must be consumed completely. Returns every action's mode and
+    /// message in request order.
+    fn decode_wallet_actions(
+        boc: &Boc,
+        source: &TonAddressString,
+        delivery: Delivery,
+    ) -> Vec<(u8, Msg<TonCell>)> {
+        let root = TonCell::from_boc(boc.as_bytes().to_vec()).expect("signed BOC parses");
+        let envelope = read_whole_message(&root);
+        assert!(envelope.init.is_none(), "an active wallet is not deployed");
+        let mut body = envelope.body.value.parser();
+        let (modes, messages) = match delivery {
+            Delivery::External => {
+                let CommonMsgInfo::ExtIn(info) = &envelope.info else {
+                    panic!("an external request must use an external envelope");
+                };
+                assert_eq!(info.dst, source.as_address().to_msg_address_int());
+                let (request, _) = WalletExtMsgBody::read_signed(&mut body)
+                    .expect("external wallet request decodes");
+                (request.msgs_modes, request.msgs)
+            }
+            Delivery::Internal => {
+                let CommonMsgInfo::Int(info) = &envelope.info else {
+                    panic!("an internal request must use an internal envelope");
+                };
+                assert_eq!(info.dst, source.as_address().to_msg_address());
+                let (request, _) =
+                    ton::ton_wallet::WalletInternalSignedBody::read_signed(&mut body)
+                        .expect("internal wallet request decodes");
+                (request.msgs_modes, request.msgs)
+            }
+        };
