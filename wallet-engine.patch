+    /// Each new refusal finishes the preview: the same client previews a
+    /// created operation right after it.
+    #[test]
+    fn a_preview_after_each_new_refusal_succeeds() {
+        let missing: fn(&mut serde_json::Value) = |root| {
+            let action = root["description"]["action"]
+                .as_object_mut()
+                .expect("action");
+            for field in ["tot_actions", "skipped_actions", "msgs_created"] {
+                let _ = action.remove(field);
+            }
+            let _ = root.as_object_mut().expect("root").remove("out_msgs");
+        };
+        let scripted = Scripted::new(W4, |address| {
+            vec![
+                answer(address, W4_EARLIER_SKIPPED),
+                answer(address, W4_CREATED_EMPTY),
+                answer(
+                    address,
+                    Root {
+                        delivery: (1, 1, 1),
+                        ..W4_CREATED_EMPTY
+                    },
+                ),
+                answer(address, W4_CREATED_EMPTY),
+                edited(address, W4_CREATED_EMPTY, missing),
+                answer(address, W4_CREATED_EMPTY),
+            ]
+        });
+        let created = single(100_000_000, None, Shape::Empty, false);
+        for refusal in [rejected(NONE_CREATED), rejected(ONLY_SOME), unreported()] {
+            assert_eq!(scripted.preview(created.clone()), Err(refusal.clone()));
+            let next = scripted
+                .preview(created.clone())
+                .unwrap_or_else(|error| panic!("after {refusal:?}: {error:?}"));
+            assert_eq!(
+                next.emulation.wallet_fees_nanograms,
+                decimal(W4_CREATED_EMPTY.total_fees)
+            );
+        }
+        assert_eq!(scripted.http.calls().len(), 18);
+        assert_eq!(scripted.unused_answers(), 0);
+    }
