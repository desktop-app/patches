+    /// Delivery form of a signed wallet request.
+    #[derive(Debug, Clone, Copy)]
+    enum Delivery {
+        /// An incoming external message, as normal submission and emulation use.
+        External,
+        /// An owner-signed internal message, as gasless submission uses.
+        Internal,
+    }
+
+    /// Decodes a complete signed wallet BOC with the vendored readers alone.
+    ///
+    /// The envelope must address `source` and deploy nothing; each action
+    /// message must be consumed completely. Returns every action's mode and
+    /// message in request order.
+    fn decode_wallet_actions(
+        boc: &Boc,
+        source: &TonAddressString,
+        delivery: Delivery,
+    ) -> Vec<(u8, Msg<TonCell>)> {
+        let root = TonCell::from_boc(boc.as_bytes().to_vec()).expect("signed BOC parses");
+        let envelope = read_whole_message(&root);
+        assert!(envelope.init.is_none(), "an active wallet is not deployed");
+        let mut body = envelope.body.value.parser();
+        let (modes, messages) = match delivery {
+            Delivery::External => {
+                let CommonMsgInfo::ExtIn(info) = &envelope.info else {
+                    panic!("an external request must use an external envelope");
+                };
+                assert_eq!(info.dst, source.as_address().to_msg_address_int());
+                let (request, _) = WalletExtMsgBody::read_signed(&mut body)
+                    .expect("external wallet request decodes");
+                (request.msgs_modes, request.msgs)
+            }
+            Delivery::Internal => {
+                let CommonMsgInfo::Int(info) = &envelope.info else {
+                    panic!("an internal request must use an internal envelope");
+                };
+                assert_eq!(info.dst, source.as_address().to_msg_address());
+                let (request, _) =
+                    ton::ton_wallet::WalletInternalSignedBody::read_signed(&mut body)
+                        .expect("internal wallet request decodes");
+                (request.msgs_modes, request.msgs)
+            }
+        };
+        assert_eq!(modes.len(), messages.len());
+        modes
+            .into_iter()
+            .zip(messages.iter().map(read_whole_message))
+            .collect()
+    }
+
+    /// Reads one message cell and requires that nothing follows the message.
+    fn read_whole_message(cell: &TonCell) -> Msg<TonCell> {
+        let mut parser = cell.parser();
+        let message = Msg::<TonCell>::read(&mut parser).expect("message decodes");
+        parser
+            .ensure_empty()
+            .expect("message has no trailing bits or references");
+        message
+    }
+
+    /// Keeps a signer's intent refusal and fails on any other signing error.
+    fn refusal<T>(result: Result<T, TransferError>) -> Result<T, SendIntentError> {
+        result.map_err(|error| {
+            let TransferError::InvalidIntent(refusal) = error else {
+                panic!("unexpected signing error: {error}");
+            };
+            refusal
+        })
+    }
+
+    /// The outcome expected from signing one served `mode`: its exact mode, or
+    /// the named refusal.
+    fn expected_signing(
+        mode: i32,
+        refusal: Option<SendModeRefusal>,
+    ) -> Result<Vec<i32>, SendIntentError> {
+        refusal.map_or_else(
+            || Ok(vec![mode]),
+            |reason| Err(SendIntentError::UnsupportedSendMode { mode, reason }),
+        )
+    }
+
+    /// A served contract's code cell, with children, and its distinct data cell.
+    fn served_contract_cells() -> (TonCell, TonCell) {
+        let code = bytes_cell(
+            &[0xc0, 0xde],
+            vec![
+                bytes_cell(&[0x01], Vec::new()),
+                bytes_cell(&[0x02], vec![bytes_cell(&[0x6c], Vec::new())]),
+            ],
+        );
+        let data = bytes_cell(&[0xda, 0x7a], vec![bytes_cell(&[0x03], Vec::new())]);
+        (code, data)
+    }
+
+    /// Builds an ordinary cell from whole bytes and child references.
+    fn bytes_cell(bytes: &[u8], children: Vec<TonCell>) -> TonCell {
+        let mut cell = TonCell::builder();
+        cell.write_bits(bytes, bytes.len() * 8)
+            .expect("bytes fit one cell");
+        for child in children {
+            cell.write_ref(child).expect("child reference fits");
         }
+        cell.build().expect("cell builds")
     }
 }
