+    /// Without usable counters the root's `out_msgs` list decides: a list
+    /// with the request's length is the unchanged preview, an empty or short
+    /// one is refused, and neither record usable fails. Usable counters
+    /// decide alone, whatever the list holds. The edited rows are synthetic.
+    #[test]
+    fn default_previews_read_the_output_list_only_without_usable_counters() {
+        type Edit = fn(&mut serde_json::Value);
+        let request = || single(100_000_000, None, Shape::Empty, false);
+        let base = Ok(expected_preview(&request(), W4, W4_CREATED_EMPTY));
+        let keep: Edit = |_| {};
+        let counters: [Edit; 7] = [
+            |root| {
+                let action = root["description"]["action"]
+                    .as_object_mut()
+                    .expect("action");
+                for field in ["tot_actions", "skipped_actions", "msgs_created"] {
+                    let _ = action.remove(field);
+                }
+            },
+            |root| root["description"]["action"]["msgs_created"] = (-1).into(),
+            |root| root["description"]["action"]["tot_actions"] = "one".into(),
+            |root| root["description"]["action"]["msgs_created"] = 1.5.into(),
+            |root| root["description"]["action"]["skipped_actions"] = 65_536.into(),
+            |root| {
+                root["description"]["action"]["skipped_actions"] = "18446744073709551616".into();
+            },
+            |root| root["description"]["action"]["msgs_created"] = serde_json::Value::Null,
+        ];
+        let empty: Edit = |root| root["out_msgs"] = serde_json::json!([]);
+        let unusable: [Edit; 5] = [
+            |root| {
+                let _ = root.as_object_mut().expect("root").remove("out_msgs");
+            },
+            |root| root["out_msgs"] = serde_json::Value::Null,
+            |root| root["out_msgs"] = serde_json::json!({ "0": {} }),
+            |root| root["out_msgs"] = "[{}]".into(),
+            |root| root["out_msgs"] = 1.into(),
+        ];
+        let reply = |root: Root, counters: Edit, list: Edit| {
+            move |address: &str| {
+                let mut body = answer_json(address, root);
+                counters(&mut body["transactions"]["root"]);
+                list(&mut body["transactions"]["root"]);
+                vec![Reply::Json(200, body)]
+            }
+        };
+
+        for (index, counters) in counters.into_iter().enumerate() {
+            let (result, _) = run(W4, request(), reply(W4_CREATED_EMPTY, counters, keep));
+            assert_eq!(result, base, "counters {index}, created list");
+            let (result, _) = run(W4, request(), reply(W4_CREATED_EMPTY, counters, empty));
+            assert_eq!(
+                result,
+                Err(rejected(NONE_CREATED)),
+                "counters {index}, empty list"
+            );
+            for (list_index, list) in unusable.into_iter().enumerate() {
+                let (result, scripted) =
+                    run(W4, request(), reply(W4_CREATED_EMPTY, counters, list));
+                assert_eq!(
+                    result,
+                    Err(unreported()),
+                    "counters {index}, list {list_index}"
+                );
+                assert_eq!(scripted.http.requests(), expected_requests(&request(), W4));
+            }
+        }
+
+        // A two-message list one entry short is partial; the full one is
+        // the created batch.
+        let short_list: Edit = |root| {
+            let _ = root["out_msgs"].as_array_mut().expect("list").pop();
+        };
+        let (result, _) = run(W4, batch(), reply(W4_CREATED_TWO, counters[0], short_list));
+        assert_eq!(result, Err(rejected(ONLY_SOME)));
+        let (result, _) = run(W4, batch(), reply(W4_CREATED_TWO, counters[0], keep));
+        assert_eq!(result, Ok(expected_preview(&batch(), W4, W4_CREATED_TWO)));
+
+        // Usable counters decide, with no new veto from an unusable or
+        // disagreeing list.
+        for list in unusable.into_iter().chain([empty]) {
+            let (result, _) = run(W4, request(), reply(W4_CREATED_EMPTY, keep, list));
+            assert_eq!(result, base);
+        }
+        let skipped = Root {
+            delivery: SKIPPED,
+            ..W4_CREATED_EMPTY
+        };
+        let one_entry: Edit = |root| {
+            root["out_msgs"] = serde_json::json!([{ "destination": DESTINATION }]);
+        };
+        for list in unusable.into_iter().chain([keep, one_entry]) {
+            let (result, _) = run(W4, request(), reply(skipped, keep, list));
+            assert_eq!(result, Err(rejected(NONE_CREATED)));
+        }
+    }
