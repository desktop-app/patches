+    /// Answers the configured wallet's account read and `seqno` read from an
+    /// [`Account`] and each emulateTrace from the next scripted [`Reply`].
+    /// Every request is recorded; any other request fails.
+    struct ScriptedHost {
+        address: String,
+        account: Account,
+        emulations: Mutex<VecDeque<Reply>>,
+        requests: Mutex<Vec<HttpRequest>>,
+        cancelled: Mutex<Vec<HttpRequestId>>,
+        hold: Mutex<Option<(mpsc::Sender<HttpRequestId>, mpsc::Receiver<()>)>>,
+    }
+
+    impl ScriptedHost {
+        fn requests(&self) -> Vec<HttpRequest> {
+            self.requests.lock().expect("request lock").clone()
+        }
+
+        fn calls(&self) -> Vec<Call> {
+            self.requests()
+                .iter()
+                .map(|request| self.classify(request))
+                .collect()
+        }
+
+        /// The JSON bodies of the recorded emulateTrace requests, in order.
+        fn emulations(&self) -> Vec<serde_json::Value> {
+            self.requests()
+                .iter()
+                .filter(|request| matches!(self.classify(request), Call::Emulate(_)))
+                .map(|request| serde_json::from_slice(&request.body).expect("emulation body"))
+                .collect()
+        }
+
+        fn cancelled(&self) -> Vec<HttpRequestId> {
+            self.cancelled.lock().expect("cancel lock").clone()
+        }
+
+        fn classify(&self, request: &HttpRequest) -> Call {
+            let unexpected = || Call::Unexpected(request.url.clone());
+            let Ok(url) = url::Url::parse(&request.url) else {
+                return unexpected();
+            };
+            if url.host_str() != Some("provider.example") {
+                return unexpected();
+            }
+            let body = || serde_json::from_slice::<serde_json::Value>(&request.body).ok();
+            match (request.method, url.path()) {
+                (HttpMethod::Get, "/api/v2/getAddressInformation") => {
+                    let query = url.query_pairs().into_owned().collect::<Vec<_>>();
+                    if query == [("address".to_owned(), self.address.clone())] {
+                        Call::Account
+                    } else {
+                        unexpected()
+                    }
+                }
+                (HttpMethod::Post, "/api/v2/jsonRPC") => {
+                    if let Some(body) = body()
+                        && body["method"] == "runGetMethod"
+                        && body["params"]["method"] == "seqno"
+                        && body["params"]["address"] == self.address.as_str()
+                    {
+                        Call::Seqno
+                    } else {
+                        unexpected()
+                    }
+                }
+                (HttpMethod::Post, "/api/emulate/v1/emulateTrace") => {
+                    let Some(body) = body() else {
+                        return unexpected();
+                    };
+                    let block = &body["mc_block_seqno"];
+                    if block.is_null() {
+                        Call::Emulate(None)
+                    } else {
+                        block
+                            .as_u64()
+                            .map_or_else(unexpected, |block| Call::Emulate(Some(block)))
+                    }
+                }
+                _ => unexpected(),
+            }
+        }
