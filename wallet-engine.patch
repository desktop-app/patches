+
+        #[test]
+        fn mutated_demo_cells_never_panic(
+            len in 0_u8..128,
+            text in proptest::collection::vec(proptest::prelude::any::<u8>(), 0..120),
+            extra_bits in 0_usize..8,
+            flip in proptest::prelude::any::<u16>(),
