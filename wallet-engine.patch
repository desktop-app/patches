+    /// A never-deployed zero wallet sends its own `StateInit` with seqno 0
+    /// and reads no seqno; the network rejects it before execution, so the
+    /// refusal carries no fee, never a zero one. A zero value, which is not
+    /// above the balance, keeps the default preview's emulation error.
+    #[test]
+    fn a_never_deployed_zero_wallet_is_refused_without_a_fee() {
+        for status in [AccountStatus::Uninitialized, AccountStatus::Nonexistent] {
+            let account = Account {
+                status,
+                ..NEVER_DEPLOYED
+            };
+            let request = single(1_000_000_000, None, Shape::Empty, true);
+            let (result, scripted) =
+                run(account, request.clone(), |address| vec![rejection(address)]);
+            assert_eq!(
+                result,
+                Err(short(account, 1_000_000_000, None, None)),
+                "{status:?}"
+            );
+            assert_eq!(
+                scripted.http.calls(),
+                [Call::Account, Call::Emulate(None)],
+                "{status:?}"
+            );
+            let operation = decode(&scripted.http.emulations()[0]);
+            let config = client_config();
+            let (_, own) = derive_wallet_public_state(&config.public_key, config.network)
+                .expect("state init derives");
+            assert_eq!(
+                operation.external.init.map(|init| init.value),
+                Some(own),
+                "{status:?}"
+            );
+            assert_eq!(operation.wallet.msg_seqno, 0);
+            assert_eq!(
+                operation.boc,
+                expected_boc(&single(1_000_000_000, None, Shape::Empty, false), account)
+            );
+
+            let (opted, _) = run(account, single(0, None, Shape::Empty, true), |address| {
+                vec![rejection(address)]
+            });
+            let (default, _) = run(account, single(0, None, Shape::Empty, false), |address| {
+                vec![rejection(address)]
+            });
+            assert!(
+                matches!(opted, Err(WalletClientError::EmulationFailed { .. })),
+                "{opted:?}"
+            );
+            assert_eq!(opted, default);
+        }
+    }
