+impl UnusableQuote {
+    /// Resolves the preview with the funds checks of [`funds_refusal`], never
+    /// as a success.
+    ///
+    /// An established spend decides like a created emulation's spend, and an
+    /// established fee without one is compared like the default preview's
+    /// fee; both are reported. Without either, the raw fee keeps only the
+    /// refusal that the default preview would give and is never reported as
+    /// the operation's fee. When no check refuses, the emulation error stands,
+    /// even where the spend fits: the wallet did not create the messages.
+    fn refusal(
+        self,
+        available: &UnsignedDecimalString,
+        requested: &UnsignedDecimalString,
+    ) -> WalletClientError {
+        let Self {
+            raw_fee,
+            operation_fee,
+            operation_spend,
+            error,
+        } = self;
+        let fee = operation_fee.clone().unwrap_or(raw_fee);
+        funds_refusal(available, requested, &fee, operation_fee, operation_spend).unwrap_or(error)
