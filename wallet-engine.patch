+    /// A TON Connect batch takes the default route: it succeeds only when the
+    /// wallet created every message, and the same client previews again
+    /// after each refusal. The two-message answers are synthetic.
+    #[test]
+    fn ton_connect_batches_need_every_message_created() {
+        let rows = [
+            ((2, 0, 2), None),
+            ((2, 1, 1), Some(rejected(ONLY_SOME))),
+            ((2, 0, 2), None),
+            ((2, 2, 0), Some(rejected(NONE_CREATED))),
+            ((2, 0, 2), None),
+        ];
+        let scripted = Scripted::new(W4, |address| {
+            rows.iter()
+                .map(|(delivery, _)| {
+                    answer(
+                        address,
+                        Root {
+                            delivery: *delivery,
+                            ..W4_CREATED_TWO
+                        },
+                    )
+                })
+                .collect()
+        });
+        let intent = request(
+            vec![
+                message(100_000_000, None, Shape::Empty),
+                message(200_000_000, Some(3), Shape::Payload),
+            ],
+            false,
+        );
+        for (index, (delivery, refusal)) in rows.into_iter().enumerate() {
+            let result = block_on(scripted.client.preview_ton_connect(SendRequest {
+                operation_id: NonEmptyString::try_from("ton-connect").expect("operation ID"),
+                force: false,
+                intent: intent.intent.clone(),
+            }));
+            assert!(
+                scripted
+                    .client
+                    .lock()
+                    .expect("state")
+                    .active_preview
+                    .is_none(),
+                "the preview slot is finished"
+            );
+            match refusal {
+                None => assert_eq!(
+                    result,
+                    Ok(expected_preview(&intent, W4, W4_CREATED_TWO)),
+                    "{index}"
+                ),
+                Some(error) => assert_eq!(result, Err(error), "{index} {delivery:?}"),
+            }
+            let calls = scripted.http.calls();
+            assert_eq!(calls.len(), (index + 1) * 3);
+            assert_eq!(calls[index * 3..], UNTIL_OPERATION);
+        }
+        assert_eq!(scripted.unused_answers(), 0);
+    }
