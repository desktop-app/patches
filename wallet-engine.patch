+    let anchor = request.descriptor.address.as_address();
+    let address_hash = <[u8; 32]>::try_from(anchor.hash.as_slice())
+        .map_err(|_| WalletLifecycleError::TonConnectSigningFailed)?;
+    let address = RawAccountAddress::new(anchor.workchain, address_hash);
+    let network = NetworkId::try_from(network_global_id(request.descriptor.network))
+        .map_err(|_| WalletLifecycleError::TonConnectSigningFailed)?;
+    let payload = sign_data_payload(&request.request)
+        .map_err(|_| WalletLifecycleError::TonConnectSigningFailed)?;
+    payload
+        .validate_context(&network, &address)
+        .map_err(|_| WalletLifecycleError::TonConnectSigningFailed)?;
+    unsigned_sign_data_result(address, request.domain.clone(), request.timestamp, payload)
+        .signing_hash()
+        .map_err(|_| WalletLifecycleError::TonConnectSigningFailed)
