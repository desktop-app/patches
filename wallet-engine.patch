+        let fields = decoded(schema, &chain(5), false);
+        let depths = fields
+            .iter()
+            .filter(|(_, name, _)| name == "next")
+            .map(|(depth, _, _)| *depth)
+            .collect::<Vec<_>>();
+        assert_eq!(depths, [0, 1, 2, 3, 4]);
