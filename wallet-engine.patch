+    /// Synthetic provider balances around captured answers: a created
+    /// operation refuses exactly when its value plus its spend exceeds the
+    /// balance, for each fee kind, with the fee and the spend, and succeeds
+    /// with the spend at equality and above. A mode-2 or mode-18 message
+    /// whose balance lies between `V + S` and `V + F` succeeds, which the fee
+    /// comparison would refuse. A value above the balance carries both
+    /// amounts. The default preview at the same balances keeps its fee
+    /// comparison and reports no spend. A skipped operation's composite
+    /// spend draws the same line: one nanogram short refuses, and where the
+    /// spend fits the skip stays the emulation refusal. The chain cannot
+    /// produce these answers at these balances, so the rows check the
+    /// classifier against the protocol's boundary, not chain behaviour.
+    #[test]
+    fn the_engine_equality_boundary_is_the_spend() {
+        let value = 100_000_000;
+        let fee = W4_CREATED_EMPTY.total_fees;
+        // The spends that the captured 1e8 answers debited: 600614258 after
+        // for modes 3 and 19, 600687592 for modes 2 and 18.
+        let pays = debit_spend(value, 701_082_553, 600_614_258);
+        let kept = debit_spend(value, 701_082_553, 600_687_592);
+        assert_eq!((pays, kept), (468_295, 394_961));
+        assert!(kept < fee && fee < pays);
+        // Balance, whether the opt-in and the default previews succeed.
+        let paying = [
+            (value - 1, false, false),
+            (value + fee - 1, false, false),
+            (value + fee, false, false),
+            (value + fee + 1, false, true),
+            (value + pays - 1, false, true),
+            (value + pays, true, true),
+            (value + pays + 1, true, true),
+        ];
+        let keeping = [
+            (value - 1, false, false),
+            (value + kept - 1, false, false),
+            (value + kept, true, false),
+            (value + kept + 1, true, false),
+            (value + fee - 1, true, false),
+            (value + fee, true, false),
+            (value + fee + 1, true, true),
+        ];
+        let modes = [
+            (None, pays, &paying),
+            (Some(3), pays, &paying),
+            (Some(19), pays, &paying),
+            (Some(2), kept, &keeping),
+            (Some(18), kept, &keeping),
+        ];
+        for (mode, spend, rows) in modes {
+            for &(balance, opted_succeeds, default_succeeds) in rows {
+                let label = format!("{mode:?} {balance}");
+                let account = Account { balance, ..W4 };
+                let request = single(value, mode, Shape::Empty, true);
+                let (opted, scripted) = run(account, request.clone(), |address| {
+                    vec![answer(address, W4_CREATED_EMPTY)]
+                });
+                assert_eq!(scripted.http.calls(), UNTIL_OPERATION, "{label}");
+                if opted_succeeds {
+                    assert_eq!(
+                        opted,
+                        Ok(expected_quote(&request, account, W4_CREATED_EMPTY, spend)),
+                        "{label}"
+                    );
+                } else {
+                    assert_eq!(
+                        opted,
+                        Err(spend_refusal(account, value, fee, spend)),
+                        "{label}"
+                    );
+                }
+
+                let default = single(value, mode, Shape::Empty, false);
+                let above = balance < value;
+                let (result, _) = run(account, default.clone(), |address| {
+                    if above {
+                        Vec::new()
+                    } else {
+                        vec![answer(address, W4_CREATED_EMPTY)]
+                    }
+                });
+                let expected = if default_succeeds {
+                    Ok(expected_preview(&default, account, W4_CREATED_EMPTY))
+                } else if above {
+                    Err(short(account, value, None, None))
+                } else {
+                    Err(short_for_fees(account, value, fee, None, None))
+                };
+                assert_eq!(result, expected, "{label}");
+            }
+        }
+
+        // Skipped operations priced by their composite, with the spend of
+        // the same block's created answer: (wallet, mode, shape, value,
+        // operation, companion, spend).
+        let composites = [
+            (
+                W4,
+                Some(19),
+                Shape::Empty,
+                1_000_000_000,
+                W4_SKIPPED_EMPTY,
+                W4_ZERO_EMPTY,
+                pays,
+            ),
+            (
+                W4,
+                Some(2),
+                Shape::StateInit,
+                1_000_000_000,
+                W4_SKIPPED_INIT,
+                W4_ZERO_INIT,
+                debit_spend(value, 701_082_553, 600_626_925),
+            ),
+            (
+                W5,
+                Some(18),
+                Shape::Comment,
+                500_000_000_000,
+                W5_SKIPPED_COMMENT,
+                W5_ZERO_COMMENT,
+                debit_spend(5_000_000_000, 100_006_637_868, 95_006_230_127),
+            ),
+        ];
+        for (wallet, mode, shape, value, operation, companion, spend) in composites {
+            let fee = operation.composite(companion);
+            let mut balances = vec![
+                (value + spend - 1, false),
+                (value + spend, true),
+                (value + spend + 1, true),
+            ];
+            if spend < fee {
+                // Between `V + S` and `V + F`, where the fee would refuse.
+                balances.extend([(value + fee - 1, true), (value + fee, true)]);
+            }
+            for (balance, fits) in balances {
+                let label = format!("{mode:?} {shape:?} {balance}");
+                let account = Account { balance, ..wallet };
+                let (result, scripted) =
+                    run(account, single(value, mode, shape, true), |address| {
+                        vec![answer(address, operation), answer(address, companion)]
+                    });
+                let expected = if fits {
+                    rejected(NONE_CREATED)
+                } else {
+                    spend_refusal(account, value, fee, spend)
+                };
+                assert_eq!(result, Err(expected), "{label}");
+                assert_eq!(
+                    scripted.http.calls(),
+                    with_companion(operation.block),
+                    "{label}"
+                );
+            }
+        }
+    }
