+        fn respond(
+            &self,
+            request: &HttpRequest,
+            reply: Reply,
+        ) -> Result<HttpResponse, HttpHostError> {
+            let (status, body) = match reply {
+                Reply::Json(status, body) => {
+                    (status, serde_json::to_vec(&body).expect("response JSON"))
+                }
+                Reply::Malformed => (200, b"{\"mc_block_seqno\": 104746942, \"trace\"".to_vec()),
+                Reply::Offline => {
+                    return Err(HttpHostError::Failed {
+                        kind: HttpHostErrorKind::Offline,
+                        diagnostic: "scripted offline".to_owned(),
+                    });
+                }
+                Reply::Held(reply) => {
+                    let (held, release) = self
+                        .hold
+                        .lock()
+                        .expect("hold lock")
+                        .take()
+                        .expect("the test armed a hold");
+                    held.send(request.id).expect("the test waits for the hold");
+                    release
+                        .recv_timeout(Duration::from_secs(60))
+                        .expect("the test releases the hold");
+                    return self.respond(request, *reply);
+                }
+            };
+            Ok(HttpResponse {
+                status,
+                headers: Vec::new(),
+                body,
+                final_url: request.url.clone(),
+            })
+        }
+    }
