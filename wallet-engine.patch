+    /// No dust band yields a fee: a balance below the flat gas price is
+    /// rejected before execution (captured text); out of gas fails the
+    /// compute phase; and a balance that pays for compute but not for the
+    /// message skips the companion too. The last two are protocol readings,
+    /// scripted with synthetic answers.
+    #[test]
+    fn dust_wallets_are_refused_without_a_fee() {
+        // Above the balance: the funds refusal without a fee.
+        let out_of_gas: fn(&mut serde_json::Value) = |root| {
+            root["total_fees"] = "200000".into();
+            root["description"]["compute_ph"]["success"] = false.into();
+            root["description"]["compute_ph"]["exit_code"] = (-14).into();
+            root["description"]["action"] = serde_json::Value::Null;
+        };
+        let accepted = Account {
+            balance: 400_000,
+            ..DUST
+        };
+        let starved = Account {
+            balance: 200_000,
+            ..DUST
+        };
+        // Synthetic: the captured skipped answer at a dust balance, and its
+        // zero-value companion skipped as well.
+        let skipped_companion = Root {
+            total_fees: 394_469,
+            ..W4_EARLIER_SKIPPED
+        };
+        let (result, scripted) = run(
+            DUST,
+            single(1_000_000_000, None, Shape::Empty, true),
+            |address| vec![rejection(address)],
+        );
+        assert_eq!(result, Err(short(DUST, 1_000_000_000, None, None)));
+        assert_eq!(scripted.http.calls(), UNTIL_OPERATION);
+        let (result, scripted) = run(
+            starved,
+            single(1_000_000_000, None, Shape::Empty, true),
+            |address| vec![edited(address, W4_EARLIER_SKIPPED, out_of_gas)],
+        );
+        assert_eq!(result, Err(short(starved, 1_000_000_000, None, None)));
+        assert_eq!(scripted.http.calls(), UNTIL_OPERATION);
+        let (result, scripted) = run(
+            accepted,
+            single(1_000_000_000, None, Shape::Empty, true),
+            |address| {
+                vec![
+                    answer(address, W4_EARLIER_SKIPPED),
+                    answer(address, skipped_companion),
+                ]
+            },
+        );
+        assert_eq!(result, Err(short(accepted, 1_000_000_000, None, None)));
+        assert_eq!(
+            scripted.http.calls(),
+            with_companion(W4_EARLIER_SKIPPED.block)
+        );
+
+        // Not above the balance: the default preview's error where it fails,
+        // and the fee-less emulation refusal where it would succeed on a
+        // skipped message.
+        let (opted, _) = run(DUST, single(1_000, None, Shape::Empty, true), |address| {
+            vec![rejection(address)]
+        });
+        let (default, _) = run(DUST, single(1_000, None, Shape::Empty, false), |address| {
+            vec![rejection(address)]
+        });
+        assert!(
+            matches!(opted, Err(WalletClientError::EmulationFailed { .. })),
+            "{opted:?}"
+        );
+        assert_eq!(opted, default);
+        let (opted, _) = run(
+            starved,
+            single(1_000, None, Shape::Empty, true),
+            |address| vec![edited(address, W4_EARLIER_SKIPPED, out_of_gas)],
+        );
+        let (default, _) = run(
+            starved,
+            single(1_000, None, Shape::Empty, false),
+            |address| vec![edited(address, W4_EARLIER_SKIPPED, out_of_gas)],
+        );
+        assert_eq!(
+            opted,
+            Err(WalletClientError::EmulationRejected {
+                diagnostic: "emulated transfer did not complete successfully".to_owned(),
+                compute_exit_code: Some(-14),
+                action_result_code: None,
+            })
+        );
+        assert_eq!(opted, default);
+        let (opted, scripted) = run(accepted, single(1, None, Shape::Empty, true), |address| {
+            vec![
+                answer(address, W4_EARLIER_SKIPPED),
+                answer(address, skipped_companion),
+            ]
+        });
+        assert_eq!(opted, Err(rejected(NONE_CREATED)));
+        assert_eq!(
+            scripted.http.calls(),
+            with_companion(W4_EARLIER_SKIPPED.block)
+        );
+    }
