+        // Each list level costs three decode levels (`Maybe`, `^`, `R`), so
+        // 11 cells are the longest chain within `MAX_DECODE_DEPTH`.
+        assert!(matches!(
+            decode_sign_data_cell(schema, &chain(11), false),
+            TonConnectSignDataCellDecoding::Decoded { .. }
