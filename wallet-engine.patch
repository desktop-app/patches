+                W4,
+                Some(18),
+                Shape::Empty,
+                W4_SKIPPED_EMPTY,
+                W4_ZERO_EMPTY,
+                W4_CREATED_EMPTY,
+                (100_000_000, 701_082_553, 600_687_592),
+            ),
+            (
+                W4,
+                Some(19),
+                Shape::Empty,
+                W4_SKIPPED_EMPTY,
+                W4_ZERO_EMPTY,
+                W4_CREATED_EMPTY,
+                (100_000_000, 701_082_553, 600_614_258),
+            ),
+            (
+                W4,
+                None,
+                Shape::Comment,
+                W4_SKIPPED_COMMENT,
+                W4_ZERO_COMMENT,
+                W4_CREATED_COMMENT,
+                (100_000_000, 701_082_553, 600_589_724),
+            ),
+            (
+                W4,
+                None,
+                Shape::Payload,
+                W4_SKIPPED_PAYLOAD,
+                W4_ZERO_PAYLOAD,
+                W4_CREATED_PAYLOAD,
+                (100_000_000, 701_082_553, 600_567_858),
