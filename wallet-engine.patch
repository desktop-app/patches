+    /// The captured mode-3 delivery boundary at `W4`'s earlier block, both
+    /// sides captured at `B = 701082553`: 700614283 is the largest value whose
+    /// message the wallet created, with the wallet ending at 0, and it is the
+    /// opt-in success whose spend `S = 468270` meets the balance exactly
+    /// (`B = V + S`). From 700614284 (`B = V + S - 1`) the wallet skipped the
+    /// message although `V + F < B`; there the opt-in preview is the funds
+    /// refusal with the composite fee and spend, no longer a fee-less
+    /// emulation refusal. The default preview, which used to succeed there
+    /// with the raw skipped fee, gives the emulation refusal without asking
+    /// for a companion.
+    #[test]
+    fn the_captured_skip_window_is_refused_by_the_spend() {
+        let fee = W4_EARLIER_SKIPPED.composite(W4_EARLIER_ZERO);
+        assert_eq!(fee, W4_EARLIER_CREATED.total_fees);
+        let created = 700_614_283;
+        // The created answer's balances: 701082553 before, 0 after.
+        let spend = debit_spend(created, 701_082_553, 0);
+        assert_eq!(spend, 468_270);
+        assert_eq!(created + spend, W4.balance);
+
+        let opted = single(created, None, Shape::Empty, true);
+        let (result, scripted) = run(W4, opted.clone(), |address| {
+            vec![answer(address, W4_EARLIER_CREATED)]
+        });
+        assert_eq!(
+            result,
+            Ok(expected_quote(&opted, W4, W4_EARLIER_CREATED, spend))
+        );
+        assert_eq!(scripted.http.calls(), UNTIL_OPERATION);
+        let default = single(created, None, Shape::Empty, false);
+        let (result, scripted) = run(W4, default.clone(), |address| {
+            vec![answer(address, W4_EARLIER_CREATED)]
+        });
+        assert_eq!(
+            result,
+            Ok(expected_preview(&default, W4, W4_EARLIER_CREATED))
+        );
+        assert_eq!(scripted.http.calls(), UNTIL_OPERATION);
+
+        // The first skipped value and the old `B - F - 1`, where even the
+        // composite fee fits, and the last value below the raw-fee refusal,
+        // all captured skipped.
+        let raw = W4_EARLIER_SKIPPED.total_fees;
+        for value in [created + 1, W4.balance - fee - 1, W4.balance - raw - 1] {
+            assert!(value + raw < W4.balance);
+            let (result, scripted) = run(W4, single(value, None, Shape::Empty, true), |address| {
+                vec![
+                    answer(address, W4_EARLIER_SKIPPED),
+                    answer(address, W4_EARLIER_ZERO),
+                ]
+            });
+            assert_eq!(
+                result,
+                Err(short_for_fees(W4, value, fee, Some(fee), Some(spend))),
+                "{value}"
+            );
+            assert_eq!(
+                scripted.http.calls(),
+                with_companion(W4_EARLIER_SKIPPED.block)
+            );
+
+            let (default, scripted) =
+                run(W4, single(value, None, Shape::Empty, false), |address| {
+                    vec![answer(address, W4_EARLIER_SKIPPED)]
+                });
+            assert_eq!(default, Err(rejected(NONE_CREATED)), "{value}");
+            assert_eq!(scripted.http.calls(), UNTIL_OPERATION);
+        }
+    }
+
+    /// On the captured skipped rows the composite spend meets the engine's
+    /// `V + S > B` check exactly: from `B = V + S - 1` down the opt-in preview
+    /// refuses with the fee and the spend. At `B = V + S` and above the spend
+    /// fits, and the skipped answer, reused there although the chain created
+    /// those values (synthetic), stays the fee-less emulation refusal: a skip
+    /// is never a success. The default preview keeps its funds refusal at its
+    /// raw skipped fee and above; below it, where it used to succeed, it is
+    /// the emulation refusal.
+    #[test]
+    fn the_engine_equality_holds_on_the_captured_composite_spend() {
+        let raw = W4_EARLIER_SKIPPED.total_fees;
+        let fee = W4_EARLIER_SKIPPED.composite(W4_EARLIER_ZERO);
+        let spend = 468_270;
+        let funds = |value| spend_refusal(W4, value, fee, spend);
+        // Value, opt-in result, default result.
+        let rows = [
+            (
+                W4.balance - spend - 1,
+                rejected(NONE_CREATED),
+                rejected(NONE_CREATED),
+            ),
+            (
+                W4.balance - spend,
+                rejected(NONE_CREATED),
+                rejected(NONE_CREATED),
+            ),
+            (
+                W4.balance - spend + 1,
+                funds(W4.balance - spend + 1),
+                rejected(NONE_CREATED),
+            ),
+            (
+                W4.balance - fee - 1,
+                funds(W4.balance - fee - 1),
+                rejected(NONE_CREATED),
+            ),
+            (
+                W4.balance - fee,
+                funds(W4.balance - fee),
+                rejected(NONE_CREATED),
+            ),
+            (
+                W4.balance - raw - 1,
+                funds(W4.balance - raw - 1),
+                rejected(NONE_CREATED),
+            ),
+            (
+                W4.balance - raw,
+                funds(W4.balance - raw),
+                short_for_fees(W4, W4.balance - raw, raw, None, None),
+            ),
+            (
+                W4.balance,
+                funds(W4.balance),
+                short_for_fees(W4, W4.balance, raw, None, None),
+            ),
+            (
+                1_000_000_000,
+                funds(1_000_000_000),
+                short(W4, 1_000_000_000, None, None),
+            ),
+        ];
+        assert_eq!(W4.balance - spend + 1, 700_614_284);
+        assert_eq!(W4.balance - fee, 700_663_173);
+        assert_eq!(W4.balance - raw - 1, 700_685_950);
+        for (value, opted, default) in rows {
+            let (result, scripted) = run(W4, single(value, None, Shape::Empty, true), |address| {
+                vec![
+                    answer(address, W4_EARLIER_SKIPPED),
+                    answer(address, W4_EARLIER_ZERO),
+                ]
+            });
+            assert_eq!(result, Err(opted), "{value}");
+            assert_eq!(
+                scripted.http.calls(),
+                with_companion(W4_EARLIER_SKIPPED.block),
+                "{value}"
+            );
+
+            let above = value > W4.balance;
+            let (result, scripted) = run(W4, single(value, None, Shape::Empty, false), |address| {
+                if above {
+                    Vec::new()
+                } else {
+                    vec![answer(address, W4_EARLIER_SKIPPED)]
+                }
+            });
+            assert_eq!(result, Err(default), "{value}");
+            let expected: &[Call] = if above {
+                &[Call::Account]
+            } else {
+                &UNTIL_OPERATION
+            };
+            assert_eq!(scripted.http.calls(), expected, "{value}");
+        }
+    }
