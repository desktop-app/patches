+    /// An operation emulation that fails, is malformed or cannot prove its
+    /// delivery never carries a fee or succeeds. Above the balance it is the
+    /// fee-less funds refusal; otherwise it is the default preview's own error
+    /// where that fails, and an emulation error where the default preview
+    /// accepts an answer whose counters do not prove delivery but whose
+    /// output list does.
+    #[test]
+    fn failed_or_malformed_operation_emulations_never_carry_a_fee() {
+        type Case = (&'static str, fn(&str) -> Reply, Option<WalletClientError>);
+        let missing = || WalletClientError::EmulationFailed {
+            diagnostic: "emulation did not report the wallet's message delivery".to_owned(),
+        };
+        let cases: [Case; 18] = [
+            ("rejected before execution", rejection, None),
+            (
+                "not accepted (synthetic diagnostic)",
+                |_| {
+                    Reply::Json(
+                        500,
+                        serde_json::json!({ "error": "external message was not accepted" }),
+                    )
+                },
+                None,
+            ),
+            (
+                "compute failure",
+                |address| {
+                    edited(address, W4_CREATED_EMPTY, |root| {
+                        root["description"]["compute_ph"]["success"] = false.into();
+                        root["description"]["compute_ph"]["exit_code"] = 33.into();
+                    })
+                },
+                None,
+            ),
+            (
+                "action failure",
+                |address| {
+                    edited(address, W4_CREATED_EMPTY, |root| {
+                        root["description"]["action"]["success"] = false.into();
+                        root["description"]["action"]["result_code"] = 37.into();
+                    })
+                },
+                None,
+            ),
+            (
+                "aborted",
+                |address| {
+                    edited(address, W4_CREATED_EMPTY, |root| {
+                        root["description"]["aborted"] = true.into();
+                    })
+                },
+                None,
+            ),
+            (
+                "wrong source",
+                |_| answer(DESTINATION_B, W4_CREATED_EMPTY),
+                None,
+            ),
+            (
+                "missing root",
+                |address| {
+                    let mut body = answer_json(address, W4_CREATED_EMPTY);
+                    body["trace"]["tx_hash"] = "other".into();
+                    Reply::Json(200, body)
+                },
+                None,
+            ),
+            ("malformed JSON", |_| Reply::Malformed, None),
+            ("offline", |_| Reply::Offline, None),
+            (
+                "missing fee",
+                |address| {
+                    edited(address, W4_CREATED_EMPTY, |root| {
+                        let _ = root.as_object_mut().expect("root").remove("total_fees");
+                    })
+                },
+                None,
+            ),
+            (
+                "missing counters",
+                |address| {
+                    edited(address, W4_CREATED_EMPTY, |root| {
+                        let action = root["description"]["action"]
+                            .as_object_mut()
+                            .expect("action");
+                        for field in ["tot_actions", "skipped_actions", "msgs_created"] {
+                            let _ = action.remove(field);
+                        }
+                    })
+                },
+                Some(missing()),
+            ),
+            (
+                "negative counter",
+                |address| {
+                    edited(address, W4_CREATED_EMPTY, |root| {
+                        root["description"]["action"]["msgs_created"] = (-1).into();
+                    })
+                },
+                Some(missing()),
+            ),
+            (
+                "non-decimal counter",
+                |address| {
+                    edited(address, W4_CREATED_EMPTY, |root| {
+                        root["description"]["action"]["tot_actions"] = "one".into();
+                    })
+                },
+                Some(missing()),
+            ),
+            (
+                "fractional counter",
+                |address| {
+                    edited(address, W4_CREATED_EMPTY, |root| {
+                        root["description"]["action"]["msgs_created"] = 1.5.into();
+                    })
+                },
+                Some(missing()),
+            ),
+            (
+                "overflowing counter",
+                |address| {
+                    edited(address, W4_CREATED_EMPTY, |root| {
+                        root["description"]["action"]["skipped_actions"] =
+                            "18446744073709551616".into();
+                    })
+                },
+                Some(missing()),
+            ),
+            (
+                "missing action phase",
+                |address| {
+                    edited(address, W4_CREATED_EMPTY, |root| {
+                        root["description"]["action"] = serde_json::Value::Null;
+                    })
+                },
+                None,
+            ),
+            (
+                "zero fee",
+                |address| {
+                    answer(
+                        address,
+                        Root {
+                            total_fees: 0,
+                            ..W4_CREATED_EMPTY
+                        },
+                    )
+                },
+                Some(WalletClientError::EmulationFailed {
+                    diagnostic: "emulated wallet fee is zero".to_owned(),
+                }),
+            ),
+            (
+                "only some messages created",
+                |address| {
+                    answer(
+                        address,
+                        Root {
+                            delivery: (1, 1, 1),
+                            ..W4_CREATED_EMPTY
+                        },
+                    )
+                },
+                // The default preview used to accept this answer; both
+                // previews now give the emulation refusal.
+                None,
+            ),
+        ];
+        for (label, reply, below) in cases {
+            let (result, scripted) = run(
+                W4,
+                single(1_000_000_000, None, Shape::Empty, true),
+                |address| vec![reply(address)],
+            );
+            assert_eq!(result, Err(short(W4, 1_000_000_000, None, None)), "{label}");
+            assert_eq!(scripted.http.calls(), UNTIL_OPERATION, "{label}");
+
+            let (opted, scripted) = run(
+                W4,
+                single(100_000_000, None, Shape::Empty, true),
+                |address| vec![reply(address)],
+            );
+            assert_eq!(scripted.http.calls(), UNTIL_OPERATION, "{label}");
+            let (default, _) = run(
+                W4,
+                single(100_000_000, None, Shape::Empty, false),
+                |address| vec![reply(address)],
+            );
+            match below {
+                None => {
+                    assert!(default.is_err(), "{label}: {default:?}");
+                    assert_eq!(opted, default, "{label}");
+                }
+                Some(error) => {
+                    assert!(default.is_ok(), "{label}: {default:?}");
+                    assert_eq!(opted, Err(error), "{label}");
+                }
+            }
+        }
+    }
