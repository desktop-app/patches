+            assert_eq!(action.body.value, cell(self.opcode, &[]), "{label}: body");
+            let Some((code, data)) = &self.init else {
+                assert!(action.init.is_none(), "{label}: no StateInit was served");
+                return;
+            };
+            let init = &action
+                .init
+                .as_ref()
+                .unwrap_or_else(|| panic!("{label}: the action carries no StateInit"))
+                .value;
+            assert_eq!(init.split_depth, None, "{label}: split depth");
+            assert_eq!(init.tick_tock, None, "{label}: tick-tock");
+            assert_eq!(init.code.as_deref(), Some(code), "{label}: code");
+            assert_eq!(init.data.as_deref(), Some(data), "{label}: data");
+            assert!(init.library.is_empty(), "{label}: library");
