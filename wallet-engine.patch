+    #[async_trait::async_trait]
+    impl WalletHttpHost for ScriptedHost {
+        async fn execute_http(&self, request: HttpRequest) -> Result<HttpResponse, HttpHostError> {
+            self.requests
+                .lock()
+                .expect("request lock")
+                .push(request.clone());
+            let reply = match self.classify(&request) {
+                Call::Account => Reply::Json(
+                    200,
+                    serde_json::json!({
+                        "ok": true,
+                        "result": {
+                            "balance": self.account.balance.to_string(),
+                            "state": state_name(self.account.status),
+                            "sync_utime": PROVIDER_TIME
+                        }
+                    }),
