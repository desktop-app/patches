+    /// Every value of the measured skip window, from the first skipped value
+    /// to the last one below the raw-fee refusal, sampled at a fixed stride
+    /// together with the captured interior values, passes the unchanged funds
+    /// check and is now the emulation refusal without a fee, after the same
+    /// three requests and identifiers. The neighbours keep their outcomes:
+    /// the largest created value previews exactly as before, and `B - raw`
+    /// keeps the raw-fee funds refusal.
+    #[test]
+    fn default_previews_refuse_the_captured_skip_window() {
+        let raw = W4_EARLIER_SKIPPED.total_fees;
+        let first = 700_614_284;
+        let last = W4.balance - raw - 1;
+        assert_eq!(last, 700_685_950);
+        let values = (first..=last)
+            .step_by(7_166)
+            .chain([700_663_172, 700_663_173, 700_663_174, last])
+            .collect::<Vec<_>>();
+        assert_eq!(values.len(), 15);
+        for value in values {
+            // The funds check that runs first lets the value pass.
+            assert_eq!(
+                funds_refusal(
+                    &decimal(W4.balance),
+                    &decimal(value),
+                    &decimal(raw),
+                    None,
+                    None
+                ),
+                None,
+                "{value}"
+            );
