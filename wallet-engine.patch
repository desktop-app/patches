+    /// The value's encoded length changes the operation's own import fee and
+    /// nothing in the companion: on both sides of a byte boundary the
+    /// companion is byte-identical and the composite follows the operation.
+    #[test]
+    fn the_encoded_value_length_changes_only_the_operations_own_fee() {
+        // (wallet, largest value of n bytes, its operation, the operation of
+        // n + 1 bytes, companion); the answers of each length were captured
+        // at another value of that length.
+        let boundaries = [
+            (
+                W4,
+                u64::from(u32::MAX),
+                W4_SKIPPED_EMPTY,
+                W4_SKIPPED_EMPTY_5B,
+                W4_ZERO_EMPTY,
+            ),
+            (
+                W5,
+                (1_u64 << 40) - 1,
+                W5_SKIPPED_EMPTY_5B,
+                W5_SKIPPED_EMPTY_6B,
+                W5_ZERO_EMPTY,
+            ),
+        ];
+        for (account, below, shorter, longer, companion) in boundaries {
+            let mut companions = Vec::new();
+            for (value, operation) in [(below, shorter), (below + 1, longer)] {
+                let request = single(value, None, Shape::Empty, true);
+                let (result, scripted) = run(account, request.clone(), |address| {
+                    vec![answer(address, operation), answer(address, companion)]
+                });
+                // Mode 3 adds the companion's forwarding remainder, which
+                // the value's length does not change.
+                let fee = operation.composite(companion);
+                let spend = fee - companion.action_fees + companion.forwarding;
+                assert_eq!(result, Err(short(account, value, Some(fee), Some(spend))));
+                let emulations = scripted.http.emulations();
+                assert_operation_and_companion(&request, account, &emulations[0], &emulations[1]);
+                companions.push(emulations[1]["boc"].clone());
+            }
+            assert_eq!(companions[0], companions[1]);
+            // One more value byte costs only its import: 8 bits at 66.67.
+            let delta = longer.composite(companion) - shorter.composite(companion);
+            assert!((533..=534).contains(&delta), "{delta}");
+        }
+        // The direct quote at 5 bytes on W5 matches its composite exactly,
+        // and so does the spend that it debited (5e9, captured balances).
+        assert_eq!(
+            W5_SKIPPED_EMPTY_5B.composite(W5_ZERO_EMPTY),
+            W5_CREATED_EMPTY_5B.total_fees
+        );
+        let request = single(500_000_000_000, None, Shape::Empty, true);
+        let (result, _) = run(W5, request, |address| {
+            vec![
+                answer(address, W5_SKIPPED_EMPTY_5B),
+                answer(address, W5_ZERO_EMPTY),
+            ]
+        });
+        let spend = debit_spend(5_000_000_000, 100_006_637_868, 95_006_169_060);
+        assert_eq!(spend, 468_808);
+        assert_eq!(
+            result,
+            Err(short(
+                W5,
+                500_000_000_000,
+                Some(W5_CREATED_EMPTY_5B.total_fees),
+                Some(spend)
+            ))
+        );
+        // A created 3-byte and 4-byte value differ only by their import fee.
+        assert_eq!(
+            W4_CREATED_EMPTY.total_fees - W4_CREATED_EMPTY_3B.total_fees,
+            533
+        );
+        assert_eq!(
+            W4_CREATED_EMPTY.action_fees,
+            W4_CREATED_EMPTY_3B.action_fees
+        );
+    }
