+            address: TonAddressString::from_address(&wallet.address, Network::Testnet),
+            public_key: wallet.key_pair.public_key.to_vec(),
+            local_secret_ref: None,
+            network: Network::Testnet,
+            send_validity_seconds: 300,
+            resolution_margin_seconds: 60,
+            providers: ProviderConfig {
+                toncenter_base_url: "https://provider.example".to_owned(),
+                dns_root_address: None,
+                request_timeout_ms: 15_000,
+            },
+        }
+    }
+
+    /// A client over a fresh [`ScriptedHost`] and the panicking [`NoSecretHost`].
+    struct Scripted {
+        client: Arc<WalletClient>,
+        http: Arc<ScriptedHost>,
+    }
+
+    impl Scripted {
+        /// `emulations` receives the test wallet's raw address for the answers.
+        fn new(account: Account, emulations: impl FnOnce(&str) -> Vec<Reply>) -> Self {
+            let config = client_config();
+            let raw = config.address.as_address().to_hex().to_uppercase();
+            let http = Arc::new(ScriptedHost {
+                address: config.address.as_str().to_owned(),
+                account,
+                emulations: Mutex::new(emulations(&raw).into()),
+                requests: Mutex::new(Vec::new()),
+                cancelled: Mutex::new(Vec::new()),
+                hold: Mutex::new(None),
+            });
+            let client = WalletClient::new(config, http.clone(), Arc::new(NoSecretHost))
+                .expect("client builds");
+            Self { client, http }
+        }
+
+        fn preview(&self, request: SendPreviewRequest) -> Result<SendPreview, WalletClientError> {
+            let result = block_on(self.client.preview_send(request));
+            assert!(
+                self.client.lock().expect("state").active_preview.is_none(),
+                "the preview slot is finished"
+            );
+            result
+        }
+
+        fn unused_answers(&self) -> usize {
+            self.http.emulations.lock().expect("emulation lock").len()
+        }
+    }
+
+    /// Runs one preview against scripted answers and returns its result and
+    /// provider calls; every scripted answer must be used.
+    fn run(
+        account: Account,
+        request: SendPreviewRequest,
+        emulations: impl FnOnce(&str) -> Vec<Reply>,
+    ) -> (Result<SendPreview, WalletClientError>, Scripted) {
+        let scripted = Scripted::new(account, emulations);
+        let result = scripted.preview(request);
+        assert_eq!(
+            scripted.unused_answers(),
+            0,
+            "every scripted answer is used"
+        );
+        assert!(
+            scripted
+                .http
+                .calls()
+                .iter()
+                .all(|call| !matches!(call, Call::Unexpected(_))),
+            "{:?}",
+            scripted.http.calls()
+        );
+        (result, scripted)
+    }
+
+    /// The message shapes of the captured answers.
+    #[derive(Clone, Copy, Debug)]
+    enum Shape {
+        Empty,
+        Comment,
+        /// A 32-bit opcode, a 64-bit query id and a referenced text cell.
+        Payload,
+        /// A destination `StateInit` with a comment.
+        StateInit,
+    }
+
+    fn payload() -> Boc {
+        let mut text = TonCell::builder();
+        text.write_bits(COMMENT.as_bytes(), COMMENT.len() * 8)
+            .expect("text");
+        let text = text.build().expect("text cell");
+        let mut body = TonCell::builder();
+        body.write_bits([0x12_u8, 0x34, 0x56, 0x78], 32)
+            .expect("opcode");
+        body.write_bits([0_u8, 0, 0, 0, 0, 0, 0, 7], 64)
+            .expect("query id");
+        body.write_ref(text).expect("text reference");
+        let body = body.build().expect("payload cell");
+        Boc::try_from(body.to_boc().expect("payload BOC")).expect("payload")
+    }
+
+    fn state_init() -> Boc {
+        let (_, state_init) =
+            derive_wallet_public_state(&[7; 32], Network::Testnet).expect("state init derives");
+        Boc::try_from(state_init.to_boc().expect("state init BOC")).expect("state init")
+    }
+
+    fn message(nanograms: u64, send_mode: Option<i32>, shape: Shape) -> SendMessage {
+        SendMessage {
+            destination: TonAddressString::try_from(DESTINATION).expect("destination"),
+            amount: SendAmount::exact(nanograms.to_string()).expect("amount"),
+            body: match shape {
+                Shape::Empty => SendMessageBody::Empty,
+                Shape::Comment | Shape::StateInit => SendMessageBody::Comment {
+                    text: COMMENT.to_owned(),
+                },
+                Shape::Payload => SendMessageBody::RawPayload { boc: payload() },
+            },
+            bounce: false,
+            state_init: matches!(shape, Shape::StateInit).then(state_init),
+            send_mode,
+        }
+    }
+
+    fn request(messages: Vec<SendMessage>, estimate_shortfall: bool) -> SendPreviewRequest {
+        SendPreviewRequest {
+            intent: SendIntent {
+                expiration: SendExpiration::EngineDefault,
+                messages,
+            },
+            estimate_shortfall,
+        }
+    }
+
+    fn single(
+        nanograms: u64,
+        send_mode: Option<i32>,
+        shape: Shape,
+        estimate_shortfall: bool,
+    ) -> SendPreviewRequest {
+        request(
+            vec![message(nanograms, send_mode, shape)],
+            estimate_shortfall,
+        )
+    }
+
+    /// The fake-signed external message that the default builder makes for
+    /// `request` from `account` at the scripted provider time.
+    fn expected_boc(request: &SendPreviewRequest, account: Account) -> Boc {
+        let config = client_config();
+        let fresh = FreshSendAccount {
+            status: account.status,
+            seqno: if matches!(account.status, AccountStatus::Active) {
+                account.seqno
+            } else {
+                0
+            },
+        };
+        let valid_until = resolve_send_expiration(
+            &request.intent.expiration,
+            PROVIDER_TIME,
+            config.send_validity_seconds,
+        )
+        .expect("expiration resolves");
+        prepare_transfer_emulation(
+            &config.address,
+            &config.public_key,
+            config.network,
+            request,
+            &fresh,
+            valid_until,
+        )
+        .expect("message builds")
+    }
+
+    /// One recorded emulation, decoded with the TON readers.
+    struct Decoded {
+        boc: Boc,
+        external: Msg<TonCell>,
+        wallet: WalletExtMsgBody,
+        messages: Vec<Msg<TonCell>>,
+    }
+
+    fn decode(body: &serde_json::Value) -> Decoded {
+        let boc = Boc::try_from(body["boc"].as_str().expect("BOC string")).expect("BOC");
+        let root = TonCell::from_boc(boc.as_bytes().to_vec()).expect("BOC parses");
+        let external = Msg::<TonCell>::from_cell(&root).expect("external message parses");
+        let (wallet, _signature) =
+            WalletExtMsgBody::read_signed(&mut external.body.value.parser()).expect("request");
+        let messages = wallet
+            .msgs
+            .iter()
+            .map(|cell| Msg::<TonCell>::from_cell(cell).expect("internal message parses"))
+            .collect();
+        Decoded {
+            boc,
+            external,
+            wallet,
+            messages,
+        }
+    }
+
+    fn coins(message: &Msg<TonCell>) -> TLBCoins {
+        let CommonMsgInfo::Int(info) = &message.info else {
+            panic!("wallet actions are internal messages");
+        };
+        info.value.coins
+    }
+
+    /// Asserts that `operation` is the default builder's message for
+    /// `request` and that `companion` is the same external message with
+    /// every value 0 and modes 2 and 18 raised to 3 and 19, and nothing else
+    /// changed.
+    fn assert_operation_and_companion(
+        request: &SendPreviewRequest,
+        account: Account,
+        operation: &serde_json::Value,
+        companion: &serde_json::Value,
+    ) {
+        let operation = decode(operation);
+        let companion = decode(companion);
+        let defaulted = SendPreviewRequest {
+            estimate_shortfall: false,
+            ..request.clone()
+        };
+        assert_eq!(operation.boc, expected_boc(&defaulted, account));
+        for (message, sent) in request.intent.messages.iter().zip(&operation.messages) {
+            let SendAmount::Exact { nanograms } = &message.amount else {
+                panic!("a shortfall operation has exact values");
+            };
+            let nanograms = nanograms.try_to::<u128>().expect("value fits");
+            assert_eq!(coins(sent), TLBCoins::new(nanograms));
+        }
+
+        assert_eq!(companion.external.info, operation.external.info);
+        assert_eq!(companion.external.init, operation.external.init);
+        assert_eq!(companion.wallet.wallet_id, operation.wallet.wallet_id);
+        assert_eq!(companion.wallet.valid_until, operation.wallet.valid_until);
+        assert_eq!(companion.wallet.msg_seqno, operation.wallet.msg_seqno);
+        let raised: Vec<u8> = operation
+            .wallet
+            .msgs_modes
+            .iter()
+            .map(|mode| match mode {
+                2 => 3,
+                18 => 19,
+                mode => *mode,
+            })
+            .collect();
+        assert_eq!(companion.wallet.msgs_modes, raised);
+        assert_eq!(companion.wallet.msgs.len(), operation.wallet.msgs.len());
+        for (sent, cell) in operation.messages.iter().zip(&companion.wallet.msgs) {
+            let mut zeroed = sent.clone();
+            let CommonMsgInfo::Int(info) = &mut zeroed.info else {
+                panic!("wallet actions are internal messages");
+            };
+            assert!(info.value.other.is_empty());
+            info.value.coins = TLBCoins::ZERO;
+            let zeroed = zeroed.to_cell().expect("message serializes");
+            assert_eq!(
+                zeroed.hash().expect("hash"),
+                cell.hash().expect("hash"),
+                "the companion message is the operation's with value 0"
+            );
+        }
+    }
+
+    fn decimal(value: u64) -> UnsignedDecimalString {
+        UnsignedDecimalString::from(value)
+    }
+
+    fn short(
+        account: Account,
+        value: u64,
+        fee: Option<u64>,
+        spend: Option<u64>,
+    ) -> WalletClientError {
+        WalletClientError::InsufficientBalance {
+            available_nanograms: decimal(account.balance),
+            requested_nanograms: decimal(value),
+            operation_fee_nanograms: fee.map(decimal),
+            operation_spend_nanograms: spend.map(decimal),
+        }
+    }
+
+    fn short_for_fees(
+        account: Account,
+        value: u64,
+        estimated: u64,
+        fee: Option<u64>,
+        spend: Option<u64>,
+    ) -> WalletClientError {
+        WalletClientError::InsufficientBalanceForFees {
+            available_nanograms: decimal(account.balance),
+            requested_nanograms: decimal(value),
+            estimated_fee_nanograms: decimal(estimated),
+            operation_fee_nanograms: fee.map(decimal),
+            operation_spend_nanograms: spend.map(decimal),
+        }
+    }
+
+    /// The refusal of a value whose spend does not fit: above the balance
+    /// the value refusal, otherwise the fee refusal, both with the
+    /// operation's fee and spend.
+    fn spend_refusal(account: Account, value: u64, fee: u64, spend: u64) -> WalletClientError {
+        if value > account.balance {
+            short(account, value, Some(fee), Some(spend))
+        } else {
+            short_for_fees(account, value, fee, Some(fee), Some(spend))
+        }
+    }
+
+    const SPEND_UNPROVED: &str = "emulation did not establish the wallet's spend beyond the values";
+
+    fn unproved_spend() -> WalletClientError {
+        WalletClientError::EmulationFailed {
+            diagnostic: SPEND_UNPROVED.to_owned(),
+        }
+    }
+
+    fn rejected(diagnostic: &str) -> WalletClientError {
+        WalletClientError::EmulationRejected {
+            diagnostic: diagnostic.to_owned(),
+            compute_exit_code: Some(0),
+            action_result_code: Some(0),
+        }
+    }
+
+    const NONE_CREATED: &str = "emulated wallet created none of the messages";
+    const ONLY_SOME: &str = "emulated wallet created only some of the messages";
+
+    fn unreported() -> WalletClientError {
+        WalletClientError::EmulationFailed {
+            diagnostic: "emulation did not report the wallet's message delivery".to_owned(),
+        }
+    }
