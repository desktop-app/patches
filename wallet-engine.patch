+    fn client_config() -> WalletClientConfig {
+        let wallet = derive_wallet(MNEMONIC, Network::Testnet).expect("wallet derives");
+        WalletClientConfig {
+            record_id: NonEmptyString::try_from("prepare-transfer-test").expect("record ID"),
+            address: TonAddressString::from_address(&wallet.address, Network::Testnet),
+            public_key: wallet.key_pair.public_key.to_vec(),
+            local_secret_ref: Some(ProtectedSecretRef {
+                value: "wallet-secret".to_owned(),
+            }),
+            network: Network::Testnet,
+            send_validity_seconds: 300,
+            resolution_margin_seconds: 60,
+            providers: ProviderConfig {
+                toncenter_base_url: "https://provider.example".to_owned(),
+                dns_root_address: None,
+                request_timeout_ms: 15_000,
+            },
+        }
+    }
+
+    /// Builds a one-message preparation request naming `send_mode`.
+    fn request(send_mode: Option<i32>) -> PrepareTransferRequest {
+        PrepareTransferRequest {
+            operation_id: NonEmptyString::try_from("prepare-transfer").expect("operation ID"),
+            intent: SendIntent {
+                expiration: SendExpiration::EngineDefault,
+                messages: vec![SendMessage {
+                    destination: TonAddressString::try_from(DESTINATION).expect("destination"),
+                    amount: SendAmount::exact("1").expect("amount"),
+                    body: SendMessageBody::Empty,
+                    bounce: false,
+                    state_init: None,
+                    send_mode,
+                }],
+            },
+        }
+    }
+
+    /// Refuses a served mode before any provider request or secret read.
+    #[test]
+    fn unsupported_send_modes_are_refused_before_provider_or_secret_access() {
+        let http = Arc::new(OfflineHost {
+            requests: Mutex::new(Vec::new()),
+        });
+        let platform = Arc::new(SecretHost {
+            reasons: Mutex::new(Vec::new()),
+        });
+        let client = WalletClient::new(client_config(), http.clone(), platform.clone())
+            .expect("client builds");
+
+        for (mode, diagnostic) in [
+            (1, "an external wallet message needs flag 2 (ignore errors)"),
+            (256, "the mode does not fit the wallet action's 8-bit field"),
+        ] {
+            let error = block_on(client.prepare_transfer(request(Some(mode))))
+                .expect_err("the mode is refused");
+
+            assert_eq!(
+                error,
+                WalletClientError::UnsupportedSendMode {
+                    mode,
+                    diagnostic: diagnostic.to_owned(),
+                }
+            );
+            assert_eq!(
+                error.to_string(),
+                format!("send mode {mode} is not supported: {diagnostic}")
+            );
+            assert_eq!(http.request_count(), 0, "mode {mode}");
+            assert_eq!(platform.read_count(), 0, "mode {mode}");
+        }
+
+        // Control: an accepted mode reaches the provider, which is offline, and
+        // the refusals above left no preparation in progress.
+        let error = block_on(client.prepare_transfer(request(Some(3))))
+            .expect_err("the offline provider fails the preparation");
+        assert!(
+            !matches!(error, WalletClientError::UnsupportedSendMode { .. }),
+            "{error:?}"
+        );
+        assert_eq!(http.request_count(), 1);
+        assert_eq!(platform.read_count(), 0);
+    }
+}
