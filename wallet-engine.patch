+    /// A root fee that is zero or below its own action fee never composes a
+    /// fee or a spend, while the valid answers of the same operation do: a
+    /// zero companion total, a companion action fee above its total, and a
+    /// zero operation total and action fee. Each refusal keeps its existing
+    /// classification, comparing the raw skipped fee like any unproved
+    /// companion. The edited rows are synthetic; the captured 1e9 answers
+    /// are reused at the other values, which have the same value length.
+    #[test]
+    fn inconsistent_root_fees_never_compose_a_fee() {
+        let fee = W4_SKIPPED_EMPTY.composite(W4_ZERO_EMPTY);
+        assert_eq!(fee, W4_CREATED_EMPTY.total_fees, "the valid control");
+        // The mode-3 spend of the same block's created 1e8 answer.
+        let spend = debit_spend(100_000_000, 701_082_553, 600_614_258);
+        let raw = W4_SKIPPED_EMPTY.total_fees;
+        let above = 1_000_000_000;
+        // Above the balance, the balance itself and the valid fee's boundary.
+        let values = [above, W4.balance, W4.balance - fee];
+        let unproved = |raw: u64| {
+            [
+                short(W4, above, None, None),
+                short_for_fees(W4, W4.balance, raw, None, None),
+                rejected(NONE_CREATED),
+            ]
+        };
+        let rows = [
+            (
+                "valid control",
+                W4_SKIPPED_EMPTY,
+                W4_ZERO_EMPTY,
+                [
+                    short(W4, above, Some(fee), Some(spend)),
+                    short_for_fees(W4, W4.balance, fee, Some(fee), Some(spend)),
+                    short_for_fees(W4, W4.balance - fee, fee, Some(fee), Some(spend)),
+                ],
+            ),
+            (
+                "zero companion total",
+                W4_SKIPPED_EMPTY,
+                Root {
+                    total_fees: 0,
+                    ..W4_ZERO_EMPTY
+                },
+                unproved(raw),
+            ),
+            (
+                "companion action fee above its total",
+                W4_SKIPPED_EMPTY,
+                Root {
+                    total_fees: 1,
+                    ..W4_ZERO_EMPTY
+                },
+                unproved(raw),
+            ),
+            (
+                "zero operation total and action fee",
+                Root {
+                    total_fees: 0,
+                    action_fees: 0,
+                    ..W4_SKIPPED_EMPTY
+                },
+                W4_ZERO_EMPTY,
+                unproved(0),
+            ),
+        ];
+        for (label, operation, companion, expected) in rows {
+            for (value, expected) in values.into_iter().zip(expected) {
+                let (result, scripted) =
+                    run(W4, single(value, None, Shape::Empty, true), |address| {
+                        vec![answer(address, operation), answer(address, companion)]
+                    });
+                assert_eq!(result, Err(expected), "{label}: {value}");
+                assert_eq!(
+                    scripted.http.calls(),
+                    with_companion(W4_SKIPPED_EMPTY.block),
+                    "{label}: {value}"
+                );
+            }
+        }
+    }
+
+    /// Synthetic two-message answers: the composite needs every message
+    /// skipped by the operation and created by the companion; a partial
+    /// delivery on either side is never priced. The two messages pay their
+    /// forwarding fees in different ways (modes 2 and 3), so the composite
+    /// fee stands without a spend.
+    #[test]
+    fn a_short_multi_message_operation_needs_full_delivery_on_both_sides() {
+        let operation = Root {
+            total_fees: 398_293,
+            delivery: (2, 2, 0),
+            action_fees: 3_332,
+            ..W4_SKIPPED_EMPTY
+        };
+        let companion = Root {
+            total_fees: 441_716,
+            delivery: (2, 0, 2),
+            action_fees: 48_888,
+            forwarding: 146_668,
+            ..W4_ZERO_EMPTY
+        };
+        let two = |values: [u64; 2]| {
+            request(
+                vec![
+                    message(values[0], Some(2), Shape::Empty),
+                    message(values[1], None, Shape::Comment),
+                ],
+                true,
+            )
+        };
+        let short_request = two([600_000_000, 600_000_000]);
+        let (result, scripted) = run(W4, short_request.clone(), |address| {
+            vec![answer(address, operation), answer(address, companion)]
+        });
+        assert_eq!(
+            result,
+            Err(short(
+                W4,
+                1_200_000_000,
+                Some(operation.composite(companion)),
+                None
+            ))
+        );
+        let emulations = scripted.http.emulations();
+        assert_operation_and_companion(&short_request, W4, &emulations[0], &emulations[1]);
+        assert_eq!(decode(&emulations[1]).wallet.msgs_modes, [3, 3]);
+
+        for partial in [(2, 1, 1), (2, 2, 1), (1, 1, 0)] {
+            let (result, scripted) = run(W4, short_request.clone(), |address| {
+                vec![answer(
+                    address,
+                    Root {
+                        delivery: partial,
+                        ..operation
+                    },
+                )]
+            });
+            assert_eq!(
+                result,
+                Err(short(W4, 1_200_000_000, None, None)),
+                "{partial:?}"
+            );
+            assert_eq!(scripted.http.calls(), UNTIL_OPERATION, "{partial:?}");
+
+            let (result, scripted) = run(W4, short_request.clone(), |address| {
+                vec![
+                    answer(address, operation),
+                    answer(
+                        address,
+                        Root {
+                            delivery: partial,
+                            ..companion
+                        },
+                    ),
+                ]
+            });
+            assert_eq!(
+                result,
+                Err(short(W4, 1_200_000_000, None, None)),
+                "{partial:?}"
+            );
+            assert_eq!(
+                scripted.http.calls(),
+                with_companion(operation.block),
+                "{partial:?}"
+            );
+        }
+
+        let (result, _) = run(W4, two([100_000_000, 100_000_000]), |address| {
+            vec![answer(
+                address,
+                Root {
+                    delivery: (2, 1, 1),
+                    ..operation
+                },
+            )]
+        });
+        assert_eq!(
+            result,
+            Err(rejected(
+                "emulated wallet created only some of the messages"
+            ))
+        );
+    }
+
+    /// A created operation whose answer does not establish its spend is no
+    /// quote: never a success, and neither zero nor the root fee stands in
+    /// for the spend. The forwarding fees are missing or malformed, below the
+    /// action fee, the action fee is missing, the root fee is below the
+    /// action fee, or the spend is zero. The created operation's root fee
+    /// still decides the fee comparison's funds refusals, above the balance
+    /// and at `V + F >= B`, reported without a spend. The default preview of
+    /// the same answer is unchanged. A usable forwarding record prices the
+    /// created operation without gas or storage fees, which only the
+    /// composite needs. The edited rows are synthetic.
+    #[test]
+    fn an_unestablished_spend_is_never_a_quote() {
+        type Edit = fn(&mut serde_json::Value);
+        let keep: Edit = |_| {};
+        let at_action_fee = Root {
+            total_fees: W4_CREATED_EMPTY.action_fees,
+            ..W4_CREATED_EMPTY
+        };
+        let below_action_fee = Root {
+            total_fees: W4_CREATED_EMPTY.action_fees - 1,
+            ..W4_CREATED_EMPTY
+        };
+        // Label, mode, answer and the edit of its root transaction.
+        let cases: [(&str, Option<i32>, Root, Edit); 12] = [
+            ("forwarding fees absent", None, W4_CREATED_EMPTY, |root| {
+                let _ = root["description"]["action"]
+                    .as_object_mut()
+                    .expect("action")
+                    .remove("total_fwd_fees");
+            }),
+            (
+                "forwarding fees null, mode 2",
+                Some(2),
+                W4_CREATED_EMPTY,
+                |root| {
+                    root["description"]["action"]["total_fwd_fees"] = serde_json::Value::Null;
+                },
+            ),
+            ("forwarding fees negative", None, W4_CREATED_EMPTY, |root| {
+                root["description"]["action"]["total_fwd_fees"] = "-73334".into();
+            }),
+            (
+                "forwarding fees fractional",
+                None,
+                W4_CREATED_EMPTY,
+                |root| {
+                    root["description"]["action"]["total_fwd_fees"] = 73_334.5.into();
+                },
+            ),
+            (
+                "forwarding fees not decimal",
+                None,
+                W4_CREATED_EMPTY,
+                |root| {
+                    root["description"]["action"]["total_fwd_fees"] = "0x11e76".into();
+                },
+            ),
+            ("forwarding fees a list", None, W4_CREATED_EMPTY, |root| {
+                root["description"]["action"]["total_fwd_fees"] = serde_json::json!([73_334]);
+            }),
+            (
+                "forwarding fees below the action fee",
+                None,
+                W4_CREATED_EMPTY,
+                |root| {
+                    root["description"]["action"]["total_fwd_fees"] = "24443".into();
+                },
+            ),
+            ("action fee absent", None, W4_CREATED_EMPTY, |root| {
+                let _ = root["description"]["action"]
+                    .as_object_mut()
+                    .expect("action")
+                    .remove("total_action_fees");
+            }),
+            ("action fee malformed", Some(18), W4_CREATED_EMPTY, |root| {
+                root["description"]["action"]["total_action_fees"] = "x".into();
+            }),
+            (
+                "action phase without fees",
+                Some(19),
+                W4_CREATED_EMPTY,
+                |root| {
+                    root["description"]["action"] = serde_json::json!({
+                        "success": true,
+                        "result_code": 0,
+                        "tot_actions": 1,
+                        "skipped_actions": 0,
+                        "msgs_created": 1,
+                    });
+                },
+            ),
+            (
+                "root fee below the action fee",
+                None,
+                below_action_fee,
+                keep,
+            ),
+            ("zero spend", Some(2), at_action_fee, keep),
+        ];
+        let value = 100_000_000;
+        for (label, mode, root, edit) in cases {
+            let fee = root.total_fees;
+            let (opted, scripted) = run(W4, single(value, mode, Shape::Empty, true), |address| {
+                vec![edited(address, root, edit)]
+            });
+            assert_eq!(opted, Err(unproved_spend()), "{label}");
+            assert_eq!(scripted.http.calls(), UNTIL_OPERATION, "{label}");
+            let default = single(value, mode, Shape::Empty, false);
+            let (result, _) = run(W4, default.clone(), |address| {
+                vec![edited(address, root, edit)]
+            });
+            assert_eq!(result, Ok(expected_preview(&default, W4, root)), "{label}");
+
+            // The fee comparison with the created root fee, no spend.
+            let above = 1_000_000_000;
+            let (result, _) = run(W4, single(above, mode, Shape::Empty, true), |address| {
+                vec![edited(address, root, edit)]
+            });
+            assert_eq!(result, Err(short(W4, above, Some(fee), None)), "{label}");
+            let at_fee = W4.balance - fee;
+            let (result, _) = run(W4, single(at_fee, mode, Shape::Empty, true), |address| {
+                vec![edited(address, root, edit)]
+            });
+            assert_eq!(
+                result,
+                Err(short_for_fees(W4, at_fee, fee, Some(fee), None)),
+                "{label}"
+            );
+        }
+
+        // Usable forwarding fees without gas or storage fees still price
+        // the created operation.
+        let spend = debit_spend(value, 701_082_553, 600_614_258);
+        let edits: [Edit; 3] = [
+            |root| {
+                let _ = root["description"]["compute_ph"]
+                    .as_object_mut()
+                    .expect("compute phase")
+                    .remove("gas_used");
+            },
+            |root| {
+                let _ = root["description"]
+                    .as_object_mut()
+                    .expect("description")
+                    .remove("storage_ph");
+            },
+            |root| root["description"]["storage_ph"] = "26".into(),
+        ];
+        for (index, edit) in edits.into_iter().enumerate() {
+            let request = single(value, None, Shape::Empty, true);
+            let (result, _) = run(W4, request.clone(), |address| {
+                vec![edited(address, W4_CREATED_EMPTY, edit)]
+            });
+            assert_eq!(
+                result,
+                Ok(expected_quote(&request, W4, W4_CREATED_EMPTY, spend)),
+                "edit {index}"
+            );
+        }
+
+        // A proved composite fee whose companion does not establish the
+        // spend keeps the fee comparison with that fee, without a spend.
+        let fee = W4_SKIPPED_EMPTY.composite(W4_ZERO_EMPTY);
+        let companions: [Edit; 3] = [
+            |root| {
+                let _ = root["description"]["action"]
+                    .as_object_mut()
+                    .expect("action")
+                    .remove("total_fwd_fees");
+            },
+            |root| root["description"]["action"]["total_fwd_fees"] = "x".into(),
+            |root| root["description"]["action"]["total_fwd_fees"] = "24443".into(),
+        ];
+        for (index, edit) in companions.into_iter().enumerate() {
+            let rows = [
+                (1_000_000_000, short(W4, 1_000_000_000, Some(fee), None)),
+                (
+                    W4.balance - fee,
+                    short_for_fees(W4, W4.balance - fee, fee, Some(fee), None),
+                ),
+                (W4.balance - fee - 1, rejected(NONE_CREATED)),
+            ];
+            for (value, expected) in rows {
+                let (result, scripted) =
+                    run(W4, single(value, None, Shape::Empty, true), |address| {
+                        vec![
+                            answer(address, W4_SKIPPED_EMPTY),
+                            edited(address, W4_ZERO_EMPTY, edit),
+                        ]
+                    });
+                assert_eq!(result, Err(expected), "companion {index}: {value}");
+                assert_eq!(
+                    scripted.http.calls(),
+                    with_companion(W4_SKIPPED_EMPTY.block)
+                );
+            }
+        }
+    }
+
+    /// Synthetic two-message answers: messages that share one fee kind are
+    /// priced together from the aggregate action and forwarding fees, both
+    /// when the batch was created and when its composite prices a skipped
+    /// one. Messages whose fee kinds differ get no spend, so their opt-in
+    /// preview is no quote, while their default preview succeeds as before.
+    #[test]
+    fn a_uniform_batch_spends_its_aggregate_forwarding_fees() {
+        let two = |modes: [Option<i32>; 2], value: u64, estimate_shortfall: bool| {
+            request(
+                vec![
+                    message(value, modes[0], Shape::Empty),
+                    message(value, modes[1], Shape::Empty),
+                ],
+                estimate_shortfall,
+            )
+        };
+        // `W4_CREATED_TWO`: F 443849, A 48888, T 146668, so F - A + T with
+        // +1 and F - A without it.
+        let rows = [
+            ([None, Some(3)], Some(541_629)),
+            ([Some(3), Some(19)], Some(541_629)),
+            ([Some(2), Some(18)], Some(394_961)),
+            ([Some(2), None], None),
+            ([Some(18), Some(19)], None),
+        ];
+        for (modes, spend) in rows {
+            let opted = two(modes, 100_000_000, true);
+            let (result, _) = run(W4, opted.clone(), |address| {
+                vec![answer(address, W4_CREATED_TWO)]
+            });
+            let expected = spend.map_or_else(
+                || Err(unproved_spend()),
+                |spend| Ok(expected_quote(&opted, W4, W4_CREATED_TWO, spend)),
+            );
+            assert_eq!(result, expected, "{modes:?}");
+            let default = two(modes, 100_000_000, false);
+            let (result, _) = run(W4, default.clone(), |address| {
+                vec![answer(address, W4_CREATED_TWO)]
+            });
+            assert_eq!(
+                result,
+                Ok(expected_preview(&default, W4, W4_CREATED_TWO)),
+                "{modes:?}"
+            );
+        }
+
+        // Skipped batch, its companion created with the fees above.
+        let operation = Root {
+            total_fees: 398_293,
+            delivery: (2, 2, 0),
+            action_fees: 3_332,
+            ..W4_SKIPPED_EMPTY
+        };
+        let companion = Root {
+            delivery: (2, 0, 2),
+            ..W4_CREATED_TWO
+        };
+        let fee = operation.composite(companion);
+        assert_eq!(fee, W4_CREATED_TWO.total_fees);
+        for (modes, spend) in rows {
+            let opted = two(modes, 600_000_000, true);
+            let (result, scripted) = run(W4, opted.clone(), |address| {
+                vec![answer(address, operation), answer(address, companion)]
+            });
+            assert_eq!(
+                result,
+                Err(short(W4, 1_200_000_000, Some(fee), spend)),
+                "{modes:?}"
+            );
+            let emulations = scripted.http.emulations();
+            assert_operation_and_companion(&opted, W4, &emulations[0], &emulations[1]);
+        }
+    }
+
+    /// Modes 2 and 18 take the forwarding fee from the message value, so the
+    /// wallet skips a value below that fee whatever its balance: with the
+    /// captured zero-value answers at `W4`'s block, the companion prices the
+    /// operation's spend, yet the preview stays the fee-less emulation refusal
+    /// where that spend fits, never a success or a funds refusal. Only a
+    /// (synthetic) balance below the spend makes it the funds refusal. The
+    /// one-nanogram value reuses the zero-value answers (synthetic).
+    #[test]
+    fn a_value_below_its_forwarding_fee_is_never_a_quote() {
+        let fee = W4_ZERO_EMPTY_KEPT_MODE.composite(W4_ZERO_EMPTY);
+        assert_eq!(fee, W4_ZERO_EMPTY.total_fees);
+        // F - A for a message without +1.
+        let spend = 392_828;
+        for mode in [Some(2), Some(18)] {
+            for value in [0, 1] {
+                let label = format!("{mode:?} {value}");
+                let rows = [
+                    (W4, rejected(NONE_CREATED)),
+                    (
+                        Account {
+                            balance: value + spend,
+                            ..W4
+                        },
+                        rejected(NONE_CREATED),
+                    ),
+                    (
+                        Account {
+                            balance: value + spend - 1,
+                            ..W4
+                        },
+                        spend_refusal(
+                            Account {
+                                balance: value + spend - 1,
+                                ..W4
+                            },
+                            value,
+                            fee,
+                            spend,
+                        ),
+                    ),
+                ];
+                for (account, expected) in rows {
+                    let request = single(value, mode, Shape::Empty, true);
+                    let (result, scripted) = run(account, request.clone(), |address| {
+                        vec![
+                            answer(address, W4_ZERO_EMPTY_KEPT_MODE),
+                            answer(address, W4_ZERO_EMPTY),
+                        ]
+                    });
+                    assert_eq!(result, Err(expected), "{label} {}", account.balance);
+                    let emulations = scripted.http.emulations();
+                    assert_operation_and_companion(
+                        &request,
+                        account,
+                        &emulations[0],
+                        &emulations[1],
+                    );
+                }
+                let (result, scripted) =
+                    run(W4, single(value, mode, Shape::Empty, false), |address| {
+                        vec![answer(address, W4_ZERO_EMPTY_KEPT_MODE)]
+                    });
+                assert_eq!(result, Err(rejected(NONE_CREATED)), "{label}");
+                assert_eq!(scripted.http.calls(), UNTIL_OPERATION);
+            }
+        }
+    }
+
+    /// The new fields are read leniently: without them, or with unusable
+    /// values, a default preview gives exactly the preview it gave before.
+    #[test]
+    fn default_previews_keep_their_parse_outcome_without_the_new_fields() {
+        let request = || single(100_000_000, None, Shape::Empty, false);
+        let (base, _) = run(W4, request(), |address| {
+            vec![answer(address, W4_CREATED_EMPTY)]
+        });
+        let base = base.expect("the default preview succeeds");
+        let edits: [fn(&mut serde_json::Value); 8] = [
+            |root| {
+                let action = root["description"]["action"]
+                    .as_object_mut()
+                    .expect("action");
+                for field in [
+                    "tot_actions",
+                    "skipped_actions",
+                    "msgs_created",
+                    "total_action_fees",
+                    "total_fwd_fees",
+                ] {
+                    let _ = action.remove(field);
+                }
+            },
+            |root| {
+                for field in ["tot_actions", "skipped_actions", "msgs_created"] {
+                    root["description"]["action"][field] = (-1).into();
+                }
+            },
+            |root| root["description"]["action"]["total_action_fees"] = 1.5.into(),
+            |root| root["description"]["action"]["total_fwd_fees"] = "-73334".into(),
+            |root| root["description"]["action"]["total_fwd_fees"] = serde_json::json!([]),
+            |root| root["description"]["compute_ph"]["gas_used"] = serde_json::json!([3560]),
+            |root| {
+                let _ = root["description"]
+                    .as_object_mut()
+                    .expect("description")
+                    .remove("storage_ph");
+            },
+            |root| root["description"]["storage_ph"] = "26".into(),
+        ];
+        for (index, edit) in edits.into_iter().enumerate() {
+            let (result, scripted) = run(W4, request(), |address| {
+                vec![edited(address, W4_CREATED_EMPTY, edit)]
+            });
+            assert_eq!(result.as_ref(), Ok(&base), "edit {index}");
+            assert_eq!(scripted.http.calls(), UNTIL_OPERATION);
+        }
+    }
+
+    /// Cancelling the preview while its companion is in flight cancels that
+    /// request, ends the preview with today's cancellation error, and the
+    /// same client previews again afterwards.
+    #[test]
+    fn cancelling_a_held_companion_cancels_it_and_the_next_preview_runs() {
+        let scripted = Scripted::new(W4, |address| {
+            vec![
+                answer(address, W4_SKIPPED_EMPTY),
+                Reply::Held(Box::new(answer(address, W4_ZERO_EMPTY))),
+                answer(address, W4_CREATED_EMPTY),
+            ]
+        });
+        let (held_sender, held) = mpsc::channel();
+        let (release, release_receiver) = mpsc::channel();
+        *scripted.http.hold.lock().expect("hold lock") = Some((held_sender, release_receiver));
+
+        let client = Arc::clone(&scripted.client);
+        let preview = std::thread::spawn(move || {
+            block_on(client.preview_send(single(1_000_000_000, Some(2), Shape::Empty, true)))
+        });
+        let companion = held
+            .recv_timeout(Duration::from_secs(60))
+            .expect("the companion request is held");
+        assert_eq!(
+            scripted.http.calls(),
+            with_companion(W4_SKIPPED_EMPTY.block)
+        );
+        assert_eq!(
+            scripted.http.requests().last().map(|request| request.id),
+            Some(companion)
+        );
+
+        block_on(scripted.client.cancel_send_preview()).expect("cancel succeeds");
+        assert_eq!(scripted.http.cancelled(), [companion]);
+        release.send(()).expect("the held request waits");
+        assert_eq!(
+            preview.join().expect("preview thread"),
+            Err(WalletClientError::StateUnavailable)
+        );
+        assert!(
+            scripted
+                .client
+                .lock()
+                .expect("state")
+                .active_preview
+                .is_none()
+        );
+
+        let next = scripted
+            .preview(single(100_000_000, None, Shape::Empty, true))
+            .expect("the next preview succeeds");
+        assert_eq!(
+            next.emulation.wallet_fees_nanograms,
+            decimal(W4_CREATED_EMPTY.total_fees)
+        );
+        assert_eq!(scripted.http.calls()[4..], UNTIL_OPERATION);
+        assert_eq!(scripted.http.cancelled(), [companion]);
+        assert_eq!(scripted.unused_answers(), 0);
+    }
+
+    /// A frozen or unknown account above the balance keeps the funds refusal
+    /// without a fee after the account read; below it, the default error.
+    #[test]
+    fn frozen_or_unknown_accounts_above_the_balance_are_refused_without_a_fee() {
+        for status in [AccountStatus::Frozen, AccountStatus::Unknown] {
+            let account = Account { status, ..W4 };
+            let (result, scripted) = run(
+                account,
+                single(1_000_000_000, None, Shape::Empty, true),
+                |_| Vec::new(),
+            );
+            assert_eq!(
+                result,
+                Err(short(account, 1_000_000_000, None, None)),
+                "{status:?}"
+            );
+            assert_eq!(scripted.http.calls(), [Call::Account]);
+
+            let (opted, _) = run(account, single(1, None, Shape::Empty, true), |_| Vec::new());
+            let (default, _) = run(account, single(1, None, Shape::Empty, false), |_| {
+                Vec::new()
+            });
+            assert_eq!(
+                opted,
+                Err(WalletClientError::SendAccountUnavailable { status })
+            );
+            assert_eq!(opted, default);
+        }
+    }
+}
