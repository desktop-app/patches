+    }
+
+    /// Delivery form of a signed wallet request.
+    #[derive(Debug, Clone, Copy)]
+    enum Delivery {
+        External,
+        Internal,
+    }
+
+    /// The wallet request decoded from one returned signed BOC.
+    struct SignedRequest {
+        seqno: u32,
+        valid_until: u32,
+        actions: Vec<(u8, Msg<TonCell>)>,
+    }
+
+    /// Decodes a returned BOC with the vendored readers alone.
+    ///
+    /// The envelope must be `delivery`'s kind, address the configured wallet
+    /// and deploy nothing; the configured key must verify the request; each
+    /// action message must be consumed completely.
+    fn decode_signed_request(
+        boc: &Boc,
+        config: &WalletClientConfig,
+        delivery: Delivery,
+    ) -> SignedRequest {
+        let root = TonCell::from_boc(boc.as_bytes().to_vec()).expect("signed BOC parses");
+        let envelope = read_whole_message(&root);
+        assert!(envelope.init.is_none(), "an active wallet is not deployed");
+        let source = config.address.as_address();
+        let mut parser = envelope.body.value.parser();
+        let (body, signature, seqno, valid_until, modes, messages) = match delivery {
+            Delivery::External => {
+                let CommonMsgInfo::ExtIn(info) = &envelope.info else {
+                    panic!("an external request must use an external envelope");
+                };
+                assert_eq!(info.dst, source.to_msg_address_int());
+                let (request, signature) =
+                    WalletExtMsgBody::read_signed(&mut parser).expect("external request decodes");
+                let body = request.to_cell().expect("external request serializes");
+                let WalletExtMsgBody {
+                    valid_until,
+                    msg_seqno,
+                    msgs_modes,
+                    msgs,
+                    ..
+                } = request;
+                (body, signature, msg_seqno, valid_until, msgs_modes, msgs)
+            }
+            Delivery::Internal => {
+                let CommonMsgInfo::Int(info) = &envelope.info else {
+                    panic!("an internal request must use an internal envelope");
+                };
+                assert_eq!(info.dst, source.to_msg_address());
+                let (request, signature) = WalletInternalSignedBody::read_signed(&mut parser)
+                    .expect("internal request decodes");
+                let body = request.to_cell().expect("internal request serializes");
+                let WalletInternalSignedBody {
+                    valid_until,
+                    msg_seqno,
+                    msgs_modes,
+                    msgs,
+                    ..
+                } = request;
+                (body, signature, msg_seqno, valid_until, msgs_modes, msgs)
+            }
+        };
+        let public_key =
+            <[u8; 32]>::try_from(config.public_key.as_slice()).expect("32-byte public key");
+        VerifyingKey::from_bytes(&public_key)
+            .expect("public key is valid")
+            .verify_strict(
+                body.cell_hash().expect("request hashes").as_slice(),
+                &Signature::from_slice(&signature).expect("64-byte signature"),
+            )
+            .expect("the configured wallet key signs the request");
+        assert_eq!(modes.len(), messages.len());
+        SignedRequest {
+            seqno,
+            valid_until,
+            actions: modes
+                .into_iter()
+                .zip(messages.iter().map(read_whole_message))
+                .collect(),
+        }
+    }
+
+    /// Reads one message cell and requires that nothing follows the message.
+    fn read_whole_message(cell: &TonCell) -> Msg<TonCell> {
+        let mut parser = cell.parser();
+        let message = Msg::<TonCell>::read(&mut parser).expect("message decodes");
+        parser
+            .ensure_empty()
+            .expect("message has no trailing bits or references");
+        message
+    }
+
+    /// Asserts that a decoded request carries exactly `expected`, in order.
+    fn assert_carries(request: &SignedRequest, expected: &[Literal], label: &str) {
+        assert_eq!(
+            request.actions.len(),
+            expected.len(),
+            "{label}: action count"
+        );
+        for (index, ((mode, action), literal)) in request.actions.iter().zip(expected).enumerate() {
+            literal.assert_carried_by(*mode, action, &format!("{label}, action {index}"));
+        }
+    }
+
+    /// Signs a gasless list that differs from the intent in every field.
+    ///
+    /// Each internal-only gasless mode is signed exactly beside a normal mode
+    /// 2 or 3. The external form carries only the intent, the internal form
+    /// only the list, and both come from one account and `seqno` resolution,
+    /// one expiry and one secret read, without a journal call or submission.
+    #[test]
+    fn distinct_gasless_messages_are_signed_under_one_resolution_and_one_secret_read() {
+        let config = client_config();
+        let code = cell(0xc0de_c0de, &[cell(0x0000_0001, &[])]);
+        let data = cell(0xda7a_da7a, &[cell(0x0000_0002, &[])]);
+        let runs = [(0, 2), (1, 3), (16, 2), (17, 3)].map(|(gasless_mode, normal_mode)| {
+            let normal = vec![Literal {
+                destination: DESTINATION,
+                nanograms: 1_000,
+                bounce: false,
+                opcode: 0x0a0a_0a0a,
+                init: None,
+                mode: normal_mode,
+            }];
+            let gasless = vec![
+                Literal {
+                    destination: DESTINATION_B,
+                    nanograms: 700,
+                    bounce: true,
+                    opcode: 0x0b0b_0b0b,
+                    init: Some((code.clone(), data.clone())),
+                    mode: gasless_mode,
+                },
+                Literal {
+                    destination: DESTINATION_C,
+                    nanograms: 300,
+                    bounce: false,
+                    opcode: 0x0c0c_0c0c,
+                    init: None,
+                    mode: 18,
+                },
+            ];
+            let scripted = ScriptedClient::new(1_000_000);
+            let result = scripted.prepare(prepare_request(
+                SendExpiration::Exact {
+                    unix_timestamp: VALID_UNTIL,
+                },
+                normal.iter().map(Literal::message).collect(),
+                Some(gasless.iter().map(Literal::message).collect()),
+            ));
+            let label = format!("gasless mode {gasless_mode} beside normal mode {normal_mode}");
+            (label, normal, gasless, scripted, result)
+        });
+        let refused = runs
+            .iter()
+            .filter_map(|(label, _, _, _, result)| {
+                result
+                    .as_ref()
+                    .err()
+                    .map(|error| format!("{label}: {error}"))
+            })
+            .collect::<Vec<_>>();
+        assert!(
+            refused.is_empty(),
+            "accepted modes were refused: {refused:#?}"
+        );
+
+        for (label, normal, gasless, scripted, result) in runs {
+            let prepared = result.expect("both forms are signed");
+            assert_eq!(prepared.operation_id.as_str(), OPERATION, "{label}");
+            assert_eq!(prepared.seqno, 42, "{label}");
+            assert_eq!(prepared.valid_until, 1_900_000_000, "{label}");
+            for (boc, delivery, expected) in [
+                (&prepared.external_boc, Delivery::External, &normal),
+                (&prepared.internal_boc, Delivery::Internal, &gasless),
+            ] {
+                let label = format!("{label}, {delivery:?} form");
+                let request = decode_signed_request(boc, &config, delivery);
+                assert_eq!(request.seqno, 42, "{label}: seqno");
+                assert_eq!(request.valid_until, 1_900_000_000, "{label}: expiry");
+                assert_carries(&request, expected, &label);
+            }
+            assert_eq!(
+                scripted.http.calls(),
+                [Some(ProviderCall::Account), Some(ProviderCall::Seqno)],
+                "{label}"
+            );
+            assert_eq!(
+                scripted.platform.reasons(),
+                [SecretAccessReason::SignTransfer],
+                "{label}"
+            );
+        }
+    }
+
+    /// Without a list, and with a list equal to the intent, the public engine
+    /// returns exactly the standalone external and internal signers' BOCs.
+    #[test]
+    fn omitted_and_equal_gasless_lists_keep_the_existing_pair() {
+        let config = client_config();
+        let account = FreshSendAccount {
+            status: AccountStatus::Active,
+            seqno: 42,
+        };
+        let exact = SendExpiration::Exact {
+            unix_timestamp: VALID_UNTIL,
+        };
+        let cases = [
+            (
+                "mode-less exact values, engine expiry",
+                SendExpiration::EngineDefault,
+                301,
+                messages(&[Some(1_000), Some(2_000)]),
+            ),
+            (
+                "an exact value with mode 3",
+                exact.clone(),
+                1_900_000_000,
+                vec![message(Some(1_000), Some(3))],
+            ),
+            (
+                "a mode-less whole balance",
+                exact,
+                1_900_000_000,
+                messages(&[None]),
+            ),
+        ];
+
+        for (name, expiration, valid_until, messages) in cases {
+            let request = SendRequest {
+                operation_id: NonEmptyString::try_from(OPERATION).expect("operation ID"),
+                force: false,
+                intent: SendIntent {
+                    expiration,
+                    messages,
+                },
+            };
+            let sign = |internal: bool| {
+                let signer = if internal {
+                    crate::wallet::transfer::prepare_internal_signed_transfer
+                } else {
+                    crate::wallet::transfer::prepare_transfer
+                };
+                signer(
+                    MNEMONIC.as_bytes(),
+                    &config.record_id,
+                    &config.address,
+                    config.network,
+                    &request,
+                    &account,
+                    valid_until,
+                )
+                .expect("the standalone signer builds")
+                .signed_boc
+            };
+            let (external, internal) = (sign(false), sign(true));
+
+            for (list, gasless_messages) in [
+                ("without a list", None),
+                ("with an equal list", Some(request.intent.messages.clone())),
+            ] {
+                let label = format!("{name}, {list}");
+                let scripted = ScriptedClient::new(1_000_000);
+                let prepared = scripted
+                    .prepare(PrepareTransferRequest {
+                        operation_id: request.operation_id.clone(),
+                        intent: request.intent.clone(),
+                        gasless_messages,
+                    })
+                    .expect("both forms are signed");
+                assert_eq!(prepared.external_boc, external, "{label}: external form");
+                assert_eq!(prepared.internal_boc, internal, "{label}: internal form");
+                assert_eq!(prepared.seqno, 42, "{label}");
+                assert_eq!(prepared.valid_until, valid_until, "{label}");
+                for (boc, delivery) in [
+                    (&prepared.external_boc, Delivery::External),
+                    (&prepared.internal_boc, Delivery::Internal),
+                ] {
+                    let signed = decode_signed_request(boc, &config, delivery);
+                    assert_eq!(signed.seqno, 42, "{label}, {delivery:?}");
+                    assert_eq!(
+                        u64::from(signed.valid_until),
+                        valid_until,
+                        "{label}, {delivery:?}"
+                    );
+                }
+                assert_eq!(
+                    scripted.http.calls(),
+                    [Some(ProviderCall::Account), Some(ProviderCall::Seqno)],
+                    "{label}"
+                );
+                assert_eq!(
+                    scripted.platform.reasons(),
+                    [SecretAccessReason::SignTransfer],
+                    "{label}"
+                );
+            }
+        }
+    }
+
+    /// Refuses an invalid gasless list, or an invalid intent beside any list,
+    /// by name before any provider request or secret read.
+    #[test]
+    fn gasless_lists_are_refused_before_provider_or_secret_access() {
+        let http = Arc::new(OfflineHost {
+            requests: Mutex::new(Vec::new()),
+        });
+        let platform = Arc::new(SecretHost {
+            reasons: Mutex::new(Vec::new()),
+        });
+        let client = WalletClient::new(client_config(), http.clone(), platform.clone())
+            .expect("client builds");
+        let exact = |mode| message(Some(1), mode);
+        let refused_mode = |mode, diagnostic: &str| WalletClientError::UnsupportedSendMode {
+            mode,
+            diagnostic: diagnostic.to_owned(),
+        };
+        let cases = [
+            (
+                "normal mode 1 beside a valid list",
+                exact(Some(1)),
+                vec![exact(Some(1))],
+                refused_mode(1, MISSING_IGNORE_ERRORS),
+            ),
+            (
+                "gasless mode 128",
+                exact(Some(3)),
+                vec![exact(Some(128))],
+                refused_mode(
+                    128,
+                    "flag 128 would send the whole balance instead of the message value",
+                ),
+            ),
+            (
+                "gasless mode 256",
+                exact(Some(3)),
+                vec![exact(Some(256))],
+                refused_mode(256, "the mode does not fit the wallet action's 8-bit field"),
+            ),
+            (
+                "an empty gasless list",
+                exact(None),
+                Vec::new(),
+                WalletClientError::InvalidSendRequest,
+            ),
+            (
+                "256 gasless messages",
+                exact(None),
+                vec![exact(None); 256],
+                WalletClientError::InvalidSendRequest,
+            ),
+            (
+                "a whole-balance gasless message beside an exact one",
+                exact(None),
+                vec![message(None, None), exact(None)],
+                WalletClientError::InvalidSendRequest,
+            ),
+            (
+                "a whole-balance gasless message with mode 2",
+                exact(None),
+                vec![message(None, Some(2))],
+                refused_mode(2, "a whole-balance transfer keeps its own send mode"),
+            ),
+            (
+                "a refused third gasless message",
+                exact(None),
+                vec![exact(Some(0)), exact(Some(17)), exact(Some(64))],
+                refused_mode(
+                    64,
+                    "flag 64 would add the remaining inbound value to the message value",
+                ),
+            ),
+            (
+                "both lists refused",
+                exact(Some(17)),
+                vec![exact(Some(128))],
+                refused_mode(17, MISSING_IGNORE_ERRORS),
+            ),
+        ];
+
+        for (name, normal, gasless, expected) in cases {
+            let request =
+                prepare_request(SendExpiration::EngineDefault, vec![normal], Some(gasless));
+            let error = block_on(client.prepare_transfer(request)).expect_err(name);
+            assert_eq!(error, expected, "{name}");
+            assert_eq!(http.request_count(), 0, "{name}");
+            assert_eq!(platform.read_count(), 0, "{name}");
+        }
+
+        // Control: valid lists with internal-only gasless modes reach the
+        // offline provider once, and no refusal left a preparation in progress.
+        let request = prepare_request(
+            SendExpiration::EngineDefault,
+            vec![exact(Some(3))],
+            Some(vec![exact(Some(0)), exact(Some(17))]),
+        );
+        let error = block_on(client.prepare_transfer(request))
+            .expect_err("the offline provider fails the preparation");
+        assert!(
+            !matches!(
+                error,
+                WalletClientError::UnsupportedSendMode { .. }
+                    | WalletClientError::InvalidSendRequest
+            ),
+            "{error:?}"
+        );
+        assert_eq!(http.request_count(), 1);
+        assert_eq!(platform.read_count(), 0);
+    }
+
+    /// One balance-table preparation; `None` values are whole-balance messages.
+    struct BalanceRow {
+        name: &'static str,
+        normal: &'static [Option<u64>],
+        gasless: &'static [Option<u64>],
+        balance: u64,
+        /// The total the refusal names, or `None` when both forms are signed.
+        refused: Option<u64>,
+    }
+
+    const fn row(
+        name: &'static str,
+        normal: &'static [Option<u64>],
+        gasless: &'static [Option<u64>],
+        balance: u64,
+        refused: Option<u64>,
+    ) -> BalanceRow {
+        BalanceRow {
+            name,
+            normal,
+            gasless,
+            balance,
+            refused,
+        }
+    }
+
+    /// What a preparation returned, the provider calls and the secret reads.
+    type Observed = (
+        Result<(), WalletClientError>,
+        Vec<Option<ProviderCall>>,
+        Vec<SecretAccessReason>,
+    );
+
+    /// Every exact alternative must fit the fresh balance on its own; the
+    /// alternatives are never added, and a whole-balance form has no total.
+    #[test]
+    fn the_balance_rule_checks_every_exact_alternative() {
+        let rows = [
+            row(
+                "gasless larger, at its total",
+                &[Some(1_000)],
+                &[Some(1_200), Some(800)],
+                2_000,
+                None,
+            ),
+            row(
+                "gasless larger, one below",
+                &[Some(1_000)],
+                &[Some(1_200), Some(800)],
+                1_999,
+                Some(2_000),
+            ),
+            row(
+                "normal larger, at its total",
+                &[Some(1_500), Some(500)],
+                &[Some(1_000)],
+                2_000,
+                None,
+            ),
+            row(
+                "normal larger, one below",
+                &[Some(1_500), Some(500)],
+                &[Some(1_000)],
+                1_999,
+                Some(2_000),
+            ),
+            row(
+                "exact normal, whole-balance gasless, at the total",
+                &[Some(1_000)],
+                &[None],
+                1_000,
+                None,
+            ),
+            row(
+                "exact normal, whole-balance gasless, one below",
+                &[Some(1_000)],
+                &[None],
+                999,
+                Some(1_000),
+            ),
+            row(
+                "whole-balance normal, exact gasless, at the total",
+                &[None],
+                &[Some(1_000)],
+                1_000,
+                None,
+            ),
+            row(
+                "whole-balance normal, exact gasless, one below",
+                &[None],
+                &[Some(1_000)],
+                999,
+                Some(1_000),
+            ),
+            row(
+                "whole balance in both forms at zero",
+                &[None],
+                &[None],
+                0,
+                None,
+            ),
+        ];
+        let account = Some(ProviderCall::Account);
+        let seqno = Some(ProviderCall::Seqno);
+        let observe = |scripted: &ScriptedClient, result: Result<PreparedTransfer, _>| {
+            (
+                result.map(drop),
+                scripted.http.calls(),
+                scripted.platform.reasons(),
+            )
+        };
+        let mut failures = Vec::new();
+
+        for row in rows {
+            let scripted = ScriptedClient::new(row.balance);
+            let result = scripted.prepare(prepare_request(
+                SendExpiration::EngineDefault,
+                messages(row.normal),
+                Some(messages(row.gasless)),
+            ));
+            let observed: Observed = observe(&scripted, result);
+            let expected: Observed = row.refused.map_or_else(
+                || {
+                    (
+                        Ok(()),
+                        vec![account, seqno],
+                        vec![SecretAccessReason::SignTransfer],
+                    )
+                },
+                |requested| {
+                    let error = WalletClientError::InsufficientBalance {
+                        available_nanograms: UnsignedDecimalString::from(row.balance),
+                        requested_nanograms: UnsignedDecimalString::from(requested),
+                        operation_fee_nanograms: None,
+                        operation_spend_nanograms: None,
+                    };
+                    (Err(error), vec![account], Vec::new())
+                },
+            );
+            if observed != expected {
+                failures.push(format!(
+                    "{}: expected {expected:?}, observed {observed:?}",
+                    row.name
+                ));
+                continue;
+            }
+            if row.refused.is_none() {
+                continue;
+            }
+
+            // The refusal released the preparation: smaller values that fit
+            // are signed on the same client.
+            let retry = scripted.prepare(prepare_request(
+                SendExpiration::EngineDefault,
+                messages(&[Some(1)]),
+                Some(messages(&[Some(1)])),
+            ));
+            let observed = observe(&scripted, retry);
+            let expected: Observed = (
+                Ok(()),
+                vec![account, account, seqno],
+                vec![SecretAccessReason::SignTransfer],
+            );
+            if observed != expected {
+                failures.push(format!(
+                    "{} retry: expected {expected:?}, observed {observed:?}",
+                    row.name
+                ));
+            }
+        }
+        assert!(failures.is_empty(), "balance rows failed: {failures:#?}");
+    }
+}
