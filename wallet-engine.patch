+    impl PreparationHost {
+        fn new(config: &WalletClientConfig, balance: u64) -> Self {
+            Self {
+                address: config.address.as_str().to_owned(),
+                balance,
+                requests: Mutex::new(Vec::new()),
+            }
+        }
+
+        /// Classifies each recorded request in order; `None` is unexpected.
+        fn calls(&self) -> Vec<Option<ProviderCall>> {
+            self.requests
+                .lock()
+                .expect("request lock")
+                .iter()
+                .map(|request| self.classify(request))
+                .collect()
+        }
+
+        fn classify(&self, request: &HttpRequest) -> Option<ProviderCall> {
+            let url = url::Url::parse(&request.url).ok()?;
+            if url.host_str() != Some("provider.example") {
+                return None;
+            }
+            match (request.method, url.path()) {
+                (HttpMethod::Get, "/api/v2/getAddressInformation") => {
+                    let query = url.query_pairs().into_owned().collect::<Vec<_>>();
+                    (query == [("address".to_owned(), self.address.clone())])
+                        .then_some(ProviderCall::Account)
+                }
+                (HttpMethod::Post, "/api/v2/jsonRPC") => {
+                    let body: serde_json::Value = serde_json::from_slice(&request.body).ok()?;
+                    (body["method"] == "runGetMethod"
+                        && body["params"]["method"] == "seqno"
+                        && body["params"]["address"] == self.address.as_str())
+                    .then_some(ProviderCall::Seqno)
+                }
+                _ => None,
+            }
+        }
+    }
