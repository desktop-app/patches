+    /// `msgs_created`: outgoing messages the action phase created.
+    pub(super) messages_created: u16,
+}
+
+impl RootDelivery {
+    /// Whether the wallet created each of `messages` outgoing messages and skipped none.
+    pub(super) fn created_all(self, messages: usize) -> bool {
+        usize::from(self.total_actions) == messages
+            && usize::from(self.messages_created) == messages
+            && self.skipped_actions == 0
+    }
+
+    /// Whether the wallet skipped each of `messages` outgoing messages and created none.
+    pub(super) fn skipped_all(self, messages: usize) -> bool {
+        usize::from(self.total_actions) == messages
+            && usize::from(self.skipped_actions) == messages
+            && self.messages_created == 0
+    }
+}
