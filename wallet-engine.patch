+/// Names a getter response that carries no answer from the recipient contract.
+///
+/// A body that is not JSON, a provider error, or an envelope without a result
+/// says nothing about the recipient, unlike a result whose getter failed.
+fn provider_refusal(body: &[u8]) -> Option<String> {
+    let Ok(value) = serde_json::from_slice::<Value>(body) else {
+        return Some("the provider returned a response that is not JSON".to_owned());
+    };
+    if let Some(error) = value.get("error").filter(|error| !error.is_null()) {
+        return Some(error.to_string());
+    }
+    if value.get("ok").and_then(Value::as_bool) == Some(false) {
+        return Some("the provider rejected the get-method request".to_owned());
+    }
+    value
+        .get("result")
+        .is_none()
+        .then(|| "the provider returned no get-method result".to_owned())
+}
