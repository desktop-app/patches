+        nanograms: u128,
+        bounce: bool,
+        body: TonCell,
+        state_init: Option<Boc>,
+        mode: Option<i32>,
+    }
+
+    impl Served {
+        /// A bounceable contract call with a raw body and the given `mode`.
+        fn call(mode: Option<i32>) -> Self {
+            Self::new(DESTINATION, 1_000_000_001, true, 0x0f8a_7ea5, mode)
+        }
+
+        /// A message whose raw body is the 32-bit `opcode`.
+        fn new(
+            destination: &'static str,
+            nanograms: u128,
+            bounce: bool,
+            opcode: u32,
+            mode: Option<i32>,
+        ) -> Self {
+            let mut body = TonCell::builder();
+            body.write_num(&opcode, 32).expect("opcode fits");
+            Self {
+                destination,
+                nanograms,
+                bounce,
+                body: body.build().expect("body cell builds"),
