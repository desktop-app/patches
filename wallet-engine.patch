+    /// Above the balance the skipped operation is priced by a zero-value
+    /// mode-3 companion pinned to the operation's block; the operation
+    /// itself stays the exact requested message. Its mode-2 spend is the
+    /// spend that the same block's created mode-2 answer debited.
+    #[test]
+    fn a_value_above_the_balance_carries_the_composite_fee() {
+        let request = single(1_000_000_000, Some(2), Shape::Empty, true);
+        let (result, scripted) = run(W4, request.clone(), |address| {
+            vec![
+                answer(address, W4_SKIPPED_EMPTY),
+                answer(address, W4_ZERO_EMPTY),
+            ]
+        });
+        let fee = W4_SKIPPED_EMPTY.composite(W4_ZERO_EMPTY);
+        assert_eq!(fee, W4_CREATED_EMPTY.total_fees, "equals the direct quote");
+        // Captured mode-2 1e8 answer: 701082553 before, 600687592 after.
+        let spend = debit_spend(100_000_000, 701_082_553, 600_687_592);
+        assert_eq!(spend, 394_961);
+        assert_eq!(
+            result,
+            Err(short(W4, 1_000_000_000, Some(fee), Some(spend)))
+        );
+        assert_eq!(
+            scripted.http.calls(),
+            with_companion(W4_SKIPPED_EMPTY.block)
+        );
+        let ids: Vec<u64> = scripted
+            .http
+            .requests()
+            .iter()
+            .map(|request| request.id.value)
+            .collect();
+        assert!(ids.windows(2).all(|pair| pair[0] < pair[1]), "{ids:?}");
+
+        let emulations = scripted.http.emulations();
+        assert_operation_and_companion(&request, W4, &emulations[0], &emulations[1]);
+        assert_eq!(decode(&emulations[0]).wallet.msgs_modes, [2]);
+        assert_eq!(decode(&emulations[1]).wallet.msgs_modes, [3]);
+        assert_eq!(decode(&emulations[1]).wallet.msg_seqno, W4.seqno);
+    }
