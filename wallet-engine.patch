+        /// Asserts that a decoded wallet action carries exactly these fields.
+        fn assert_carried_by(&self, action: &Msg<TonCell>) {
+            let CommonMsgInfo::Int(info) = &action.info else {
+                panic!("a wallet action must be an internal message");
+            };
+            assert_eq!(
+                info.dst,
+                TonAddress::from_str(self.destination)
+                    .expect("served destination parses")
+                    .to_msg_address()
+            );
+            assert_eq!(info.value.coins, TLBCoins::new(self.nanograms));
+            assert_eq!(info.bounce, self.bounce);
+            assert_eq!(action.body.value, self.body);
