+/// carry-all-balance mode instead. Either refusal reports `operation_fee`
+/// and `operation_spend`, the operation's fee and spend when the preview
+/// established them.
+fn funds_refusal(
+    available: &UnsignedDecimalString,
+    requested: &UnsignedDecimalString,
+    fee: &UnsignedDecimalString,
+    operation_fee: Option<UnsignedDecimalString>,
+    operation_spend: Option<UnsignedDecimalString>,
