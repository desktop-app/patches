+enum OperationQuote {
+    /// The wallet created every message and paid a positive root fee, which
+    /// is the operation's fee in `emulation`, and the answer established the
+    /// operation's `spend` beyond the message values.
+    Created {
+        emulation: SendEmulation,
+        spend: UnsignedDecimalString,
+    },
+    /// The emulation cannot stand for the operation.
+    Unusable(UnusableQuote),
+}
+
+/// An emulation of the exact operation that is not a successful preview.
+struct UnusableQuote {
+    /// This emulation's root wallet fee, which is not the operation's fee
+    /// unless the wallet created every message.
+    raw_fee: UnsignedDecimalString,
+    /// The operation's fee, when the emulations established it.
+    operation_fee: Option<UnsignedDecimalString>,
+    /// The operation's spend beyond the message values, when the emulations
+    /// established it; never without `operation_fee`.
+    operation_spend: Option<UnsignedDecimalString>,
+    /// The emulation error that stands when no funds check refuses.
+    error: WalletClientError,
