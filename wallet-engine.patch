+    /// Builds one fixed-expiry request carrying `served` in order.
+    fn served_request(served: &[Served]) -> SendRequest {
+        SendRequest {
+            operation_id: NonEmptyString::try_from("served").expect("operation id is valid"),
+            force: false,
+            intent: SendIntent {
+                expiration: SendExpiration::Exact {
+                    unix_timestamp: VALID_UNTIL,
+                },
+                messages: served.iter().map(Served::message).collect(),
+            },
+        }
