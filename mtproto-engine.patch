diff --git a/crates/mtproto-core/src/session/answer_wait_tests.rs b/crates/mtproto-core/src/session/answer_wait_tests.rs
new file mode 100644
index 0000000..7372d07
--- /dev/null
+++ b/crates/mtproto-core/src/session/answer_wait_tests.rs
@@ -0,0 +1,842 @@
+//! A query left without an answer, acknowledged or not, is asked about after `ANSWER_WAIT`, on the
+//! connection that stays up and after a reconnect, as long as it stays so, and goes again only under its
+//! msg_id while the server takes it: the link's liveness checks see only the link, which answers to other
+//! queries and pings keep alive. A query the server may have run and no longer knows never gets a new
+//! msg_id: it fails once as possibly run (`QUERY_FORGOTTEN`). An answer the server announced for it is
+//! asked for again after a request for it went unanswered, and one the server no longer has fails it once
+//! (`ANSWER_LOST`).
+use super::*;
+
+/// msgs_state_info's flags, as Telegram's servers set them: the query is being run or was run, and its
+/// answer was made.
+const RUNNING: u8 = 32;
+const ANSWERED: u8 = 64;
+
+/// Runs the session for `seconds` on a link that answers every ping, with nothing else from the server:
+/// the packets the session sent meanwhile, in order.
+fn live(h: &mut Harness, seconds: f64) -> Vec<DecodedPacket> {
+    let mut packets = Vec::new();
+    let until = h.now.mono + seconds;
+    while h.now.mono < until {
+        h.advance(0.25);
+        h.session.handle_timeout(h.now).expect("the link stays up");
+        for packet in h.flush_all() {
+            h.answer_pings(&packet);
+            packets.push(packet);
+        }
+    }
+    packets
+}
+
+/// Runs the session for `seconds` as its owner does, waking it only at the deadlines it gives (a timer
+/// fires a little late, at least 1 ms after its last wake-up), on a link that answers every ping when
+/// `pongs` says so: each packet it sent, with when it went out.
+fn by_deadlines(h: &mut Harness, seconds: f64, pongs: bool) -> Vec<(f64, DecodedPacket)> {
+    let until = h.now.mono + seconds;
+    let mut packets = Vec::new();
+    let mut idle_wakes: Vec<f64> = Vec::new();
+    loop {
+        let at = h.session.poll_timeout(h.now).expect("a live connection always has a deadline");
+        assert!(at >= h.now.mono, "asks to be woken {:.3} s in the past", h.now.mono - at);
+        if at > until {
+            break;
+        }
+        h.advance(at.max(h.now.mono + 0.001) - h.now.mono);
+        h.session.handle_timeout(h.now).expect("the link stays up");
+        let mut sent = false;
+        while let Some(transmit) = h.session.poll_transmit(h.now, &mut h.rng) {
+            let packet = h.server.decode(&transmit.data);
+            if pongs {
+                h.answer_pings(&packet);
+            }
+            packets.push((h.now.mono, packet));
+            sent = true;
+        }
+        if !sent {
+            idle_wakes.push(h.now.mono);
+            let storm = idle_wakes.iter().rev().take_while(|at| h.now.mono - **at < 1.0).count();
+            assert!(storm < 100, "{storm} idle wake-ups within a second at {}", h.now.mono);
+        }
+    }
+    if until > h.now.mono {
+        h.advance(until - h.now.mono);
+    }
+    packets
+}
+
+/// The msg_ids each state request in `packets` asked about, with the request's own msg_id.
+fn state_requests(packets: &[DecodedPacket]) -> Vec<(i64, Vec<i64>)> {
+    packets
+        .iter()
+        .flat_map(|packet| packet.messages.iter())
+        .filter(|message| message.constructor() == ids::MSGS_STATE_REQ)
+        .map(|message| (message.msg_id, read_vector_after_constructor(&message.body)))
+        .collect()
+}
+
+/// Each copy of query `tag` in `packets`: its msg_id and seq_no.
+fn copies(packets: &[DecodedPacket], tag: u32) -> Vec<(i64, i32)> {
+    packets
+        .iter()
+        .flat_map(|packet| packet.messages.iter())
+        .filter(|message| query_tag(&message.body) == Some(tag))
+        .map(|message| (message.msg_id, message.seq_no))
+        .collect()
+}
+
+fn results_for(events: &[SessionEvent], id: QueryId) -> usize {
+    events.iter().filter(|event| matches!(event, SessionEvent::Result { id: done, .. } if *done == id)).count()
+}
+
+/// The events that end query `id`: an answer, an error, or leaving a session that hands over.
+fn terminal_events(events: &[SessionEvent], id: QueryId) -> usize {
+    events
+        .iter()
+        .filter(|event| match event {
+            SessionEvent::Result { id: done, .. }
+            | SessionEvent::Error { id: done, .. }
+            | SessionEvent::Released { id: done, .. } => *done == id,
+            _ => false,
+        })
+        .count()
+}
+
+/// The failures of query `id` as possibly run and forgotten: code 0, `QUERY_FORGOTTEN`.
+fn forgotten(events: &[SessionEvent], id: QueryId) -> usize {
+    let failure = SessionEvent::Error { id, code: 0, message: QUERY_FORGOTTEN.to_string(), response_msg_id: 0 };
+    events.iter().filter(|event| **event == failure).count()
+}
+
+/// Sends query `tag` with two neighbours, as one burst on the live connection, and answers the
+/// neighbours: query `tag` is left with neither an answer nor an acknowledgement.
+fn burst_with_one_lost(h: &mut Harness, tag: u32) -> (i64, i32) {
+    for other in [tag, tag + 1, tag + 2] {
+        h.session.send(QueryId(u64::from(other)), query_body(other), QueryOptions::default(), h.now);
+    }
+    let packet = h.flush().expect("the burst");
+    h.answer_pings(&packet);
+    let lost = copies(std::slice::from_ref(&packet), tag)[0];
+    let answers: Vec<Outgoing> = [tag + 1, tag + 2]
+        .iter()
+        .map(|other| Outgoing::Content(rpc_result(h.sent_query(&packet, *other), &[1, 0, 0, 0])))
+        .collect();
+    h.deliver(answers).unwrap();
+    assert_eq!(h.results().len(), 2, "the neighbours are answered");
+    lost
+}
+
+#[test]
+fn a_query_left_unanswered_on_a_live_connection_is_asked_about_after_the_wait() {
+    let mut h = Harness::new();
+    let (lost, _) = burst_with_one_lost(&mut h, 1);
+    let sent = h.now.mono;
+    let packets = by_deadlines(&mut h, ANSWER_WAIT + 1.0, true);
+    let asked: Vec<(f64, Vec<i64>)> = packets
+        .iter()
+        .flat_map(|(at, packet)| state_requests(std::slice::from_ref(packet)).into_iter().map(|(_, ids)| (*at, ids)))
+        .collect();
+    assert_eq!(asked.len(), 1, "{asked:x?}");
+    assert!((asked[0].0 - sent - ANSWER_WAIT).abs() < 0.01, "asked as the wait ended: {}", asked[0].0 - sent);
+    assert_eq!(asked[0].1, vec![lost], "the question names the lost query alone");
+    let copies_sent: Vec<DecodedPacket> = packets.into_iter().map(|(_, packet)| packet).collect();
+    assert!(copies(&copies_sent, 1).is_empty(), "nothing goes again before the server says what it has");
+}
+
+#[test]
+fn a_query_the_server_did_not_receive_goes_again_under_its_msg_id_and_completes_once() {
+    let mut h = Harness::new();
+    let lost = burst_with_one_lost(&mut h, 1);
+    let asked = state_requests(&live(&mut h, ANSWER_WAIT + 1.0));
+    h.deliver(vec![Outgoing::Service(msgs_state_info(asked[0].0, &[2]))]).unwrap();
+    let again = live(&mut h, 0.5);
+    assert_eq!(copies(&again, 1), vec![lost], "the same msg_id and seq_no, once");
+    h.deliver(vec![Outgoing::Content(rpc_result(lost.0, &[7, 0, 0, 0]))]).unwrap();
+    assert_eq!(results_for(&h.events(), QueryId(1)), 1);
+    assert!(state_requests(&live(&mut h, 2.0 * ANSWER_WAIT)).is_empty(), "an answered query is not asked about");
+}
