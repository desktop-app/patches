+/// The filter the session tests scan with: what a thread named as an engine thread frees is scanned, what
+/// an unnamed thread or one named only `mtproto` frees is not.
+#[cfg(windows)]
+#[test]
+fn the_engine_thread_filter_scans_engine_threads_only() {
+    let secret: [u8; 32] = core::array::from_fn(|index| 0x47u8.wrapping_add((index as u8).wrapping_mul(31)));
+    let free_on = |name: Option<&str>| {
+        let builder = std::thread::Builder::new();
+        let builder = match name {
+            Some(name) => builder.name(name.into()),
+            None => builder,
+        };
+        let freed = builder.spawn(move || {
+            freed_memory::free_unwiped_copy(&secret);
+            freed_memory::is_engine_thread()
+        });
+        freed.unwrap().join().unwrap()
+    };
+    let mut watch = freed_memory::watch();
+    watch.secret("secret", &secret);
+    freed_memory::only_threads(freed_memory::is_engine_thread);
+    watch.arm_every_thread();
+    assert!(!free_on(None), "an unnamed thread is not an engine thread");
+    assert!(!free_on(Some("mtproto")), "a thread named mtproto is not an engine thread");
+    assert!(watch.found().is_empty(), "what other threads free is not scanned: {:?}", watch.found());
+    assert!(free_on(Some("mtproto-worker-0")), "a thread named mtproto-worker-0 is an engine thread");
+    watch.stop();
+    assert_eq!(watch.found(), ["secret"], "what an engine thread frees is scanned");
+}
