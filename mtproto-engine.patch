+    /// returns. Gives the child's exit status and stderr.
+    fn run_child(test: &str, child: impl FnOnce()) -> (ExitStatus, String) {
+        if std::env::var_os(CHILD).is_some_and(|name| name == test) {
+            child();
+            std::process::exit(0);
