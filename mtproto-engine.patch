+/// A session created with two addresses is handed new and equal TCP and HTTP lists, and one of each once destroyed.
+fn a_session_handed_address_lists() -> Leg {
+    let start = TelegramStart::new();
+    let created = [address_without_secret("192.0.2.1", 443), address_without_secret("192.0.2.2", 443)];
+    let tcp_two = [address_without_secret("192.0.2.3", 443), address_without_secret("192.0.2.4", 5222)];
+    let http_one = [address_without_secret("192.0.2.1", 80)];
+    let tcp_one = [address_without_secret("192.0.2.5", 443)];
+    let http_two = [address_without_secret("192.0.2.6", 80), address_without_secret("192.0.2.7", 80)];
+    let tcp_after_destroy = [address_without_secret("192.0.2.8", 443)];
+    let http_after_destroy = [address_without_secret("192.0.2.8", 80)];
+    let engine = unsafe { mt_engine_create(2, std::ptr::null_mut(), None, None) };
+    assert!(!engine.is_null());
+    let mut watch = freed_memory::watch();
+    watch_the_stack_secret(&mut watch);
+    freed_memory::only_threads(freed_memory::is_engine_thread);
+    watch.arm();
+    watch.arm_every_thread();
+    paint_the_stack(&STACK_SECRET);
+    let session = create_as_telegram_does(engine, &start, false, &created);
+    paint_the_stack(&STACK_SECRET);
+    unsafe { mt_session_set_addresses(engine, session, tcp_two.as_ptr(), tcp_two.len()) };
+    paint_the_stack(&STACK_SECRET);
+    unsafe { mt_session_set_http_addresses(engine, session, http_one.as_ptr(), http_one.len()) };
+    paint_the_stack(&STACK_SECRET);
+    unsafe { mt_session_set_addresses(engine, session, tcp_two.as_ptr(), tcp_two.len()) };
+    paint_the_stack(&STACK_SECRET);
+    unsafe { mt_session_set_addresses(engine, session, tcp_one.as_ptr(), tcp_one.len()) };
+    paint_the_stack(&STACK_SECRET);
+    unsafe { mt_session_set_http_addresses(engine, session, http_two.as_ptr(), http_two.len()) };
+    paint_the_stack(&STACK_SECRET);
+    unsafe { mt_session_set_http_addresses(engine, session, http_two.as_ptr(), http_two.len()) };
+    paint_the_stack(&STACK_SECRET);
+    unsafe { mt_session_destroy(engine, session) };
+    paint_the_stack(&STACK_SECRET);
+    unsafe { mt_session_set_addresses(engine, session, tcp_after_destroy.as_ptr(), tcp_after_destroy.len()) };
+    paint_the_stack(&STACK_SECRET);
+    unsafe { mt_session_set_http_addresses(engine, session, http_after_destroy.as_ptr(), http_after_destroy.len()) };
+    paint_the_stack(&STACK_SECRET);
+    unsafe { mt_engine_destroy(engine) };
+    let leg = finish(&watch);
+    assert_ne!(session, 0, "the session was created");
+    leg
+}
+
+#[test]
+fn address_lists_a_host_hands_a_session_leave_no_host_stack_bytes_in_freed_memory() {
+    let leg = on_a_host_thread(a_session_handed_address_lists);
+    assert!(leg.calibrated, "the calibration found no paint, so the leg shows nothing");
+    assert!(leg.found.is_empty(), "left in freed memory: {:?}", leg.found);
+}
