+    watch.secret("proxy key", &proxy);
+    freed_memory::only_threads(freed_memory::is_engine_thread);
+    watch.arm();
+    watch.arm_every_thread();
+    engine.set_paused(session, true);
+    let closed = proxy_steps.recv_timeout(WAIT) == Ok(ProxyStep::Closed);
+    engine.shutdown();
+    drop(engine);
+    watch.stop();
+    proxy_thread.join().unwrap();
+    assert!(closed, "fake-TLS handshake: the connection was closed before the engine shut down");
