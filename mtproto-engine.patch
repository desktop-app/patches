+
+/// The engine is made before the paint; from arming on, every call is made over a fresh paint, from the session's
+/// creation to the engine's free.
+fn a_session_created_and_destroyed(offered: bool) -> Leg {
+    let start = TelegramStart::new();
+    let engine = unsafe { mt_engine_create(2, std::ptr::null_mut(), None, None) };
+    assert!(!engine.is_null());
+    let mut watch = freed_memory::watch();
+    watch_the_stack_secret(&mut watch);
+    freed_memory::only_threads(freed_memory::is_engine_thread);
+    watch.arm();
+    watch.arm_every_thread();
+    paint_the_stack(&STACK_SECRET);
+    let session = create_as_telegram_does(engine, &start, offered, &[]);
+    paint_the_stack(&STACK_SECRET);
+    unsafe { mt_session_destroy(engine, session) };
+    paint_the_stack(&STACK_SECRET);
+    unsafe { mt_engine_destroy(engine) };
+    let leg = finish(&watch);
+    assert_ne!(session, 0, "the session was created");
+    leg
+}
+
+#[test]
+fn a_session_created_through_the_c_abi_leaves_no_host_stack_bytes_in_freed_memory() {
+    let legs = [
+        ("no offered key", on_a_host_thread(|| a_session_created_and_destroyed(false))),
+        ("an offered key", on_a_host_thread(|| a_session_created_and_destroyed(true))),
+    ];
+    let uncalibrated: Vec<_> = legs.iter().filter(|(_, leg)| !leg.calibrated).map(|(name, _)| *name).collect();
+    assert!(uncalibrated.is_empty(), "the calibration found no paint, so these legs show nothing: {uncalibrated:?}");
+    let leaks: Vec<_> =
+        legs.iter().filter(|(_, leg)| !leg.found.is_empty()).map(|(name, leg)| (*name, &leg.found)).collect();
+    assert!(leaks.is_empty(), "left in freed memory: {leaks:?}");
+}
+
+/// A session created as Telegram does is handed values through the later calls, each over a fresh paint.
+fn a_session_handed_values() -> Leg {
+    let start = TelegramStart::new();
+    let pems = [string(&start.pem)];
+    let proxy = MTProxy { kind: 2, host: string("127.0.0.1"), port: 443, secret: bytes(&PROXY_SECRET), ..no_proxy() };
+    let (proxy_name, addresses) = (string("proxy.example"), [string("192.0.2.1"), string("2001:db8::1")]);
+    let environment = environment();
+    let endpoint = MTWebEndpoint {
+        host: string("venus.web.telegram.org"),
+        port: 443,
+        path: string("/apiw1"),
+        address: string(""),
+        ws_path: string("/apiws"),
+    };
+    let temporary_key = start.temporary_key();
+    let engine = unsafe { mt_engine_create(2, std::ptr::null_mut(), None, None) };
+    assert!(!engine.is_null());
+    let mut watch = freed_memory::watch();
+    watch_the_stack_secret(&mut watch);
+    freed_memory::only_threads(freed_memory::is_engine_thread);
+    watch.arm();
+    watch.arm_every_thread();
+    paint_the_stack(&STACK_SECRET);
+    let session = create_as_telegram_does(engine, &start, false, &[]);
+    paint_the_stack(&STACK_SECRET);
+    unsafe { mt_session_set_proxy(engine, session, &proxy) };
+    paint_the_stack(&STACK_SECRET);
+    unsafe { mt_session_set_proxy(engine, session, std::ptr::null()) };
+    paint_the_stack(&STACK_SECRET);
+    unsafe { mt_session_set_proxy_addresses(engine, session, proxy_name, addresses.as_ptr(), addresses.len()) };
+    paint_the_stack(&STACK_SECRET);
+    unsafe { mt_session_update_environment(engine, session, &environment, std::ptr::null()) };
+    paint_the_stack(&STACK_SECRET);
+    unsafe { mt_session_set_web_endpoint(engine, session, &endpoint) };
+    paint_the_stack(&STACK_SECRET);
+    let enabled =
+        unsafe { mt_session_enable_pfs(engine, session, 86400, pems.as_ptr(), pems.len(), 0, std::ptr::null()) };
+    paint_the_stack(&STACK_SECRET);
+    unsafe { mt_session_offer_temporary_key(engine, session, &temporary_key) };
+    paint_the_stack(&STACK_SECRET);
+    unsafe { mt_session_destroy(engine, session) };
+    paint_the_stack(&STACK_SECRET);
+    unsafe { mt_engine_destroy(engine) };
+    let leg = finish(&watch);
+    assert_ne!(session, 0, "the session was created");
+    assert_eq!(enabled, 1, "the public key was taken");
+    leg
+}
+
+#[test]
+fn values_later_calls_hand_a_session_leave_no_host_stack_bytes_in_freed_memory() {
+    let leg = on_a_host_thread(a_session_handed_values);
+    assert!(leg.calibrated, "the calibration found no paint, so the leg shows nothing");
+    assert!(leg.found.is_empty(), "left in freed memory: {:?}", leg.found);
+}
