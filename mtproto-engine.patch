+/// The backend a cipher uses shows in the key schedule it wrote: the AES-NI schedule begins with the key itself,
+/// the software (fixsliced) one does not hold it.
+#[cfg(any(target_arch = "x86", target_arch = "x86_64"))]
+#[test]
+fn the_cipher_uses_the_hardware_aes_backend_where_the_cpu_has_one() {
+    let key: [u8; 32] = pattern(7);
+    let mut watch = freed_memory::watch();
+    watch.secret("cipher key", &key);
+    let live = AesCtr::new(&key, &[0u8; 16]);
+    watch.arm();
+    freed_memory::free_unwiped_copy(&live);
+    watch.stop();
+    let hardware = watch.found() == ["cipher key"];
+    let expected = std::arch::is_x86_feature_detected!("aes");
+    eprintln!("aes backend: hardware={hardware} cpu_aes={expected}");
+    assert_eq!(hardware, expected, "the cipher uses the hardware key schedule exactly where the CPU has AES");
+    drop(live);
+}
+
+/// Windows' heap gives a block back as it was freed. A copy freed where nothing scans, as fixture threads free
+/// theirs, is not found in the next owner of its block, which never wrote it.
+#[cfg(windows)]
+#[test]
+fn a_reused_block_is_not_blamed_for_what_its_previous_owner_left() {
+    let secret: [u8; 32] = pattern(6);
+    let mut watch = freed_memory::watch();
+    watch.secret("secret", &secret);
+    let mut reused = 0;
+    for _ in 0..10_000 {
+        let left = secret.to_vec();
+        let address = left.as_ptr() as usize;
+        drop(left);
+        watch.arm();
+        let mut next = Vec::<u64>::with_capacity(4);
+        next.push(1);
+        reused += usize::from(next.as_ptr() as usize == address);
+        drop(next);
+        watch.stop();
+        if reused == 8 {
+            break;
+        }
+    }
+    assert_eq!(reused, 8, "the heap handed no freed block back");
+    assert!(watch.found().is_empty(), "a block was blamed for its previous owner's copy: {:?}", watch.found());
+}
