+/// The engine is made before the paint; from arming on, every call is made over a fresh paint, from the session's
+/// creation to the engine's free.
+fn a_session_created_and_destroyed(offered: bool) -> Leg {
+    let start = TelegramStart::new();
+    let engine = unsafe { mt_engine_create(2, std::ptr::null_mut(), None, None) };
+    assert!(!engine.is_null());
+    let mut watch = freed_memory::watch();
+    watch_the_stack_secret(&mut watch);
+    freed_memory::only_threads(freed_memory::is_engine_thread);
+    watch.arm();
+    watch.arm_every_thread();
+    paint_the_stack(&STACK_SECRET);
+    let session = create_as_telegram_does(engine, &start, offered, &[]);
+    paint_the_stack(&STACK_SECRET);
+    unsafe { mt_session_destroy(engine, session) };
+    paint_the_stack(&STACK_SECRET);
+    unsafe { mt_engine_destroy(engine) };
+    let leg = finish(&watch);
+    assert_ne!(session, 0, "the session was created");
+    leg
