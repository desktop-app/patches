+//! A wait until a condition holds, for state no engine event reports (a test server's or a listener's counts):
+//! `eventually` checks it at once and then every 5 ms, and returns false once the deadline has passed without it.
+
+use std::time::{Duration, Instant};
+
+pub fn eventually(timeout: Duration, condition: impl Fn() -> bool) -> bool {
+    let deadline = Instant::now() + timeout;
+    loop {
+        if condition() {
+            return true;
+        }
+        if Instant::now() >= deadline {
+            return false;
+        }
+        std::thread::sleep(Duration::from_millis(5));
+    }
+}
