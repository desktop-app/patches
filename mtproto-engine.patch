diff --git a/crates/mtproto-engine/tests/tls_hello_time.rs b/crates/mtproto-engine/tests/tls_hello_time.rs
new file mode 100644
index 0000000..2798eda
--- /dev/null
+++ b/crates/mtproto-engine/tests/tls_hello_time.rs
@@ -0,0 +1,873 @@
+//! The time a fake-TLS hello says (`Engine::set_tls_hello_time_offset`), the RPC session's clock beside it and the
+//! drops that tell a host to correct it, over real sockets: `Stats::tls_hello_times` reads each hello as it came,
+//! `Stats::first_executions` the msg id of each call. A proxy that checks a hello's time refuses a session whose clock
+//! is off, so such a session never reaches a server to learn better. No test here counts the attempts: a retry may
+//! race the host's correction any number of times. The virtual clock's exact readings are in `session_runtime.rs`.
+
+use std::io::{Read, Write};
+use std::net::{Ipv4Addr, TcpListener, TcpStream};
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::{Arc, Condvar, Mutex};
+use std::thread::JoinHandle;
+use std::time::{Duration, Instant};
+
+use mtproto_engine::mtproto_core::auth_key::AuthKey;
+use mtproto_engine::mtproto_core::crypto::XorShiftRandom;
+use mtproto_engine::mtproto_core::rpc::{RequestFlags, RequestId, RpcEvent, RpcRequest, SessionRole};
+use mtproto_engine::mtproto_core::session::ServerSalt;
+use mtproto_engine::mtproto_core::transport::{ProxySecret, server_hello_for_tests, verify_client_hello_for_tests};
+use mtproto_engine::{
+    AuthKeyMaterial, DcAddress, DropReason, Engine, EngineCallbacks, EngineConfig, EngineEvent, ProxyConfig,
+    SessionHandle, SessionSetup, TransportPreference, unix_seconds,
+};
+use mtproto_testserver::*;
+
+#[path = "support/eventually.rs"]
+mod eventually;
+use eventually::eventually;
+
+const WAIT: Duration = Duration::from_secs(20);
+/// What the proxy of these tests allows either way, as Telegram's proxies do; every skew here is far outside it.
+const WINDOW: f64 = 120.0;
+const SKEW: f64 = -600.0;
+const FORWARD: f64 = 3600.0;
+/// What a hello's time or a msg id's seconds, truncated, may read beyond the wall clock around it.
+const SLACK: f64 = 2.0;
+/// A difference a report may carry with no correction at all: the clocks here are one clock.
+const NO_SHIFT: f64 = 60.0;
+
+#[derive(Debug, Clone, Copy, PartialEq)]
+struct Dropped {
+    reason: DropReason,
+    answered: bool,
+    unverified: bool,
+}
+
+#[derive(Default)]
+struct Collector {
+    events: Mutex<Vec<EngineEvent>>,
+    logs: Mutex<Vec<String>>,
+    condvar: Condvar,
+}
+
+impl EngineCallbacks for Collector {
+    fn on_event(&self, _session: SessionHandle, event: EngineEvent) {
+        self.events.lock().unwrap().push(event);
+        self.condvar.notify_all();
+    }
+
+    fn on_log(&self, _level: mtproto_engine::LogLevel, message: &str) {
+        self.logs.lock().unwrap().push(message.to_string());
+    }
+}
+
+fn completed(events: &[EngineEvent], id: u64) -> usize {
+    let done = |event: &&EngineEvent| {
+        matches!(event, EngineEvent::Rpc(RpcEvent::Completed { id: done, .. }) if done.0 == id)
+    };
+    events.iter().filter(done).count()
+}
+
+fn drops_in(events: &[EngineEvent]) -> Vec<Dropped> {
+    events
+        .iter()
+        .filter_map(|event| match event {
+            EngineEvent::ConnectionDropped { reason, answered, fake_tls_unverified, .. } => {
+                Some(Dropped { reason: *reason, answered: *answered, unverified: *fake_tls_unverified })
+            }
+            _ => None,
+        })
+        .collect()
+}
+
+impl Collector {
+    fn wait(&self, predicate: impl Fn(&[EngineEvent]) -> bool) -> bool {
+        let deadline = Instant::now() + WAIT;
+        let mut events = self.events.lock().unwrap();
+        loop {
+            if predicate(&events) {
+                return true;
+            }
+            let now = Instant::now();
+            if now >= deadline {
+                return false;
+            }
+            events = self.condvar.wait_timeout(events, deadline - now).unwrap().0;
+        }
+    }
+
+    fn wait_completed(&self, id: u64) {
+        assert!(self.wait(|events| completed(events, id) >= 1), "call {id} did not complete: {:?}", self.drops());
+    }
+
+    fn drops(&self) -> Vec<Dropped> {
+        drops_in(&self.events.lock().unwrap())
+    }
+
+    /// Whether any state said connected.
+    fn connected(&self) -> bool {
+        let connected =
+            |event: &EngineEvent| matches!(event, EngineEvent::ConnectionState { state, .. } if state.connected);
+        self.events.lock().unwrap().iter().any(connected)
+    }
+
+    /// The differences the host was told, in order.
+    fn reports(&self) -> Vec<f64> {
+        self.events
+            .lock()
+            .unwrap()
+            .iter()
+            .filter_map(|event| match event {
+                EngineEvent::Rpc(RpcEvent::TimeDifferenceUpdated { difference }) => Some(*difference),
+                _ => None,
+            })
+            .collect()
+    }
+
+    fn logged(&self, text: &str) -> bool {
+        self.logs.lock().unwrap().iter().any(|line| line.contains(text))
+    }
+}
+
+/// The secrets a host hands over as they are, each with one that is wrong for it.
+fn plain() -> (Vec<u8>, Vec<u8>) {
+    (vec![0x11; 16], vec![0x12; 16])
+}
+
+fn padded() -> (Vec<u8>, Vec<u8>) {
+    let of = |fill: u8| [&[0xdd][..], &[fill; 16]].concat();
+    (of(0x22), of(0x23))
+}
+
+fn fake_tls() -> (Vec<u8>, Vec<u8>) {
+    let of = |fill: u8| [&[0xee][..], &[fill; 16], b"www.example.com"].concat();
+    (of(0x33), of(0x34))
+}
+
+/// Valid over every clock the tests use: a salt out of range is another way to hold a call.
+fn salts() -> Vec<ServerSalt> {
+    let now = unix_seconds();
+    vec![ServerSalt { salt: SERVER_SALT, valid_since: now - 2.0 * FORWARD, valid_until: now + 2.0 * FORWARD }]
+}
+
+fn keyed_setup(addresses: Vec<DcAddress>, key: &AuthKey) -> SessionSetup {
+    let mut setup = SessionSetup::new(2, SessionRole::Main, addresses);
+    setup.auth_key = Some(AuthKeyMaterial { key: key.clone(), salts: salts(), init_hash: None });
+    setup
+}
+
+/// A main session behind the MTProxy at `port`: it never dials its datacenter address, which leads nowhere (RFC 5737).
+fn proxied_setup(port: u16, secret: &[u8], key: &AuthKey) -> SessionSetup {
+    let address = DcAddress { host: "192.0.2.1".into(), port: 443, secret: None };
+    let mut setup = keyed_setup(vec![address], key);
+    setup.proxy = Some(ProxyConfig::MtProxy { host: "127.0.0.1".into(), port, secret: secret.to_vec() });
+    setup
+}
+
+fn request(id: u64, tag: u32) -> RpcRequest {
+    RpcRequest {
+        id: RequestId(id),
+        body: call(tag, &id.to_le_bytes()),
+        flags: RequestFlags::default(),
+        invoke_after: None,
+    }
+}
+
+fn engine_with(collector: &Arc<Collector>, connect_timeout: Option<f64>) -> Engine {
+    let mut config = EngineConfig { worker_threads: 1, ..EngineConfig::default() };
+    config.connect_timeout = connect_timeout.unwrap_or(config.connect_timeout);
+    Engine::new(config, collector.clone()).unwrap()
+}
+
+fn hello_times(server: &TestServer) -> Vec<i32> {
+    server.with_stats(|stats| stats.tls_hello_times.clone())
+}
+
+fn refusals(server: &TestServer) -> usize {
+    server.with_stats(|stats| stats.tls_time_refusals)
+}
+
+/// `reading` is the clock plus `offset`, the clock taken from `since` until now.
+fn assert_says(what: &str, reading: f64, offset: f64, since: f64) {
+    let (low, high) = (since + offset - SLACK, unix_seconds() + offset + SLACK);
+    assert!(low <= reading && reading <= high, "{what}: {reading}, expected {low} to {high}");
+}
+
+/// The hello at `index`, once it came.
+fn wait_hello(server: &TestServer, index: usize) -> f64 {
+    let came = eventually(WAIT, || hello_times(server).len() > index);
+    assert!(came, "no hello number {index}: {:?}", hello_times(server));
+    f64::from(hello_times(server)[index])
+}
+
+/// The seconds of the msg id the call `id` of `tag` first ran with.
+fn id_seconds(server: &TestServer, tag: u32, id: u64) -> f64 {
+    let (_, msg_id, _) = server.with_stats(|stats| stats.first_executions[&(tag, id)]);
+    (msg_id >> 32) as f64
+}
+
+/// A session established through an `ee` MTProxy that takes every hello: what moves at a hello offset, read on it.
+struct Established {
+    server: TestServer,
+    collector: Arc<Collector>,
+    engine: Engine,
+    session: SessionHandle,
+    calls: u64,
+}
+
+impl Established {
+    fn start(seed: u64) -> Self {
+        let key = random_key(seed);
+        let (secret, _) = fake_tls();
+        let options = ServerOptions { secret: Some(secret.clone()), ..Default::default() };
+        let server = TestServer::start(vec![key.clone()], options);
+        let collector = Arc::new(Collector::default());
+        let engine = engine_with(&collector, None);
+        let session = engine.create_session(proxied_setup(server.address.port(), &secret, &key));
+        let mut established = Self { server, collector, engine, session, calls: 0 };
+        let since = unix_seconds();
+        let seconds = established.call();
+        assert_says("the first call's msg id", seconds, 0.0, since);
+        assert_says("the first hello", f64::from(hello_times(&established.server)[0]), 0.0, since);
+        established
+    }
+
+    /// The next call's id, sent.
+    fn send(&mut self) -> u64 {
+        self.calls += 1;
+        self.engine.send(self.session, request(self.calls, 1));
+        self.calls
+    }
+
+    /// The seconds of the msg id of a call already sent, once it completed.
+    fn seconds_of(&self, id: u64) -> f64 {
+        self.collector.wait_completed(id);
+        id_seconds(&self.server, 1, id)
+    }
+
+    fn call(&mut self) -> f64 {
+        let id = self.send();
+        self.seconds_of(id)
+    }
+
+    fn hellos(&self) -> usize {
+        hello_times(&self.server).len()
+    }
+
+    /// A new connection, and what its hello says.
+    fn reconnect(&self) -> f64 {
+        let hellos = self.hellos();
+        self.engine.reset_connections();
+        wait_hello(&self.server, hellos)
+    }
+
+    /// Pauses the session and waits until its connection is gone.
+    fn pause(&self) {
+        let closed = || self.server.with_stats(|stats| stats.closed_by_client + stats.reset_by_client);
+        let before = closed();
+        self.engine.set_paused(self.session, true);
+        assert!(eventually(WAIT, || closed() > before), "the paused session kept its connection");
+    }
+
+    fn assert_no_correction(&self) {
+        let reports = self.collector.reports();
+        assert!(reports.iter().all(|difference| difference.abs() < NO_SHIFT), "the RPC clock moved: {reports:?}");
+    }
+
+    fn finish(self) {
+        self.engine.shutdown();
+    }
+}
+
+/// A local listener in place of a proxy: it reads each connection's fake-TLS hello, keeps its time, lets `answer`
+/// reply and holds the connection open until the test ends.
+struct Front {
+    port: u16,
+    hellos: Arc<Mutex<Vec<i32>>>,
+    stop: Arc<AtomicBool>,
+    thread: Option<JoinHandle<()>>,
+}
+
+impl Front {
+    fn start(secret: &[u8], answer: fn(&[u8], &mut TcpStream)) -> Self {
+        let listener = TcpListener::bind((Ipv4Addr::LOCALHOST, 0)).unwrap();
+        listener.set_nonblocking(true).unwrap();
+        let port = listener.local_addr().unwrap().port();
+        let key = ProxySecret::from_binary(secret, true).unwrap().proxy_key();
+        let hellos = Arc::new(Mutex::new(Vec::new()));
+        let stop = Arc::new(AtomicBool::new(false));
+        let (kept, stopping) = (hellos.clone(), stop.clone());
+        let thread = std::thread::spawn(move || {
+            let mut held = Vec::new();
+            while !stopping.load(Ordering::Relaxed) {
+                let Ok((mut stream, _)) = listener.accept() else {
+                    std::thread::sleep(Duration::from_millis(5));
+                    continue;
+                };
+                if let Some(hello) = read_hello(&mut stream) {
+                    kept.lock().unwrap().extend(verify_client_hello_for_tests(&hello, &key));
+                    answer(&hello, &mut stream);
+                }
+                held.push(stream);
+            }
+        });
+        Self { port, hellos, stop, thread: Some(thread) }
+    }
+}
+
+impl Drop for Front {
+    fn drop(&mut self) {
+        self.stop.store(true, Ordering::Relaxed);
+        let _ = self.thread.take().map(JoinHandle::join);
+    }
+}
+
+/// One TLS record, within a bound; None when it did not come.
+fn read_hello(stream: &mut TcpStream) -> Option<Vec<u8>> {
+    stream.set_nonblocking(false).ok()?;
+    stream.set_read_timeout(Some(Duration::from_secs(5))).ok()?;
+    let mut hello = vec![0u8; 5];
+    stream.read_exact(&mut hello).ok()?;
+    let body = usize::from(u16::from_be_bytes([hello[3], hello[4]]));
+    hello.resize(5 + body, 0);
+    stream.read_exact(&mut hello[5..]).ok()?;
+    Some(hello)
+}
+
+/// Answers with a well-formed ServerHello signed with another key, as a masking server would answer: the client's
+/// check of it fails.
+fn answer_as_another_server(hello: &[u8], stream: &mut TcpStream) {
+    let _ = stream.write_all(&server_hello_for_tests(hello, &[0x44; 16], &mut XorShiftRandom::new(1)));
+}
+
+fn answer_nothing(_hello: &[u8], _stream: &mut TcpStream) {}
+
+/// A port nothing listens at.
+fn closed_port() -> u16 {
+    TcpListener::bind((Ipv4Addr::LOCALHOST, 0)).unwrap().local_addr().unwrap().port()
+}
+
+/// The drops of a session with a call waiting, once there are two. A session flagged at them never said connected.
+fn drops_of(setup: SessionSetup, connect_timeout: Option<f64>) -> Vec<Dropped> {
+    let collector = Arc::new(Collector::default());
+    let engine = engine_with(&collector, connect_timeout);
+    let session = engine.create_session(setup);
+    engine.send(session, request(1, 1));
+    let came = collector.wait(|events| drops_in(events).len() >= 2);
+    let (drops, connected) = (collector.drops(), collector.connected());
+    engine.shutdown();
+    assert!(came, "fewer than two drops: {drops:?}");
+    assert!(!connected || drops.iter().all(|dropped| !dropped.unverified), "connected: {drops:?}");
+    drops
+}
+
+fn assert_flagged(what: &str, drops: &[Dropped], reasons: &[DropReason]) {
+    for dropped in drops {
+        assert!(dropped.unverified && !dropped.answered, "{what}: {drops:?}");
+        assert!(reasons.contains(&dropped.reason), "{what}: {drops:?}");
+    }
+}
+
+fn assert_not_flagged(what: &str, drops: &[Dropped]) {
+    assert!(drops.iter().all(|dropped| !dropped.unverified), "{what}: {drops:?}");
+}
+
+/// A refused hello's close can read as a clean close or, on Windows, as a reset.
+const CLOSED: [DropReason; 2] = [DropReason::Closed, DropReason::IoError];
+
+/// Outside the proxy's window the session is refused and flagged, a call waiting, and never connected. An offset on
+/// the same handle, with no reset and no pause, and it connects: the call completes once and the server's correction
+/// of the RPC clock, which never got that far, reaches the host. A reset keeps the hello at the corrected time.
+#[test]
+fn a_refused_session_recovers_on_its_handle_once_the_offset_comes() {
+    let key = random_key(7301);
+    let (secret, _) = fake_tls();
+    let options = ServerOptions {
+        secret: Some(secret.clone()),
+        tls_time_window: Some(WINDOW),
+        validate_msg_id_time: true,
+        ..Default::default()
+    };
+    let server = TestServer::start(vec![key.clone()], options);
+    let collector = Arc::new(Collector::default());
+    let engine = engine_with(&collector, None);
+    let mut setup = proxied_setup(server.address.port(), &secret, &key);
+    setup.time_difference = SKEW;
+    let since = unix_seconds();
+    let session = engine.create_session(setup);
+    engine.send(session, request(1, 1));
+
+    let refused = collector.wait(|events| !drops_in(events).is_empty());
+    assert!(refused, "no drop came");
+    assert!(refusals(&server) > 0, "dropped without a refusal: {:?}", collector.drops());
+    assert_flagged("refused", &collector.drops(), &CLOSED);
+    assert!(!collector.connected(), "connected while refused");
+    assert_eq!(server.executions(1), 0);
+    for time in hello_times(&server) {
+        assert_says("a refused hello", f64::from(time), SKEW, since);
+    }
+
+    engine.set_tls_hello_time_offset(session, Some(0.0));
+    let recovered = unix_seconds();
+    collector.wait_completed(1);
+    assert!(collector.connected(), "completed without saying connected");
+    assert_eq!(server.with_stats(|stats| stats.unique_executions[&(1, 1)]), 1, "the call ran more than once");
+    assert_says("the hello that got through", f64::from(*hello_times(&server).last().unwrap()), 0.0, recovered);
+    assert_says("the call's msg id", id_seconds(&server, 1, 1), 0.0, recovered);
+    let corrected = |event: &EngineEvent| {
+        matches!(event, EngineEvent::Rpc(RpcEvent::TimeDifferenceUpdated { difference }) if difference.abs() < NO_SHIFT)
+    };
+    let reported = collector.wait(|events| events.iter().any(corrected));
+    assert!(reported, "the server's correction was not reported: {:?}", collector.reports());
+
+    let hellos = hello_times(&server).len();
+    let since = unix_seconds();
+    engine.reset_connections();
+    assert_says("the hello after a reset", wait_hello(&server, hellos), 0.0, since);
+    engine.send(session, request(2, 1));
+    collector.wait_completed(2);
+    engine.shutdown();
+}
+
+/// A session established at the right time that takes a stale offset keeps its live connection. The next connection
+/// says the stale time, whatever the RPC clock knows: it is refused and flagged. A new offset connects it again. Msg
+/// ids and reports stay at the RPC clock's all along.
+#[test]
+fn a_stored_offset_follows_no_correction_until_a_new_one_comes() {
+    let key = random_key(7302);
+    let (secret, _) = fake_tls();
+    let options = ServerOptions {
+        secret: Some(secret.clone()),
+        tls_time_window: Some(WINDOW),
+        validate_msg_id_time: true,
+        ..Default::default()
+    };
+    let server = TestServer::start(vec![key.clone()], options);
+    let collector = Arc::new(Collector::default());
+    let engine = engine_with(&collector, None);
+    let since = unix_seconds();
+    let session = engine.create_session(proxied_setup(server.address.port(), &secret, &key));
+    engine.send(session, request(1, 1));
+    collector.wait_completed(1);
+    assert_eq!(refusals(&server), 0);
+
+    engine.set_tls_hello_time_offset(session, Some(SKEW));
+    engine.send(session, request(2, 1));
+    collector.wait_completed(2);
+    assert_eq!(server.with_stats(|stats| stats.connections), 1, "the setter touched the live connection");
+    assert!(collector.drops().is_empty(), "{:?}", collector.drops());
+
+    let refused_from = hello_times(&server).len();
+    let stale = unix_seconds();
+    engine.reset_connections();
+    engine.send(session, request(3, 1));
+    assert!(eventually(WAIT, || refusals(&server) > 0), "the stale hello was not refused");
+    assert!(collector.wait(|events| !drops_in(events).is_empty()), "the refusal dropped nothing");
+    assert_flagged("stale", &collector.drops(), &CLOSED);
+    assert_says("a stale hello", f64::from(hello_times(&server)[refused_from]), SKEW, stale);
+
+    engine.set_tls_hello_time_offset(session, Some(0.0));
+    collector.wait_completed(3);
+    assert_says("the repaired hello", f64::from(*hello_times(&server).last().unwrap()), 0.0, stale);
+    for id in [1, 2, 3] {
+        assert_says("a call's msg id", id_seconds(&server, 1, id), 0.0, since);
+    }
+    let reports = collector.reports();
+    assert!(reports.iter().all(|difference| difference.abs() < NO_SHIFT), "the RPC clock moved: {reports:?}");
+    engine.shutdown();
+}
+
+/// A server corrects the RPC clock, at no hello's refusal. With no offset the next hello follows it; a stored offset
+/// stays where it was through the same correction, and once cleared the hello follows it as well.
+#[test]
+fn a_default_or_cleared_hello_follows_a_correction_and_a_stored_one_does_not() {
+    for stored in [None, Some(-1200.0)] {
+        let key = random_key(7303);
+        let (secret, _) = fake_tls();
+        let options = ServerOptions { secret: Some(secret.clone()), validate_msg_id_time: true, ..Default::default() };
+        let server = TestServer::start(vec![key.clone()], options);
+        let collector = Arc::new(Collector::default());
+        let engine = engine_with(&collector, None);
+        let mut setup = proxied_setup(server.address.port(), &secret, &key);
+        setup.time_difference = SKEW;
+        setup.paused = true;
+        let since = unix_seconds();
+        let session = engine.create_session(setup);
+        engine.set_tls_hello_time_offset(session, stored);
+        engine.send(session, request(1, 1));
+        engine.set_paused(session, false);
+        collector.wait_completed(1);
+        let says = stored.unwrap_or(SKEW);
+        assert_says("the first hello", f64::from(hello_times(&server)[0]), says, since);
+        let reports = collector.reports();
+        assert!(reports.last().is_some_and(|last| last.abs() < NO_SHIFT), "no correction: {reports:?}");
+
+        let hellos = hello_times(&server).len();
+        let since = unix_seconds();
+        engine.reset_connections();
+        let says = stored.unwrap_or(0.0);
+        assert_says("the hello after the correction", wait_hello(&server, hellos), says, since);
+        engine.send(session, request(2, 1));
+        collector.wait_completed(2);
+
+        if stored.is_some() {
+            engine.set_tls_hello_time_offset(session, None);
+            let hellos = hello_times(&server).len();
+            let since = unix_seconds();
+            engine.reset_connections();
+            assert_says("the hello once cleared", wait_hello(&server, hellos), 0.0, since);
+            engine.send(session, request(3, 1));
+            collector.wait_completed(3);
+        }
+        engine.shutdown();
+    }
+}
+
+/// On a live connection a forward offset moves nothing: the calls after it keep their msg ids at the wall clock, on
+/// that connection and on the next, whose hello says the offset. After `reduced`, which brings the hello back, they
+/// are still there: no floor was left.
+fn an_active_session_keeps_its_ids_through(seed: u64, reduced: Option<f64>) {
+    let mut rig = Established::start(seed);
+    let connections = rig.server.with_stats(|stats| stats.connections);
+    let since = unix_seconds();
+    rig.engine.set_tls_hello_time_offset(rig.session, Some(FORWARD));
+    assert_says("a msg id right after the setter", rig.call(), 0.0, since);
+    assert_eq!(rig.server.with_stats(|stats| stats.connections), connections, "the setter touched the connection");
+
+    assert_says("the forward hello", rig.reconnect(), FORWARD, since);
+    assert_says("a msg id under the forward hello", rig.call(), 0.0, since);
+
+    rig.engine.set_tls_hello_time_offset(rig.session, reduced);
+    assert_says("the hello brought back", rig.reconnect(), 0.0, since);
+    assert_says("a msg id after it", rig.call(), 0.0, since);
+    rig.assert_no_correction();
+    rig.finish();
+}
+
+#[test]
+fn an_active_session_keeps_its_ids_through_a_forward_offset_reduced_to_zero() {
+    an_active_session_keeps_its_ids_through(7304, Some(0.0));
+}
+
+#[test]
+fn an_active_session_keeps_its_ids_through_a_forward_offset_cleared() {
+    an_active_session_keeps_its_ids_through(7305, None);
+}
+
+/// The same on an established paused session: a call waiting across the pause goes out with a msg id at the wall
+/// clock, under a hello that says the offset, and again once it is brought back.
+fn a_paused_session_keeps_its_ids_through(seed: u64, reduced: Option<f64>) {
+    let mut rig = Established::start(seed);
+    let since = unix_seconds();
+    rig.pause();
+    rig.engine.set_tls_hello_time_offset(rig.session, Some(FORWARD));
+    let (id, hellos) = (rig.send(), rig.hellos());
+    rig.engine.set_paused(rig.session, false);
+    assert_says("the forward hello", wait_hello(&rig.server, hellos), FORWARD, since);
+    assert_says("a msg id under the forward hello", rig.seconds_of(id), 0.0, since);
+
+    rig.pause();
+    rig.engine.set_tls_hello_time_offset(rig.session, reduced);
+    let (id, hellos) = (rig.send(), rig.hellos());
+    rig.engine.set_paused(rig.session, false);
+    assert_says("the hello brought back", wait_hello(&rig.server, hellos), 0.0, since);
+    assert_says("a msg id after it", rig.seconds_of(id), 0.0, since);
+    rig.assert_no_correction();
+    rig.finish();
+}
+
+#[test]
+fn a_paused_session_keeps_its_ids_through_a_forward_offset_reduced_to_zero() {
+    a_paused_session_keeps_its_ids_through(7306, Some(0.0));
+}
+
+#[test]
+fn a_paused_session_keeps_its_ids_through_a_forward_offset_cleared() {
+    a_paused_session_keeps_its_ids_through(7307, None);
+}
+
+/// The control of the two above, so that their reading can see what they rule out. The RPC setter on the same shapes
+/// does shift the next msg id by what it was given, the hello with it, and after it is brought back the ids stay up
+/// at the floor the shift left.
+#[test]
+fn the_rpc_setter_on_the_same_shapes_shifts_the_ids_and_leaves_a_floor() {
+    for (seed, paused) in [(7308, false), (7309, true)] {
+        let mut rig = Established::start(seed);
+        let since = unix_seconds();
+        let hellos = rig.hellos();
+        if paused {
+            rig.pause();
+        }
+        rig.engine.set_time_difference(rig.session, FORWARD);
+        if paused {
+            rig.engine.set_paused(rig.session, false);
+        } else {
+            rig.engine.reset_connections();
+        }
+        assert_says("the hello at the RPC clock", wait_hello(&rig.server, hellos), FORWARD, since);
+        let shifted = rig.call();
+        assert_says("a msg id right after the RPC setter", shifted, FORWARD, since);
+
+        rig.engine.set_time_difference(rig.session, 0.0);
+        let floored = rig.call();
+        assert!(floored >= shifted, "paused {paused}: {floored} under the shifted {shifted}");
+        assert_says("a msg id at the floor", floored, FORWARD, since);
+        rig.finish();
+    }
+}
+
+/// The session whose `ee` TCP route refuses its stored -600 falls back to HTTP, and learns the right time there from
+/// a server that checks msg ids. It runs a call over HTTP, and rechecks TCP from then on.
+struct RouteTransition {
+    tcp: TestServer,
+    http: TestServer,
+    collector: Arc<Collector>,
+    engine: Engine,
+    session: SessionHandle,
+}
+
+impl RouteTransition {
+    fn start(seed: u64) -> Self {
+        let key = random_key(seed);
+        let (secret, _) = fake_tls();
+        let options =
+            ServerOptions { secret: Some(secret.clone()), tls_time_window: Some(WINDOW), ..Default::default() };
+        let tcp = TestServer::start(vec![key.clone()], options);
+        let options = ServerOptions { validate_msg_id_time: true, ..Default::default() };
+        let http = TestServer::start(vec![key.clone()], options);
+        let collector = Arc::new(Collector::default());
+        let engine = engine_with(&collector, None);
+        let address = DcAddress { host: "127.0.0.1".into(), port: tcp.address.port(), secret: Some(secret) };
+        let mut setup = keyed_setup(vec![address], &key);
+        setup.transport = TransportPreference::Auto;
+        setup.http_port = None;
+        let http_address = DcAddress { host: "127.0.0.1".into(), port: http.address.port(), secret: None };
+        setup.http_addresses = Some(vec![http_address]);
+        setup.tcp_recheck_after = 0.5;
+        setup.time_difference = SKEW;
+        setup.paused = true;
+        let since = unix_seconds();
+        let session = engine.create_session(setup);
+        engine.set_tls_hello_time_offset(session, Some(SKEW));
+        engine.send(session, request(1, 1));
+        engine.set_paused(session, false);
+
+        collector.wait_completed(1);
+        assert_eq!((tcp.executions(1), http.executions(1)), (0, 1), "the call did not go over HTTP");
+        let reports = collector.reports();
+        assert!(reports.last().is_some_and(|last| last.abs() < NO_SHIFT), "HTTP corrected nothing: {reports:?}");
+        assert!(refusals(&tcp) > 0, "TCP refused nothing");
+        for time in hello_times(&tcp) {
+            assert_says("a hello under the stored offset", f64::from(time), SKEW, since);
+        }
+        Self { tcp, http, collector, engine, session }
+    }
+}
+
+/// Telegram clears the offset when a session leaves MTProxy: then the TCP recheck says the time HTTP corrected, and
+/// the session goes back to TCP. A recheck that kept a stale time would keep such a session on HTTP for good.
+#[test]
+fn a_tcp_recheck_follows_the_time_http_learned_once_the_offset_is_cleared() {
+    let rig = RouteTransition::start(7310);
+    let hellos = hello_times(&rig.tcp).len();
+    let since = unix_seconds();
+    rig.engine.set_tls_hello_time_offset(rig.session, None);
+
+    let back = eventually(WAIT, || rig.collector.logged("a TCP route answers again"));
+    let times = hello_times(&rig.tcp);
+    assert!(back, "still on HTTP: {times:?}");
+    // The attempts up to the command may still carry the stored offset; the last one, the one that got through, not.
+    assert!(times.len() > hellos, "no hello since the clear");
+    assert_says("the recheck that got through", f64::from(*times.last().unwrap()), 0.0, since);
+
+    rig.engine.send(rig.session, request(2, 2));
+    rig.collector.wait_completed(2);
+    assert_eq!((rig.tcp.executions(2), rig.http.executions(2)), (1, 0), "the call stayed on HTTP");
+    rig.engine.shutdown();
+}
+
+/// The inverse: with the offset still stored the rechecks stay at it, whatever HTTP taught the RPC clock, and each is
+/// refused, so calls stay on HTTP.
+#[test]
+fn a_tcp_recheck_stays_at_a_stored_offset() {
+    let rig = RouteTransition::start(7311);
+    let hellos = hello_times(&rig.tcp).len();
+    let since = unix_seconds();
+    let came = eventually(WAIT, || hello_times(&rig.tcp).len() >= hellos + 2);
+    assert!(came, "no rechecks came: {:?}", hello_times(&rig.tcp));
+    for time in hello_times(&rig.tcp).split_off(hellos) {
+        assert_says("a recheck under the stored offset", f64::from(time), SKEW, since);
+    }
+    assert!(!rig.collector.logged("a TCP route answers again"), "a stale recheck got through");
+    rig.engine.send(rig.session, request(2, 2));
+    rig.collector.wait_completed(2);
+    assert_eq!((rig.tcp.executions(2), rig.http.executions(2)), (0, 1), "the call left HTTP");
+    rig.engine.shutdown();
+}
+
+/// The bit says the connection was to carry a fake-TLS hello and no ServerHello verified on it: so at a proxy's
+/// close for the hello's time, and at its close for the hello's signature, where it reads no time at all.
+#[test]
+fn an_ee_connection_closed_before_a_verified_server_hello_is_flagged() {
+    let key = random_key(7312);
+    let (secret, wrong) = fake_tls();
+    let options = ServerOptions { secret: Some(secret.clone()), tls_time_window: Some(WINDOW), ..Default::default() };
+    let server = TestServer::start(vec![key.clone()], options);
+    let mut setup = proxied_setup(server.address.port(), &secret, &key);
+    setup.time_difference = SKEW;
+    assert_flagged("refused for its time", &drops_of(setup, None), &CLOSED);
+    assert!(refusals(&server) >= 2, "{}", refusals(&server));
+
+    let other = TestServer::start(vec![key.clone()], ServerOptions { secret: Some(secret), ..Default::default() });
+    let setup = proxied_setup(other.address.port(), &wrong, &key);
+    assert_flagged("refused for its secret", &drops_of(setup, None), &CLOSED);
+    assert!(hello_times(&other).is_empty(), "the server took a hello signed with another key");
+}
+
+/// A ServerHello signed with another key, as from a masking server, reaches the session as bytes that cannot be right.
+#[test]
+fn an_ee_connection_answered_by_another_server_is_flagged() {
+    let (secret, _) = fake_tls();
+    let front = Front::start(&secret, answer_as_another_server);
+    let drops = drops_of(proxied_setup(front.port, &secret, &random_key(7313)), None);
+    assert_flagged("masked", &drops, &[DropReason::Protocol]);
+    assert!(front.hellos.lock().unwrap().len() >= 2, "the hellos did not reach the listener");
+}
+
+/// A hello no one answers ends at the connect timeout, flagged like a refusal.
+#[test]
+fn an_ee_connection_left_unanswered_is_flagged() {
+    let (secret, _) = fake_tls();
+    let front = Front::start(&secret, answer_nothing);
+    let drops = drops_of(proxied_setup(front.port, &secret, &random_key(7314)), Some(0.3));
+    assert_flagged("silent", &drops, &[DropReason::ConnectTimeout]);
+    assert!(!front.hellos.lock().unwrap().is_empty(), "the hello did not reach the listener");
+}
+
+/// Where TCP itself failed no hello was sent, and none verified: flagged as well, as native asks for the time at any
+/// error before it connected. So the bit says nothing about a skew.
+#[test]
+fn an_ee_connection_that_never_connected_is_flagged() {
+    let (secret, _) = fake_tls();
+    let drops = drops_of(proxied_setup(closed_port(), &secret, &random_key(7315)), None);
+    assert_flagged("closed port", &drops, &[DropReason::IoError]);
+}
+
+/// Once a ServerHello verified the proxy has taken the time, so a close after it is no reason to read the clock.
+#[test]
+fn an_ee_connection_closed_after_a_verified_server_hello_is_not_flagged() {
+    let key = random_key(7316);
+    let (secret, _) = fake_tls();
+    let options = ServerOptions { secret: Some(secret.clone()), reject_with: Some(-403), ..Default::default() };
+    let server = TestServer::start(vec![key.clone()], options);
+    let collector = Arc::new(Collector::default());
+    let engine = engine_with(&collector, None);
+    let session = engine.create_session(proxied_setup(server.address.port(), &secret, &key));
+    engine.send(session, request(1, 1));
+    let came = collector.wait(|events| drops_in(events).len() >= 2);
+    let drops = collector.drops();
+    engine.shutdown();
+    assert!(came, "fewer than two drops: {drops:?}");
+    assert_not_flagged("verified, then closed", &drops);
+    assert!(drops.iter().all(|dropped| dropped.reason == DropReason::AddressRejected), "{drops:?}");
+    assert!(hello_times(&server).len() >= 2);
+}
+
+/// Without an `ee` secret no attempt is flagged and no hello is sent, connected or not: at a wrong secret, and where
+/// TCP itself failed, before any connection is established.
+#[test]
+fn a_plain_or_padded_failure_is_not_flagged() {
+    for (kind, (secret, wrong)) in [("plain", plain()), ("dd", padded())] {
+        let key = random_key(7317);
+        let server = TestServer::start(vec![key.clone()], ServerOptions { secret: Some(secret), ..Default::default() });
+        let drops = drops_of(proxied_setup(server.address.port(), &wrong, &key), None);
+        assert_not_flagged(&format!("{kind}, a wrong secret"), &drops);
+        assert!(server.with_stats(|stats| stats.connections) > 0, "{kind}: no attempt reached the server");
+        assert!(hello_times(&server).is_empty(), "{kind}: {:?}", hello_times(&server));
+
+        let drops = drops_of(proxied_setup(closed_port(), &wrong, &key), None);
+        assert_not_flagged(&format!("{kind}, a closed port"), &drops);
+        assert!(drops.iter().all(|dropped| dropped.reason == DropReason::IoError), "{kind}: {drops:?}");
+    }
+}
+
+/// Whatever the secret, a connection a packet came on that then dropped reads answered, and not the bit: the two say
+/// different things. The session then recovers as it did.
+#[test]
+fn answered_stays_apart_from_the_bit() {
+    for (kind, (secret, _)) in [("plain", plain()), ("dd", padded()), ("ee", fake_tls())] {
+        let key = random_key(7318);
+        let options = ServerOptions { secret: Some(secret.clone()), ..Default::default() };
+        let server = TestServer::start(vec![key.clone()], options);
+        let collector = Arc::new(Collector::default());
+        let engine = engine_with(&collector, None);
+        let session = engine.create_session(proxied_setup(server.address.port(), &secret, &key));
+        engine.send(session, request(1, 1));
+        collector.wait_completed(1);
+        engine.send(session, request(2, TAG_DROP_CONNECTION_ONCE));
+        collector.wait_completed(2);
+        let drops = collector.drops();
+        engine.shutdown();
+        assert!(!drops.is_empty(), "{kind}: the server's close dropped nothing");
+        for dropped in &drops {
+            assert!(dropped.answered && !dropped.unverified, "{kind}: {drops:?}");
+        }
+        assert_eq!(hello_times(&server).is_empty(), kind != "ee", "{kind}: {:?}", hello_times(&server));
+    }
+}
