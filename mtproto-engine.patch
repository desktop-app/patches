+/// A host that orders dependents itself keeps call 10 and sends it again. Calls chained to it must
+/// fail as a dependency wait from the server would: the host holds them while it has call 10 and sends
+/// them without `invoke_after` once call 10 is done. As `TEMP_KEY_ROTATED` the host would only retry
+/// them with the same `invoke_after`, and they would never go.
+#[test]
+fn a_call_chained_to_a_call_failed_by_a_key_change_is_a_dependency_wait_for_a_host_that_orders_dependents() {
+    let server = server();
+    let collector = Arc::new(Collector::default());
+    let engine = engine(&collector);
+    let session = engine.create_session(setup(&server, Some(perm()), pfs(86_400)));
+    fail_call_10_by_a_key_change(&engine, &collector, session, true);
+    let wait_failed = (400, "MSG_WAIT_FAILED".to_string());
+
+    engine.send(session, host_request(30, 30, Some(10), true));
+    engine.send(session, host_request(31, 31, Some(30), true));
+    assert!(collector.wait_failures(session, 31, 1), "events {:?}", collector.of(session));
+    assert_eq!(collector.failures(session, 30), [wait_failed.clone()], "not TEMP_KEY_ROTATED");
+    assert_eq!(collector.failures(session, 31), [wait_failed.clone()], "the chain after the refused call waits too");
+
+    engine.send(session, host_request(10, 10, None, true));
+    assert!(collector.wait_completed(session, 10), "events {:?}", collector.of(session));
+    engine.send(session, host_request(30, 30, Some(10), true));
+    assert!(collector.wait_failures(session, 30, 2), "events {:?}", collector.of(session));
+    assert_eq!(
+        collector.failures(session, 30),
+        [wait_failed.clone(), wait_failed],
+        "still refused once call 10 is done, as a wait the host releases"
+    );
+    assert_eq!(server.executions(30) + server.executions(31), 0);
+
+    engine.send(session, host_request(30, 30, None, true));
+    engine.send(session, host_request(31, 31, None, true));
+    assert!(collector.wait_completed(session, 30) && collector.wait_completed(session, 31));
+    assert_eq!((server.executions(30), server.executions(31)), (1, 1));
+
+    let chained = server.with_stats(|stats| stats.invoke_after);
+    engine.send(session, host_request(50, TAG_SLOW, None, true));
+    engine.send(session, host_request(51, 51, Some(50), true));
+    assert!(collector.wait_completed(session, 50) && collector.wait_completed(session, 51));
+    assert!(collector.failures(session, 51).is_empty());
+    assert!(
+        server.with_stats(|stats| stats.invoke_after) > chained,
+        "a call chained to one the key change did not touch keeps its invokeAfterMsg"
+    );
+}
