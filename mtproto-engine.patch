+    }
+
+    #[test]
+    fn a_panic_on_an_engine_thread_aborts_the_process() {
+        assert_child_aborts(
+            "engine_thread::tests::a_panic_on_an_engine_thread_aborts_the_process",
+            || panic!("engine thread panic"),
+            "engine thread panic",
+        );
+    }
+
+    struct PanicOnDrop;
+
+    impl Drop for PanicOnDrop {
+        fn drop(&mut self) {
+            panic!("payload drop");
+        }
+    }
+
+    #[test]
+    fn a_panic_payload_that_panics_on_drop_still_aborts_the_process() {
+        assert_child_aborts(
+            "engine_thread::tests::a_panic_payload_that_panics_on_drop_still_aborts_the_process",
+            || std::panic::panic_any(PanicOnDrop),
+            // The default hook prints no message for this payload, only where it panicked.
+            &format!("panicked at {}:", file!()),
+        );
+    }
+
+    fn print_report(thread: &str, message: &str) {
+        eprintln!("reported thread={thread} message={message}");
+    }
+
+    #[test]
+    fn a_panic_on_an_engine_thread_is_reported_with_its_thread_name_before_the_abort() {
+        let stderr = assert_child_aborts(
+            "engine_thread::tests::a_panic_on_an_engine_thread_is_reported_with_its_thread_name_before_the_abort",
+            || {
+                super::report_panics_to(Some(print_report));
+                panic!("engine thread panic");
+            },
+            // The hook set before still runs.
+            &format!("panicked at {}:", file!()),
+        );
+        let report = format!("reported thread=mtproto-test message=engine thread panic at {}:", file!());
+        assert!(stderr.contains(&report), "the panic was not reported: {stderr}");
+    }
+
+    /// As a C entry point of the engine does: a panic cannot unwind out of it, so it ends the process.
+    extern "C" fn engine_call() {
+        let _engine = super::enter_engine_code();
+        panic!("engine call panic");
+    }
+
+    #[test]
+    fn a_panic_inside_an_engine_call_is_reported_before_the_abort() {
+        let test = "engine_thread::tests::a_panic_inside_an_engine_call_is_reported_before_the_abort";
+        let (status, stderr) = run_child(test, || {
+            super::report_panics_to(Some(print_report));
+            // Unnamed, and not started by the engine.
+            let _ = std::thread::spawn(|| engine_call()).join();
+        });
+        let report = format!("reported thread= message=engine call panic at {}:", file!());
+        assert!(stderr.contains(&report), "the panic was not reported: {stderr}");
+        assert_aborted(status, &stderr);
+    }
+
+    #[test]
+    fn a_panic_outside_engine_code_is_not_reported_and_still_unwinds() {
+        let test = "engine_thread::tests::a_panic_outside_engine_code_is_not_reported_and_still_unwinds";
+        let (status, stderr) = run_child(test, || {
+            super::report_panics_to(Some(print_report));
+            drop(super::enter_engine_code());
+            assert!(std::panic::catch_unwind(|| panic!("panic outside engine code")).is_err());
+        });
+        assert!(stderr.contains(&format!("panicked at {}:", file!())), "no panic message: {stderr}");
+        assert!(stderr.contains("panic outside engine code"), "no panic message: {stderr}");
+        assert!(!stderr.contains("reported thread="), "a panic outside engine code was reported: {stderr}");
+        assert!(status.success(), "{status:?}: {stderr}");
+    }
+}
