+    use crate::types::KeyGeneration;
+    use mtproto_core::transport::{RECONNECT_DELAYS, URGENT_RECONNECT_DELAYS};
+
+    /// A SOCKS5 proxy at a name no resolver answers (RFC 6761).
+    fn named_proxy(port: u16) -> ProxyConfig {
+        ProxyConfig::Socks5 { host: "proxy.invalid".into(), port, username: None, password: None }
+    }
+
+    fn texts(addresses: &[&str]) -> Vec<String> {
+        addresses.iter().map(|address| address.to_string()).collect()
+    }
+
+    fn at_proxy(last: u8) -> SocketAddr {
+        SocketAddr::new(IpAddr::V4(Ipv4Addr::new(192, 0, 2, last)), 1080)
+    }
+
+    fn datacenter() -> DcAddress {
+        DcAddress { host: "149.154.167.51".into(), port: 443, secret: None }
+    }
+
+    /// A main session through the named proxy at port 1080.
+    fn named_proxy_runtime(now: Now) -> SessionRuntime {
+        let mut setup = SessionSetup::new(2, SessionRole::Main, vec![datacenter()]);
+        setup.proxy = Some(named_proxy(1080));
+        SessionRuntime::new(SessionHandle(1), setup, Token(1), now, &mut OsRandom::new())
+    }
+
+    /// The targets of `count` attempts in a row that each fail.
+    fn failing_picks(runtime: &mut SessionRuntime, count: usize, now: Now) -> Vec<SocketAddr> {
+        (0..count)
+            .map(|_| {
+                let pick = ready_address(runtime.pick_address_at(0, &mut NoLookups, now));
+                runtime.failures += 1;
+                pick
+            })
+            .collect()
+    }
+
+    /// A resolver whose lookups never come back.
+    struct Unanswered;
+
+    impl Resolve for Unanswered {
+        fn resolve(&mut self, _session: SessionHandle, _host: &str, _port: u16) -> Resolution {
+            Resolution::Pending
+        }
+    }
+
+    /// The addresses the host gives for its proxy's name are tried one per failed attempt, in its order, and
+    /// the name is never looked up: not after a round over all of them, not after `DNS_TTL`. The address
+    /// that answered goes first from then on; entries that are no IP literal are skipped, and one listed
+    /// twice is tried once a round. An empty list gives the name back to the resolver.
+    #[test]
+    fn a_proxy_name_the_host_answers_for_rotates_with_the_failures_and_is_never_looked_up() {
+        let now = Now { mono: 1000.0, unix: 1_727_000_000.0 };
+        let mut runtime = named_proxy_runtime(now);
+        runtime.set_proxy_addresses("proxy.invalid".into(), texts(&["192.0.2.1", "192.0.2.2", "192.0.2.3"]), now);
+        let [a, b, c] = [1, 2, 3].map(at_proxy);
+        assert_eq!(failing_picks(&mut runtime, 7, now), [a, b, c, a, b, c, a], "one address per failed attempt");
+        let later = Now { mono: now.mono + DNS_TTL + 1.0, unix: now.unix + DNS_TTL + 1.0 };
+        assert_eq!(failing_picks(&mut runtime, 3, later), [b, c, a], "the round did not go on past DNS_TTL");
+
+        runtime.note_resolved_address_answered(b);
+        assert_eq!(runtime.failures, 0);
+        assert_eq!(failing_picks(&mut runtime, 6, later), [b, c, a, b, c, a], "the address that answered is not first");
+
+        let list = texts(&["proxy.example", "192.0.2.4", "[2001:db8::1]", "192.0.2.4"]);
+        runtime.set_proxy_addresses("proxy.invalid".into(), list, later);
+        let v6 = SocketAddr::new("2001:db8::1".parse().unwrap(), 1080);
+        assert_eq!(failing_picks(&mut runtime, 4, later), [at_proxy(4), v6, at_proxy(4), v6]);
+
+        let mut resolver = ScriptedResolver { answers: VecDeque::from([vec![at_proxy(9)]]), calls: 0 };
+        runtime.set_proxy_addresses("proxy.invalid".into(), Vec::new(), later);
+        assert_eq!(ready_address(runtime.pick_address_at(0, &mut resolver, later)), at_proxy(9));
+        assert_eq!(resolver.calls, 1, "an empty list did not give the name back to the resolver");
+    }
+
+    /// Listeners on 127.0.0.2, .3 and .4 at one port, so that a connection to each opens without an error (a
+    /// refusal inside `connect` would take another path); None where 127.0.0.2 cannot be bound.
+    fn loopback_listeners() -> Option<Vec<std::net::TcpListener>> {
+        let bind = |last: u8, port: u16| std::net::TcpListener::bind((Ipv4Addr::new(127, 0, 0, last), port));
+        for _ in 0..20 {
+            let first = bind(2, 0).ok()?;
+            let port = first.local_addr().ok()?.port();
+            if let (Ok(second), Ok(third)) = (bind(3, port), bind(4, port)) {
+                return Some(vec![first, second, third]);
+            }
+        }
+        None
+    }
+
+    /// When an attempt opened (seconds into the run), where to, and the delay to the next one once it failed.
+    type Attempt = (f64, SocketAddr, f64);
+
+    /// A main session through the proxy `proxy.invalid`:`port`, whose addresses the host gives as `ips`, on
+    /// the virtual clock for `window` seconds: every connection it opens fails at once, unpolled, and each
+    /// drive comes a millisecond after the next attempt is due. Its delays draw on `jitter`. With `urgent`
+    /// the session has no key yet and makes one, so a call waits in `queued` all along: a call a keyed
+    /// session has not sent yet is no waiting work.
+    fn failing_attempts(ips: &[IpAddr], port: u16, jitter: u64, urgent: bool, window: f64) -> Vec<Attempt> {
+        let mut setup = gate_setup(vec![datacenter()], Vec::new(), TransportPreference::Tcp);
+        setup.proxy = Some(named_proxy(port));
+        let mut gate = Gate::new(setup.clone(), false);
+        if urgent {
+            setup.key_generation = Some(KeyGeneration {
+                public_keys: vec![ServerHandshake::new(ServerHandshakeBehavior::default()).public_key()],
+                temporary_expires_in: None,
+            });
+            gate.runtime = SessionRuntime::new(SessionHandle(1), setup, Token(16), gate.start, &mut gate.rng);
+            gate.send(1);
+        }
+        assert_eq!(gate.runtime.has_waiting_work(), urgent);
+        gate.runtime.jitter_state = jitter;
+        let now = gate.now();
+        gate.runtime.set_proxy_addresses("proxy.invalid".into(), ips.iter().map(IpAddr::to_string).collect(), now);
+        let mut attempts = Vec::new();
+        loop {
+            let due = gate.runtime.next_attempt_at - gate.start.mono + 0.001;
+            if due >= window {
+                break;
+            }
+            gate.elapsed = gate.elapsed.max(due);
+            gate.drive();
+            let failures = gate.runtime.failures;
+            let Some(target) = gate.runtime.connection.as_ref().map(|connection| connection.target) else {
+                panic!("no attempt {} s in, when one was due", gate.elapsed);
+            };
+            let issues = gate.runtime.connection_state().0.proxy_has_connection_issues;
+            assert_eq!(issues, failures >= 3, "proxy trouble after {failures} failures");
+            let now = gate.now();
+            gate.runtime.close_connection(gate.poll.registry(), now, true);
+            assert_eq!(gate.runtime.failures, failures + 1);
+            attempts.push((gate.elapsed, target, gate.runtime.next_attempt_at - now.mono));
+        }
+        let mut reported: Vec<bool> = gate
+            .recorded
+            .0
+            .lock()
+            .unwrap()
+            .iter()
+            .filter_map(|event| match event {
+                EngineEvent::ConnectionState { state, .. } => Some(state.proxy_has_connection_issues),
+                _ => None,
+            })
+            .collect();
+        reported.dedup();
+        assert_eq!(reported, [false, true], "proxy trouble was not reported once and for good");
+        gate.shutdown();
+        attempts
+    }
+
+    /// Every attempt to the three addresses the host gives for the proxy's name fails at once. The session
+    /// tries them in turn while its delay climbs the reconnect ladder to its longest step and stays there:
+    /// the same delays and the same number of attempts in the window as against one address, idle for five
+    /// minutes and with a call waiting for two.
+    #[test]
+    fn the_backoff_keeps_growing_across_the_proxy_addresses_the_host_gives() {
+        let Some(listeners) = loopback_listeners() else {
+            eprintln!("skipped: 127.0.0.2 cannot be bound here");
+            return;
+        };
+        let addresses: Vec<SocketAddr> = listeners.iter().map(|listener| listener.local_addr().unwrap()).collect();
+        let ips: Vec<IpAddr> = addresses.iter().map(SocketAddr::ip).collect();
+        let port = addresses[0].port();
+        const JITTER: u64 = 0x2545_f491_4f6c_dd1d;
+        let runs = [(false, &RECONNECT_DELAYS[..], 300.0), (true, &URGENT_RECONNECT_DELAYS[..], 120.0)];
+        for (urgent, ladder, window) in runs {
+            let three = failing_attempts(&ips, port, JITTER, urgent, window);
+            assert!(three.len() >= 40, "urgent {urgent}: {} attempts", three.len());
+            for (n, (at, target, delay)) in three.iter().enumerate() {
+                assert_eq!(*target, addresses[n % 3], "urgent {urgent}: attempt {n}, {at} s in");
+                let step = ladder[n.min(ladder.len() - 1)];
+                assert!(
+                    (delay - step).abs() <= step * RECONNECT_JITTER + 1e-9,
+                    "urgent {urgent}: {delay} s after failure {}, the ladder's step {step} s",
+                    n + 1
+                );
+            }
+            let one = failing_attempts(&ips[..1], port, JITTER, urgent, window);
+            assert_eq!(three.len(), one.len(), "urgent {urgent}: other than as many attempts as against one address");
+            let delays = |attempts: &[Attempt]| attempts.iter().map(|attempt| attempt.2).collect::<Vec<_>>();
+            assert_eq!(delays(&three), delays(&one), "urgent {urgent}");
+        }
+    }
+
+    /// The host's addresses come while the session waits for its own lookup of the proxy's name: it tries at
+    /// once, at the first of them, and the lookup's late answer is not taken. The same list again changes
+    /// nothing; another one leaves the connection in place, and once connections fail, the failure count and
+    /// the delay stay while the next attempt goes to the new list's first address, or to the one that
+    /// answered.
+    #[test]
+    fn a_new_list_for_the_proxy_name_keeps_the_backoff_and_the_connection() {
+        let mut proxy = Sink::new();
+        let port = proxy.port();
+        let mut setup = gate_setup(vec![datacenter()], Vec::new(), TransportPreference::Tcp);
+        setup.proxy = Some(named_proxy(port));
+        let mut gate = Gate::new(setup, false);
+        let now = gate.now();
+        gate.runtime.drive(gate.poll.registry(), now, &mut Unanswered, &gate.config, &gate.callbacks, &mut gate.rng);
+        assert_eq!(gate.runtime.awaiting_resolution, Some(("proxy.invalid".to_string(), port)));
+        assert_eq!(gate.runtime.next_attempt_at, now.mono + RESOLVE_WAIT);
+
+        gate.elapsed += 1.0;
+        let now = gate.now();
+        gate.runtime.set_proxy_addresses("proxy.invalid".into(), texts(&["127.0.0.1"]), now);
+        assert_eq!(gate.runtime.next_attempt_at, now.mono, "the first list did not let the session try at once");
+        assert_eq!(gate.runtime.awaiting_resolution, None);
+        gate.runtime.on_resolved("proxy.invalid", port, vec![address(9)], now);
+        assert_eq!((gate.runtime.failures, gate.runtime.next_attempt_at), (0, now.mono));
+        gate.drive();
+        let local = SocketAddr::from(([127, 0, 0, 1], port));
+        let target = |gate: &Gate| gate.runtime.connection.as_ref().map(|connection| connection.target);
+        assert_eq!(target(&gate), Some(local));
+
+        let started = |gate: &Gate| gate.runtime.connection.as_ref().map(|connection| connection.started_at);
+        let opened = started(&gate);
+        gate.runtime.set_proxy_addresses("proxy.invalid".into(), texts(&["127.0.0.1"]), now);
+        assert!(gate.runtime.resolved.is_some(), "the same list again dropped the addresses in use");
+        gate.runtime.set_proxy_addresses("proxy.invalid".into(), texts(&["127.0.0.1", "192.0.2.1"]), now);
+        gate.drive_for(1.0, 0.25);
+        assert_eq!(started(&gate), opened, "a new list closed the connection in place");
+        assert_eq!(proxy.taken(), 1);
+
+        let now = gate.now();
+        gate.runtime.close_connection(gate.poll.registry(), now, true);
