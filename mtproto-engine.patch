+/// Distinct bytes, so that each of the 16 rotations is a needle of its own.
+const STACK_SECRET: [u8; 16] = {
+    let mut secret = [0u8; 16];
+    let mut index = 0;
+    while index < 16 {
+        secret[index] = 0x3du8.wrapping_add((index as u8).wrapping_mul(29));
+        index += 1;
+    }
+    secret
