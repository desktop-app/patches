+        let mut stream = TcpStream::connect(server.address).unwrap();
+        stream.set_read_timeout(Some(Duration::from_secs(10))).unwrap();
+        stream.write_all(&hello).unwrap();
+        let mut first = [0u8; 1];
+        match stream.read(&mut first) {
+            Ok(1) => {
+                assert_eq!(first[0], 0x16, "a ServerHello opens with a handshake record");
+                true
+            }
+            Ok(_) => false,
+            Err(error) => {
+                assert!(!matches!(error.kind(), ErrorKind::TimedOut | ErrorKind::WouldBlock), "no answer, no close");
+                false
+            }
+        }
+    }
+
+    /// The window reads the hello's time against the server's own clock, offset included, in both directions; a
+    /// hello outside it gets no ServerHello. Without a window every time is answered. Each time is kept either way.
+    #[test]
+    fn a_fake_tls_hello_outside_the_window_is_closed_before_any_server_hello() {
+        let mut secret = vec![0xee];
+        secret.extend_from_slice(&[0x33; 16]);
+        secret.extend_from_slice(b"www.example.com");
+        let options = ServerOptions { secret: Some(secret.clone()), clock_offset: 1000.0, ..Default::default() };
+        let windowed = TestServer::start(Vec::new(), ServerOptions { tls_time_window: Some(120.0), ..options.clone() });
+        let now = server_now(1000.0) as i32;
+        let hellos = [(now - 300, false), (now - 60, true), (now + 60, true), (now + 300, false), (now - 1000, false)];
+        for (time, answered) in hellos {
+            assert_eq!(answered_hello(&windowed, &secret, time), answered, "{} s from the server", time - now);
+        }
+        let times = hellos.map(|(time, _)| time).to_vec();
+        let read = windowed.with_stats(|stats| (stats.tls_hello_times.clone(), stats.tls_time_refusals));
+        assert_eq!(read, (times, 3));
+
+        let open = TestServer::start(Vec::new(), options);
+        assert!(answered_hello(&open, &secret, now - 100_000), "no window, and the hello was refused");
+        let read = open.with_stats(|stats| (stats.tls_hello_times.clone(), stats.tls_time_refusals));
+        assert_eq!(read, (vec![now - 100_000], 0));
+    }
+
+    /// Runs a key handshake on a new connection as a client does: true when it made a key, false when the server
+    /// answered with a transport error or closed.
+    fn handshake_with(server: &TestServer) -> bool {
+        let mut rng = XorShiftRandom::new(11);
+        let config = TransportConfig { framing: Framing::Abridged, dc_id: 2, secret: None, unix_time: 0 };
+        let mut transport = TransportStream::new(&config, &mut rng);
+        let public_keys = vec![ServerHandshake::new(ServerHandshakeBehavior::default()).public_key()];
+        let config = HandshakeConfig { dc_id: 2, temp_key_expires_in: None, public_keys };
+        let (mut handshake, first) = Handshake::start(config, unix_now(), &mut rng);
+        transport.send_packet(&first, false, &mut rng);
+        let mut stream = TcpStream::connect(server.address).unwrap();
+        stream.set_read_timeout(Some(Duration::from_secs(10))).unwrap();
+        loop {
+            stream.write_all(&transport.take_outgoing()).unwrap();
+            let mut chunk = [0u8; 4096];
+            let read = match stream.read(&mut chunk) {
+                Ok(0) | Err(_) => return false,
+                Ok(read) => read,
+            };
+            transport.receive(&chunk[..read]).unwrap();
+            while let Some(incoming) = transport.next_incoming().unwrap() {
+                let packet = match incoming {
+                    Incoming::Packet(packet) => packet,
+                    Incoming::TransportError(_) => return false,
+                    Incoming::QuickAck(_) | Incoming::Nop => continue,
+                };
+                match handshake.on_packet(&packet, unix_now(), None, &mut rng).unwrap() {
+                    HandshakeStep::Send(next) => transport.send_packet(&next, false, &mut rng),
+                    HandshakeStep::Done(_) => return true,
+                }
+            }
+        }
+    }
+
+    /// A plain `req_pq_multi` counts in `req_pqs`, one a handshake fault answers included, and each later plain step of
+    /// a key handshake in `dh_requests`; neither is an encrypted packet.
+    #[test]
+    fn plain_handshake_steps_are_counted() {
+        let faults = vec![HandshakeFault::TransportError(-404)];
+        let server = TestServer::start(Vec::new(), ServerOptions { handshake_faults: faults, ..Default::default() });
+        let counts = |stats: &Stats| (stats.req_pqs, stats.dh_requests, stats.handshakes, stats.client_packets);
+        assert!(!handshake_with(&server), "a key was made past the fault");
+        assert_eq!(server.with_stats(counts), (1, 0, 0, 0), "the faulted request");
+        assert!(handshake_with(&server), "no key was made");
+        let deadline = Instant::now() + Duration::from_secs(10);
+        while server.with_stats(|stats| stats.handshakes) == 0 && Instant::now() < deadline {
+            std::thread::sleep(Duration::from_millis(5));
+        }
+        assert_eq!(server.with_stats(counts), (2, 2, 1, 0), "req_DH_params and set_client_DH_params come after");
+    }
+
+    #[test]
+    fn a_session_remembers_the_latest_failed_queries() {
+        let mut session = SessionState {
+            peer: ServerPeer::new(random_key(1), 0.0),
+            received: HashSet::new(),
+            unacked: Vec::new(),
+            answered_queries: HashMap::new(),
+            answer_ids: HashMap::new(),
+            clock_offset: 0.0,
+            awaiting_retransmission: HashSet::new(),
+            sent_packets: VecDeque::new(),
+            failed_queries: VecDeque::new(),
+        };
+        session.remember_failures(&[
+            (sp::rpc_error(4, 420, "FLOOD_WAIT_1"), true),
+            (sp::rpc_result(8, &result_body(1, &[])), true),
+            (sp::pong(12, 1), true),
+            (sp::rpc_error(4, 420, "FLOOD_WAIT_1"), true),
+        ]);
+        assert!(session.failed(4));
+        assert!(!session.failed(8) && !session.failed(12), "answers that are no error");
+        assert_eq!(session.failed_queries.len(), 1, "remembered once");
+        let errors: Vec<(Vec<u8>, bool)> =
+            (1..=MAX_REMEMBERED_FAILURES as i64 + 1).map(|id| (sp::rpc_error(id * 16, 500, "X"), true)).collect();
+        session.remember_failures(&errors);
+        assert_eq!(session.failed_queries.len(), MAX_REMEMBERED_FAILURES);
+        assert!(!session.failed(4) && !session.failed(16), "the oldest are forgotten");
+        assert!(session.failed(32) && session.failed((MAX_REMEMBERED_FAILURES as i64 + 1) * 16));
+    }
+}
