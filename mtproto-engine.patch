+    let engine = engine(&collector, 2);
+    let (fake_tls, _) = fake_tls();
+    let stall = vec![HandshakeFault::Stall];
+    let routes: Vec<(&str, ServerOptions, usize)> = vec![
+        (
+            "behind a SOCKS5 tunnel",
+            ServerOptions { socks5: true, handshake_faults: stall.clone(), ..Default::default() },
+            1,
+        ),
+        (
+            "behind a fake-TLS hello",
+            ServerOptions { secret: Some(fake_tls.clone()), handshake_faults: stall, ..Default::default() },
+            1,
+        ),
+        ("at a server that never reads", ServerOptions::default(), 0),
+    ];
+    for (what, options, requests) in routes {
+        let server = TestServer::start(Vec::new(), options);
+        let mut setup = if what.contains("SOCKS5") {
+            through(socks5(&server, None))
