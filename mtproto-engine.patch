+        let (handle, checked, took) = check(&engine, &collector, route(&server));
+        assert!(checked.answered, "{what}: {checked:?}");
+        assert_eq!((checked.reason, checked.attempts), ("", 1), "{what}: {checked:?}");
+        assert!(0.0 <= checked.round_trip && checked.round_trip <= took, "{what}: {checked:?} in {took} s");
+        let (connections, req_pqs, ..) = progress(&server);
