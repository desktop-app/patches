+/// The device model an `initConnection` wrapper carries; None for a call sent without one.
+fn init_device_model(body: &[u8]) -> Option<Vec<u8>> {
+    let mut reader = Reader::new(body);
+    (reader.read_u32().ok()? == ids::INVOKE_WITH_LAYER).then_some(())?;
+    reader.read_i32().ok()?;
+    (reader.read_u32().ok()? == INIT_CONNECTION).then_some(())?;
+    reader.read_i32().ok()?;
+    reader.read_i32().ok()?;
+    Some(reader.read_bytes().ok()?.to_vec())
+}
+
+impl Harness {
+    /// The calls that go out, each with its msg_id and the body as sent.
+    fn flush_call_bodies(&mut self) -> Vec<(i64, Vec<u8>)> {
+        let mut calls = Vec::new();
+        for _ in 0..10 {
+            self.advance(0.002);
+            let _ = self.client.handle_timeout(self.now);
+            if let Some(transmit) = self.client.poll_transmit(self.now, &mut self.rng) {
+                let packet = self.server.decode(&transmit.data);
+                calls.extend(
+                    packet
+                        .messages
+                        .into_iter()
+                        .filter(|message| unwrap_call(&message.body).1.is_some())
+                        .map(|message| (message.msg_id, message.body)),
+                );
+            }
+        }
+        calls
+    }
+}
