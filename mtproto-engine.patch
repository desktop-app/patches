+    fn a_new_engine_connects_a_new_session_at_once() {
+        use std::sync::Arc;
+        use std::time::{Duration, Instant};
+
+        use mtproto_core::auth_key::AuthKey;
+        use mtproto_core::rpc::SessionRole;
+        use mtproto_core::session::ServerSalt;
+
+        use crate::{
+            AuthKeyMaterial, DcAddress, Engine, EngineCallbacks, EngineConfig, EngineEvent, SessionHandle, SessionSetup,
+        };
+
+        struct Ignored;
+        impl EngineCallbacks for Ignored {
+            fn on_event(&self, _session: SessionHandle, _event: EngineEvent) {}
+        }
+        let listener = std::net::TcpListener::bind("127.0.0.1:0").unwrap();
+        listener.set_nonblocking(true).unwrap();
+        let port = listener.local_addr().unwrap().port();
+        let engine =
+            Engine::new(EngineConfig { worker_threads: 1, ..EngineConfig::default() }, Arc::new(Ignored)).unwrap();
+        let unix = unix_seconds();
+        let address = DcAddress { host: "127.0.0.1".into(), port, secret: None };
+        let mut setup = SessionSetup::new(2, SessionRole::Main, vec![address]);
+        setup.auth_key = Some(AuthKeyMaterial {
+            key: AuthKey::new([7u8; 256]),
+            salts: vec![ServerSalt { salt: 1, valid_since: unix - 60.0, valid_until: unix + 3600.0 }],
+            init_hash: None,
+        });
+        let started = Instant::now();
+        engine.create_session(setup);
+        let connected = loop {
+            match listener.accept() {
+                Ok(_) => break true,
+                Err(error)
+                    if error.kind() == std::io::ErrorKind::WouldBlock && started.elapsed() < Duration::from_secs(5) =>
+                {
+                    std::thread::sleep(Duration::from_millis(5));
+                }
+                Err(_) => break false,
+            }
+        };
+        let waited = started.elapsed();
+        engine.shutdown();
+        assert!(connected, "no connection {waited:?} after the session was made");
+    }
 }
