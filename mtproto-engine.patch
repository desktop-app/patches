+#[test]
+fn a_move_to_the_media_class_and_back_takes_the_offered_regular_key_again() {
+    for apart in [false, true] {
+        let server = server();
+        let collector = Arc::new(Collector::default());
+        let engine = engine(&collector);
+        let worker = |obfuscation_dc_id: i16| {
+            let mut worker = setup(&server, Some(perm()), pfs(86_400));
+            worker.role = SessionRole::Worker { requires_auth_token: false };
+            worker.keep_connected = true;
+            worker.idle_disconnect_after = None;
+            worker.obfuscation_dc_id = obfuscation_dc_id;
+            worker
+        };
+        let media_maker = engine.create_session(worker(-10_002));
+        let session = engine.create_session(worker(10_002));
+        engine.send(media_maker, request(1));
+        engine.send(session, request(2));
+        assert!(collector.wait_completed(media_maker, 1) && collector.wait_completed(session, 2));
+        let media = collector.bound_key(media_maker);
+        let regular = collector.bound_key(session);
+        let (media_id, regular_id) = (media.material.key.id() as i64, regular.material.key.id() as i64);
+        let handshakes = server.with_stats(|stats| stats.handshakes);
+        let wait = || {
+            if apart {
+                std::thread::sleep(Duration::from_millis(200));
+            }
+        };
+
+        engine.set_paused(session, true);
+        engine.send(session, request(3));
+        engine.set_obfuscation_dc_id(session, -10_002);
+        engine.offer_temporary_key(session, media);
+        wait();
+        engine.set_obfuscation_dc_id(session, 10_002);
+        engine.offer_temporary_key(session, regular);
+        wait();
+        engine.set_paused(session, false);
+        assert!(collector.wait_completed(session, 3), "apart {apart}: events {:?}", collector.of(session));
+        let in_use = collector.in_use(session);
+        let (made, ran) = server.with_stats(|stats| (stats.handshakes, stats.executed_with_key.clone()));
+        engine.shutdown();
+        let call3: Vec<i64> = ran.iter().filter(|(tag, _)| *tag == 3).map(|(_, key)| *key as i64).collect();
+        assert_eq!(in_use[1..], [(media_id, true), (regular_id, true)], "apart {apart}: keys in use {in_use:x?}");
+        assert_eq!(made, handshakes, "apart {apart}: a key was made instead of taking the Regular key again");
+        assert_eq!(call3, [regular_id], "apart {apart}: call 3 ran other than once under the Regular key");
+    }
+}
