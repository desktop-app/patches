+            std::mem::size_of::<TCP_INFO_v0>() as u32,
+            &mut returned,
+            std::ptr::null_mut(),
+            None,
+        )
+    };
+    let needed = std::mem::offset_of!(TCP_INFO_v0, BytesInFlight) + std::mem::size_of::<u32>();
+    (result == 0 && returned as usize >= needed).then_some(info.BytesInFlight as usize)
