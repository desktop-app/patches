+#[test]
+fn a_question_repeats_while_the_query_stays_unanswered() {
+    let mut h = Harness::new();
+    let lost = burst_with_one_lost(&mut h, 1);
+    for round in 0..3 {
+        let packets = live(&mut h, ANSWER_WAIT + 1.0);
+        let asked = state_requests(&packets);
+        assert_eq!(asked.len(), 1, "round {round}: {asked:x?}");
+        assert_eq!(asked[0].1, vec![lost.0]);
+        h.deliver(vec![Outgoing::Service(msgs_state_info(asked[0].0, &[3]))]).unwrap();
+        assert_eq!(copies(&live(&mut h, 0.5), 1), vec![lost], "round {round}: again under its msg_id");
+    }
+}
+
+#[test]
+fn a_query_the_server_received_without_answering_here_goes_again_under_its_msg_id_once() {
+    let mut h = Harness::new();
+    let lost = burst_with_one_lost(&mut h, 1);
+    let asked = state_requests(&live(&mut h, ANSWER_WAIT + 1.0));
+    h.deliver(vec![Outgoing::Service(msgs_state_info(asked[0].0, &[4 | 32 | 64]))]).unwrap();
+    assert!(h.events().iter().any(|event| matches!(event, SessionEvent::Acknowledged { id: QueryId(1) })));
+    let again = live(&mut h, 0.5);
+    assert_eq!(copies(&again, 1), vec![lost], "one copy under its msg_id fetches the answer");
+    h.deliver(vec![Outgoing::Content(rpc_result(lost.0, &[7, 0, 0, 0]))]).unwrap();
+    assert_eq!(results_for(&h.events(), QueryId(1)), 1);
+    let later = live(&mut h, 3.0 * ANSWER_WAIT);
+    assert!(copies(&later, 1).is_empty() && state_requests(&later).is_empty());
+}
+
+/// Received and still running at the server (+32 without +64), or received and not started (4 alone, as
+/// Telegram's servers say of a query waiting its turn): it is asked about once per wait and never goes
+/// again, then its answer completes it once.
+#[test]
+fn a_query_the_server_runs_is_asked_about_once_per_wait_and_never_goes_again() {
+    let mut h = Harness::new();
+    let lost = burst_with_one_lost(&mut h, 1);
+    for (round, state) in [4 | RUNNING, 4, 4 | 8 | RUNNING, 4 | RUNNING].into_iter().enumerate() {
+        let packets = live(&mut h, ANSWER_WAIT + 1.0);
+        let asked = state_requests(&packets);
+        assert_eq!(asked.len(), 1, "round {round}: one question per wait: {asked:x?}");
+        assert_eq!(asked[0].1, vec![lost.0], "round {round}");
+        assert!(copies(&packets, 1).is_empty(), "round {round}: the server has it, it never goes again");
+        h.deliver(vec![Outgoing::Service(msgs_state_info(asked[0].0, &[state]))]).unwrap();
+    }
+    assert!(copies(&live(&mut h, 1.0), 1).is_empty());
+    h.deliver(vec![Outgoing::Content(rpc_result(lost.0, &[7, 0, 0, 0]))]).unwrap();
+    let events = h.events();
+    assert_eq!(results_for(&events, QueryId(1)), 1);
+    assert_eq!(terminal_events(&events, QueryId(1)), 1);
+    let later = live(&mut h, 3.0 * ANSWER_WAIT);
+    assert!(copies(&later, 1).is_empty() && state_requests(&later).is_empty(), "an answered query is done");
+}
+
+/// The server acknowledged the query and then its answer was lost: native's `checkSentRequests` asks
+/// about every request still without an answer, acknowledged or not, and so does the session; the answer
+/// the server made is fetched by a copy under the query's msg_id.
+#[test]
+fn an_acknowledged_query_whose_answer_was_lost_is_asked_about_and_fetched_under_its_msg_id() {
+    let mut h = Harness::new();
+    h.session.send(QueryId(1), query_body(1), QueryOptions::default(), h.now);
+    let packet = h.flush().unwrap();
+    let sent = copies(std::slice::from_ref(&packet), 1)[0];
+    h.answer_pings(&packet);
+    h.deliver(vec![Outgoing::Service(msgs_ack(&[sent.0]))]).unwrap();
+    let packets = live(&mut h, ANSWER_WAIT + 1.0);
+    let asked = state_requests(&packets);
+    assert_eq!(asked.len(), 1, "acknowledged and unanswered, it is asked about after the wait: {asked:x?}");
+    assert_eq!(asked[0].1, vec![sent.0]);
+    assert!(copies(&packets, 1).is_empty(), "nothing goes again before the server says what it has");
+    h.deliver(vec![Outgoing::Service(msgs_state_info(asked[0].0, &[4 | 8 | RUNNING | ANSWERED]))]).unwrap();
+    assert_eq!(copies(&live(&mut h, 0.5), 1), vec![sent], "the answer is fetched under its msg_id and seq_no");
+    h.deliver(vec![Outgoing::Content(rpc_result(sent.0, &[7, 0, 0, 0]))]).unwrap();
+    let events = h.events();
+    assert_eq!(results_for(&events, QueryId(1)), 1);
+    assert_eq!(terminal_events(&events, QueryId(1)), 1);
+}
+
+/// The server side of query 1, which it ran under the msg_ids in `ran` and whose answer it keeps: it
+/// answers pings and other queries at once, a state request about query 1 with `state` (none while
+/// `state` is None), a copy under a msg_id it ran with the answer from what it has, losing the first
+/// `lose` of those answers on the way, and runs the query again under a msg_id it never saw.
+struct Holder {
+    ran: Vec<i64>,
+    lose: usize,
+    state: Option<u8>,
+}
+
+impl Holder {
+    fn replies(&mut self, packet: &DecodedPacket) -> Vec<Outgoing> {
+        let mut replies = Vec::new();
+        for message in &packet.messages {
+            match query_tag(&message.body) {
+                Some(1) => {
+                    if !self.ran.contains(&message.msg_id) {
+                        self.ran.push(message.msg_id);
+                    }
+                    if self.lose > 0 {
+                        self.lose -= 1;
+                    } else {
+                        replies.push(Outgoing::Content(rpc_result(message.msg_id, &[7, 0, 0, 0])));
+                    }
+                }
+                Some(_) => replies.push(Outgoing::Content(rpc_result(message.msg_id, &[1, 0, 0, 0]))),
+                None if message.constructor() == ids::MSGS_STATE_REQ => {
+                    if let Some(state) = self.state {
+                        let info: Vec<u8> = read_vector_after_constructor(&message.body)
+                            .iter()
+                            .map(|id| if self.ran.contains(id) { state } else { 2 })
+                            .collect();
+                        replies.push(Outgoing::Service(msgs_state_info(message.msg_id, &info)));
+                    }
+                }
+                None => {}
+            }
+        }
+        replies
+    }
+}
+
+/// `live` with `holder` as the server: it answers each packet as it arrives.
+fn serve(h: &mut Harness, seconds: f64, holder: &mut Holder) -> Vec<DecodedPacket> {
+    let mut packets = Vec::new();
+    let until = h.now.mono + seconds;
+    while h.now.mono < until {
+        h.advance(0.25);
+        h.session.handle_timeout(h.now).expect("the link stays up");
+        for packet in h.flush_all() {
+            h.answer_pings(&packet);
+            let replies = holder.replies(&packet);
+            if !replies.is_empty() {
+                h.deliver(replies).unwrap();
+            }
+            packets.push(packet);
+        }
+    }
+    packets
+}
+
+/// The finite losses of G1: the server ran the query once and keeps its answer, which went elsewhere;
+/// the answer to the first fetch is lost, and the connection closes with the next fetch queued, before
+/// it goes out. Other queries are answered before and after, pings all along. The query is asked about
+/// again after each, on the new connection too, and completes once, every copy under the msg_id the
+/// server ran it under.
+#[test]
+fn a_query_whose_answer_the_server_keeps_completes_once_through_a_lost_fetch_and_a_reconnect() {
+    let mut h = Harness::new();
+    let lost = burst_with_one_lost(&mut h, 1);
+    let mut holder = Holder { ran: vec![lost.0], lose: 1, state: Some(4 | RUNNING | ANSWERED) };
+    let mut packets = serve(&mut h, ANSWER_WAIT + 1.0, &mut holder);
+    assert_eq!(copies(&packets, 1), vec![lost], "the first fetch went, under its msg_id");
+    assert_eq!(holder.lose, 0, "and its answer was lost");
+    holder.state = None;
+    let asked = state_requests(&serve(&mut h, ANSWER_WAIT + 1.0, &mut holder));
+    assert_eq!(asked.len(), 1, "asked about again after the wait from the lost fetch: {asked:x?}");
+    h.deliver(vec![Outgoing::Service(msgs_state_info(asked[0].0, &[4 | RUNNING | ANSWERED]))]).unwrap();
+    h.session.connection_closed();
+    h.advance(1.0);
+    h.session.connection_opened(h.now);
+    h.session.send(QueryId(9), query_body(9), QueryOptions::default(), h.now);
+    holder.state = Some(4 | RUNNING | ANSWERED);
+    let after = serve(&mut h, 2.0 * ANSWER_WAIT, &mut holder);
+    assert!(
+        state_requests(&after).iter().any(|(_, ids)| ids == &vec![lost.0]),
+        "asked about on the new connection, though the server acknowledged it"
+    );
+    packets.extend(after);
+    let events = h.events();
+    assert_eq!(results_for(&events, QueryId(1)), 1, "completed once");
+    assert_eq!(terminal_events(&events, QueryId(1)), 1);
+    assert_eq!(results_for(&events, QueryId(9)), 1, "the link answered other queries meanwhile");
+    assert!(copies(&packets, 1).iter().all(|copy| *copy == lost), "every copy under its msg_id and seq_no");
+    assert_eq!(holder.ran, vec![lost.0], "the server ran it once");
+    assert!(!h.session.contains(QueryId(1)));
+}
+
+/// The answer to the fetch is lost while the connection stays up: the query is asked about again after
+/// the wait and fetched again, never sent under a new msg_id.
+#[test]
+fn a_fetch_whose_answer_was_lost_is_made_again_after_the_wait() {
+    let mut h = Harness::new();
+    let lost = burst_with_one_lost(&mut h, 1);
+    let mut holder = Holder { ran: vec![lost.0], lose: 1, state: Some(4 | RUNNING | ANSWERED) };
+    let packets = serve(&mut h, 3.0 * ANSWER_WAIT, &mut holder);
+    let events = h.events();
+    assert_eq!(copies(&packets, 1), vec![lost, lost], "two fetches, the second after the first's answer was lost");
+    assert!(state_requests(&packets).len() >= 2);
+    assert_eq!(results_for(&events, QueryId(1)), 1);
+    assert_eq!(terminal_events(&events, QueryId(1)), 1);
+    assert_eq!(holder.ran, vec![lost.0]);
+}
+
+/// The server ran the query, its acknowledgement and answer were lost, and pongs keep the link up. Past
+/// `RETRANSMIT_WINDOW` a current state reply says "nothing known" (1): the server may have run it and
+/// forgotten. It must not go again under a new msg_id, which would run it a second time, and it cannot go
+/// under its own: it fails once as possibly run, with no further traffic about it.
+#[test]
+fn past_the_retransmit_window_a_query_the_server_forgot_fails_once_and_never_gets_a_new_msg_id() {
+    let mut h = Harness::new();
+    h.session.send(QueryId(1), query_body(1), QueryOptions::default(), h.now);
+    let packet = h.flush().unwrap();
+    let original = copies(std::slice::from_ref(&packet), 1)[0];
+    h.answer_pings(&packet);
+    let start = h.now.mono;
+    let mut ran = vec![original.0];
+    let mut questions = 0;
+    let mut replied = false;
+    while h.now.mono - start < RETRANSMIT_WINDOW + 4.0 * ANSWER_WAIT {
+        let packets = live(&mut h, 1.0);
+        for (msg_id, _) in copies(&packets, 1) {
+            if !ran.contains(&msg_id) {
+                ran.push(msg_id);
+            }
+        }
+        let asked = state_requests(&packets);
+        questions += asked.len();
+        if !replied
+            && h.now.mono - start > RETRANSMIT_WINDOW
+            && let Some((request, ids)) = asked.last()
+        {
+            h.deliver(vec![Outgoing::Service(msgs_state_info(*request, &vec![1; ids.len()]))]).unwrap();
+            replied = true;
+        }
+    }
+    assert!(replied && questions >= 5, "asked about while it stayed unanswered: {questions}");
+    assert_eq!(ran, vec![original.0], "no copy under a new msg_id: the server ran it once");
+    let events = h.events();
+    assert_eq!(forgotten(&events, QueryId(1)), 1, "{events:?}");
+    assert_eq!(terminal_events(&events, QueryId(1)), 1, "one terminal event, of the kind no host retries");
+    assert!(!h.session.contains(QueryId(1)));
+    let later = live(&mut h, 3.0 * ANSWER_WAIT);
+    assert!(copies(&later, 1).is_empty() && state_requests(&later).is_empty(), "nothing more about it");
+}
+
+/// The control of the case above: the first copy never reached the server, which past the window says
+/// "not received" (2). A new msg_id is safe then: the query runs once, under it, and completes once.
+#[test]
+fn past_the_retransmit_window_a_query_the_server_never_received_runs_once_under_a_new_msg_id() {
+    let mut h = Harness::new();
+    h.session.send(QueryId(1), query_body(1), QueryOptions::default(), h.now);
+    let packet = h.flush().unwrap();
+    let original = copies(std::slice::from_ref(&packet), 1)[0];
+    h.answer_pings(&packet);
+    let start = h.now.mono;
+    let mut ran: Vec<i64> = Vec::new();
+    let mut replied = false;
+    while h.now.mono - start < RETRANSMIT_WINDOW + 4.0 * ANSWER_WAIT {
+        let packets = live(&mut h, 1.0);
+        for (msg_id, _) in copies(&packets, 1) {
+            if !ran.contains(&msg_id) {
+                ran.push(msg_id);
+                h.deliver(vec![Outgoing::Content(rpc_result(msg_id, &[7, 0, 0, 0]))]).unwrap();
+            }
+        }
+        if !replied
+            && h.now.mono - start > RETRANSMIT_WINDOW
+            && let Some((request, ids)) = state_requests(&packets).last()
+        {
+            h.deliver(vec![Outgoing::Service(msgs_state_info(*request, &vec![2; ids.len()]))]).unwrap();
+            replied = true;
+        }
+    }
+    assert!(replied);
+    assert_eq!(ran.len(), 1, "the server ran it once: {ran:x?}");
+    assert_ne!(ran[0], original.0, "under a new msg_id");
+    let events = h.events();
+    assert_eq!(results_for(&events, QueryId(1)), 1);
+    assert_eq!(terminal_events(&events, QueryId(1)), 1);
+}
+
+/// "Nothing known" within the window: the query goes again under its msg_id, and the server refuses that
+/// copy. Whatever the state reply after that says, "nothing known" again or "not received", the query may
+/// have run and been forgotten: it fails once as possibly run and never goes under a new msg_id.
+#[test]
+fn a_query_the_server_forgot_whose_copy_it_refused_fails_once_and_never_gets_a_new_msg_id() {
+    for after in [1u8, 2] {
+        let mut h = Harness::new();
+        let lost = burst_with_one_lost(&mut h, 1);
+        let asked = state_requests(&live(&mut h, ANSWER_WAIT + 1.0));
+        h.deliver(vec![Outgoing::Service(msgs_state_info(asked[0].0, &[1]))]).unwrap();
+        let packets = live(&mut h, 0.5);
+        assert_eq!(copies(&packets, 1), vec![lost], "{after}: within the window, again under its msg_id");
+        let carrier = packets.iter().find(|packet| !copies(std::slice::from_ref(*packet), 1).is_empty()).unwrap();
+        let refusal = bad_msg_notification(carrier.header.msg_id, carrier.header.seq_no, 20);
+        h.deliver(vec![Outgoing::Service(refusal)]).unwrap();
+        let packets = live(&mut h, 1.0);
+        assert!(copies(&packets, 1).is_empty(), "{after}: a refused copy is not sent again blindly");
+        let question = state_requests(&packets);
+        assert!(question.iter().any(|(_, ids)| ids.contains(&lost.0)), "{after}: asked about: {question:x?}");
+        let (request, ids) = question.last().unwrap();
+        let info: Vec<u8> = ids.iter().map(|id| if *id == lost.0 { after } else { 2 }).collect();
+        h.deliver(vec![Outgoing::Service(msgs_state_info(*request, &info))]).unwrap();
+        let later = live(&mut h, 2.0 * ANSWER_WAIT);
+        assert!(copies(&later, 1).is_empty(), "{after}: never under a new msg_id");
+        let events = h.events();
+        assert_eq!(forgotten(&events, QueryId(1)), 1, "{after}: {events:?}");
+        assert_eq!(terminal_events(&events, QueryId(1)), 1, "{after}");
+    }
+}
