+            in_flight += usize::from(kernel_send_queue(&observed).is_some_and(|queued| queued > 0));
+        }
+        writer.join().unwrap().unwrap();
+        assert_eq!(reader.join().unwrap(), TOTAL);
+        assert!(in_flight > 0, "no bytes in flight in {samples} readings while {TOTAL} bytes crossed");
