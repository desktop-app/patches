+/// Call 10 is still unanswered when a class change makes the temporary key go: it fails as
+/// `TEMP_KEY_ROTATED`, whatever the host's dependency flag says.
+fn fail_call_10_by_a_key_change(engine: &Engine, collector: &Collector, session: SessionHandle, surface: bool) {
+    engine.send(session, host_request(1, 1, None, surface));
+    assert!(collector.wait_completed(session, 1));
+    engine.send(session, host_request(10, TAG_NEVER, None, surface));
+    std::thread::sleep(Duration::from_millis(500));
+    engine.set_obfuscation_dc_id(session, -2);
+    assert!(collector.wait_failures(session, 10, 1), "events {:?}", collector.of(session));
+    assert_eq!(collector.failures(session, 10), [(500, "TEMP_KEY_ROTATED".to_string())]);
+}
