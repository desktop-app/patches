+/// The resets and updates among `events`, in their order: an update as its first word.
+fn resets_and_updates(events: Vec<RpcEvent>) -> Vec<(Option<UpdatesResetReason>, Vec<u8>)> {
+    events
+        .into_iter()
+        .filter_map(|event| match event {
+            RpcEvent::UpdatesReset { reason, notice } => Some((Some(reason), notice)),
+            RpcEvent::Update { body } => Some((None, body[..4].to_vec())),
+            _ => None,
+        })
+        .collect()
+}
+
+#[test]
+fn updates_reset_says_why() {
+    let mut h = Harness::new(SessionRole::Main, Some("h1"));
+    h.send(1, RequestFlags::default());
+    let calls = h.flush_calls();
+    let mut reasons = Vec::new();
+
+    let notice = new_session_created(calls[0].0, 1, 5);
+    assert_eq!(notice.len(), 28);
+    h.reply(vec![Outgoing::Service(notice.clone())]);
+    let seen = resets_and_updates(h.events());
+    assert_eq!(seen, vec![(Some(UpdatesResetReason::ServerSession), notice)], "the server's own message");
+    reasons.extend(seen.into_iter().filter_map(|(reason, _)| reason));
+
+    let old = h.server.next_msg_id(false);
+    for _ in 0..2001 {
+        h.reply(vec![Outgoing::Content(update(0x0101_0101, &[0; 4]))]);
+    }
+    h.events();
+    let fresh = h.server.next_msg_id(false);
+    let packet = h.server.seal(fresh, 0, &container(&[(old, 1, update(0x74ae4240, &[0; 4]))]));
+    h.client.handle_packet(&packet, h.now, &mut h.rng).unwrap();
+    let seen = resets_and_updates(h.events());
+    assert_eq!(seen, vec![(Some(UpdatesResetReason::UpdatesLost), Vec::new())], "a dropped update");
+    reasons.extend(seen.into_iter().filter_map(|(reason, _)| reason));
+
+    h.client.reset_session(h.now, &mut h.rng);
+    let seen = resets_and_updates(h.events());
+    assert_eq!(seen, vec![(Some(UpdatesResetReason::LocalSession), Vec::new())], "a new session of our own");
+    reasons.extend(seen.into_iter().filter_map(|(reason, _)| reason));
+
+    h.server.session_id = h.client.session().session_id();
+    h.reply(vec![Outgoing::Content(update(0xe317af7e, &[]))]);
+    let seen = resets_and_updates(h.events());
+    assert_eq!(
+        seen,
+        vec![(Some(UpdatesResetReason::UpdatesTooLong), Vec::new()), (None, 0xe317af7eu32.to_le_bytes().to_vec())],
+        "the reset comes directly before its updatesTooLong"
+    );
