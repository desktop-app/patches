+/// The server ran a call whose acknowledgement and answer were lost, and past the retransmit window it says
+/// it knows nothing of its msg_id. The call fails to the host once with `PROTOCOL_ERROR_QUERY_FORGOTTEN` and
+/// code 0, which is no server error a host retries, never as a retry decision, and it never goes again as a
+/// new message, which would run it a second time.
+#[test]
+fn a_call_the_server_forgot_fails_once_with_code_0_and_never_runs_again() {
+    for flags in [RequestFlags::default(), RequestFlags { delegate_retry_decisions: true, ..RequestFlags::default() }] {
+        let mut h = Harness::new(SessionRole::Main, Some("h1"));
+        h.send(1, flags);
+        let calls = h.flush_calls();
+        assert_eq!(calls.len(), 1);
+        let start = h.now.mono;
+        let mut ran = vec![calls[0].0];
+        let mut surfaced = Vec::new();
+        let mut questions = 0;
+        let mut replied = false;
+        for _ in 0..400 {
+            h.advance(1.0);
+            let _ = h.client.handle_timeout(h.now);
+            while let Some(transmit) = h.client.poll_transmit(h.now, &mut h.rng) {
+                let packet = h.server.decode(&transmit.data);
+                let mut replies = Vec::new();
+                for message in &packet.messages {
+                    if unwrap_call(&message.body).1.is_some() && !ran.contains(&message.msg_id) {
+                        ran.push(message.msg_id);
+                    }
+                    if message.constructor() == ids::PING_DELAY_DISCONNECT || message.constructor() == ids::PING {
+                        let ping_id = i64::from_le_bytes(message.body[4..12].try_into().unwrap());
+                        replies.push(Outgoing::Service(pong(message.msg_id, ping_id)));
+                    }
+                    if message.constructor() == ids::MSGS_STATE_REQ {
+                        questions += 1;
+                        if !replied && h.now.mono - start > crate::session::RETRANSMIT_WINDOW {
+                            let asked = read_vector_after_constructor(&message.body);
+                            replies.push(Outgoing::Service(msgs_state_info(message.msg_id, &vec![1; asked.len()])));
+                            replied = true;
+                        }
+                    }
+                }
+                if !replies.is_empty() {
+                    h.reply(replies);
+                }
+            }
+            for event in h.events() {
+                match event {
+                    RpcEvent::Failed { code, message, .. } => surfaced.push((code, message)),
+                    RpcEvent::RetryDecisionRequired { id, message, .. } => {
+                        surfaced.push((-1, format!("decision:{message}")));
+                        h.client.decide_retry(id, true, h.now);
+                    }
+                    RpcEvent::Completed { .. } => surfaced.push((-1, "completed".into())),
+                    _ => {}
+                }
+            }
+        }
+        assert!(replied && questions >= 5, "asked about while unanswered: {questions}");
+        assert_eq!(ran, vec![calls[0].0], "only the copy the server ran ever went");
+        assert_eq!(surfaced, vec![(0, crate::session::QUERY_FORGOTTEN.to_string())]);
+    }
+}
