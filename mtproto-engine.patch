+/// `req_pq_multi` with `nonce` as a plain message, its msg id from `server_time`: the first packet of a key
+/// handshake, which a check of a route sends alone.
+pub(crate) fn plain_req_pq_packet(nonce: [u8; 16], server_time: f64) -> Vec<u8> {
+    let mut writer = Writer::with_capacity(24);
+    ReqPqMulti { nonce }.write_to(&mut writer);
+    let msg_id = msg_id_for_time(server_time) & !3;
+    encode_plain_message(msg_id, &writer.into_inner())
+}
