+        let backoff = (gate.runtime.failures, gate.runtime.next_attempt_at);
+        gate.runtime.set_proxy_addresses("proxy.invalid".into(), texts(&["192.0.2.4", "192.0.2.3", "192.0.2.5"]), now);
