+        gate.runtime.close_connection(gate.poll.registry(), now, true);
+        let backoff = (gate.runtime.failures, gate.runtime.next_attempt_at);
+        assert_eq!(backoff.0, 2);
+        assert!(backoff.1 > now.mono);
+        gate.runtime.set_proxy_addresses("proxy.invalid".into(), texts(&["192.0.2.2", "192.0.2.3"]), now);
+        assert_eq!((gate.runtime.failures, gate.runtime.next_attempt_at), backoff, "a new list reset the backoff");
+        let next = |gate: &mut Gate, now: Now| ready_address(gate.runtime.pick_address_at(0, &mut NoLookups, now));
+        let at = |last: u8| SocketAddr::new(IpAddr::V4(Ipv4Addr::new(192, 0, 2, last)), port);
