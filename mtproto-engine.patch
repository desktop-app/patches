+#[test]
+fn new_session_created_hands_over_the_message_as_received() {
+    let mut h = Harness::new();
+    h.session.send(QueryId(1), query_body(1), QueryOptions::default(), h.now);
+    let packet = h.flush().unwrap();
+    let query = h.sent_query(&packet, 1);
+
+    // gzip-packed in a container, with a new salt and a query older than the new session.
+    let packed = new_session_created(packet.header.msg_id + 4, 41, 4242);
+    assert_eq!(packed.len(), 28);
+    h.deliver(vec![Outgoing::Content(update(0x0101_0101, &[0; 4])), Outgoing::Service(gzip_packed(&packed))]).unwrap();
+    let events = h.events();
+    assert_eq!(reset_notices(&events), vec![packed], "the bytes inside the gzip");
+    assert!(events.iter().any(|event| matches!(event, SessionEvent::SaltsUpdated { .. })));
+    let packet = h.flush().unwrap();
+    assert_eq!(packet.header.salt, 4242, "the salt it carried is taken");
+    let resent = h.sent_query(&packet, 1);
+    assert!(resent > query, "the older query goes again");
+
+    let contained = new_session_created(resent, 42, 4242);
+    h.deliver(vec![Outgoing::Content(update(0x0101_0101, &[0; 4])), Outgoing::Service(contained.clone())]).unwrap();
+    assert_eq!(reset_notices(&h.events()), vec![contained], "a container's child");
+    let alone = new_session_created(resent, 43, 4242);
+    h.deliver(vec![Outgoing::Service(alone.clone())]).unwrap();
+    assert_eq!(reset_notices(&h.events()), vec![alone], "a message of its own");
+    let packed_alone = new_session_created(resent, 44, 4242);
+    h.deliver(vec![Outgoing::Service(gzip_packed(&packed_alone))]).unwrap();
+    assert_eq!(reset_notices(&h.events()), vec![packed_alone], "gzip-packed alone");
+
+    h.deliver(vec![Outgoing::Service(new_session_created(resent, 41, 4242))]).unwrap();
+    assert!(reset_notices(&h.events()).is_empty(), "a new session already reported");
+    let repeated = h.server.encode(vec![Outgoing::Service(new_session_created(resent, 45, 4242))]);
+    h.session.handle_packet(&repeated, h.now, &mut h.rng).unwrap();
+    assert_eq!(reset_notices(&h.events()).len(), 1);
+    h.session.handle_packet(&repeated, h.now, &mut h.rng).unwrap();
+    assert!(reset_notices(&h.events()).is_empty(), "the same packet again");
+    assert!(h.flush_all().iter().all(|packet| packet.messages.iter().all(|m| query_tag(&m.body).is_none())));
