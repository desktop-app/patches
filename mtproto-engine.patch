+    let both = ServerOptions { http_proxy: Some(HttpProxyMode::Both), ..Default::default() };
+    let (plain, _) = plain();
+    let (padded, _) = padded();
+    let (fake_tls, _) = fake_tls();
+    let socks = ServerOptions { socks5: true, ..Default::default() };
+    let routes: Vec<(&str, ServerOptions, Route)> = vec![
+        ("direct", ServerOptions::default(), Box::new(direct)),
+        ("socks5", socks.clone(), Box::new(|server: &TestServer| through(socks5(server, None)))),
+        ("socks5 with credentials", socks, Box::new(move |server: &TestServer| through(socks5(server, credentials)))),
+        ("http", both.clone(), Box::new(|server: &TestServer| through(http(server, None)))),
+        (
+            "http with credentials",
+            secured(both),
+            Box::new(move |server: &TestServer| through(http(server, credentials))),
+        ),
+        (
+            "mtproxy",
