+    /// A refused admission is one failed connection: the backoff of a failure, then the next ask.
+    #[test]
+    fn a_refused_connection_counts_one_failure() {
+        let mut tcp = Sink::new();
+        let mut gate = Gate::new(gate_setup(vec![tcp.address()], Vec::new(), TransportPreference::Tcp), true);
+        gate.drive();
+        gate.admit(1, false);
+        assert_eq!(gate.runtime.failures, 1);
+        let retry_in = gate.runtime.next_attempt_at - gate.now().mono;
+        assert!((RESOLVE_RETRY_MIN..=RESOLVE_RETRY_MAX).contains(&retry_in), "retries in {retry_in} s");
+        gate.drive();
+        assert_eq!(gate.asked().len(), 1, "asked again before the backoff");
+        gate.drive_for(retry_in + 0.25, 0.25);
+        assert_eq!(gate.asked_for(RouteTransport::Tcp, tcp.port()), [1, 2]);
+        assert!(gate.runtime.connection.is_none());
+        assert_eq!(tcp.taken(), 0);
