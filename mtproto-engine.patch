+fn assert_refused(what: &str, checked: Checked, reasons: &[&str]) {
+    assert!(!checked.answered, "{what}: {checked:?}");
+    assert!(reasons.contains(&checked.reason), "{what}: {checked:?}, expected one of {reasons:?}");
+    assert_eq!(checked.round_trip, 0.0, "{what}: {checked:?}");
+}
