+/// A main session set up as a desktop host sets one up: TCP falling back to HTTP, HTTP on port 80
+/// unless the host gives HTTP addresses of its own.
+fn setup(key: &AuthKey, tcp: Vec<DcAddress>, http: Option<Vec<DcAddress>>) -> SessionSetup {
+    let mut setup = SessionSetup::new(2, SessionRole::Main, tcp);
+    setup.auth_key = Some(AuthKeyMaterial { key: key.clone(), salts: salts(), init_hash: None });
+    setup.transport = TransportPreference::Auto;
+    setup.http_port = Some(80);
+    setup.http_addresses = http;
+    setup
+}
