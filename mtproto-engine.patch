+//! A worker's lookups with only the blocking system lookup replaced, by a stand-in that holds each lookup until the
+//! test lets its name go. The rest is the engine's own: checks and sessions asking the worker's resolver for a name,
+//! its queue, the thread each lookup runs on and the room it keeps among `MAX_LOOKUPS`, the answer it posts back to
+//! the worker and who takes it.
+
+use std::collections::HashSet;
+use std::net::{Ipv4Addr, SocketAddr};
+use std::sync::{Arc, Condvar, Mutex, MutexGuard, PoisonError};
+use std::time::{Duration, Instant};
+
+use mtproto_core::rpc::{RequestFlags, RequestId, RpcEvent, RpcRequest, SessionRole};
+use mtproto_core::session::ServerSalt;
+use mtproto_testserver::{SERVER_SALT, ServerOptions, TestServer, call, random_key};
+
+use super::MAX_LOOKUPS;
+use crate::resolver::BlockingLookup;
+use crate::types::{
+    AuthKeyMaterial, DcAddress, EngineCallbacks, EngineConfig, EngineEvent, ProxyConfig, RouteCheckSetup,
+    SessionHandle, SessionSetup,
+};
+use crate::{Engine, unix_seconds};
+
+const WAIT: Duration = Duration::from_secs(20);
+/// The bound of a check that is to outlast every stall below.
+const PATIENT: f64 = 30.0;
+/// The bound of a check that is to expire while its lookup is held or queued.
+const BRIEF: f64 = 1.0;
+/// How long the worker is given to take what was posted to it, or to start what it should not.
+const SETTLE: Duration = Duration::from_millis(500);
+
+/// The system resolver's stand-in: each lookup is counted while it runs and held until its name is let go, then
+/// answers `127.0.0.1` at the port asked.
+#[derive(Default)]
+struct Lookups {
+    held: Mutex<Held>,
+    changed: Condvar,
+}
+
+#[derive(Default)]
+struct Held {
+    /// The names looked up, in the order their lookups started.
+    started: Vec<String>,
+    running: usize,
+    peak: usize,
+    released: HashSet<String>,
+    all_released: bool,
+}
+
+impl Lookups {
+    fn backend(self: &Arc<Self>) -> BlockingLookup {
+        let lookups = self.clone();
+        Arc::new(move |host: &str, port: u16| lookups.look_up(host, port))
+    }
+
+    fn look_up(&self, host: &str, port: u16) -> Vec<SocketAddr> {
+        let mut held = self.held.lock().unwrap_or_else(PoisonError::into_inner);
+        held.started.push(host.to_string());
+        held.running += 1;
+        held.peak = held.peak.max(held.running);
+        self.changed.notify_all();
+        while !held.all_released && !held.released.contains(host) {
+            held = self.changed.wait(held).unwrap_or_else(PoisonError::into_inner);
+        }
+        held.running -= 1;
+        self.changed.notify_all();
+        vec![SocketAddr::from((Ipv4Addr::LOCALHOST, port))]
+    }
+
+    fn release(&self, names: &[String]) {
+        self.held.lock().unwrap_or_else(PoisonError::into_inner).released.extend(names.iter().cloned());
+        self.changed.notify_all();
+    }
+
+    fn release_all(&self) {
+        self.held.lock().unwrap_or_else(PoisonError::into_inner).all_released = true;
+        self.changed.notify_all();
+    }
+
+    fn held(&self) -> MutexGuard<'_, Held> {
+        self.held.lock().unwrap_or_else(PoisonError::into_inner)
+    }
+
+    fn wait(&self, predicate: impl Fn(&Held) -> bool) -> bool {
+        let deadline = Instant::now() + WAIT;
+        let mut held = self.held.lock().unwrap_or_else(PoisonError::into_inner);
+        while !predicate(&held) {
+            let now = Instant::now();
+            if now >= deadline {
+                return false;
+            }
+            held = self.changed.wait_timeout(held, deadline - now).unwrap_or_else(PoisonError::into_inner).0;
+        }
+        true
+    }
+}
+
+/// Lets every lookup go when a test ends, failed or not, so no stand-in thread stays blocked. The locks here and in
+/// `Collector` take a mutex a failed assertion poisoned as it is: a panic on an engine thread aborts the whole run.
+struct ReleaseAll(Arc<Lookups>);
+
+impl Drop for ReleaseAll {
+    fn drop(&mut self) {
+        self.0.release_all();
+    }
+}
