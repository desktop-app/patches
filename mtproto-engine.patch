+/// The host's panic callback with its context: replaced together, read together.
+struct PanicCallback {
+    context: ContextPointer,
+    callback: MTPanicCallback,
+}
+
+static PANIC_CALLBACK: Mutex<PanicCallback> =
+    Mutex::new(PanicCallback { context: ContextPointer(std::ptr::null_mut()), callback: None });
+
+/// The engine's panic reporter while the host has a panic callback; runs on the panicking thread.
+fn report_to_host(thread: &str, message: &str) {
+    let (context, callback) = {
+        let host = PANIC_CALLBACK.lock().unwrap_or_else(PoisonError::into_inner);
+        (host.context.0, host.callback)
+    };
+    if let Some(callback) = callback {
+        unsafe { callback(context, string_ref(thread), string_ref(message)) };
+    }
+}
+
+/// Panics of engine code, on the engine's threads or inside an `mt_*` call, go to `callback` with `context` for the
+/// whole process, on the panicking thread before the process ends; NULL stops them. A later call replaces both.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn mt_set_panic_callback(context: *mut c_void, callback: MTPanicCallback) {
+    let _engine = enter_engine_code();
+    let mut host = PANIC_CALLBACK.lock().unwrap_or_else(PoisonError::into_inner);
+    *host = PanicCallback { context: ContextPointer(context), callback };
+    // Still locked: calls on several threads leave the reporter in step with the callback stored last.
+    report_panics_to(callback.is_some().then_some(report_to_host));
+}
