+/// The engine does not know a host's route policy: a direct route with an `ee` address reads the bit at a refusal and
+/// takes the offset as an MTProxy route does.
+#[test]
+fn a_direct_ee_address_reads_the_bit_and_takes_the_offset() {
+    let key = random_key(7319);
+    let (secret, _) = fake_tls();
+    let options = ServerOptions {
+        secret: Some(secret.clone()),
+        tls_time_window: Some(WINDOW),
+        validate_msg_id_time: true,
+        ..Default::default()
+    };
+    let server = TestServer::start(vec![key.clone()], options);
+    let collector = Arc::new(Collector::default());
+    let engine = engine_with(&collector, None);
+    let address = DcAddress { host: "127.0.0.1".into(), port: server.address.port(), secret: Some(secret) };
+    let mut setup = keyed_setup(vec![address], &key);
+    setup.time_difference = SKEW;
+    let session = engine.create_session(setup);
+    engine.send(session, request(1, 1));
+    assert!(collector.wait(|events| !drops_in(events).is_empty()), "no drop came");
+    assert!(refusals(&server) > 0);
+    assert_flagged("direct, refused", &collector.drops(), &CLOSED);
+    assert!(!collector.connected());
+
+    engine.set_tls_hello_time_offset(session, Some(0.0));
+    let since = unix_seconds();
+    collector.wait_completed(1);
+    assert_says("the direct hello that got through", f64::from(*hello_times(&server).last().unwrap()), 0.0, since);
+    engine.shutdown();
+}
+
+/// A value that is no number is ignored, with nothing stored and with one stored alike; None clears.
+#[test]
+fn a_non_finite_offset_changes_nothing_and_none_clears() {
+    let mut rig = Established::start(7320);
+    let non_finite = [f64::NAN, f64::INFINITY, f64::NEG_INFINITY];
+    let since = unix_seconds();
+    for value in non_finite {
+        rig.engine.set_tls_hello_time_offset(rig.session, Some(value));
+    }
+    assert_says("non-finite with nothing stored", rig.reconnect(), 0.0, since);
+
+    rig.engine.set_tls_hello_time_offset(rig.session, Some(FORWARD));
+    for value in non_finite {
+        rig.engine.set_tls_hello_time_offset(rig.session, Some(value));
+    }
+    assert_says("non-finite with an offset stored", rig.reconnect(), FORWARD, since);
+
+    rig.engine.set_tls_hello_time_offset(rig.session, None);
+    assert_says("cleared", rig.reconnect(), 0.0, since);
+    assert_says("a msg id at the end", rig.call(), 0.0, since);
+    rig.assert_no_correction();
+    rig.finish();
+}
