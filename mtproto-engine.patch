+        assert!(live.until(|live| live.completions(1) == 1), "call 1 never completed: {:?}", live.failures(1));
+        assert_eq!(server.with_stats(|stats| stats.handshakes), handshakes, "the handshake went on");
+        assert_eq!(live.created_keys(), 0);
