new file mode 100644
index 0000000..1ab3c49
--- /dev/null
+++ b/crates/mtproto-engine/src/engine_thread.rs
@@ -0,0 +1,225 @@
+use std::cell::{Cell, OnceCell};
+use std::io;
+use std::marker::PhantomData;
+use std::panic::PanicHookInfo;
+use std::sync::{Mutex, Once, PoisonError};
+use std::thread::{Builder, JoinHandle};
+
+/// Starts one of the engine's threads. A panic on it ends the process, as the engine's own `panic = "abort"`
+/// profile does: in a host built with `panic = "unwind"` the thread would otherwise end alone and leave the engine
+/// without its worker or resolver, with requests that never complete. The whole thread runs as engine code: a panic
+/// on it goes to the reporter of [`report_panics_to`] under the name `builder` gave it.
+pub fn spawn(builder: Builder, body: impl FnOnce() + Send + 'static) -> io::Result<JoinHandle<()>> {
+    builder.spawn(move || {
+        let name = std::thread::current().name().unwrap_or_default().to_owned();
+        let _ = SCOPE.try_with(|scope| scope.thread.set(name));
+        let _engine = enter_engine_code();
+        // Kept until the abort: a payload whose drop panics would otherwise end only this thread.
+        let result = std::panic::catch_unwind(std::panic::AssertUnwindSafe(body));
+        if result.is_err() {
+            std::process::abort();
+        }
+    })
+}
+
+/// The engine code running on a thread: how many scopes of [`enter_engine_code`] are open on it, and its name if
+/// [`spawn`] started it.
+struct Scope {
+    depth: Cell<usize>,
+    thread: OnceCell<String>,
+}
+
+thread_local! {
+    static SCOPE: Scope = const { Scope { depth: Cell::new(0), thread: OnceCell::new() } };
+}
+
+/// Runs the calling thread as engine code until the returned guard is dropped, unwinding included: a panic on it
+/// until then goes to the reporter of [`report_panics_to`], under an empty thread name unless the engine started the
+/// thread. Each C entry point of the engine holds one for its whole body. Scopes nest; a nested one keeps the name.
+pub fn enter_engine_code() -> EngineCode {
+    let _ = SCOPE.try_with(|scope| scope.depth.set(scope.depth.get() + 1));
+    EngineCode(PhantomData)
+}
+
+/// An open scope of [`enter_engine_code`]. Not `Send`: it closes on the thread that opened it.
+#[must_use = "the thread leaves engine code when this is dropped"]
+pub struct EngineCode(PhantomData<*const ()>);
+
+impl Drop for EngineCode {
+    fn drop(&mut self) {
+        let _ = SCOPE.try_with(|scope| scope.depth.set(scope.depth.get() - 1));
+    }
+}
+
+/// The reporter of [`report_panics_to`].
+static REPORTER: Mutex<Option<fn(&str, &str)>> = Mutex::new(None);
+
+/// Installs the engine's panic hook once.
+static HOOK: Once = Once::new();
+
+/// Reports each panic of engine code, on a thread the engine started or in a scope of [`enter_engine_code`], to
+/// `report`; `None` stops the reports. `report` gets the name of the panicking thread, empty for a thread the engine
+/// did not start, and `<message> at <file>:<line>:<column>`. It is called on the panicking thread before any unwinding,
+/// and it may end the process itself; if it returns, the panic hook set before runs as it did and the panic goes on.
+/// Panics outside engine code, such as another Rust library's on a host thread, are not reported. Nothing changes until
+/// the first reporter installs the engine's panic hook in front of the one already set.
+pub fn report_panics_to(report: Option<fn(thread: &str, message: &str)>) {
+    *REPORTER.lock().unwrap_or_else(PoisonError::into_inner) = report;
+    if report.is_some() {
+        HOOK.call_once(|| {
+            let previous = std::panic::take_hook();
+            std::panic::set_hook(Box::new(move |info| {
+                report_engine_panic(info);
+                previous(info);
+            }));
+        });
+    }
+}
+
+/// Calls the reporter if the panicking thread runs engine code. A panic inside it needs no guard: std aborts on a panic
+/// inside a panic hook.
+fn report_engine_panic(info: &PanicHookInfo<'_>) {
+    let _ = SCOPE.try_with(|scope| {
+        if scope.depth.get() == 0 {
+            return;
+        }
+        let Some(report) = *REPORTER.lock().unwrap_or_else(PoisonError::into_inner) else {
+            return;
+        };
+        let message = info.payload_as_str().unwrap_or("Box<dyn Any>");
+        let message = match info.location() {
+            Some(location) => format!("{message} at {location}"),
+            None => message.to_owned(),
+        };
+        report(scope.thread.get().map_or("", String::as_str), &message);
+    });
+}
+
+#[cfg(test)]
+mod tests {
+    use std::process::{Command, ExitStatus};
+
+    const CHILD: &str = "MTPROTO_ENGINE_THREAD_PANIC_CHILD";
+
+    /// Re-runs this binary on `test` alone, with `CHILD` set to that name: the child runs `child` and exits zero if it
+    /// returns. Gives the child's exit status and stderr.
+    fn run_child(test: &str, child: impl FnOnce()) -> (ExitStatus, String) {
+        if std::env::var_os(CHILD).is_some_and(|name| name == test) {
+            child();
+            std::process::exit(0);
+        }
+        let output = Command::new(std::env::current_exe().unwrap())
+            .args(["--exact", test, "--nocapture"])
+            .env(CHILD, test)
+            .output()
+            .unwrap();
+        (output.status, String::from_utf8_lossy(&output.stderr).into_owned())
+    }
+
+    fn assert_aborted(status: ExitStatus, stderr: &str) {
+        #[cfg(unix)]
+        {
+            use std::os::unix::process::ExitStatusExt;
+            assert_eq!(status.signal(), Some(libc::SIGABRT), "{status:?}: {stderr}");
+        }
+        // std::process::abort is __fastfail: STATUS_STACK_BUFFER_OVERRUN, but an access violation on Windows 7.
+        #[cfg(windows)]
+        assert!(
+            [Some(0xC000_0409_u32 as i32), Some(0xC000_0005_u32 as i32)].contains(&status.code()),
+            "the child did not abort: {status:?}: {stderr}"
+        );
+    }
+
+    /// Re-runs this binary on `test` alone, with `CHILD` set to that name: the child runs `body` on an engine thread
+    /// and exits zero if it outlives the thread. Its stderr must hold `panicked`, and it must abort. Gives that stderr.
+    fn assert_child_aborts(test: &str, body: fn(), panicked: &str) -> String {
+        let (status, stderr) = run_child(test, || {
+            let thread = super::spawn(std::thread::Builder::new().name("mtproto-test".into()), body).unwrap();
+            // Not dropped: a payload that panics on drop would fail the child here, before its exit(0).
+            let _result = thread.join();
+            std::process::exit(0);
+        });
+        assert!(stderr.contains(panicked), "the child's thread did not panic: {stderr}");
+        assert_aborted(status, &stderr);
+        stderr
+    }
+
+    #[test]
+    fn a_panic_on_an_engine_thread_aborts_the_process() {
+        assert_child_aborts(
+            "engine_thread::tests::a_panic_on_an_engine_thread_aborts_the_process",
+            || panic!("engine thread panic"),
+            "engine thread panic",
+        );
+    }
+
+    struct PanicOnDrop;
+
+    impl Drop for PanicOnDrop {
+        fn drop(&mut self) {
+            panic!("payload drop");
+        }
+    }
+
+    #[test]
+    fn a_panic_payload_that_panics_on_drop_still_aborts_the_process() {
+        assert_child_aborts(
+            "engine_thread::tests::a_panic_payload_that_panics_on_drop_still_aborts_the_process",
+            || std::panic::panic_any(PanicOnDrop),
+            // The default hook prints no message for this payload, only where it panicked.
+            &format!("panicked at {}:", file!()),
+        );
+    }
+
+    fn print_report(thread: &str, message: &str) {
+        eprintln!("reported thread={thread} message={message}");
+    }
+
+    #[test]
+    fn a_panic_on_an_engine_thread_is_reported_with_its_thread_name_before_the_abort() {
+        let stderr = assert_child_aborts(
+            "engine_thread::tests::a_panic_on_an_engine_thread_is_reported_with_its_thread_name_before_the_abort",
+            || {
+                super::report_panics_to(Some(print_report));
+                panic!("engine thread panic");
+            },
+            // The hook set before still runs.
+            &format!("panicked at {}:", file!()),
+        );
+        let report = format!("reported thread=mtproto-test message=engine thread panic at {}:", file!());
+        assert!(stderr.contains(&report), "the panic was not reported: {stderr}");
+    }
+
+    /// As a C entry point of the engine does: a panic cannot unwind out of it, so it ends the process.
+    extern "C" fn engine_call() {
+        let _engine = super::enter_engine_code();
+        panic!("engine call panic");
+    }
+
+    #[test]
+    fn a_panic_inside_an_engine_call_is_reported_before_the_abort() {
+        let test = "engine_thread::tests::a_panic_inside_an_engine_call_is_reported_before_the_abort";
+        let (status, stderr) = run_child(test, || {
+            super::report_panics_to(Some(print_report));
+            // Unnamed, and not started by the engine.
+            let _ = std::thread::spawn(|| engine_call()).join();
+        });
+        let report = format!("reported thread= message=engine call panic at {}:", file!());
+        assert!(stderr.contains(&report), "the panic was not reported: {stderr}");
+        assert_aborted(status, &stderr);
+    }
