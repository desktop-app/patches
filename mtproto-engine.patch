+/// std's `Instant` (the performance counter) from one origin for the whole process, counted on from the
+/// wall clock at that origin. Like a boot epoch, that base keeps a zero time long past and a zero deadline
+/// due; later changes to the wall clock leave it alone.
+#[cfg(windows)]
+pub fn monotonic_seconds() -> f64 {
+    static ORIGIN: std::sync::OnceLock<(std::time::Instant, f64)> = std::sync::OnceLock::new();
+    let (origin, base) = ORIGIN.get_or_init(|| (std::time::Instant::now(), unix_seconds().max(1.0)));
+    base + origin.elapsed().as_secs_f64()
+}
+
 pub fn unix_seconds() -> f64 {
     SystemTime::now().duration_since(UNIX_EPOCH).map(|duration| duration.as_secs_f64()).unwrap_or(0.0)
 }
