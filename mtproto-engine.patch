+//! The endpoints a host gives a session. With its own HTTP addresses (`set_http_addresses`) HTTP goes
+//! there and nowhere else, at their own ports; each test runs the routes derived from the TCP
+//! addresses as its control, where the same listener does get HTTP. A host that holds a session
+//! paused while it replaces addresses, transport and environment gets no connection anywhere until it
+//! lets the session go, and then only to the latest ones, without a call running or completing twice.
+//! The same holds for a new proxy given while paused, and an HTTP proxy that refuses CONNECT carries Auto
+//! over forwarded HTTP to the host's HTTP addresses.
+
+use std::io::{Read, Write};
+use std::net::{Shutdown, SocketAddr, TcpListener, TcpStream};
+use std::sync::atomic::{AtomicUsize, Ordering};
+use std::sync::{Arc, Condvar, Mutex};
+use std::time::{Duration, Instant};
+
+use mtproto_engine::mtproto_core::auth_key::AuthKey;
+use mtproto_engine::mtproto_core::rpc::{ApiEnvironment, RequestFlags, RequestId, RpcEvent, RpcRequest, SessionRole};
+use mtproto_engine::mtproto_core::session::ServerSalt;
+use mtproto_engine::{
+    AuthKeyMaterial, DcAddress, DropReason, Engine, EngineCallbacks, EngineConfig, EngineEvent, ProxyConfig,
+    SessionHandle, SessionSetup, TransportPreference, unix_seconds,
+};
+use mtproto_testserver::*;
+
+#[path = "support/eventually.rs"]
+mod eventually;
+use eventually::eventually;
+
+const WAIT: Duration = Duration::from_secs(20);
+
+#[derive(Default)]
+struct Collector {
+    events: Mutex<Vec<(SessionHandle, EngineEvent)>>,
+    condvar: Condvar,
+}
+
+impl EngineCallbacks for Collector {
+    fn on_event(&self, session: SessionHandle, event: EngineEvent) {
+        self.events.lock().unwrap().push((session, event));
+        self.condvar.notify_all();
+    }
+
+    fn on_log(&self, _level: mtproto_engine::LogLevel, message: &str) {
+        if std::env::var_os("MTPROTO_TEST_LOG").is_some() {
+            eprintln!("LOG {message}");
+        }
+    }
+}
+
+impl Collector {
+    fn wait<F: Fn(&[(SessionHandle, EngineEvent)]) -> bool>(&self, timeout: Duration, predicate: F) -> bool {
+        let deadline = Instant::now() + timeout;
+        let mut events = self.events.lock().unwrap();
+        loop {
+            if predicate(&events) {
+                return true;
+            }
+            let now = Instant::now();
+            if now >= deadline {
+                return false;
+            }
+            events = self.condvar.wait_timeout(events, deadline - now).unwrap().0;
+        }
+    }
+
+    fn completed(&self, session: SessionHandle, id: u64) -> usize {
+        completed(&self.events.lock().unwrap(), session, id)
+    }
+
+    fn count(&self, predicate: impl Fn(&EngineEvent) -> bool) -> usize {
+        self.events.lock().unwrap().iter().filter(|(_, event)| predicate(event)).count()
+    }
+}
+
+fn completed(events: &[(SessionHandle, EngineEvent)], session: SessionHandle, id: u64) -> usize {
+    events
+        .iter()
+        .filter(|(handle, event)| {
+            *handle == session
+                && matches!(event, EngineEvent::Rpc(RpcEvent::Completed { id: completed, .. }) if completed.0 == id)
+        })
+        .count()
+}
+
+/// What reached an endpoint: every connection, and how it opened.
+#[derive(Default)]
+struct Seen {
+    connections: AtomicUsize,
+    /// Connections that opened with an HTTP request.
+    http: AtomicUsize,
+    /// Connections that opened with anything else: the TCP transport, whose obfuscated header never
+    /// starts like an HTTP request.
+    tcp: AtomicUsize,
+    /// Connections that are over.
+    ended: AtomicUsize,
+    /// Connections accepted before this many get nothing back from upstream.
+    held_below: AtomicUsize,
+    /// The request line of each connection that opened with an HTTP request.
+    request_lines: Mutex<Vec<String>>,
+}
+
+/// A local address a session can be given. With an upstream it forwards both ways, a route to the test
+/// server; without one it takes connections and never answers, an address that leads nowhere.
+struct Endpoint {
+    port: u16,
+    seen: Arc<Seen>,
+}
+
+impl Endpoint {
+    fn route(upstream: SocketAddr) -> Self {
+        Self::start(Some(upstream))
+    }
+
+    fn sink() -> Self {
+        Self::start(None)
+    }
+
+    fn start(upstream: Option<SocketAddr>) -> Self {
+        let listener = TcpListener::bind("127.0.0.1:0").unwrap();
+        let port = listener.local_addr().unwrap().port();
+        let seen = Arc::new(Seen::default());
+        let counted = seen.clone();
+        std::thread::spawn(move || {
+            for stream in listener.incoming() {
+                let Ok(stream) = stream else { continue };
+                let serial = counted.connections.fetch_add(1, Ordering::SeqCst);
+                let seen = counted.clone();
+                std::thread::spawn(move || {
+                    serve(stream, serial, upstream, &seen);
+                    seen.ended.fetch_add(1, Ordering::SeqCst);
+                });
+            }
+        });
+        Self { port, seen }
+    }
+
+    fn address(&self) -> DcAddress {
+        DcAddress { host: "127.0.0.1".into(), port: self.port, secret: None }
+    }
+
+    fn connections(&self) -> usize {
+        self.seen.connections.load(Ordering::SeqCst)
+    }
+
+    fn http(&self) -> usize {
+        self.seen.http.load(Ordering::SeqCst)
+    }
+
+    fn tcp(&self) -> usize {
+        self.seen.tcp.load(Ordering::SeqCst)
+    }
+
+    fn ended(&self) -> usize {
+        self.seen.ended.load(Ordering::SeqCst)
+    }
+
+    /// Every connection open now is over.
+    fn all_ended(&self) -> bool {
+        self.ended() == self.connections()
+    }
+
+    /// From now on nothing the server sends on the connections open now reaches the session.
+    fn hold_open_connections(&self) {
+        self.seen.held_below.store(self.connections(), Ordering::SeqCst);
+    }
+
+    fn request_lines(&self) -> Vec<String> {
+        self.seen.request_lines.lock().unwrap().clone()
+    }
+}
+
+fn serve(mut client: TcpStream, serial: usize, upstream: Option<SocketAddr>, seen: &Arc<Seen>) {
+    let mut buffer = vec![0u8; 64 * 1024];
+    let mut head = Vec::new();
+    while head.len() < 4 {
+        match client.read(&mut buffer) {
+            Ok(0) | Err(_) => return,
+            Ok(read) => head.extend_from_slice(&buffer[..read]),
+        }
+    }
+    let opened_with_http = [&b"POST"[..], b"GET ", b"HEAD", b"OPTI", b"PUT "].contains(&&head[..4]);
+    if opened_with_http {
+        seen.http.fetch_add(1, Ordering::SeqCst);
+        let line = head.split(|byte| *byte == b'\r').next().unwrap_or_default();
+        seen.request_lines.lock().unwrap().push(String::from_utf8_lossy(line).into_owned());
+    } else {
+        seen.tcp.fetch_add(1, Ordering::SeqCst);
+    }
+    let Some(upstream) = upstream else {
+        while matches!(client.read(&mut buffer), Ok(read) if read > 0) {}
+        return;
+    };
+    let Ok(mut server) = TcpStream::connect(upstream) else {
+        return;
+    };
+    let _ = server.set_nodelay(true);
+    let _ = client.set_nodelay(true);
+    if server.write_all(&head).is_err() {
+        return;
+    }
+    let (Ok(mut from_server), Ok(mut to_client)) = (server.try_clone(), client.try_clone()) else {
+        return;
+    };
+    let held = seen.clone();
+    std::thread::spawn(move || {
+        let mut buffer = vec![0u8; 64 * 1024];
+        loop {
+            let read = match from_server.read(&mut buffer) {
+                Ok(0) | Err(_) => break,
+                Ok(read) => read,
+            };
+            if serial < held.held_below.load(Ordering::SeqCst) {
+                continue;
+            }
+            if to_client.write_all(&buffer[..read]).is_err() {
+                break;
+            }
+        }
+        let _ = to_client.shutdown(Shutdown::Both);
+    });
+    loop {
+        let read = match client.read(&mut buffer) {
+            Ok(0) | Err(_) => break,
+            Ok(read) => read,
+        };
+        if server.write_all(&buffer[..read]).is_err() {
+            break;
+        }
+    }
+    let _ = server.shutdown(Shutdown::Both);
+}
+
+fn salts() -> Vec<ServerSalt> {
+    let now = unix_seconds();
+    vec![ServerSalt { salt: SERVER_SALT, valid_since: now - 60.0, valid_until: now + 3600.0 }]
+}
+
+fn environment(hash: &str) -> ApiEnvironment {
+    ApiEnvironment {
+        layer: 230,
+        api_id: 9,
+        device_model: "Desktop".into(),
+        system_version: "Windows 11".into(),
+        app_version: "1".into(),
+        system_lang_code: "en".into(),
+        lang_pack: "tdesktop".into(),
+        lang_code: "en".into(),
+        proxy: None,
+        params: None,
+        init_hash: hash.into(),
+        disable_updates: false,
+    }
+}
