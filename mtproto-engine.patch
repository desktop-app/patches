+
+/// A racer reads only until its `res_pq` verifies it, short of `WouldBlock`, and mio on Windows reports
+/// nothing more for a socket until a read or write hits `WouldBlock` or it is registered anew. Promoted,
+/// it has to hear the answer to the request it resends through a poll event of its own: from the turn
+/// that sends the request on, nothing is driven, written or timed to wake it.
+#[cfg(windows)]
+#[test]
+fn a_promoted_racer_hears_the_answer_to_the_resent_request_through_the_poll() {
+    let key = random_key(9003);
+    let server = TestServer::start(vec![key.clone()], ServerOptions::default());
+    let silent = TcpListener::bind("127.0.0.1:0").unwrap();
+    let mut poll = mio::Poll::new().unwrap();
+    let mut events = mio::Events::with_capacity(64);
+    let mut scratch = vec![0u8; 256 * 1024];
+    let mut rng = OsRandom::new();
+    let start = crate::clock::now();
+    let addresses = [silent.local_addr().unwrap(), server.address]
+        .iter()
+        .map(|address| DcAddress { host: address.ip().to_string(), port: address.port(), secret: None })
+        .collect();
+    let mut setup = SessionSetup::new(2, SessionRole::Main, addresses);
+    setup.transport = TransportPreference::Tcp;
+    setup.http_port = None;
+    setup.auth_key = Some(material(&key, start));
+    let mut runtime = SessionRuntime::new(SessionHandle(1), setup, Token(16), start, &mut rng);
+    let recorder = Arc::new(Recorder::default());
+    let callbacks: Arc<dyn EngineCallbacks> = recorder.clone();
+    let config = EngineConfig::default();
+    let racer = runtime.race_token();
+    let mut racer_events = 0;
+    let mut turn = |runtime: &mut SessionRuntime, drive: bool| {
+        poll.poll(&mut events, Some(Duration::from_millis(2))).unwrap();
+        let now = crate::clock::now();
+        for event in events.iter() {
+            let readable = event.is_readable() || event.is_read_closed() || event.is_error();
+            let writable = event.is_writable() || event.is_write_closed();
+            racer_events += usize::from(event.token() == racer);
+            runtime.handle_io(
+                event.token(),
+                readable,
+                writable,
+                poll.registry(),
+                &mut scratch,
+                now,
+                &callbacks,
+                &mut rng,
+            );
+        }
+        if drive {
+            runtime.drive(poll.registry(), now, &mut NoLookups, &config, &callbacks, &mut rng);
+        }
+    };
+    let completed = || {
+        recorder.events.lock().unwrap().iter().any(|(_, event)| {
+            matches!(event, EngineEvent::Rpc(RpcEvent::Completed { id, .. }) if *id == RequestId(1))
+        })
+    };
+    runtime.send(plain_request(1), start);
+    let real = Instant::now();
+    while runtime.connection.as_ref().is_none_or(|connection| connection.token() != racer)
+        && real.elapsed() < Duration::from_secs(10)
+    {
+        turn(&mut runtime, true);
+    }
+    let promoted = runtime.connection.as_ref().filter(|connection| connection.token() == racer);
+    let sent = promoted.map_or(0, |connection| connection.bytes_out);
+    assert!(sent > 0 && runtime.racer.is_none(), "no promoted racer that resent the request ({sent} bytes)");
+    assert!(!completed(), "the silent primary answered");
+    let waited = Instant::now();
+    while !completed() && waited.elapsed() < Duration::from_secs(3) {
+        turn(&mut runtime, false);
+    }
+    let answered = completed();
+    let waited = waited.elapsed();
+    runtime.shutdown(poll.registry(), crate::clock::now());
+    assert!(answered, "no answer {waited:?} after the promotion; {racer_events} poll events for the racer's socket");
+    assert_eq!(server.executions(1), 1);
+}
diff --git a/crates/mtproto-engine/src/session_hello_time_tests.rs b/crates/mtproto-engine/src/session_hello_time_tests.rs
new file mode 100644
index 0000000..b540e78
--- /dev/null
+++ b/crates/mtproto-engine/src/session_hello_time_tests.rs
@@ -0,0 +1,302 @@
+use super::tests::{Gate, Sink, gate_setup};
+use super::*;
+use crate::types::TransportPreference;
+use mtproto_core::transport::{ProxySecret, verify_client_hello_for_tests};
+use std::time::{Duration, Instant};
+
+/// The secret of the fake-TLS addresses below.
+fn fake_tls_secret() -> Vec<u8> {
+    let mut secret = vec![0xee];
+    secret.extend_from_slice(&[0x33; 16]);
+    secret.extend_from_slice(b"www.example.com");
+    secret
+}
+
+impl Sink {
+    fn fake_tls_address(&self) -> DcAddress {
+        let mut address = self.address();
+        address.secret = Some(fake_tls_secret());
+        address
+    }
+
+    /// The time the fake-TLS hello of the connection taken `index`th says, once it came whole. It reads what
+    /// has arrived and does not wait.
+    fn hello_time(&mut self, index: usize) -> Option<i32> {
+        use std::io::Read;
+        while let Ok((stream, _)) = self.listener.accept() {
+            self.taken.push(stream);
+        }
+        self.sent.resize(self.taken.len(), Vec::new());
+        let (stream, sent) = (self.taken.get_mut(index)?, &mut self.sent[index]);
+        stream.set_nonblocking(true).unwrap();
+        let mut chunk = [0u8; 4096];
+        while let Ok(read @ 1..) = stream.read(&mut chunk) {
+            sent.extend_from_slice(&chunk[..read]);
+        }
+        let record = usize::from(u16::from_be_bytes([*sent.get(3)?, *sent.get(4)?]));
+        let key = ProxySecret::from_binary(&fake_tls_secret(), true).unwrap().proxy_key();
+        let time = verify_client_hello_for_tests(sent.get(..5 + record)?, &key);
+        Some(time.expect("a hello signed with the secret"))
+    }
+}
+
+/// What a hello offset leaves as it was, a connection's identity included.
+#[derive(Debug, PartialEq)]
+struct Untouched {
+    time_difference: f64,
+    rpc_time_difference: Option<f64>,
+    setup_time_difference: f64,
+    reported_time_difference: Option<f64>,
+    reports: usize,
+    connection: Option<(Token, f64)>,
+    paused: bool,
+    failures: u32,
+    flaps: u32,
+    next_attempt_at: f64,
+}
+
+impl Gate {
+    fn untouched(&self) -> Untouched {
+        let is_report =
+            |event: &&EngineEvent| matches!(event, EngineEvent::Rpc(RpcEvent::TimeDifferenceUpdated { .. }));
+        let runtime = &self.runtime;
+        Untouched {
+            time_difference: runtime.time_difference(),
+            rpc_time_difference: runtime.rpc.as_ref().map(|rpc| rpc.session().time_difference()),
+            setup_time_difference: runtime.setup.time_difference,
+            reported_time_difference: runtime.reported_time_difference,
+            reports: self.recorded.0.lock().unwrap().iter().filter(is_report).count(),
+            connection: runtime.connection.as_ref().map(|connection| (connection.token(), connection.started_at)),
+            paused: runtime.setup.paused,
+            failures: runtime.failures,
+            flaps: runtime.flaps,
+            next_attempt_at: runtime.next_attempt_at,
+        }
+    }
+
+    /// Turns, with I/O only for the connection at `token`, until the one `sink` took `index`th sent its whole
+    /// hello, for 3 s at most. Polled, a slow primary would drop the racer beside it.
+    fn hello_on(&mut self, sink: &mut Sink, index: usize, token: Token) -> i32 {
+        let started = Instant::now();
+        loop {
+            if let Some(time) = sink.hello_time(index) {
+                return time;
+            }
+            assert!(started.elapsed() < Duration::from_secs(3), "no whole hello on connection {index}");
+            self.turn_with(|polled| polled == token);
+        }
+    }
+
+    fn primary_token(&self) -> Token {
+        self.runtime.connection.as_ref().expect("a primary connection").token()
+    }
+
+    fn close_primary(&mut self, failed: bool) {
+        let now = self.now();
+        self.runtime.close_connection(self.poll.registry(), now, failed);
+    }
+}
+
+/// Around every set and clear, on a live connection and on a paused session, the RPC session's clock, the
+/// setup's, what was reported, the connection and the backoff read exactly the same, also after a drive.
+#[test]
+fn a_hello_offset_moves_nothing_but_the_hello() {
+    let mut tcp = Sink::new();
+    let mut setup = gate_setup(vec![tcp.fake_tls_address()], Vec::new(), TransportPreference::Tcp);
+    setup.time_difference = -600.0;
+    let mut gate = Gate::new(setup, false);
+    gate.drive();
+    let live = gate.untouched();
+    assert_eq!((live.time_difference, live.rpc_time_difference), (-600.0, Some(-600.0)));
+    assert!(live.connection.is_some());
+    for offset in [Some(3600.0), Some(0.0), None, Some(-1200.0), None] {
+        gate.runtime.set_tls_hello_time_offset(offset);
+        assert_eq!(gate.untouched(), live, "at the setter, {offset:?}");
+        gate.drive();
+        assert_eq!(gate.untouched(), live, "after a drive, {offset:?}");
+    }
+    let opened = tcp.taken();
+    assert_eq!(opened, 1);
+
+    let now = gate.now();
+    gate.runtime.set_paused(true, now, gate.poll.registry());
+    let paused = gate.untouched();
+    assert!(paused.paused && paused.connection.is_none());
+    for offset in [Some(3600.0), Some(0.0), None, Some(-1200.0), None] {
+        gate.runtime.set_tls_hello_time_offset(offset);
+        assert_eq!(gate.untouched(), paused, "paused, at the setter, {offset:?}");
+        gate.drive();
+        assert_eq!(gate.untouched(), paused, "paused, after a drive, {offset:?}");
+    }
+    assert_eq!(tcp.taken(), opened, "a paused session opened a connection");
+    gate.shutdown();
+}
+
+/// While a session backs off, an offset brings its retry no closer and opens nothing, up to the last moment.
+/// The retry comes when it was due and says the offset.
+#[test]
+fn a_hello_offset_neither_advances_a_retry_nor_opens_a_connection() {
+    let mut tcp = Sink::new();
+    let setup = gate_setup(vec![tcp.fake_tls_address()], Vec::new(), TransportPreference::Tcp);
+    let mut gate = Gate::new(setup, false);
+    // The ladder's first step is no delay, so it takes two failed connections to wait.
+    for _ in 0..2 {
+        gate.drive();
+        assert!(gate.runtime.connection.is_some());
+        gate.close_primary(true);
+    }
+    let waiting = gate.untouched();
+    let due = waiting.next_attempt_at;
+    assert_eq!(waiting.failures, 2);
+    assert!(due > gate.now().mono, "the session does not wait: {waiting:?}");
+    let opened = tcp.taken();
+
+    gate.runtime.set_tls_hello_time_offset(Some(3600.0));
+    assert_eq!(gate.untouched(), waiting);
+    gate.drive();
+    assert_eq!(gate.untouched(), waiting, "the setter advanced the retry");
+
+    gate.elapsed = due - gate.start.mono - 0.001;
+    gate.runtime.set_tls_hello_time_offset(Some(7200.0));
+    gate.drive();
+    assert_eq!(gate.untouched(), waiting, "a moment before it was due");
+    assert_eq!(tcp.taken(), opened, "a connection opened before the retry was due");
+
+    gate.elapsed = due - gate.start.mono + 0.001;
+    let at = gate.now().unix;
+    gate.drive();
+    let token = gate.primary_token();
+    assert_eq!(gate.hello_on(&mut tcp, opened, token), (at + 7200.0) as i32);
+    gate.shutdown();
+}
+
+/// An offset that arrives once a connection was constructed, even with its hello not sent yet, changes only the
+/// next connection: delivery needs no particular timing against the attempts.
+#[test]
+fn a_late_hello_offset_changes_only_later_constructions() {
+    let mut tcp = Sink::new();
+    let mut setup = gate_setup(vec![tcp.fake_tls_address()], Vec::new(), TransportPreference::Tcp);
+    setup.time_difference = -600.0;
+    let mut gate = Gate::new(setup, false);
+    gate.elapsed = 0.75;
+    let first = gate.now().unix;
+    gate.drive();
+    gate.runtime.set_tls_hello_time_offset(Some(0.0));
+    let token = gate.primary_token();
+    assert_eq!(gate.hello_on(&mut tcp, 0, token), (first - 600.0) as i32, "the hello already constructed");
+
+    gate.close_primary(false);
+    gate.elapsed += 1.0;
+    let second = gate.now().unix;
+    gate.drive();
+    let token = gate.primary_token();
+    assert_eq!(gate.hello_on(&mut tcp, 1, token), second as i32, "the connection after it");
+    gate.shutdown();
+}
+
+#[derive(Clone, Copy, Debug)]
+enum HelloSite {
+    Primary,
+    Racer,
+    TcpRecheck,
+}
+
+#[derive(Clone, Copy)]
+enum ClockStep {
+    /// The host's `set_tls_hello_time_offset`.
+    Offset(Option<f64>),
+    /// What a server's correction leaves in the RPC session.
+    Correction(f64),
+}
+
+const HELLO_DIFFERENCE: f64 = -600.0;
+const HELLO_OFFSET: f64 = 3600.0;
+const HELLO_CORRECTED: f64 = -30.0;
+
+/// The real hello of the connection `site` constructs right after `steps`, and the virtual time it was
+/// constructed at. It goes by the admission shapes of `tests`: the answer starts that one connection in that drive.
+fn hello_at(site: HelloSite, steps: &[ClockStep]) -> (f64, i32) {
+    let (mut target, other) = (Sink::new(), Sink::new());
+    let (tcp, http, transport) = match site {
+        HelloSite::Primary => (vec![target.fake_tls_address()], Vec::new(), TransportPreference::Tcp),
+        HelloSite::Racer => {
+            (vec![other.fake_tls_address(), target.fake_tls_address()], Vec::new(), TransportPreference::Tcp)
+        }
+        HelloSite::TcpRecheck => (vec![target.fake_tls_address()], vec![other.address()], TransportPreference::Auto),
+    };
+    let mut setup = gate_setup(tcp, http, transport);
+    setup.time_difference = HELLO_DIFFERENCE;
+    let mut gate = Gate::new(setup, true);
+    match site {
+        HelloSite::Primary => {}
+        HelloSite::Racer => {
+            gate.drive();
+            gate.admit(1, true);
+            gate.drive();
+            gate.drive_for(1.0, 0.25);
+        }
+        HelloSite::TcpRecheck => {
+            let now = gate.now();
+            gate.runtime.auto.on_http = true;
+            gate.runtime.enter_http(gate.poll.registry(), now);
+        }
+    }
+    gate.drive();
+    let asked = gate.asked_for(RouteTransport::Tcp, target.port());
+    assert_eq!(asked.len(), 1, "{site:?}: {:?}", gate.asked());
+    for step in steps {
+        match step {
+            ClockStep::Offset(offset) => gate.runtime.set_tls_hello_time_offset(*offset),
+            ClockStep::Correction(difference) => {
+                gate.runtime.rpc.as_mut().unwrap().session_mut().set_time_difference(*difference)
+            }
+        }
+    }
+    gate.elapsed += 0.75;
+    let at = gate.now().unix;
+    gate.admit(asked[0], true);
+    gate.drive();
+    let token = match site {
+        HelloSite::Primary => gate.primary_token(),
+        HelloSite::Racer | HelloSite::TcpRecheck => gate.runtime.racer.as_ref().expect("a racer").token(),
+    };
+    let hello = gate.hello_on(&mut target, 0, token);
+    gate.shutdown();
+    (at, hello)
+}
+
+/// Without an offset, or once it is cleared, a hello says the wall clock plus the RPC session's time difference,
+/// a later correction of it included. With one stored it says the wall clock plus that, whatever corrects the
+/// RPC session meanwhile. Read exactly, against the virtual clock, in what went over the socket.
+fn every_clock_at(site: HelloSite) {
+    use ClockStep::{Correction, Offset};
+    let stored = Offset(Some(HELLO_OFFSET));
+    let corrected = Correction(HELLO_CORRECTED);
+    let cases: [(&str, &[ClockStep], f64); 6] = [
+        ("fallback", &[], HELLO_DIFFERENCE),
+        ("override", &[stored], HELLO_OFFSET),
+        ("clear", &[stored, Offset(None)], HELLO_DIFFERENCE),
+        ("fallback after a correction", &[corrected], HELLO_CORRECTED),
+        ("override after a correction", &[stored, corrected], HELLO_OFFSET),
+        ("clear after a correction", &[stored, corrected, Offset(None)], HELLO_CORRECTED),
+    ];
+    for (what, steps, difference) in cases {
+        let (at, hello) = hello_at(site, steps);
+        assert_eq!(hello, (at + difference) as i32, "{site:?}, {what}");
+    }
+}
+
+#[test]
+fn a_primary_hello_says_the_offset_or_else_the_time_difference() {
+    every_clock_at(HelloSite::Primary);
+}
+
+#[test]
+fn a_racer_hello_says_the_offset_or_else_the_time_difference() {
+    every_clock_at(HelloSite::Racer);
+}
+
+#[test]
+fn a_tcp_recheck_hello_says_the_offset_or_else_the_time_difference() {
+    every_clock_at(HelloSite::TcpRecheck);
+}
