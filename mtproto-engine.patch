+    /// Waits up to `limit` for the reading to be `Some(0)`, the peer having acknowledged everything.
+    #[cfg(windows)]
+    fn drained(socket: &mio::net::TcpStream, limit: std::time::Duration) -> Option<usize> {
+        let started = std::time::Instant::now();
+        loop {
+            let queued = kernel_send_queue(socket);
+            if queued == Some(0) || started.elapsed() >= limit {
+                return queued;
