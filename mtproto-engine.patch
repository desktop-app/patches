+/// What a test-local peer read: whether the one packet it answered was a `req_pq_multi`, and the bytes that came
+/// after it until the client closed.
+#[derive(Debug, PartialEq)]
+struct PeerRead {
+    req_pq_multi: bool,
+    after: usize,
+}
+
+/// A datacenter's stand-in on loopback for one connection with no secret and the abridged framing: it takes the first
+/// packet, answers with a plain message of the body `reply` makes of the nonce the packet carried, then reads what
+/// else comes until the client closes.
+fn peer(reply: fn([u8; 16]) -> Vec<u8>) -> (u16, JoinHandle<PeerRead>) {
+    let listener = TcpListener::bind((Ipv4Addr::LOCALHOST, 0)).unwrap();
+    let port = listener.local_addr().unwrap().port();
+    let thread = std::thread::spawn(move || {
+        let (mut socket, _) = listener.accept().unwrap();
+        socket.set_read_timeout(Some(WAIT)).unwrap();
+        let mut header = [0u8; 64];
+        socket.read_exact(&mut header).unwrap();
+        let mut crypto = accept_obfuscated_header(&header, None).expect("an obfuscated header with no secret");
+        let mut length = [0u8; 1];
+        socket.read_exact(&mut length).unwrap();
+        crypto.decryptor.apply(&mut length);
+        assert!(length[0] < 0x7f, "not a short abridged frame");
+        let mut packet = vec![0u8; usize::from(length[0]) * 4];
+        socket.read_exact(&mut packet).unwrap();
+        crypto.decryptor.apply(&mut packet);
+        let body = decode_plain_message(&packet).expect("a plain message").body.to_vec();
+        let req_pq_multi = body.len() == 20 && body[..4] == ids::REQ_PQ_MULTI.to_le_bytes();
+        let nonce = body[4..20].try_into().unwrap();
+        let message = encode_plain_message(((unix_seconds() as i64) << 32) | 1, &reply(nonce));
+        let mut frame = vec![u8::try_from(message.len() / 4).unwrap()];
+        frame.extend_from_slice(&message);
+        crypto.encryptor.apply(&mut frame);
+        socket.write_all(&frame).unwrap();
+        let (mut after, mut chunk) = (0, [0u8; 4096]);
+        while let Ok(read @ 1..) = socket.read(&mut chunk) {
+            after += read;
+        }
+        PeerRead { req_pq_multi, after }
+    });
+    (port, thread)
+}
+
+/// Where a `res_pq`'s `pq` string starts: after its constructor and its two nonces.
+const PQ_AT: usize = 36;
+/// Where its fingerprint vector starts, after the 8 bytes of `pq` and their length and padding.
+const FINGERPRINTS_AT: usize = PQ_AT + 12;
+
+/// A whole `res_pq` with `nonce`, as a server writes one.
+fn whole_res_pq(nonce: [u8; 16]) -> Vec<u8> {
+    let pq = 0x17ed_4894_1a08_f981_u64.to_be_bytes().to_vec();
+    ResPq { nonce, server_nonce: [0x5a; 16], pq, fingerprints: vec![0x0123_4567_89ab_cdef] }.to_bytes()
+}
+
+/// A whole `res_pq` with `nonce` and `bytes` written over it at `at`.
+fn res_pq_with(nonce: [u8; 16], at: usize, bytes: &[u8]) -> Vec<u8> {
+    let mut body = whole_res_pq(nonce);
+    body[at..at + bytes.len()].copy_from_slice(bytes);
+    body
+}
+
+/// A reply with the nonce sent answers only when it is a whole `res_pq`, read as the key handshake reads one: cut
+/// short after the nonce, with a malformed `pq` string or with a malformed fingerprint vector it is no answer, and a
+/// whole one with another nonce neither. Each check reports once, after its one request, and sends nothing after it:
+/// no key handshake step.
+#[test]
+fn only_a_whole_res_pq_with_the_sent_nonce_is_an_answer() {
+    assert_eq!(whole_res_pq([0; 16]).len(), FINGERPRINTS_AT + 16);
+    let collector = Arc::new(Collector::default());
+    let engine = engine(&collector, 2);
+    let cases: [(&str, fn([u8; 16]) -> Vec<u8>, bool); 8] = [
+        ("a whole res_pq", whole_res_pq, true),
+        (
+            "a whole res_pq with another nonce",
+            |mut nonce| {
+                nonce[0] ^= 1;
+                whole_res_pq(nonce)
+            },
+            false,
+        ),
+        ("a res_pq cut short after the nonce", |nonce| whole_res_pq(nonce)[..20].to_vec(), false),
+        ("a pq string with no valid length", |nonce| res_pq_with(nonce, PQ_AT, &[0xff, 0, 0, 0]), false),
+        ("a pq string longer than the reply", |nonce| res_pq_with(nonce, PQ_AT, &[0xfe, 0, 1, 0]), false),
+        (
+            "a fingerprint vector with another constructor",
+            |nonce| res_pq_with(nonce, FINGERPRINTS_AT, &ids::RES_PQ.to_le_bytes()),
+            false,
+        ),
+        (
+            "a fingerprint vector counting more than it holds",
+            |nonce| res_pq_with(nonce, FINGERPRINTS_AT + 4, &2i32.to_le_bytes()),
+            false,
+        ),
+        (
+            "a fingerprint vector counting past the parser's bound",
+            |nonce| res_pq_with(nonce, FINGERPRINTS_AT + 4, &(MAX_VECTOR_ITEMS as i32 + 1).to_le_bytes()),
+            false,
+        ),
+    ];
+    for (what, reply, answers) in cases {
+        let (port, reader) = peer(reply);
+        let setup = RouteCheckSetup::new(DcAddress { host: "127.0.0.1".into(), port, secret: None }, DC_ID);
+        let (handle, checked, took) = check(&engine, &collector, setup);
+        let read = reader.join().expect("the peer");
+        assert_eq!(read, PeerRead { req_pq_multi: true, after: 0 }, "{what}: not the one request alone");
+        if answers {
+            assert!(checked.answered, "{what}: {checked:?}");
+            assert_eq!((checked.reason, checked.attempts), ("", 1), "{what}: {checked:?}");
+            assert!(0.0 <= checked.round_trip && checked.round_trip <= took, "{what}: {checked:?} in {took} s");
+        } else {
+            assert_refused(what, checked, &["wrong_answer"]);
+            assert_eq!(checked.attempts, 1, "{what}");
+        }
+        assert_eq!(collector.events_of(handle).len(), 1, "{what}: {:?}", collector.events_of(handle));
+    }
+    engine.shutdown();
+}
