+#[cfg(test)]
+mod tests {
+    use std::process::{Command, ExitStatus};
+
+    use super::*;
+
+    fn flags_of(bits: u32) -> RequestFlags {
+        let body = [0u8; 4];
+        let value = MTRequest {
+            id: 1,
+            body: MTBytes { data: body.as_ptr(), length: body.len() },
+            flags: bits,
+            expected_response_size: 0,
+            invoke_after: 0,
+        };
+        unsafe { request(&value) }.flags
+    }
+
+    #[test]
+    fn bit_8_alone_asks_for_dependency_waits() {
+        let only = flags_of(1 << 8);
+        assert!(only.surface_dependency_waits);
+        assert_eq!(only, RequestFlags { surface_dependency_waits: true, ..flags_of(0) });
+        assert!(!flags_of(0xff).surface_dependency_waits, "the other bits leave it off");
+        assert!(!flags_of(0).surface_dependency_waits);
+    }
+
+    /// A panic in an entry point's body is reported only while the thread runs as engine code.
+    #[test]
+    fn every_entry_point_runs_as_engine_code() {
+        // Trimmed lines: the same with LF and CRLF checkouts.
+        let lines: Vec<&str> = include_str!("lib.rs").lines().map(str::trim).collect();
+        let mut entry_points = 0;
+        for (at, line) in lines.iter().enumerate().filter(|(_, line)| line.contains("extern \"C\" fn mt_")) {
+            entry_points += 1;
+            let body = (at..lines.len()).find(|&index| lines[index].ends_with('{')).expect(line);
+            assert_eq!(lines[body + 1], "let _engine = enter_engine_code();", "{line}");
+        }
+        let exported = lines.iter().filter(|line| **line == "#[unsafe(no_mangle)]").count();
+        assert_eq!((entry_points, exported), (50, 50), "every exported function is an mt_* entry point");
+    }
+
+    const CHILD: &str = "MTPROTO_FFI_PANIC_CHILD";
+
+    /// Re-runs this binary on `test` alone, with `CHILD` set to that name: the child runs `child` and exits zero if it
+    /// returns. Gives the child's exit status and stderr.
+    fn run_child(test: &str, child: impl FnOnce()) -> (ExitStatus, String) {
+        if std::env::var_os(CHILD).is_some_and(|name| name == test) {
+            child();
+            std::process::exit(0);
+        }
+        let output = Command::new(std::env::current_exe().unwrap())
+            .args(["--exact", test, "--nocapture"])
+            .env(CHILD, test)
+            .output()
+            .unwrap();
+        (output.status, String::from_utf8_lossy(&output.stderr).into_owned())
+    }
+
+    fn assert_aborted(status: ExitStatus, stderr: &str) {
+        #[cfg(unix)]
+        {
+            use std::os::unix::process::ExitStatusExt;
+            const SIGABRT: i32 = 6;
+            assert_eq!(status.signal(), Some(SIGABRT), "{status:?}: {stderr}");
+        }
+        // std::process::abort is __fastfail: STATUS_STACK_BUFFER_OVERRUN, but an access violation on Windows 7.
+        #[cfg(windows)]
+        assert!(
+            [Some(0xC000_0409_u32 as i32), Some(0xC000_0005_u32 as i32)].contains(&status.code()),
+            "the child did not abort: {status:?}: {stderr}"
+        );
+    }
+
+    /// What the host's context points to.
+    static HOST: u8 = 0;
+
+    fn host_context() -> *mut c_void {
+        (&raw const HOST).cast_mut().cast()
+    }
+
+    unsafe extern "C" fn print_report(context: *mut c_void, thread: MTString, message: MTString) {
+        let (thread, message) = unsafe { (text(thread), text(message)) };
+        eprintln!("host report context={} thread={thread} message={message}", context == host_context());
+    }
+
+    /// As an entry point does: a panic cannot unwind out of it, so it ends the process.
+    extern "C" fn engine_call() {
+        let _engine = enter_engine_code();
+        panic!("engine call panic");
+    }
+
+    #[test]
+    fn a_panic_inside_an_engine_call_reaches_the_host_before_the_abort() {
+        let test = "tests::a_panic_inside_an_engine_call_reaches_the_host_before_the_abort";
+        let (status, stderr) = run_child(test, || {
+            unsafe { mt_set_panic_callback(host_context(), Some(print_report)) };
+            engine_call();
+        });
+        // The test harness named this thread, but the engine did not start it.
+        let report = format!("host report context=true thread= message=engine call panic at {}:", file!());
+        assert!(stderr.contains(&report), "the host got no report: {stderr}");
+        assert_eq!(stderr.matches("host report").count(), 1, "one report per panic: {stderr}");
+        assert_aborted(status, &stderr);
+    }
+
+    #[test]
+    fn a_null_panic_callback_stops_the_reports() {
+        let test = "tests::a_null_panic_callback_stops_the_reports";
+        let (status, stderr) = run_child(test, || {
+            unsafe { mt_set_panic_callback(host_context(), Some(print_report)) };
+            unsafe { mt_set_panic_callback(std::ptr::null_mut(), None) };
+            engine_call();
+        });
+        assert!(stderr.contains("engine call panic"), "the child did not panic: {stderr}");
+        assert!(!stderr.contains("host report"), "the host still got a report: {stderr}");
+        assert_aborted(status, &stderr);
+    }
+}
