+    h.client.reset_session(h.now, &mut h.rng);
+    let seen = resets_and_updates(h.events());
+    assert_eq!(seen, vec![(Some(UpdatesResetReason::LocalSession), Vec::new())], "a new session of our own");
+    reasons.extend(seen.into_iter().filter_map(|(reason, _)| reason));
