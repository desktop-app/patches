+
+#[derive(Default)]
+struct Collector {
+    events: Mutex<Vec<(SessionHandle, EngineEvent)>>,
+    changed: Condvar,
+}
+
+impl EngineCallbacks for Collector {
+    fn on_event(&self, session: SessionHandle, event: EngineEvent) {
+        self.events.lock().unwrap_or_else(PoisonError::into_inner).push((session, event));
+        self.changed.notify_all();
+    }
+}
+
+impl Collector {
+    fn wait(&self, predicate: impl Fn(&Events) -> bool) -> bool {
+        let deadline = Instant::now() + WAIT;
+        let mut events = self.events.lock().unwrap_or_else(PoisonError::into_inner);
+        while !predicate(&events) {
+            let now = Instant::now();
+            if now >= deadline {
+                return false;
+            }
+            events = self.changed.wait_timeout(events, deadline - now).unwrap_or_else(PoisonError::into_inner).0;
+        }
+        true
+    }
+
+    fn results(&self, check: SessionHandle) -> Vec<(bool, &'static str, u32)> {
+        results(&self.events.lock().unwrap_or_else(PoisonError::into_inner), check)
+    }
+
+    fn events_of(&self, handle: SessionHandle) -> Vec<EngineEvent> {
+        let events = self.events.lock().unwrap_or_else(PoisonError::into_inner);
+        events.iter().filter(|(session, _)| *session == handle).map(|(_, event)| event.clone()).collect()
+    }
+}
+
+/// What `check` reported: answered, the reason, the attempts.
+fn results(events: &Events, check: SessionHandle) -> Vec<(bool, &'static str, u32)> {
+    events
+        .iter()
+        .filter_map(|(handle, event)| match event {
+            EngineEvent::RouteChecked { answered, reason, attempts, .. } if *handle == check => {
+                Some((*answered, *reason, *attempts))
+            }
+            _ => None,
+        })
+        .collect()
+}
+
+fn all_reported(checks: &[SessionHandle]) -> impl Fn(&Events) -> bool + '_ {
+    move |events| checks.iter().all(|check| !results(events, *check).is_empty())
+}
+
+/// Two workers: every check, and every session but the main one, runs on the second.
+fn engine(collector: &Arc<Collector>, lookups: &Arc<Lookups>) -> Engine {
+    let config = EngineConfig { worker_threads: 2, ..EngineConfig::default() };
+    Engine::with_lookup(config, collector.clone(), lookups.backend()).unwrap()
+}
+
+fn names(prefix: &str, count: usize) -> Vec<String> {
+    (0..count).map(|index| format!("{prefix}-{index}.test")).collect()
+}
+
+fn set(names: &[String]) -> HashSet<String> {
+    names.iter().cloned().collect()
+}
+
+/// A check through the SOCKS5 front of `server` by `name`, which only the stand-in resolves; the front carries the
+/// tunnel to the server itself.
+fn check(engine: &Engine, server: &TestServer, name: &str, timeout: f64) -> SessionHandle {
+    let mut setup = RouteCheckSetup::new(DcAddress { host: "192.0.2.1".into(), port: 443, secret: None }, 10002);
+    let port = server.address.port();
+    setup.proxy = Some(ProxyConfig::Socks5 { host: name.into(), port, username: None, password: None });
+    setup.timeout = timeout;
+    let handle = engine.start_route_check(setup);
+    assert_ne!(handle, SessionHandle(0));
+    handle
+}
+
+fn socks5_server() -> TestServer {
+    TestServer::start(Vec::new(), ServerOptions { socks5: true, ..Default::default() })
+}
+
+/// More names than a worker looks up at once: `MAX_LOOKUPS` run, held, and the rest wait, a second burst behind the
+/// first. As the running ones return, the queued ones take their room in the order asked, never more than
+/// `MAX_LOOKUPS` at once, and their checks answer. A second check of a name already asked for shares its lookup.
+#[test]
+fn a_worker_runs_at_most_max_lookups_at_once_and_the_rest_wait_their_turn() {
+    let (collector, lookups) = (Arc::new(Collector::default()), Arc::new(Lookups::default()));
+    let _release = ReleaseAll(lookups.clone());
+    let engine = engine(&collector, &lookups);
+    let server = socks5_server();
+    let first = names("first", 2 * MAX_LOOKUPS);
+    let mut checks: Vec<SessionHandle> = first.iter().map(|name| check(&engine, &server, name, PATIENT)).collect();
+    assert!(lookups.wait(|held| held.running == MAX_LOOKUPS), "the first lookups did not start");
+    std::thread::sleep(SETTLE);
+    checks.push(check(&engine, &server, &first[0], PATIENT));
+    let second = names("second", MAX_LOOKUPS);
+    checks.extend(second.iter().map(|name| check(&engine, &server, name, PATIENT)));
+    std::thread::sleep(SETTLE);
+    let running = {
+        let held = lookups.held();
+        assert_eq!((held.started.len(), held.running, held.peak), (MAX_LOOKUPS, MAX_LOOKUPS, MAX_LOOKUPS));
+        assert!(held.started.iter().all(|name| first.contains(name)), "{:?}", held.started);
+        held.started.clone()
+    };
+    assert!(checks.iter().all(|check| collector.results(*check).is_empty()), "a check ended while its lookup waited");
+
+    lookups.release(&running);
+    let started = |count: usize| move |held: &Held| held.started.len() == count && held.running == MAX_LOOKUPS;
+    assert!(
+        lookups.wait(started(2 * MAX_LOOKUPS)),
+        "the rest of the first burst did not start: {:?}",
+        lookups.held().started
+    );
+    let rest = {
+        let held = lookups.held();
+        assert_eq!(set(&held.started), set(&first), "not the first burst before the second: {:?}", held.started);
+        assert_eq!(held.peak, MAX_LOOKUPS);
+        held.started[MAX_LOOKUPS..].to_vec()
+    };
+    lookups.release(&rest);
+    assert!(lookups.wait(started(3 * MAX_LOOKUPS)), "the second burst did not start: {:?}", lookups.held().started);
+    assert_eq!(set(&lookups.held().started[2 * MAX_LOOKUPS..]), set(&second));
+    lookups.release(&second);
+
+    assert!(collector.wait(all_reported(&checks)), "not every check reported");
+    for check in &checks {
+        assert_eq!(collector.results(*check), vec![(true, "", 1)], "{:?}", collector.events_of(*check));
+    }
+    std::thread::sleep(SETTLE);
+    let held = lookups.held();
+    assert_eq!(held.started.len(), 3 * MAX_LOOKUPS, "a name was looked up twice: {:?}", held.started);
+    assert_eq!((held.running, held.peak), (0, MAX_LOOKUPS));
+    drop(held);
+    assert_eq!(server.with_stats(|stats| stats.connections), checks.len());
+    engine.shutdown();
+}
+
+/// A lookup whose checks are gone keeps its room until it returns: with every place held by lookups of checks that
+/// expired, a new burst waits. Once room frees, the queued lookups of checks cancelled or expired never start, while
+/// those still awaited do and their checks answer.
+#[test]
+fn queued_lookups_of_cancelled_or_expired_checks_never_start_and_running_ones_keep_their_room() {
+    let (collector, lookups) = (Arc::new(Collector::default()), Arc::new(Lookups::default()));
+    let _release = ReleaseAll(lookups.clone());
+    let engine = engine(&collector, &lookups);
+    let server = socks5_server();
+    let running = names("running", MAX_LOOKUPS);
+    let expiring: Vec<SessionHandle> = running.iter().map(|name| check(&engine, &server, name, BRIEF)).collect();
+    assert!(lookups.wait(|held| held.running == MAX_LOOKUPS), "the first lookups did not start");
+    let (cancelled, expired, kept) = (names("cancelled", 2), names("expired", 2), names("kept", 2));
+    let cancelled_checks: Vec<_> = cancelled.iter().map(|name| check(&engine, &server, name, PATIENT)).collect();
+    let expired_checks: Vec<_> = expired.iter().map(|name| check(&engine, &server, name, BRIEF)).collect();
+    let kept_checks: Vec<_> = kept.iter().map(|name| check(&engine, &server, name, PATIENT)).collect();
+    std::thread::sleep(SETTLE);
+    for check in &cancelled_checks {
+        engine.cancel_route_check(*check);
+    }
+    let gone: Vec<_> = expiring.iter().chain(&expired_checks).copied().collect();
+    assert!(collector.wait(all_reported(&gone)), "a check did not end at its bound");
+    for check in &gone {
+        assert_eq!(collector.results(*check), vec![(false, "timeout", 0)]);
+    }
+
+    let late = names("late", MAX_LOOKUPS);
+    let late_checks: Vec<_> = late.iter().map(|name| check(&engine, &server, name, PATIENT)).collect();
+    std::thread::sleep(SETTLE);
+    {
+        let held = lookups.held();
+        assert_eq!(set(&held.started), set(&running), "a lookup started past the held ones");
+        assert_eq!((held.started.len(), held.running, held.peak), (MAX_LOOKUPS, MAX_LOOKUPS, MAX_LOOKUPS));
+    }
+
+    lookups.release_all();
+    let awaited: Vec<_> = kept_checks.iter().chain(&late_checks).copied().collect();
+    assert!(collector.wait(all_reported(&awaited)), "an awaited check did not report");
+    for check in &awaited {
+        assert_eq!(collector.results(*check), vec![(true, "", 1)], "{:?}", collector.events_of(*check));
+    }
+    std::thread::sleep(SETTLE);
+    let held = lookups.held();
+    let expected: HashSet<String> = running.iter().chain(&kept).chain(&late).cloned().collect();
+    assert_eq!(set(&held.started), expected, "the lookups started: {:?}", held.started);
+    assert_eq!(held.started.len(), expected.len(), "a name was looked up twice: {:?}", held.started);
+    assert!(held.peak <= MAX_LOOKUPS, "{} lookups at once", held.peak);
+    drop(held);
+    for check in &cancelled_checks {
+        assert!(collector.events_of(*check).is_empty(), "{:?}", collector.events_of(*check));
+    }
+    assert_eq!(server.with_stats(|stats| stats.connections), awaited.len());
+    engine.shutdown();
+}
+
+fn salts() -> Vec<ServerSalt> {
+    let now = unix_seconds();
+    vec![ServerSalt { salt: SERVER_SALT, valid_since: now - 60.0, valid_until: now + 3600.0 }]
+}
+
+fn request(id: u64) -> RpcRequest {
+    RpcRequest {
+        id: RequestId(id),
+        body: call(1, &id.to_le_bytes()),
+        flags: RequestFlags::default(),
+        invoke_after: None,
+    }
+}
+
+/// A keyed session that is connected and idle on the worker of the checks, while every lookup place there is held and
+/// more lookups wait: its next request completes on the connection it had, with no drop and no state change.
+#[test]
+fn a_keyed_session_completes_a_request_on_its_connection_while_lookups_stall() {
+    let (collector, lookups) = (Arc::new(Collector::default()), Arc::new(Lookups::default()));
+    let _release = ReleaseAll(lookups.clone());
+    let engine = engine(&collector, &lookups);
+    let key = random_key(9311);
+    let home = TestServer::start(vec![key.clone()], ServerOptions::default());
+    let address = DcAddress { host: "127.0.0.1".into(), port: home.address.port(), secret: None };
+    let mut setup = SessionSetup::new(2, SessionRole::Worker { requires_auth_token: false }, vec![address]);
+    setup.auth_key = Some(AuthKeyMaterial { key, salts: salts(), init_hash: None });
+    let session = engine.create_session(setup);
+    let completed = |id: u64| {
+        move |events: &Events| {
+            events.iter().any(|(handle, event)| {
+                *handle == session
+                    && matches!(event, EngineEvent::Rpc(RpcEvent::Completed { id: done, .. }) if done.0 == id)
+            })
+        }
+    };
+    engine.send(session, request(1));
+    assert!(collector.wait(completed(1)), "the first request did not complete");
+    let disturbed = |event: &EngineEvent| {
+        matches!(event, EngineEvent::ConnectionState { .. } | EngineEvent::ConnectionDropped { .. })
+    };
+    let connected =
+        |event: &EngineEvent| matches!(event, EngineEvent::ConnectionState { state, .. } if state.connected);
+    let settled = collector.wait(|events| {
+        let last = events.iter().rev().find(|(handle, event)| *handle == session && disturbed(event));
+        last.is_some_and(|(_, event)| connected(event))
+    });
+    assert!(settled, "the session did not connect: {:?}", collector.events_of(session));
+    std::thread::sleep(SETTLE);
+    let count = |events: &[EngineEvent]| events.iter().filter(|event| disturbed(event)).count();
+    let before = count(&collector.events_of(session));
+    let connections = home.with_stats(|stats| stats.connections);
+
+    let server = socks5_server();
+    let stalled = names("stalled", 2 * MAX_LOOKUPS);
+    let checks: Vec<_> = stalled.iter().map(|name| check(&engine, &server, name, PATIENT)).collect();
+    assert!(lookups.wait(|held| held.running == MAX_LOOKUPS), "the lookups did not start");
+    engine.send(session, request(2));
+    assert!(collector.wait(completed(2)), "the request did not complete: {:?}", collector.events_of(session));
+    {
+        let held = lookups.held();
+        assert_eq!((held.started.len(), held.running), (MAX_LOOKUPS, MAX_LOOKUPS), "not during the stall");
+    }
+    let worker = |handle: SessionHandle| handle.0 & 0xff;
+    assert!(checks.iter().all(|check| worker(*check) == worker(session)), "a check ran on another worker");
+    assert_eq!(count(&collector.events_of(session)), before, "{:?}", collector.events_of(session));
+    assert_eq!(home.with_stats(|stats| stats.connections), connections);
+    assert_eq!(connections, 1);
+
+    lookups.release_all();
+    assert!(collector.wait(all_reported(&checks)), "not every check reported");
+    for check in &checks {
+        assert_eq!(collector.results(*check), vec![(true, "", 1)]);
+    }
+    engine.shutdown();
+}
