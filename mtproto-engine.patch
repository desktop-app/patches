+    fn temporary_key(&self) -> MTTemporaryKey {
+        MTTemporaryKey {
+            key: bytes(&self.temporary_key),
+            expires_at: mtproto_engine::unix_seconds() as i32 + 86400,
+            bound_to: self.persistent_key_id,
+            salts: std::ptr::null(),
+            salt_count: 0,
+            has_init_hash: 0,
+            init_hash: string(""),
+        }
+    }
