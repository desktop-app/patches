+/// Fills 64 KiB of stack below the caller's frame with the secret: the frames of the caller's next call lie there,
+/// so a value built in them keeps the secret wherever it leaves bytes unused.
+#[inline(never)]
+fn paint_the_stack(secret: &[u8; 16]) {
+    let mut painted = [0u8; 64 * 1024];
+    for (index, byte) in painted.iter_mut().enumerate() {
+        *byte = secret[index % secret.len()];
+    }
+    std::hint::black_box(&mut painted);
