+/// Session calls with a check's handle while its request stalls at the server: a key, PFS, leave to make a permanent
+/// key, a temporary key and a request. None reaches the check, which makes no key and sends nothing but its request;
+/// the request fails as for a handle no session has, and the check ends at its own bound.
+#[test]
+fn a_check_never_asks_for_or_makes_a_key_and_session_calls_do_not_reach_it() {
+    let collector = Arc::new(Collector::default());
+    let engine = engine(&collector, 2);
+    let server = TestServer::start(
+        Vec::new(),
+        ServerOptions { handshake_faults: vec![HandshakeFault::Stall], ..Default::default() },
+    );
+    let mut setup = direct(&server);
+    setup.timeout = 2.0;
+    let handle = engine.start_route_check(setup);
+    assert!(eventually(WAIT, || progress(&server).1 == 1), "the request did not reach the server");
+
+    let material = AuthKeyMaterial { key: random_key(9301), salts: salts(), init_hash: None };
+    engine.set_auth_key(handle, Some(material.clone()));
+    let public_keys = vec![ServerHandshake::new(ServerHandshakeBehavior::default()).public_key()];
+    assert!(engine.enable_pfs(handle, PfsSetup { lifetime: 3600, public_keys, ..Default::default() }));
+    engine.allow_permanent_key(handle, true);
+    let expires_at = unix_seconds() as i32 + 3600;
+    engine.offer_temporary_key(handle, BoundTemporaryKey { material, expires_at, bound_to: None });
+    engine.send(handle, request(1, 1));
+
+    let came = collector.wait(WAIT, |events| !results(events, handle).is_empty());
+    let events = collector.events_of(handle);
+    engine.shutdown();
+    assert!(came, "no result: {events:?}");
+    let refused = |event: &EngineEvent| {
+        matches!(event, EngineEvent::Rpc(RpcEvent::Failed { id, code: -1, message, .. })
+            if id.0 == 1 && message == "SESSION_CLOSED")
+    };
+    assert_eq!(events.len(), 2, "events other than the refused request and the result: {events:?}");
+    assert!(refused(&events[0]), "{events:?}");
+    let (checked, _) = collector.results(handle)[0];
+    assert_refused("stalled", checked, &["timeout"]);
+    assert_eq!(checked.attempts, 1);
+    assert_eq!(progress(&server), (1, 1, 0, 0, 0), "past the stalled request");
+    assert_no_key_work("stalled", &server);
+}
