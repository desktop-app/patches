+        let route = Endpoint::route(server.address);
+        let other_port = Endpoint::sink();
+        let collector = Arc::new(Collector::default());
+        let engine = engine(&collector);
+        let mut setup = setup(&key, vec![route.address()], http_list.then(|| vec![route.address()]));
+        setup.transport = TransportPreference::Http;
+        setup.http_port = Some(other_port.port);
+        let session = engine.create_session(setup);
+        engine.send(session, request(1, 1));
+        let done = if http_list {
+            collector.wait(WAIT, |events| completed(events, session, 1) == 1)
+        } else {
+            eventually(WAIT, || other_port.connections() > 0)
+        };
+        let (at_route, at_other_port) = (route.http(), other_port.connections());
+        engine.shutdown();
+        eprintln!(
+            "HTTP list {http_list}: done {done}, HTTP at the address's port {at_route}, connections to http_port {at_other_port}"
+        );
+        results.push((http_list, done, at_route, at_other_port));
+    }
+    let (_, done, at_route, at_other_port) = results[0];
+    assert!(done && at_route > 0, "the call did not complete at the HTTP address's own port");
+    assert_eq!(at_other_port, 0, "HTTP went to http_port instead of the host's port");
+    let (_, done, _, at_other_port) = results[1];
+    assert!(done && at_other_port > 0, "control: derived routes try http_port first");
+}
+
+/// An empty HTTP list: Auto never falls back, however long TCP gets no answer. The control with
+/// derived routes sends HTTP to the TCP address within the same time.
+#[test]
+fn an_empty_http_list_allows_no_fallback() {
+    let mut results = Vec::new();
+    for empty in [true, false] {
+        let key = random_key(8103);
+        let tcp_only = Endpoint::sink();
+        let collector = Arc::new(Collector::default());
+        let engine = engine(&collector);
+        let mut setup = setup(&key, vec![tcp_only.address()], empty.then(Vec::new));
+        setup.http_port = None;
+        let session = engine.create_session(setup);
+        engine.send(session, request(1, 1));
+        // Auto tries HTTP after 2.5 s of silence or two failed connections.
+        std::thread::sleep(Duration::from_secs(8));
+        let (tcp, http) = (tcp_only.tcp(), tcp_only.http());
+        let switches = collector
+            .count(|event| matches!(event, EngineEvent::ConnectionDropped { reason: DropReason::TransportSwitch, .. }));
+        let done = collector.completed(session, 1);
+        engine.shutdown();
+        eprintln!("empty list {empty}: in 8 s {tcp} TCP and {http} HTTP connections, {switches} switches, {done} done");
+        results.push((empty, tcp, http, switches, done));
+    }
+    let (_, tcp, http, switches, done) = results[0];
+    assert!(tcp > 0, "TCP was never tried");
+    assert_eq!((http, switches, done), (0, 0, 0), "an empty HTTP list still let HTTP through");
+    let (_, _, http, _, _) = results[1];
+    assert!(http > 0, "control: derived routes fall back to HTTP within 8 s");
+}
+
+/// On HTTP, a new HTTP list closes every connection to the old address, and from then on HTTP goes
+/// only to the new one. The TCP address is only a sink, so routes derived from it (ABI 5) complete
+/// nothing at all.
+#[test]
+fn a_new_http_list_moves_http_to_it() {
+    let key = random_key(8104);
+    let server = TestServer::start(vec![key.clone()], ServerOptions::default());
+    let tcp_only = Endpoint::sink();
+    let first = Endpoint::route(server.address);
+    let second = Endpoint::route(server.address);
+    let collector = Arc::new(Collector::default());
+    let engine = engine(&collector);
+    let mut setup = setup(&key, vec![tcp_only.address()], Some(vec![first.address()]));
+    setup.transport = TransportPreference::Http;
+    setup.http_port = None;
+    let session = engine.create_session(setup);
+    engine.send(session, request(1, 1));
+    let first_done = collector.wait(WAIT, |events| completed(events, session, 1) == 1);
+    let first_before = first.http();
+    engine.set_http_addresses(session, vec![second.address()]);
+    engine.send(session, request(2, 2));
+    let second_done = collector.wait(WAIT, |events| completed(events, session, 2) == 1);
+    let old_closed = eventually(Duration::from_secs(5), || first.all_ended());
+    let old_connections = first.connections();
+    engine.send(session, request(3, 3));
+    let third_done = collector.wait(WAIT, |events| completed(events, session, 3) == 1);
+    std::thread::sleep(Duration::from_millis(500));
+    let (old_after, new_http, sink) = (first.connections(), second.http(), tcp_only.connections());
+    engine.shutdown();
+    eprintln!(
+        "first address: {first_before} HTTP connections before the change, {old_after} in all; second address: {new_http} HTTP connections; TCP address: {sink} connections"
+    );
+    assert!(first_done && first_before > 0, "the first call did not complete at the first HTTP address");
+    assert!(second_done && third_done, "calls after the change did not complete");
+    assert!(old_closed, "connections to the old HTTP address stayed open");
+    assert_eq!(old_after, old_connections, "HTTP went to the old address after the change");
+    assert!(new_http > 0, "nothing reached the new HTTP address");
+    assert_eq!(sink, 0, "a session on HTTP connected to its TCP address");
+}
+
+/// The HTTP list it already has changes nothing: the TCP connection stays. A different list voids
+/// the routes as new addresses do: the connection closes and the session reconnects at once.
+#[test]
+fn the_same_http_list_again_changes_nothing_and_a_new_one_reconnects() {
+    let key = random_key(8105);
+    let server = TestServer::start(vec![key.clone()], ServerOptions::default());
+    let tcp = Endpoint::route(server.address);
+    let (first, second) = (Endpoint::sink(), Endpoint::sink());
+    let collector = Arc::new(Collector::default());
+    let engine = engine(&collector);
+    let session = engine.create_session(setup(&key, vec![tcp.address()], Some(vec![first.address()])));
+    engine.send(session, request(1, 1));
+    assert!(collector.wait(WAIT, |events| completed(events, session, 1) == 1));
+    let connected = tcp.connections();
+    engine.set_http_addresses(session, vec![first.address()]);
+    engine.send(session, request(2, 2));
+    let same_done = collector.wait(WAIT, |events| completed(events, session, 2) == 1);
+    std::thread::sleep(Duration::from_millis(300));
+    let (after_same, ended_after_same) = (tcp.connections(), tcp.ended());
+    engine.set_http_addresses(session, vec![second.address()]);
+    engine.send(session, request(3, 3));
+    let new_done = collector.wait(WAIT, |events| completed(events, session, 3) == 1);
+    let (after_new, ended_after_new) = (tcp.connections(), tcp.ended());
+    let http = first.connections() + second.connections();
+    engine.shutdown();
+    eprintln!(
+        "TCP connections: {connected} at first, {after_same} ({ended_after_same} over) after the same list, {after_new} ({ended_after_new} over) after a new one"
+    );
+    assert!(same_done && new_done);
+    assert_eq!((after_same, ended_after_same), (connected, 0), "the same HTTP list again closed the connection");
+    assert!(ended_after_new >= 1 && after_new > after_same, "a new HTTP list kept the old connection");
+    assert_eq!(http, 0, "HTTP was tried while TCP answered");
+}
+
+/// A host holding a session paused changes everything a refresh changes: empty lists, another
+/// transport and environment, then the latest lists. Nothing connects while it is held, nor while it
+/// runs with empty lists; let go, it connects only to the latest TCP address.
+#[test]
+fn a_paused_session_connects_only_after_unpause_to_the_latest_lists() {
+    let key = random_key(8106);
+    let server = TestServer::start(vec![key.clone()], ServerOptions::default());
+    let endpoints: Vec<Endpoint> = (0..4).map(|_| Endpoint::route(server.address)).collect();
+    let [old_tcp, old_http, new_tcp, new_http] = &endpoints[..] else { unreachable!() };
+    let connections = || endpoints.iter().map(Endpoint::connections).sum::<usize>();
+    let collector = Arc::new(Collector::default());
+    let engine = engine(&collector);
+    let mut paused = setup(&key, vec![old_tcp.address()], Some(vec![old_http.address()]));
+    paused.paused = true;
+    paused.transport = TransportPreference::Tcp;
+    paused.environment = Some(environment("first"));
+    let session = engine.create_session(paused);
+    engine.send(session, request(1, 1));
+    std::thread::sleep(Duration::from_millis(300));
+    assert_eq!(connections(), 0, "a session created paused connected");
+
+    engine.set_addresses(session, Vec::new());
+    engine.set_http_addresses(session, Vec::new());
+    engine.set_transport(session, TransportPreference::Http, None);
+    engine.update_environment(session, environment("second"), None);
+    std::thread::sleep(Duration::from_secs(1));
+    assert_eq!(connections(), 0, "a paused session connected after new lists, transport and environment");
+
+    engine.set_paused(session, false);
+    std::thread::sleep(Duration::from_secs(1));
+    assert_eq!(connections(), 0, "a session with empty lists connected");
+
+    engine.set_paused(session, true);
+    engine.set_addresses(session, vec![new_tcp.address()]);
+    engine.set_http_addresses(session, vec![new_http.address()]);
+    engine.set_transport(session, TransportPreference::Auto, Some(80));
+    engine.update_environment(session, environment("third"), None);
+    std::thread::sleep(Duration::from_secs(1));
+    assert_eq!(connections(), 0, "a paused session connected after the latest lists");
+
+    engine.set_paused(session, false);
+    let done = collector.wait(WAIT, |events| completed(events, session, 1) == 1);
+    let seen: Vec<(usize, usize)> = endpoints.iter().map(|endpoint| (endpoint.tcp(), endpoint.http())).collect();
+    engine.shutdown();
+    eprintln!("(TCP, HTTP) connections at old TCP, old HTTP, new TCP, new HTTP: {seen:?}");
+    assert!(done, "the call did not complete after unpause");
+    assert_eq!(old_tcp.connections() + old_http.connections(), 0, "the session connected to an old address");
+    assert!(seen[2].0 > 0, "the call did not go over TCP to the latest address");
+}
+
+/// The session is on Auto with an HTTP probe outstanding (the HTTP address takes it and never answers)
+/// when the host pauses it. The pause alone closes the probe and the TCP connection; the host then
+/// replaces both lists, transport and environment, nothing connects while it is held, and let go the
+/// session reaches the server only through the new lists: TCP to the new TCP address, which never
+/// answers either, and then HTTP to the new HTTP address.
+#[test]
+fn a_pause_during_an_http_probe_connects_only_after_unpause_to_the_latest_lists() {
+    let key = random_key(8107);
+    let server = TestServer::start(vec![key.clone()], ServerOptions::default());
+    let (old_tcp, old_http, new_tcp) = (Endpoint::sink(), Endpoint::sink(), Endpoint::sink());
+    let new_http = Endpoint::route(server.address);
+    let collector = Arc::new(Collector::default());
+    let engine = engine(&collector);
+    let mut setup = setup(&key, vec![old_tcp.address()], Some(vec![old_http.address()]));
+    setup.environment = Some(environment("first"));
+    let session = engine.create_session(setup);
+    engine.send(session, request(1, 1));
+    assert!(eventually(WAIT, || old_http.http() > 0), "Auto never probed the HTTP address");
+
+    engine.set_paused(session, true);
+    let closed = eventually(Duration::from_secs(2), || old_tcp.all_ended() && old_http.all_ended());
+    assert!(closed, "the pause left the probe or the TCP connection open");
+    engine.set_addresses(session, vec![new_tcp.address()]);
+    engine.set_http_addresses(session, vec![new_http.address()]);
+    engine.set_transport(session, TransportPreference::Tcp, Some(80));
+    engine.set_transport(session, TransportPreference::Auto, Some(80));
+    engine.update_environment(session, environment("second"), None);
+    let counts = || [&old_tcp, &old_http, &new_tcp, &new_http].map(Endpoint::connections);
+    let held = counts();
+    std::thread::sleep(Duration::from_secs(1));
+    let still = counts();
+    assert_eq!(still, held, "connections while paused (old TCP, old HTTP, new TCP, new HTTP)");
+    assert_eq!(held[2] + held[3], 0, "the new addresses were used before unpause");
+
+    engine.set_paused(session, false);
+    let done = collector.wait(WAIT, |events| completed(events, session, 1) == 1);
+    let after = counts();
+    let (new_tcp_attempts, new_http_requests) = (new_tcp.tcp(), new_http.http());
+    engine.shutdown();
+    eprintln!("connections (old TCP, old HTTP, new TCP, new HTTP) while paused {held:?}, at the end {after:?}");
+    assert!(done, "the call did not complete after unpause");
+    assert_eq!(after[..2], held[..2], "the session went back to an old address");
+    assert!(new_tcp_attempts > 0 && new_http_requests > 0, "the latest lists were not the ones used");
+}
+
+/// What the host gives a paused session before it lets it go again.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum Restart {
+    /// The lists it has.
+    SameLists,
+    /// Lists naming the second route.
+    NewLists,
+    /// The second route as its SOCKS5 proxy, in place of the first.
+    NewProxy,
+}
+
+/// A call runs on the server while its answer is held on the way back; the host then pauses the
+/// session, gives it its lists (new ones or the same) or a new proxy and lets it go. Both routes lead to
+/// one server, whose session keeps the answer: it comes back once and the call never runs again.
+fn a_call_outstanding_across_a_restart(restart: Restart) {
+    let key = random_key(8108);
+    let socks5 = restart == Restart::NewProxy;
+    let server = TestServer::start(vec![key.clone()], ServerOptions { socks5, ..Default::default() });
+    let (first, second) = (Endpoint::route(server.address), Endpoint::route(server.address));
+    let collector = Arc::new(Collector::default());
+    let engine = engine(&collector);
+    let session = engine.create_session(if socks5 {
+        proxied_setup(&key, socks5_via(&first))
+    } else {
+        setup(&key, vec![first.address()], Some(vec![first.address()]))
+    });
+    engine.send(session, request(1, 1));
+    assert!(collector.wait(WAIT, |events| completed(events, session, 1) == 1), "the first route did not answer");
+    first.hold_open_connections();
+    engine.send(session, request(2, TAG_SLOW));
+    assert!(eventually(WAIT, || server.executions(TAG_SLOW) == 1), "the call never ran");
+    // The server answers TAG_SLOW 300 ms after running it, into the held connection.
+    std::thread::sleep(Duration::from_millis(500));
+    assert_eq!(collector.completed(session, 2), 0, "the held answer reached the session");
+
+    engine.set_paused(session, true);
+    assert!(eventually(Duration::from_secs(5), || first.all_ended()), "the pause left the connection open");
+    let before = (first.connections(), second.connections());
+    if restart == Restart::NewProxy {
+        engine.set_proxy(session, Some(socks5_via(&second)));
+    } else {
+        let route = if restart == Restart::NewLists { second.address() } else { first.address() };
+        engine.set_addresses(session, vec![route.clone()]);
+        engine.set_http_addresses(session, vec![route]);
+    }
+    engine.set_paused(session, false);
+    let done = collector.wait(WAIT, |events| completed(events, session, 2) > 0);
+    std::thread::sleep(Duration::from_millis(1500));
+    let (completions, executions) = (collector.completed(session, 2), server.executions(TAG_SLOW));
+    let after = (first.connections(), second.connections());
+    let redelivered = server.with_stats(|stats| stats.redelivered_answers);
+    engine.shutdown();
+    eprintln!(
+        "{restart:?}: completions {completions}, executions {executions}, connections (first, second) {before:?} -> {after:?}, answers redelivered for repeats {redelivered}"
+    );
+    assert!(done, "the call never completed after unpause");
+    assert_eq!(completions, 1, "the call completed more than once");
+    assert_eq!(executions, 1, "the call ran again");
+    if restart == Restart::SameLists {
+        assert!(after.0 > before.0, "the session did not reconnect");
+        assert_eq!(after.1, 0);
+    } else {
+        assert_eq!(after.0, before.0, "the session went back to the old route");
+        assert!(after.1 > before.1, "the session did not connect to the new route");
+    }
+}
+
+#[test]
+fn a_call_outstanding_across_a_pause_and_new_lists_runs_and_completes_once() {
+    a_call_outstanding_across_a_restart(Restart::NewLists);
+}
+
+#[test]
+fn a_call_outstanding_across_a_forced_restart_runs_and_completes_once() {
+    a_call_outstanding_across_a_restart(Restart::SameLists);
+}
+
+/// A SOCKS5 proxy in front of a `socks5: true` test server: one of the forwarding endpoints. With
+/// credentials, so that the greeting (methods 0 and 2) fills the four bytes the forwarder reads before it
+/// connects upstream.
+fn socks5_via(endpoint: &Endpoint) -> ProxyConfig {
+    ProxyConfig::Socks5 {
+        host: "127.0.0.1".into(),
+        port: endpoint.port,
+        username: Some("user".into()),
+        password: Some("secret".into()),
+    }
+}
+
+/// A session behind a proxy, given a datacenter address the proxy takes it to.
+fn proxied_setup(key: &AuthKey, proxy: ProxyConfig) -> SessionSetup {
+    let tcp = DcAddress { host: "149.154.167.51".into(), port: 443, secret: None };
+    let http = DcAddress { host: "149.154.167.51".into(), port: 80, secret: None };
+    let mut setup = setup(key, vec![tcp], Some(vec![http]));
+    setup.proxy = Some(proxy);
+    setup
+}
+
+/// A host holding a session paused gives it another proxy: nothing connects while it is held, at the
+/// old proxy or the new one; let go, the session connects through the new one only.
+#[test]
+fn a_paused_session_given_a_new_proxy_connects_only_after_unpause_through_it() {
+    let key = random_key(8109);
+    let server = TestServer::start(vec![key.clone()], ServerOptions { socks5: true, ..Default::default() });
+    let (first, second) = (Endpoint::route(server.address), Endpoint::route(server.address));
+    let collector = Arc::new(Collector::default());
+    let engine = engine(&collector);
+    let session = engine.create_session(proxied_setup(&key, socks5_via(&first)));
+    engine.send(session, request(1, 1));
+    assert!(
+        collector.wait(WAIT, |events| completed(events, session, 1) == 1),
+        "the first proxy did not carry the call"
+    );
+
+    engine.set_paused(session, true);
+    assert!(eventually(Duration::from_secs(5), || first.all_ended()), "the pause left the connection open");
+    let held = (first.connections(), second.connections());
+    engine.set_proxy(session, Some(socks5_via(&second)));
+    std::thread::sleep(Duration::from_secs(1));
+    let still = (first.connections(), second.connections());
+
+    engine.set_paused(session, false);
+    engine.send(session, request(2, 2));
+    let done = collector.wait(WAIT, |events| completed(events, session, 2) == 1);
+    let after = (first.connections(), second.connections());
+    engine.shutdown();
+    eprintln!(
+        "connections (first proxy, second proxy): {held:?} at the pause, {still:?} a second after the new proxy, {after:?} after unpause"
+    );
+    assert_eq!(still, held, "a paused session connected after it was given a new proxy");
+    assert_eq!(held.1, 0);
+    assert!(done, "the call did not complete through the new proxy");
+    assert_eq!(after.0, held.0, "the session went back to the old proxy");
+    assert!(after.1 > 0, "the session did not connect through the new proxy");
+}
+
+/// `a_call_outstanding_across_a_restart` across a paused switch to a second SOCKS5 proxy.
+#[test]
+fn a_call_outstanding_across_a_paused_proxy_switch_runs_and_completes_once() {
+    a_call_outstanding_across_a_restart(Restart::NewProxy);
+}
