+impl TelegramStart {
+    fn new() -> Self {
+        let persistent_key = core::array::from_fn(|index| (index as u8).wrapping_mul(7) ^ 0xa3);
+        let persistent_key_id = AuthKey::from_slice(&persistent_key).expect("a 256-byte key").id() as i64;
+        let temporary_key = core::array::from_fn(|index| (index as u8).wrapping_mul(11) ^ 0x6c);
+        Self { persistent_key, persistent_key_id, temporary_key, pem: test_rsa_public_key_pem() }
+    }
