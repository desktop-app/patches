+#[test]
+fn a_dependent_of_a_surfaced_failure_reaches_the_host_when_it_orders_dependents() {
+    for ((code, message), (wait_code, wait_message)) in FAILED_DEPENDENCIES {
+        let context = format!("{code} {message}, then {wait_code} {wait_message}");
+        let mut h = Harness::new(SessionRole::Main, Some("h1"));
+        let (first, dependent) = h.send_chained(host_retries(true));
+        h.reply(vec![Outgoing::Content(rpc_error(first, code, message))]);
+        assert_eq!(failed_with(&h.events(), 1), Some((code, message.into())), "{context}: the host retries it");
+        h.reply(vec![Outgoing::Content(rpc_error(dependent, wait_code, wait_message))]);
+        assert_eq!(
+            failed_with(&h.events(), 2),
+            Some((wait_code, wait_message.into())),
+            "{context}: as the server said"
+        );
+        assert_eq!(h.client.request_count(), 0, "{context}: the host has both");
+        h.assert_quiet(&context);
+
+        // The dependent's answer can come while the request it waits for is still in flight.
+        let mut h = Harness::new(SessionRole::Main, Some("h1"));
+        let (first, dependent) = h.send_chained(host_retries(true));
+        h.reply(vec![Outgoing::Content(rpc_error(dependent, wait_code, wait_message))]);
+        assert_eq!(failed_with(&h.events(), 2), Some((wait_code, wait_message.into())), "{context}: before 1");
+        h.reply(vec![Outgoing::Content(rpc_result(first, &[1, 0, 0, 0]))]);
+        let events = h.events();
+        assert!(events.iter().any(|e| matches!(e, RpcEvent::Completed { id: RequestId(1), .. })), "{context}");
+        h.assert_quiet(&context);
+    }
