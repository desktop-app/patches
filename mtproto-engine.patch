--- /dev/null
+++ b/crates/mtproto-engine/src/engine_thread.rs
@@ -0,0 +1,79 @@
+use std::io;
+use std::thread::{Builder, JoinHandle};
+
+/// Starts one of the engine's threads. A panic on it ends the process, as the engine's own `panic = "abort"`
+/// profile does: in a host built with `panic = "unwind"` the thread would otherwise end alone and leave the engine
+/// without its worker or resolver, with requests that never complete.
+pub fn spawn(builder: Builder, body: impl FnOnce() + Send + 'static) -> io::Result<JoinHandle<()>> {
+    builder.spawn(move || {
+        // Kept until the abort: a payload whose drop panics would otherwise end only this thread.
+        let result = std::panic::catch_unwind(std::panic::AssertUnwindSafe(body));
+        if result.is_err() {
+            std::process::abort();
+        }
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use std::process::Command;
+
+    const CHILD: &str = "MTPROTO_ENGINE_THREAD_PANIC_CHILD";
+
+    /// Re-runs this binary on `test` alone, with `CHILD` set to that name: the child runs `body` on an engine thread
+    /// and exits zero if it outlives the thread. Its stderr must hold `panicked`, and it must abort.
+    fn assert_child_aborts(test: &str, body: fn(), panicked: &str) {
+        if std::env::var_os(CHILD).is_some_and(|child| child == test) {
+            let thread = super::spawn(std::thread::Builder::new().name("mtproto-test".into()), body).unwrap();
+            // Not dropped: a payload that panics on drop would fail the child here, before its exit(0).
+            let _result = thread.join();
+            std::process::exit(0);
+        }
+        let output = Command::new(std::env::current_exe().unwrap())
+            .args(["--exact", test, "--nocapture"])
+            .env(CHILD, test)
+            .output()
+            .unwrap();
+        let stderr = String::from_utf8_lossy(&output.stderr);
+        assert!(stderr.contains(panicked), "the child's thread did not panic: {stderr}");
+        #[cfg(unix)]
+        {
+            use std::os::unix::process::ExitStatusExt;
+            assert_eq!(output.status.signal(), Some(libc::SIGABRT), "{:?}: {stderr}", output.status);
+        }
+        // std::process::abort is __fastfail: STATUS_STACK_BUFFER_OVERRUN, but an access violation on Windows 7.
+        #[cfg(windows)]
+        assert!(
+            [Some(0xC000_0409_u32 as i32), Some(0xC000_0005_u32 as i32)].contains(&output.status.code()),
+            "the child did not abort: {:?}: {stderr}",
+            output.status
+        );
+    }
+
+    #[test]
+    fn a_panic_on_an_engine_thread_aborts_the_process() {
+        assert_child_aborts(
+            "engine_thread::tests::a_panic_on_an_engine_thread_aborts_the_process",
+            || panic!("engine thread panic"),
+            "engine thread panic",
+        );
+    }
+
+    struct PanicOnDrop;
+
+    impl Drop for PanicOnDrop {
+        fn drop(&mut self) {
+            panic!("payload drop");
+        }
+    }
+
+    #[test]
+    fn a_panic_payload_that_panics_on_drop_still_aborts_the_process() {
+        assert_child_aborts(
+            "engine_thread::tests::a_panic_payload_that_panics_on_drop_still_aborts_the_process",
+            || std::panic::panic_any(PanicOnDrop),
+            // The default hook prints no message for this payload, only where it panicked.
+            &format!("panicked at {}:", file!()),
+        );
+    }
+}
