+impl Harness {
+    /// The calls that go out, each with its msg_id and the body as sent.
+    fn flush_call_bodies(&mut self) -> Vec<(i64, Vec<u8>)> {
+        let mut calls = Vec::new();
+        for _ in 0..10 {
+            self.advance(0.002);
+            let _ = self.client.handle_timeout(self.now);
+            if let Some(transmit) = self.client.poll_transmit(self.now, &mut self.rng) {
+                let packet = self.server.decode(&transmit.data);
+                calls.extend(
+                    packet
+                        .messages
+                        .into_iter()
+                        .filter(|message| unwrap_call(&message.body).1.is_some())
+                        .map(|message| (message.msg_id, message.body)),
+                );
+            }
+        }
+        calls
+    }
