+    /// Asks for the first address, applies `change` and then admits that first ask: the answer opens
+    /// nothing, and the session asks anew.
+    fn a_late_answer_after(what: &str, change: impl FnOnce(&mut Gate, &DcAddress, &DcAddress)) {
+        let (mut tcp, mut other) = (Sink::new(), Sink::new());
+        let mut gate =
+            Gate::new(gate_setup(vec![tcp.address()], vec![tcp.address()], TransportPreference::Tcp), true);
+        gate.drive();
+        assert_eq!(gate.asked_for(RouteTransport::Tcp, tcp.port()), [1]);
+        change(&mut gate, &tcp.address(), &other.address());
+        gate.admit(1, true);
+        gate.drive();
+        assert!(gate.runtime.connection.is_none(), "{what}: the late answer opened a connection");
+        assert_eq!(tcp.taken() + other.taken(), 0, "{what}: the late answer opened a connection");
+        assert_eq!(gate.asked_for(RouteTransport::Tcp, tcp.port()), [1, 2], "{what}: the route was not asked anew");
+        gate.shutdown();
+    }
