+/// The flags of a host that keeps flood waits, server error retries and, with
+/// `surface_dependency_waits`, the order of dependent requests to itself.
+fn host_retries(surface_dependency_waits: bool) -> RequestFlags {
+    RequestFlags {
+        automatic_flood_wait: false,
+        retry_server_errors: false,
+        surface_dependency_waits,
+        ..Default::default()
+    }
+}
+
+/// The error of the request waited for, which the host retries itself, and the server's answer to the
+/// request chained after it: 400, 500 and negative codes.
+const FAILED_DEPENDENCIES: [((i32, &str), (i32, &str)); 4] = [
+    ((420, "FLOOD_WAIT_3"), (400, "MSG_WAIT_FAILED")),
+    ((500, "INTERNAL_SERVER_ERROR"), (500, "MSG_WAIT_FAILED")),
+    ((-503, "Timeout"), (-503, "MSG_WAIT_TIMEOUT")),
+    ((-500, "SOMETHING"), (400, "MSG_WAIT_TIMEOUT")),
+];
+
+impl Harness {
+    /// Request 1 and request 2 chained after it, both with `flags`: the msg_ids they went under. Request
+    /// 2 goes with invokeAfterMsg, request 1 being in flight.
+    fn send_chained(&mut self, flags: RequestFlags) -> (i64, i64) {
+        self.send(1, flags);
+        self.client
+            .send(RpcRequest { id: RequestId(2), body: call(2), flags, invoke_after: Some(RequestId(1)) }, self.now);
+        let calls = self.flush_calls();
+        let first = calls.iter().find(|c| c.2 == 1).expect("request 1 went").0;
+        let dependent = calls.iter().find(|c| c.2 == 2).expect("request 2 went");
+        assert_eq!(dependent.1, vec![ids::INVOKE_AFTER_MSG]);
+        (first, dependent.0)
+    }
+
+    /// Nothing goes out and nothing is reported for a while longer than any wait the client keeps.
+    fn assert_quiet(&mut self, context: &str) {
+        self.advance(SERVER_ERROR_MAX_RETRY_DELAY + 4.0);
+        assert!(self.flush_calls().is_empty(), "{context}: nothing is sent again by the client");
+        let events = self.events();
+        assert!(
+            !events.iter().any(|e| matches!(e, RpcEvent::Completed { .. } | RpcEvent::Failed { .. })),
+            "{context}: {events:?}"
+        );
+    }
+}
+
+#[test]
+fn a_dependent_of_a_surfaced_failure_reaches_the_host_when_it_orders_dependents() {
+    for ((code, message), (wait_code, wait_message)) in FAILED_DEPENDENCIES {
+        let context = format!("{code} {message}, then {wait_code} {wait_message}");
+        let mut h = Harness::new(SessionRole::Main, Some("h1"));
+        let (first, dependent) = h.send_chained(host_retries(true));
+        h.reply(vec![Outgoing::Content(rpc_error(first, code, message))]);
+        assert_eq!(failed_with(&h.events(), 1), Some((code, message.into())), "{context}: the host retries it");
+        h.reply(vec![Outgoing::Content(rpc_error(dependent, wait_code, wait_message))]);
+        assert_eq!(
+            failed_with(&h.events(), 2),
+            Some((wait_code, wait_message.into())),
+            "{context}: as the server said"
+        );
+        assert_eq!(h.client.request_count(), 0, "{context}: the host has both");
+        h.assert_quiet(&context);
+
+        // The dependent's answer can come while the request it waits for is still in flight.
+        let mut h = Harness::new(SessionRole::Main, Some("h1"));
+        let (first, dependent) = h.send_chained(host_retries(true));
+        h.reply(vec![Outgoing::Content(rpc_error(dependent, wait_code, wait_message))]);
+        assert_eq!(failed_with(&h.events(), 2), Some((wait_code, wait_message.into())), "{context}: before 1");
+        h.reply(vec![Outgoing::Content(rpc_result(first, &[1, 0, 0, 0]))]);
+        let events = h.events();
+        assert!(events.iter().any(|e| matches!(e, RpcEvent::Completed { id: RequestId(1), .. })), "{context}");
+        h.assert_quiet(&context);
+    }
+}
+
+#[test]
+fn without_host_ordering_a_dependent_of_a_surfaced_failure_goes_again_at_once() {
+    for ((code, message), (wait_code, wait_message)) in FAILED_DEPENDENCIES {
+        let context = format!("{code} {message}, then {wait_code} {wait_message}");
+        let mut h = Harness::new(SessionRole::Main, Some("h1"));
+        let (first, dependent) = h.send_chained(host_retries(false));
+        h.reply(vec![Outgoing::Content(rpc_error(first, code, message))]);
+        assert_eq!(failed_with(&h.events(), 1), Some((code, message.into())), "{context}");
+        h.reply(vec![Outgoing::Content(rpc_error(dependent, wait_code, wait_message))]);
+        assert!(failed_with(&h.events(), 2).is_none(), "{context}: the client keeps the dependent");
+        let calls = h.flush_calls();
+        assert_eq!(calls.iter().map(|c| c.2).collect::<Vec<_>>(), vec![2], "{context}: goes again at once");
+        assert!(calls[0].1.is_empty(), "{context}: and unchained, though the host still has request 1 to retry");
+    }
+}
