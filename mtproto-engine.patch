+#[test]
+fn an_answer_to_a_superseded_initialization_stores_nothing() {
+    let mut h = Harness::new(SessionRole::Main, None);
+    // A paused session: the call waits for a connection, already wrapped with the environment of now.
+    h.client.connection_closed(h.now);
+    h.send(1, RequestFlags::default());
+    let mut replaced = environment("h2");
+    replaced.device_model = "PC".into();
+    h.client.update_environment(replaced, None, h.now);
+    h.client.connection_opened(h.now);
+    let sent = h.flush_call_bodies();
+    assert_eq!(sent.len(), 1);
+    assert_eq!(init_device_model(&sent[0].1), Some(b"Mac".to_vec()), "the call went as it was wrapped");
+    h.reply(vec![Outgoing::Content(rpc_result(sent[0].0, &[1, 0, 0, 0]))]);
+    let events = h.events();
+    assert!(events.iter().any(|event| matches!(event, RpcEvent::Completed { id: RequestId(1), .. })));
+    assert!(
+        !events.iter().any(|event| matches!(event, RpcEvent::InitHashStored { .. })),
+        "the server was initialized with the old environment, not with h2: {events:?}"
+    );
+    assert_eq!(h.client.stored_init_hash(), None);
+
+    h.send(2, RequestFlags::default());
+    let sent = h.flush_call_bodies();
+    assert_eq!(init_device_model(&sent[0].1), Some(b"PC".to_vec()), "the next call initializes with h2");
+    h.reply(vec![Outgoing::Content(rpc_result(sent[0].0, &[2, 0, 0, 0]))]);
+    assert!(h.events().contains(&RpcEvent::InitHashStored { hash: "h2".into() }));
+    assert_eq!(h.client.stored_init_hash(), Some("h2"));
+    h.send(3, RequestFlags::default());
+    assert_eq!(init_device_model(&h.flush_call_bodies()[0].1), None, "initialized with h2 now");
