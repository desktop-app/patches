+/// Checks run on the worker of a keyed session that is connected and idle: through proxies to other servers, one
+/// refused and one cut short by a cancel. The session's connection stays as it was, it reports no drop and no state,
+/// and its next call completes on that connection.
+#[test]
+fn a_check_leaves_a_running_session_alone() {
+    let collector = Arc::new(Collector::default());
+    let engine = engine(&collector, 2);
+    let key = random_key(9302);
+    let home = TestServer::start(vec![key.clone()], ServerOptions::default());
+    let address = DcAddress { host: "127.0.0.1".into(), port: home.address.port(), secret: None };
+    let mut setup = SessionSetup::new(2, SessionRole::Worker { requires_auth_token: false }, vec![address]);
+    setup.auth_key = Some(AuthKeyMaterial { key, salts: salts(), init_hash: None });
+    let session = engine.create_session(setup);
+    let completed = |id: u64| {
+        move |events: &[(SessionHandle, EngineEvent, Instant)]| {
+            events.iter().any(|(handle, event, _)| {
+                *handle == session
+                    && matches!(event, EngineEvent::Rpc(RpcEvent::Completed { id: done, .. }) if done.0 == id)
+            })
+        }
+    };
+    engine.send(session, request(1, 1));
+    assert!(collector.wait(WAIT, completed(1)), "the session's first call did not complete");
+    let disturbed = |event: &EngineEvent| {
+        matches!(event, EngineEvent::ConnectionState { .. } | EngineEvent::ConnectionDropped { .. })
+    };
+    // Settled: the last state said connected, and none came for half a second.
+    let settled = || {
+        let events = collector.events.lock().unwrap();
+        let last = events.iter().rev().find(|(handle, event, _)| *handle == session && disturbed(event));
+        last.is_some_and(|(_, event, at)| {
+            matches!(event, EngineEvent::ConnectionState { state, .. } if state.connected)
+                && at.elapsed() > Duration::from_millis(500)
+        })
+    };
+    assert!(eventually(WAIT, settled), "the session did not settle: {:?}", collector.events_of(session));
+    let before = collector.events_of(session).iter().filter(|event| disturbed(event)).count();
+    let home_before = (home.with_stats(|stats| stats.connections), closed_by_client(&home));
+
+    let (padded, wrong) = padded();
+    let socks = TestServer::start(Vec::new(), ServerOptions { socks5: true, ..Default::default() });
+    let dd = TestServer::start(Vec::new(), ServerOptions { secret: Some(padded.clone()), ..Default::default() });
+    let stalled = TestServer::start(
+        Vec::new(),
+        ServerOptions { handshake_faults: vec![HandshakeFault::Stall], ..Default::default() },
+    );
+    let mut handles = Vec::new();
+    for setup in [through(socks5(&socks, None)), through(mtproxy("127.0.0.1", &dd, &padded))] {
+        let (handle, checked, _) = check(&engine, &collector, setup);
+        assert!(checked.answered, "{checked:?}");
+        handles.push(handle);
+    }
+    let (handle, checked, _) = check(&engine, &collector, through(mtproxy("127.0.0.1", &dd, &wrong)));
+    assert_refused("a wrong secret", checked, &CLOSED);
+    handles.push(handle);
+    let cancelled = engine.start_route_check(direct(&stalled));
+    assert!(eventually(WAIT, || progress(&stalled).1 == 1), "the stalled request did not arrive");
+    engine.cancel_route_check(cancelled);
+    assert!(eventually(WAIT, || closed_by_client(&stalled) == 1), "the cancel left the connection open");
+    handles.push(cancelled);
+
+    engine.send(session, request(2, 1));
+    let done = collector.wait(WAIT, completed(2));
+    let events = collector.events_of(session);
+    let home_after = (home.with_stats(|stats| stats.connections), closed_by_client(&home));
+    engine.shutdown();
+    let worker = |handle: SessionHandle| handle.0 & 0xff;
+    assert!(handles.iter().all(|handle| worker(*handle) == worker(session)), "a check ran on another worker");
+    assert!(done, "the session's call after the checks did not complete: {events:?}");
+    let after = events.iter().filter(|event| disturbed(event)).count();
+    assert_eq!(after, before, "the session reported a drop or a state during the checks: {events:?}");
+    assert_eq!(home_after, home_before, "the session's connection changed");
+    assert_eq!(home_after.0, 1);
+}
