+#[test]
+fn a_dependent_of_a_failed_request_reaches_the_host_that_asks_for_it() {
+    let rig = Rig::new(602);
+    let port = rig.server.address.port();
+
+    // A floods; B, chained after it with invokeAfterMsg, hears MSG_WAIT_FAILED and the host gets it.
+    let host_ordered = rig.paused_session(port);
+    let first = rig.send(host_ordered, TAG_FLOOD_ONCE, 0, 0);
+    let dependent = rig.send(host_ordered, 7, SURFACE_DEPENDENCY_WAITS, first);
+    rig.resume(host_ordered);
+    let failed = rig.wait_finished(host_ordered, first).expect("A finished");
+    assert_eq!((failed.kind, failed.code, failed.text.as_str()), (FAILED, 420, "FLOOD_WAIT_1"));
+    let failed = rig.wait_finished(host_ordered, dependent).expect("B finished");
+    assert_eq!((failed.kind, failed.code, failed.text.as_str()), (FAILED, 400, "MSG_WAIT_FAILED"));
+    assert!(rig.server.with_stats(|stats| stats.invoke_after) >= 1, "B rode with invokeAfterMsg");
+    std::thread::sleep(Duration::from_millis(1500));
+    assert_eq!(rig.server.executions(7), 0, "B never ran: the host sends it again once A is through");
+    let finished_b = rig
+        .sink
+        .of(host_ordered)
+        .iter()
+        .filter(|e| e.request == dependent && (e.kind == COMPLETED || e.kind == FAILED))
+        .count();
+    assert_eq!(finished_b, 1, "B finished once, as failed");
+
+    // The control without the flag: the engine waits for A, which has left, and sends B again at once.
+    let engine_ordered = rig.paused_session(port);
+    let first = rig.send(engine_ordered, TAG_SERVER_ERROR_ONCE, 0, 0);
+    let dependent = rig.send(engine_ordered, 8, 0, first);
+    rig.resume(engine_ordered);
+    let failed = rig.wait_finished(engine_ordered, first).expect("A finished");
+    assert_eq!((failed.kind, failed.code), (FAILED, 500));
+    let completed = rig.wait_finished(engine_ordered, dependent).expect("B finished");
+    assert_eq!(completed.kind, COMPLETED, "{completed:?}");
+    assert_eq!(rig.server.with_stats(|stats| stats.msg_wait_failures), 2, "both Bs heard MSG_WAIT_FAILED first");
+    assert_eq!(rig.server.executions(8), 1, "B ran once, sent again without invokeAfterMsg");
+}
