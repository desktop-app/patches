+        let runs = [(false, &RECONNECT_DELAYS[..], 300.0), (true, &URGENT_RECONNECT_DELAYS[..], 120.0)];
+        for (urgent, ladder, window) in runs {
+            let three = failing_attempts(&ips, port, JITTER, urgent, window);
+            assert!(three.len() >= 40, "urgent {urgent}: {} attempts", three.len());
+            for (n, (at, target, delay)) in three.iter().enumerate() {
+                assert_eq!(*target, addresses[n % 3], "urgent {urgent}: attempt {n}, {at} s in");
+                let step = ladder[n.min(ladder.len() - 1)];
