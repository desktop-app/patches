index 0000000..ea5f557
--- /dev/null
+++ b/crates/mtproto-engine/src/wiped.rs
@@ -0,0 +1,93 @@
+//! A box whose every byte is wiped before it is freed, for the values a host builds and hands the engine and for
+//! what the engine keeps of them. Such a value leaves bytes unused (a `None` field's payload, padding) that keep
+//! what the building thread's stack held, and every move copies them; in a box of its own the value moves as a
+//! pointer. When the value is dropped or taken out, a byte array laid over all of its space is written and
+//! zeroized, as mtproto-core's `WipedAes256` does. `Option::zeroize` is not used: it ends by writing a `None`
+//! copied from a stack temporary whose payload bytes are uninitialized, which puts stack bytes back.
+
+use std::ops::{Deref, DerefMut};
+
+use mtproto_core::Zeroize;
+
+/// The bytes that cover a value's slot after the tag: `align_of - 1 + size_of` of them. One registration per
+/// type (`overlay!`), as stable Rust computes no array length from a type parameter.
+pub(crate) trait Overlay: Sized {
+    type Bytes: Zeroize;
+    const ZERO: Self::Bytes;
+}
+
+/// `repr(u8)` puts the tag first and each variant's fields after it, so `Wiped` lies over every byte after the
+/// tag: the value's and the padding in front of it.
+#[repr(u8)]
+enum Slot<T: Overlay> {
+    Value(T),
+    Wiped(T::Bytes),
+}
+
+pub(crate) struct Wiped<T: Overlay>(Slot<T>);
+
+impl<T: Overlay> Wiped<T> {
+    #[inline(always)]
+    pub(crate) fn boxed(value: T) -> Box<Self> {
+        Box::new(Self(Slot::Value(value)))
+    }
+
+    /// The value, moved out into the caller's frame; the box is wiped before it is freed.
+    #[inline(always)]
+    pub(crate) fn take(mut self: Box<Self>) -> T {
+        match std::mem::replace(&mut self.0, Slot::Wiped(T::ZERO)) {
+            Slot::Value(value) => value,
+            Slot::Wiped(_) => unreachable!("only take and drop wipe the value"),
+        }
+    }
+}
+
+impl<T: Overlay> Deref for Wiped<T> {
+    type Target = T;
+
+    fn deref(&self) -> &T {
+        match &self.0 {
+            Slot::Value(value) => value,
+            Slot::Wiped(_) => unreachable!("only take and drop wipe the value"),
+        }
+    }
+}
+
+impl<T: Overlay> DerefMut for Wiped<T> {
+    fn deref_mut(&mut self) -> &mut T {
+        match &mut self.0 {
+            Slot::Value(value) => value,
+            Slot::Wiped(_) => unreachable!("only take and drop wipe the value"),
+        }
+    }
+}
+
+impl<T: Overlay> Drop for Wiped<T> {
+    fn drop(&mut self) {
+        // The assignment drops the value where it lies; the volatile writes then survive the free that follows.
+        self.0 = Slot::Wiped(T::ZERO);
+        if let Slot::Wiped(bytes) = &mut self.0 {
+            bytes.zeroize();
+        }
+    }
+}
+
+macro_rules! overlay {
+    ($($value:ty),* $(,)?) => {$(
+        impl Overlay for $value {
+            type Bytes = [u8; align_of::<$value>() - 1 + size_of::<$value>()];
+            const ZERO: Self::Bytes = [0; align_of::<$value>() - 1 + size_of::<$value>()];
+        }
+        const _: () = assert!(size_of::<Slot<$value>>() == align_of::<$value>() + size_of::<$value>());
+    )*};
+}
+
+overlay!(
+    crate::worker::Command,
+    crate::types::SessionSetup,
+    crate::session_runtime::SessionRuntime,
+    crate::types::PfsSetup,
+    crate::types::BoundTemporaryKey,
+    mtproto_core::rpc::ApiEnvironment,
+    crate::types::WebEndpoint,
+);
