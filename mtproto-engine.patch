+    let port = listener.local_addr().unwrap().port();
+    let (steps, proxy_steps) = mpsc::channel();
+    let proxy_thread = std::thread::spawn(move || silent_proxy(listener, steps));
+    let secret = off_the_test_stack(|| [&[0xeeu8][..], &proxy_key(), b"www.example.com"].concat());
+    let proxy = off_the_test_stack(|| proxy_key().to_vec());
+    let mut config = setup_at(SocketAddr::from(([149, 154, 167, 51], 443)), Some(&random_key(seed)));
