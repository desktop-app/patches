+            Box::new(move |server: &TestServer| through(mtproxy("127.0.0.1", server, &padded))),
+        ),
+        (
+            "mtproxy ee",
+            ServerOptions { secret: Some(fake_tls.clone()), ..Default::default() },
+            Box::new(move |server: &TestServer| through(mtproxy("127.0.0.1", server, &fake_tls))),
+        ),
+    ];
+    for (what, options, route) in routes {
