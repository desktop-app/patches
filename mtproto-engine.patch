+    fn the_kernel_send_queue_counts_bytes_in_flight_and_drains_once_the_peer_read_them() {
+        use std::time::Duration;
+        const TOTAL: usize = 32 * 1024 * 1024;
+        let listener = std::net::TcpListener::bind("127.0.0.1:0").unwrap();
+        let mut client = std::net::TcpStream::connect(listener.local_addr().unwrap()).unwrap();
+        let (mut peer, _) = listener.accept().unwrap();
+        let observed = mio::net::TcpStream::from_std(client.try_clone().unwrap());
+        assert_eq!(kernel_send_queue(&observed), Some(0), "nothing sent yet");
+        peer.set_read_timeout(Some(Duration::from_secs(10))).unwrap();
+        let reader = std::thread::spawn(move || {
+            let mut buffer = vec![0u8; 64 * 1024];
+            let mut received = 0;
+            while received < TOTAL {
+                match peer.read(&mut buffer) {
+                    Ok(0) => break,
+                    Ok(read) => received += read,
+                    Err(error) => panic!("peer read failed after {received} bytes: {error}"),
