+    /// Without a class change an offer replaces no key in use: neither K itself, with the class command
+    /// repeating the class the session has, nor another key, which waits. The call in flight goes on.
+    /// The class change that follows drops K, and the waiting key was offered for the old class: it is
+    /// not taken for the new one.
+    #[test]
+    fn offers_wait_while_the_key_is_in_use_and_a_class_change_forgets_them() {
+        let perm = random_key(4401);
+        let server = live_server(&perm);
+        let (mut live, regular) = bound_worker(&server, &perm);
+        let regular_id = regular.material.key.id();
+        let other = live.other_key(4403);
+        live.send(2, TAG_NEVER);
+        assert!(live.until(|_| server.executions(TAG_NEVER) == 1), "call 2 never reached the server");
+
+        live.set_class(REGULAR);
+        live.offer(regular);
+        live.offer(other);
+        live.drive();
+        for _ in 0..50 {
+            live.turn();
+        }
+        assert_eq!(live.key_in_use(), Some(regular_id));
+        assert_eq!(live.in_use().len(), 1, "keys in use {:x?}", live.in_use());
+        assert!(live.failures(2).is_empty(), "the call in flight failed: {:?}", live.failures(2));
+        assert!(live.runtime.connection.is_some(), "the connection went");
+        live.send(3, 3);
+        assert!(live.until(|live| live.completions(3) == 1), "call 3 never completed: {:?}", live.failures(3));
+
+        live.pause(true);
+        live.set_class(MEDIA);
+        live.drive();
+        assert_eq!(live.key_in_use(), None, "a key offered for the Regular class was taken for the media class");
+        assert_eq!(live.in_use().len(), 1);
+        assert_eq!(live.failures(2), [(500, "TEMP_KEY_ROTATED".to_string())]);
+        assert_eq!(live.created_keys(), 1);
+        live.shutdown();
+    }
+
+    /// The move back offers K with a binding to another permanent key: it is refused, and the session
+    /// makes a key of its own once the pause ends.
+    #[test]
+    fn a_move_to_the_media_class_and_back_refuses_the_key_bound_to_another_permanent_key() {
+        let perm = random_key(4401);
+        let server = live_server(&perm);
+        let (mut live, regular) = bound_worker(&server, &perm);
+        let regular_id = regular.material.key.id();
+        let foreign = BoundTemporaryKey { bound_to: Some(perm.id() ^ 1), ..regular };
+        live.pause(true);
+        let handshakes = server.with_stats(|stats| stats.handshakes);
+
+        move_and_back(&mut live, None, foreign, false);
+
+        assert_eq!(live.key_in_use(), None, "the key bound to another permanent key was taken");
+        assert_eq!(live.in_use().len(), 1);
+        live.pause(false);
+        live.send(2, 2);
+        assert!(live.until(|live| live.completions(2) == 1), "call 2 never completed: {:?}", live.failures(2));
+        assert_eq!(server.with_stats(|stats| stats.handshakes), handshakes + 1, "no key was made instead");
+        let made = live.in_use().last().copied().expect("a key in use");
+        assert!(made.0 != regular_id && !made.1 && made.2 == i32::from(REGULAR), "keys in use {:x?}", live.in_use());
+        live.shutdown();
