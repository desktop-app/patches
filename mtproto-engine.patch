+#[cfg(test)]
+mod tests {
+    use mtproto_core::rpc::{ApiEnvironment, ClientProxy, wrap_request};
+
+    use super::*;
+
+    fn after(msg_id: i64, body: &[u8]) -> Vec<u8> {
+        let mut writer = Writer::new();
+        writer.write_u32(ids::INVOKE_AFTER_MSG);
+        writer.write_i64(msg_id);
+        writer.write_raw(body);
+        writer.into_inner()
+    }
+
+    fn without_updates(body: &[u8]) -> Vec<u8> {
+        let mut writer = Writer::new();
+        writer.write_u32(ids::INVOKE_WITHOUT_UPDATES);
+        writer.write_raw(body);
+        writer.into_inner()
+    }
+
+    #[test]
+    fn the_invoke_after_msg_id_is_kept_through_gzip() {
+        let inner = call(7, &[1, 2, 3]);
+        for (body, expected, updates_off) in [
+            (inner.clone(), None, false),
+            (after(0x1234, &inner), Some(0x1234), false),
+            (after(0x1234, &sp::gzip_packed(&inner)), Some(0x1234), false),
+            (sp::gzip_packed(&after(0x5678, &without_updates(&inner))), Some(0x5678), true),
+            (without_updates(&sp::gzip_packed(&after(0x9abc, &inner))), Some(0x9abc), true),
+        ] {
+            let (call, flags) = unwrap_wrappers(&body);
+            assert!(matches!(call, Some(Inner::Call(7, ref payload)) if payload == &[1, 2, 3]));
+            assert_eq!(flags.invoke_after, expected);
+            assert_eq!(flags.without_updates, updates_off);
+        }
+    }
+
+    fn init_connection(proxy: Option<(&str, i32)>, params: Option<Vec<u8>>) -> Vec<u8> {
+        let environment = ApiEnvironment {
+            layer: 230,
+            api_id: 9,
+            device_model: "Mac".into(),
+            system_version: "26".into(),
+            app_version: "1".into(),
+            system_lang_code: "en".into(),
+            lang_pack: "macos".into(),
+            lang_code: "en".into(),
+            proxy: proxy.map(|(address, port)| ClientProxy { address: address.into(), port }),
+            params,
+            init_hash: "hash".into(),
+            disable_updates: false,
+        };
+        wrap_request(&call(7, &[1, 2, 3]), Some(&environment), false, None)
+    }
+
+    #[test]
+    fn a_client_proxy_is_observed_only_from_an_init_connection_that_parsed() {
+        let observed = |body: &[u8]| {
+            let (_, flags) = unwrap_wrappers(body);
+            (flags.init_connection, flags.client_proxy)
+        };
+        let named = Some(("proxy.example".to_string(), 443));
+        let with_proxy = init_connection(Some(("proxy.example", 443)), None);
+        assert_eq!(observed(&with_proxy), (true, Some(named.clone())));
+        assert_eq!(observed(&init_connection(None, None)), (true, Some(None)));
+        assert_eq!(observed(&call(7, &[1, 2, 3])), (false, None), "no initConnection, no observation");
+        assert_eq!(observed(&sp::gzip_packed(&with_proxy)), (true, Some(named.clone())), "seen through gzip");
+        let json_null = 0x3f6d_7b68u32.to_le_bytes().to_vec();
+        assert_eq!(observed(&init_connection(Some(("proxy.example", 443)), Some(json_null))), (true, Some(named)));
+
+        // invokeWithLayer, its layer and initConnection take 12 bytes; then the flags, api_id and the strings.
+        let proxy_at = with_proxy.windows(4).position(|word| word == INPUT_CLIENT_PROXY.to_le_bytes()).unwrap();
+        let port_at = proxy_at + 4 + 16;
+        for (what, length) in [("the flags", 14), ("api_id", 18), ("a string", 22), ("the port", port_at + 2)] {
+            assert_eq!(observed(&with_proxy[..length]), (true, None), "cut inside {what}");
+        }
+        assert_eq!(observed(&with_proxy[..8]), (false, None), "cut before initConnection");
+        let mut changed = with_proxy.clone();
+        changed[proxy_at] ^= 1;
+        assert_eq!(observed(&changed), (true, None), "another constructor");
+        let mut changed = with_proxy.clone();
+        changed[proxy_at + 5] = 0xff;
+        assert_eq!(observed(&changed), (true, None), "an address that is no text");
+        assert_eq!(observed(&init_connection(None, Some(vec![1, 2, 3, 4]))), (true, None), "params that do not parse");
+    }
+
+    #[test]
+    fn a_session_remembers_the_latest_failed_queries() {
+        let mut session = SessionState {
+            peer: ServerPeer::new(random_key(1), 0.0),
+            received: HashSet::new(),
+            unacked: Vec::new(),
+            answered_queries: HashMap::new(),
+            answer_ids: HashMap::new(),
+            clock_offset: 0.0,
+            awaiting_retransmission: HashSet::new(),
+            sent_packets: VecDeque::new(),
+            failed_queries: VecDeque::new(),
+        };
+        session.remember_failures(&[
+            (sp::rpc_error(4, 420, "FLOOD_WAIT_1"), true),
+            (sp::rpc_result(8, &result_body(1, &[])), true),
+            (sp::pong(12, 1), true),
+            (sp::rpc_error(4, 420, "FLOOD_WAIT_1"), true),
+        ]);
+        assert!(session.failed(4));
+        assert!(!session.failed(8) && !session.failed(12), "answers that are no error");
+        assert_eq!(session.failed_queries.len(), 1, "remembered once");
+        let errors: Vec<(Vec<u8>, bool)> =
+            (1..=MAX_REMEMBERED_FAILURES as i64 + 1).map(|id| (sp::rpc_error(id * 16, 500, "X"), true)).collect();
+        session.remember_failures(&errors);
+        assert_eq!(session.failed_queries.len(), MAX_REMEMBERED_FAILURES);
+        assert!(!session.failed(4) && !session.failed(16), "the oldest are forgotten");
+        assert!(session.failed(32) && session.failed((MAX_REMEMBERED_FAILURES as i64 + 1) * 16));
+    }
+}
