+    }
+    h.events();
+    let fresh = h.server.next_msg_id(false);
+    let packet = h.server.seal(fresh, 0, &container(&[(old, 1, update(0x74ae4240, &[0; 4]))]));
+    h.client.handle_packet(&packet, h.now, &mut h.rng).unwrap();
+    let seen = resets_and_updates(h.events());
+    assert_eq!(seen, vec![(Some(UpdatesResetReason::UpdatesLost), Vec::new())], "a dropped update");
+    reasons.extend(seen.into_iter().filter_map(|(reason, _)| reason));
