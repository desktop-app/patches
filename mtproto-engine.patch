+/// A fake-TLS hello says the wall clock plus the offset given, and without one plus the time difference: at a proxy
+/// that takes hellos within 120 s of its clock, -600 either way is refused before any ServerHello, and an offset of 0
+/// passes over a time difference of -600.
+#[test]
+fn an_ee_hello_takes_the_given_offset_or_else_the_time_difference() {
+    const SKEW: f64 = -600.0;
+    let collector = Arc::new(Collector::default());
+    let engine = engine(&collector, 2);
+    let (secret, _) = fake_tls();
+    let options = ServerOptions { secret: Some(secret.clone()), tls_time_window: Some(120.0), ..Default::default() };
+    let server = TestServer::start(Vec::new(), options);
+    let cases = [
+        ("an offset of -600", Some(SKEW), 0.0, SKEW, false),
+        ("an offset of 0 over a time difference of -600", Some(0.0), SKEW, 0.0, true),
+        ("no offset, a time difference of -600", None, SKEW, SKEW, false),
+    ];
+    let mut requests = 0;
+    for (index, (what, offset, time_difference, says, answered)) in cases.into_iter().enumerate() {
+        let mut setup = through(mtproxy("127.0.0.1", &server, &secret));
+        setup.tls_hello_time_offset = offset;
+        setup.time_difference = time_difference;
+        let since = unix_seconds();
+        let (_, checked, _) = check(&engine, &collector, setup);
+        let hellos = server.with_stats(|stats| stats.tls_hello_times.clone());
+        assert_eq!(hellos.len(), index + 1, "{what}: {hellos:?}");
+        let hello = f64::from(hellos[index]);
+        let (low, high) = (since + says - SLACK, unix_seconds() + says + SLACK);
+        assert!(low <= hello && hello <= high, "{what}: the hello said {hello}, expected {low} to {high}");
+        let refusals = server.with_stats(|stats| stats.tls_time_refusals);
+        if answered {
+            assert!(checked.answered, "{what}: {checked:?}");
+            requests += 1;
+        } else {
+            assert_refused(what, checked, &CLOSED);
+        }
+        assert_eq!(refusals, index + 1 - requests, "{what}");
+        assert_eq!(progress(&server).1, requests, "{what}: a request got past a refused hello");
+    }
+    engine.shutdown();
+}
