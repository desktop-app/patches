+/// The size the server announces for query 1's answer: large enough that it announces the answer to a
+/// copy of the query instead of sending it again.
+const ANSWER_BYTES: i32 = 40_000;
+
+/// What the server does with a request for the answer it announced.
+#[derive(Clone, Copy, Debug, PartialEq)]
+enum Fetch {
+    /// The reply is lost on the way.
+    Lost,
+    /// The answer goes out on another connection of the session, which closes before it is read.
+    Elsewhere,
+    /// The server no longer has the answer and says so (msgs_state_info about the request).
+    Unavailable,
+}
+
+/// The server side of query 1, whose answer was lost and which the server ran under the msg_ids in `ran`;
+/// it keeps the answer, `answer`, and as Telegram's servers do with a large one, announces it with
+/// msg_detailed_info to a copy under a msg_id it ran instead of sending it again. A state request about
+/// query 1 gets 4 + 32 + 64; a request for `answer` gets the next of `fetches` and, once they ran out, the
+/// answer. It answers pings and other queries at once, and runs query 1 again under a msg_id it never saw.
+struct Announcer {
+    ran: Vec<i64>,
+    answer: i64,
+    fetches: std::collections::VecDeque<Fetch>,
+    /// When each request for `answer` arrived.
+    asks: Vec<f64>,
+    /// The packets that carried the answer on the other connection, never read by this session.
+    elsewhere: Vec<Vec<u8>>,
+}
+
+impl Announcer {
+    fn new(ran: i64, answer: i64, fetches: &[Fetch]) -> Self {
+        Self {
+            ran: vec![ran],
+            answer,
+            fetches: fetches.iter().copied().collect(),
+            asks: Vec::new(),
+            elsewhere: Vec::new(),
+        }
+    }
+
+    fn answer_body(&self) -> Vec<u8> {
+        rpc_result(self.ran[0], &[7, 0, 0, 0])
+    }
+
+    fn replies(&mut self, packet: &DecodedPacket, peer: &mut ServerPeer, now: f64) -> Vec<Outgoing> {
+        let mut replies = Vec::new();
+        for message in &packet.messages {
+            match query_tag(&message.body) {
+                Some(1) if self.ran.contains(&message.msg_id) => {
+                    replies.push(Outgoing::Service(msg_detailed_info(message.msg_id, self.answer, ANSWER_BYTES)));
+                }
+                Some(1) => {
+                    self.ran.push(message.msg_id);
+                    replies.push(Outgoing::Content(rpc_result(message.msg_id, &[7, 0, 0, 0])));
+                }
+                Some(_) => replies.push(Outgoing::Content(rpc_result(message.msg_id, &[1, 0, 0, 0]))),
+                None if message.constructor() == ids::MSGS_STATE_REQ => {
+                    let info: Vec<u8> = read_vector_after_constructor(&message.body)
+                        .iter()
+                        .map(|id| if self.ran.contains(id) { 4 | RUNNING | ANSWERED } else { 2 })
+                        .collect();
+                    replies.push(Outgoing::Service(msgs_state_info(message.msg_id, &info)));
+                }
+                None if message.constructor() == ids::MSG_RESEND_REQ => {
+                    if !read_vector_after_constructor(&message.body).contains(&self.answer) {
+                        continue;
+                    }
+                    self.asks.push(now);
+                    match self.fetches.pop_front() {
+                        Some(Fetch::Lost) => {}
+                        Some(Fetch::Elsewhere) => {
+                            let carried = peer.seal(self.answer, 1, &self.answer_body());
+                            self.elsewhere.push(carried);
+                        }
+                        Some(Fetch::Unavailable) => {
+                            replies.push(Outgoing::Service(msgs_state_info(message.msg_id, &[2])));
+                        }
+                        None => {
+                            let body = self.answer_body();
+                            replies.push(Outgoing::Raw { body, seq_no: 1, msg_id: Some(self.answer) });
+                        }
+                    }
+                }
+                None => {}
+            }
+        }
+        replies
+    }
+}
+
+/// What `run_announced` saw: the packets the session sent, with when each went out, and the events.
+struct Announced {
+    h: Harness,
+    lost: (i64, i32),
+    packets: Vec<DecodedPacket>,
+    sent_at: Vec<f64>,
+    events: Vec<SessionEvent>,
+    server: Announcer,
+}
+
+impl Announced {
+    /// When each state request naming query 1 went out.
+    fn questions(&self) -> Vec<f64> {
+        self.packets
+            .iter()
+            .zip(&self.sent_at)
+            .filter(|(packet, _)| {
+                state_requests(std::slice::from_ref(*packet)).iter().any(|(_, ids)| ids.contains(&self.lost.0))
+            })
+            .map(|(_, at)| *at)
+            .collect()
+    }
+
+    /// After the run nothing more goes about query 1: no copy, no question, no request for its answer.
+    fn nothing_more(&mut self) {
+        let later = live(&mut self.h, 3.0 * ANSWER_WAIT);
+        assert!(copies(&later, 1).is_empty(), "no copy of a finished query");
+        assert!(state_requests(&later).iter().all(|(_, ids)| !ids.contains(&self.lost.0)), "no question about it");
+        let answer = self.server.answer;
+        let asks = later
+            .iter()
+            .flat_map(|packet| packet.messages.iter())
+            .filter(|message| message.constructor() == ids::MSG_RESEND_REQ)
+            .filter(|message| read_vector_after_constructor(&message.body).contains(&answer))
+            .count();
+        assert_eq!(asks, 0, "no request for its answer");
+    }
+}
+
+/// `by_deadlines` with `run.server` answering each packet as it arrives and every ping answered.
+fn announced_by_deadlines(run: &mut Announced, seconds: f64) {
+    let h = &mut run.h;
+    let until = h.now.mono + seconds;
+    let mut idle_wakes: Vec<f64> = Vec::new();
+    loop {
+        let at = h.session.poll_timeout(h.now).expect("a live connection always has a deadline");
+        assert!(at >= h.now.mono, "asks to be woken {:.3} s in the past", h.now.mono - at);
+        if at > until {
+            break;
+        }
+        h.advance(at.max(h.now.mono + 0.001) - h.now.mono);
+        h.session.handle_timeout(h.now).expect("the link stays up");
+        let mut sent = false;
+        while let Some(transmit) = h.session.poll_transmit(h.now, &mut h.rng) {
+            let packet = h.server.decode(&transmit.data);
+            h.answer_pings(&packet);
+            let replies = run.server.replies(&packet, &mut h.server, h.now.mono);
+            if !replies.is_empty() {
+                h.deliver(replies).unwrap();
+            }
+            run.packets.push(packet);
+            run.sent_at.push(h.now.mono);
+            sent = true;
+        }
+        if !sent {
+            idle_wakes.push(h.now.mono);
+            let storm = idle_wakes.iter().rev().take_while(|at| h.now.mono - **at < 1.0).count();
+            assert!(storm < 100, "{storm} idle wake-ups within a second at {}", h.now.mono);
+        }
+    }
+    if until > h.now.mono {
+        h.advance(until - h.now.mono);
+    }
+}
+
+/// Runs query 1, left without an answer by `burst_with_one_lost`, against an `Announcer` with `fetches`
+/// for `seconds`, query 9 going out on the same connection meanwhile.
+fn run_announced(fetches: &[Fetch], seconds: f64) -> Announced {
+    let mut h = Harness::new();
+    let lost = burst_with_one_lost(&mut h, 1);
+    let answer = h.server.next_msg_id(true);
+    let server = Announcer::new(lost.0, answer, fetches);
+    let mut run = Announced { h, lost, packets: Vec::new(), sent_at: Vec::new(), events: Vec::new(), server };
+    announced_by_deadlines(&mut run, 3.0 * ANSWER_WAIT);
+    run.h.session.send(QueryId(9), query_body(9), QueryOptions::default(), run.h.now);
+    announced_by_deadlines(&mut run, seconds - 3.0 * ANSWER_WAIT);
+    run.events = run.h.events();
+    run
+}
+
+/// The failures of query `id` with `ANSWER_LOST`: the server ran it and no longer has its answer.
+fn answers_lost(events: &[SessionEvent], id: QueryId) -> usize {
+    let failure = SessionEvent::Error { id, code: 500, message: ANSWER_LOST.to_string(), response_msg_id: 0 };
+    events.iter().filter(|event| **event == failure).count()
+}
+
+/// P1 of review round 4. The server ran query 1 and keeps its answer, which it announces with
+/// msg_detailed_info to the copy under the query's msg_id that its +64 fetched. The reply to the request
+/// for that answer is lost, or goes out on another connection of the session that closes before it is
+/// read, once or more, while pongs and another query's answer keep the link up. Each request that expires
+/// leaves the query to be asked about again, the server's +64 asks for the answer again, never sooner than
+/// `TCP_ASK_BACKSTOP` after the last request, and the query completes once, its one copy under its msg_id:
+/// the server ran it once.
+#[test]
+fn an_announced_answer_whose_reply_was_lost_is_asked_for_again_and_completes_once() {
+    for fetches in [vec![Fetch::Lost], vec![Fetch::Elsewhere], vec![Fetch::Lost, Fetch::Elsewhere, Fetch::Lost]] {
+        let rounds = fetches.len() as f64 + 1.0;
+        let mut run = run_announced(&fetches, rounds * (TCP_ASK_BACKSTOP + 3.0 * ANSWER_WAIT));
+        let (events, asks) = (&run.events, &run.server.asks);
+        assert_eq!(results_for(events, QueryId(1)), 1, "{fetches:?}: completed once, asks at {asks:?}");
+        assert_eq!(terminal_events(events, QueryId(1)), 1, "{fetches:?}");
+        assert_eq!(results_for(events, QueryId(9)), 1, "{fetches:?}: the link answered another query meanwhile");
+        assert_eq!(run.server.ran, vec![run.lost.0], "{fetches:?}: the server ran it once");
+        assert_eq!(copies(&run.packets, 1), vec![run.lost], "{fetches:?}: one copy, the fetch, under its msg_id");
+        assert_eq!(asks.len(), fetches.len() + 1, "{fetches:?}: asks at {asks:?}");
+        for pair in asks.windows(2) {
+            let gap = pair[1] - pair[0];
+            assert!(gap > TCP_ASK_BACKSTOP, "{fetches:?}: asked again {gap:.1} s after the last request");
+            assert!(gap < TCP_ASK_BACKSTOP + 2.0 * ANSWER_WAIT, "{fetches:?}: asked again only {gap:.1} s after");
+        }
+        let elsewhere = fetches.iter().filter(|fetch| **fetch == Fetch::Elsewhere).count();
+        assert_eq!(run.server.elsewhere.len(), elsewhere, "{fetches:?}");
+        let questions = run.questions();
+        for pair in questions.windows(2) {
+            assert!(pair[1] - pair[0] >= ANSWER_WAIT - 0.01, "{fetches:?}: questions at {questions:?}");
+        }
+        assert!(!run.h.session.contains(QueryId(1)));
+        run.nothing_more();
+    }
+}
+
+/// P2 of review round 4. The announced answer the +64 fetch brought is gone when the session asks for it,
+/// at once or when it asks again after the first request's reply was lost: the server ran the query. It
+/// fails once with `ANSWER_LOST`, of the kind a host must not send again, and never goes again under any
+/// msg_id.
+#[test]
+fn an_announced_answer_the_server_no_longer_has_fails_the_query_once_and_it_never_goes_again() {
+    for fetches in [vec![Fetch::Unavailable], vec![Fetch::Lost, Fetch::Unavailable]] {
+        let rounds = fetches.len() as f64;
+        let mut run = run_announced(&fetches, rounds * (TCP_ASK_BACKSTOP + 3.0 * ANSWER_WAIT));
+        let (events, asks) = (&run.events, &run.server.asks);
+        assert_eq!(answers_lost(events, QueryId(1)), 1, "{fetches:?}: asks at {asks:?}, {events:?}");
+        assert_eq!(terminal_events(events, QueryId(1)), 1, "{fetches:?}: one terminal event");
+        assert_eq!(results_for(events, QueryId(9)), 1, "{fetches:?}");
+        assert_eq!(run.server.ran, vec![run.lost.0], "{fetches:?}: the server ran it once");
+        assert_eq!(copies(&run.packets, 1), vec![run.lost], "{fetches:?}: one copy, the fetch, under its msg_id");
+        assert_eq!(asks.len(), fetches.len(), "{fetches:?}: asks at {asks:?}");
+        assert!(!run.h.session.contains(QueryId(1)));
+        run.nothing_more();
+    }
+}
+
+/// The control of the two above: the first request for the announced answer brings it.
+#[test]
+fn an_announced_answer_the_fetch_brought_completes_the_query_once() {
+    let mut run = run_announced(&[], TCP_ASK_BACKSTOP);
+    assert_eq!(results_for(&run.events, QueryId(1)), 1);
+    assert_eq!(terminal_events(&run.events, QueryId(1)), 1);
+    assert_eq!(run.server.ran, vec![run.lost.0]);
+    assert_eq!(copies(&run.packets, 1), vec![run.lost]);
+    assert_eq!(run.server.asks.len(), 1);
+    run.nothing_more();
+}
