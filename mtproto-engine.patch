+fn keys_left_during_the_fake_tls_handshake(seed: u64) -> Vec<&'static str> {
+    let mut watch = freed_memory::watch();
+    let listener = TcpListener::bind("127.0.0.1:0").unwrap();
+    let port = listener.local_addr().unwrap().port();
+    let (steps, proxy_steps) = mpsc::channel();
+    let proxy_thread = std::thread::spawn(move || silent_proxy(listener, steps));
+    let secret = off_the_test_stack(|| [&[0xeeu8][..], &proxy_key(), b"www.example.com"].concat());
+    let proxy = off_the_test_stack(|| proxy_key().to_vec());
+    let mut config = setup_at(SocketAddr::from(([149, 154, 167, 51], 443)), Some(&random_key(seed)));
+    config.proxy = Some(ProxyConfig::MtProxy { host: "127.0.0.1".into(), port, secret });
+    let collector = Arc::new(Collector::default());
+    let engine = Engine::new(EngineConfig { worker_threads: 2, ..EngineConfig::default() }, collector.clone()).unwrap();
+    let session = engine.create_session(config);
+    engine.send(session, request(1));
+    assert_eq!(
+        proxy_steps.recv_timeout(WAIT),
+        Ok(ProxyStep::Hello),
