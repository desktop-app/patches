+        let now = gate.now();
+        gate.runtime.drive(gate.poll.registry(), now, &mut Unanswered, &gate.config, &gate.callbacks, &mut gate.rng);
+        assert_eq!(gate.runtime.awaiting_resolution, Some(("proxy.invalid".to_string(), port)));
+        assert_eq!(gate.runtime.next_attempt_at, now.mono + RESOLVE_WAIT);
+
+        gate.elapsed += 1.0;
+        let now = gate.now();
+        gate.runtime.set_proxy_addresses("proxy.invalid".into(), texts(&["127.0.0.1"]), now);
+        assert_eq!(gate.runtime.next_attempt_at, now.mono, "the first list did not let the session try at once");
+        assert_eq!(gate.runtime.awaiting_resolution, None);
+        gate.runtime.on_resolved("proxy.invalid", port, vec![address(9)], now);
+        assert_eq!((gate.runtime.failures, gate.runtime.next_attempt_at), (0, now.mono));
+        gate.drive();
