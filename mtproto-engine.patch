+/// The server ran a call whose acknowledgement and answer were lost. Asked about it, the server says its
+/// answer was made (+64), and the copy under its msg_id that fetches it gets msg_detailed_info announcing a
+/// large answer. The server no longer has that answer when asked for it, at once or when asked again after
+/// the first request's reply was lost. The call fails to the host once with `PROTOCOL_ERROR_ANSWER_LOST` and
+/// code 500, never as a retry decision, and never goes under a new msg_id; the host must not send it again
+/// either (Telegram Desktop fails it as possibly run).
+#[test]
+fn a_call_whose_fetched_answer_the_server_no_longer_has_fails_once_and_never_runs_again() {
+    for flags in [RequestFlags::default(), RequestFlags { delegate_retry_decisions: true, ..RequestFlags::default() }] {
+        for lose_first_reply in [false, true] {
+            let mut h = Harness::new(SessionRole::Main, Some("h1"));
+            h.send(1, flags);
+            let calls = h.flush_calls();
+            assert_eq!(calls.len(), 1);
+            let original = calls[0].0;
+            let answer = h.server.next_msg_id(true);
+            let (mut copies, mut asks) = (0, 0);
+            let mut ran = vec![original];
+            let mut surfaced = Vec::new();
+            for _ in 0..400 {
+                h.advance(1.0);
+                let _ = h.client.handle_timeout(h.now);
+                while let Some(transmit) = h.client.poll_transmit(h.now, &mut h.rng) {
+                    let packet = h.server.decode(&transmit.data);
+                    let mut replies = Vec::new();
+                    for message in &packet.messages {
+                        if unwrap_call(&message.body).1.is_some() {
+                            if ran.contains(&message.msg_id) {
+                                copies += 1;
+                                replies.push(Outgoing::Service(msg_detailed_info(message.msg_id, answer, 40_000)));
+                            } else {
+                                ran.push(message.msg_id);
+                            }
+                        }
+                        match message.constructor() {
+                            ids::PING_DELAY_DISCONNECT | ids::PING => {
+                                let ping_id = i64::from_le_bytes(message.body[4..12].try_into().unwrap());
+                                replies.push(Outgoing::Service(pong(message.msg_id, ping_id)));
+                            }
+                            ids::MSGS_STATE_REQ => {
+                                let info: Vec<u8> = read_vector_after_constructor(&message.body)
+                                    .iter()
+                                    .map(|id| if ran.contains(id) { 4 | 32 | 64 } else { 2 })
+                                    .collect();
+                                replies.push(Outgoing::Service(msgs_state_info(message.msg_id, &info)));
+                            }
+                            ids::MSG_RESEND_REQ if read_vector_after_constructor(&message.body).contains(&answer) => {
+                                asks += 1;
+                                if !(lose_first_reply && asks == 1) {
+                                    replies.push(Outgoing::Service(msgs_state_info(message.msg_id, &[2])));
+                                }
+                            }
+                            _ => {}
+                        }
+                    }
+                    if !replies.is_empty() {
+                        h.reply(replies);
+                    }
+                }
+                for event in h.events() {
+                    match event {
+                        RpcEvent::Failed { code, message, .. } => surfaced.push((code, message)),
+                        RpcEvent::RetryDecisionRequired { id, message, .. } => {
+                            surfaced.push((-1, format!("decision:{message}")));
+                            h.client.decide_retry(id, true, h.now);
+                        }
+                        RpcEvent::Completed { .. } => surfaced.push((-1, "completed".into())),
+                        _ => {}
+                    }
+                }
+            }
+            let case = format!("lose_first_reply={lose_first_reply}");
+            assert_eq!(ran, vec![original], "{case}: only the copy the server ran ever went");
+            assert_eq!(copies, 1, "{case}: one copy under its msg_id fetched the answer");
+            assert_eq!(asks, 1 + usize::from(lose_first_reply), "{case}");
+            assert_eq!(surfaced, vec![(500, crate::session::ANSWER_LOST.to_string())], "{case}");
+        }
+    }
+}
