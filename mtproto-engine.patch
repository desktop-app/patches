+/// An HTTP proxy that refuses CONNECT, and the host's own HTTP addresses at port 80: Auto moves to HTTP
+/// forwarded by the proxy to exactly those addresses, and the calls complete. The explicit-list variant of
+/// `auto_forwards_http_when_the_proxy_refuses_connect` in `http.rs`.
+#[test]
+fn auto_forwards_http_to_the_hosts_http_addresses_through_a_proxy_that_refuses_connect() {
+    let key = random_key(8111);
+    let server = TestServer::start(
+        vec![key.clone()],
+        ServerOptions { http_proxy: Some(HttpProxyMode::ForwardOnly), ..Default::default() },
+    );
+    let proxy = Endpoint::route(server.address);
+    let collector = Arc::new(Collector::default());
+    let engine = engine(&collector);
+    let http_proxy = ProxyConfig::Http { host: "127.0.0.1".into(), port: proxy.port, username: None, password: None };
+    let session = engine.create_session(proxied_setup(&key, http_proxy));
+    for id in 1..=5 {
+        engine.send(session, request(id, id as u32));
+    }
+    let done = collector.wait(WAIT, |events| (1..=5).all(|id| completed(events, session, id) == 1));
+    let refusals = server.with_stats(|stats| stats.proxy_refusals);
+    let lines = proxy.request_lines();
+    engine.shutdown();
+    eprintln!("CONNECT refused {refusals} times; forwarded connections opened with {lines:?}");
+    assert!(done, "the calls did not complete over forwarded HTTP");
+    assert!(refusals >= 1, "the proxy never refused a CONNECT");
+    assert!(!lines.is_empty(), "nothing was forwarded");
+    assert!(
+        lines.iter().all(|line| line == "POST http://149.154.167.51:80/api HTTP/1.1"),
+        "HTTP was forwarded elsewhere than the host's HTTP address: {lines:?}"
+    );
+}
