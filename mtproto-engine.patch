+
+/// A racer reads only until its `res_pq` verifies it, short of `WouldBlock`, and mio on Windows reports
+/// nothing more for a socket until a read or write hits `WouldBlock` or it is registered anew. Promoted,
+/// it has to hear the answer to the request it resends through a poll event of its own: from the turn
+/// that sends the request on, nothing is driven, written or timed to wake it.
+#[cfg(windows)]
+#[test]
+fn a_promoted_racer_hears_the_answer_to_the_resent_request_through_the_poll() {
+    let key = random_key(9003);
+    let server = TestServer::start(vec![key.clone()], ServerOptions::default());
+    let silent = TcpListener::bind("127.0.0.1:0").unwrap();
+    let mut poll = mio::Poll::new().unwrap();
+    let mut events = mio::Events::with_capacity(64);
+    let mut scratch = vec![0u8; 256 * 1024];
+    let mut rng = OsRandom::new();
+    let start = crate::clock::now();
+    let addresses = [silent.local_addr().unwrap(), server.address]
+        .iter()
+        .map(|address| DcAddress { host: address.ip().to_string(), port: address.port(), secret: None })
+        .collect();
+    let mut setup = SessionSetup::new(2, SessionRole::Main, addresses);
+    setup.transport = TransportPreference::Tcp;
+    setup.http_port = None;
+    setup.auth_key = Some(material(&key, start));
+    let mut runtime = SessionRuntime::new(SessionHandle(1), setup, Token(16), start, &mut rng);
+    let recorder = Arc::new(Recorder::default());
+    let callbacks: Arc<dyn EngineCallbacks> = recorder.clone();
+    let config = EngineConfig::default();
+    let racer = runtime.race_token();
+    let mut racer_events = 0;
+    let mut turn = |runtime: &mut SessionRuntime, drive: bool| {
+        poll.poll(&mut events, Some(Duration::from_millis(2))).unwrap();
+        let now = crate::clock::now();
+        for event in events.iter() {
+            let readable = event.is_readable() || event.is_read_closed() || event.is_error();
+            let writable = event.is_writable() || event.is_write_closed();
+            racer_events += usize::from(event.token() == racer);
+            runtime.handle_io(
+                event.token(),
+                readable,
+                writable,
+                poll.registry(),
+                &mut scratch,
+                now,
+                &callbacks,
+                &mut rng,
+            );
+        }
+        if drive {
+            runtime.drive(poll.registry(), now, &mut NoLookups, &config, &callbacks, &mut rng);
+        }
+    };
+    let completed = || {
+        recorder.events.lock().unwrap().iter().any(|(_, event)| {
+            matches!(event, EngineEvent::Rpc(RpcEvent::Completed { id, .. }) if *id == RequestId(1))
+        })
+    };
+    runtime.send(plain_request(1), start);
+    let real = Instant::now();
+    while runtime.connection.as_ref().is_none_or(|connection| connection.token() != racer)
+        && real.elapsed() < Duration::from_secs(10)
+    {
+        turn(&mut runtime, true);
+    }
+    let promoted = runtime.connection.as_ref().filter(|connection| connection.token() == racer);
+    let sent = promoted.map_or(0, |connection| connection.bytes_out);
+    assert!(sent > 0 && runtime.racer.is_none(), "no promoted racer that resent the request ({sent} bytes)");
+    assert!(!completed(), "the silent primary answered");
+    let waited = Instant::now();
+    while !completed() && waited.elapsed() < Duration::from_secs(3) {
+        turn(&mut runtime, false);
+    }
+    let answered = completed();
+    let waited = waited.elapsed();
+    runtime.shutdown(poll.registry(), crate::clock::now());
+    assert!(answered, "no answer {waited:?} after the promotion; {racer_events} poll events for the racer's socket");
+    assert_eq!(server.executions(1), 1);
+}
