+            let mut received = 0;
+            while received < TOTAL {
+                match peer.read(&mut buffer) {
+                    Ok(0) => break,
+                    Ok(read) => received += read,
+                    Err(error) => panic!("peer read failed after {received} bytes: {error}"),
+                }
+            }
+            received
+        });
+        let writer = std::thread::spawn(move || client.write_all(&vec![7u8; TOTAL]));
+        let (mut samples, mut in_flight) = (0, 0);
