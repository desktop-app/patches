+/// A session created as Telegram does is handed values through the later calls, each over a fresh paint.
+fn a_session_handed_values() -> Leg {
+    let start = TelegramStart::new();
+    let pems = [string(&start.pem)];
+    let proxy = MTProxy { kind: 2, host: string("127.0.0.1"), port: 443, secret: bytes(&PROXY_SECRET), ..no_proxy() };
+    let (proxy_name, addresses) = (string("proxy.example"), [string("192.0.2.1"), string("2001:db8::1")]);
+    let environment = environment();
+    let endpoint = MTWebEndpoint {
+        host: string("venus.web.telegram.org"),
+        port: 443,
+        path: string("/apiw1"),
+        address: string(""),
+        ws_path: string("/apiws"),
+    };
+    let temporary_key = start.temporary_key();
+    let engine = unsafe { mt_engine_create(2, std::ptr::null_mut(), None, None) };
+    assert!(!engine.is_null());
+    let mut watch = freed_memory::watch();
+    watch_the_stack_secret(&mut watch);
+    freed_memory::only_threads(freed_memory::is_engine_thread);
+    watch.arm();
+    watch.arm_every_thread();
+    paint_the_stack(&STACK_SECRET);
+    let session = create_as_telegram_does(engine, &start, false, &[]);
+    paint_the_stack(&STACK_SECRET);
+    unsafe { mt_session_set_proxy(engine, session, &proxy) };
+    paint_the_stack(&STACK_SECRET);
+    unsafe { mt_session_set_proxy(engine, session, std::ptr::null()) };
+    paint_the_stack(&STACK_SECRET);
+    unsafe { mt_session_set_proxy_addresses(engine, session, proxy_name, addresses.as_ptr(), addresses.len()) };
+    paint_the_stack(&STACK_SECRET);
+    unsafe { mt_session_update_environment(engine, session, &environment, std::ptr::null()) };
+    paint_the_stack(&STACK_SECRET);
+    unsafe { mt_session_set_web_endpoint(engine, session, &endpoint) };
+    paint_the_stack(&STACK_SECRET);
+    let enabled =
+        unsafe { mt_session_enable_pfs(engine, session, 86400, pems.as_ptr(), pems.len(), 0, std::ptr::null()) };
+    paint_the_stack(&STACK_SECRET);
