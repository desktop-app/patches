index 0000000..fb15cc0
--- /dev/null
+++ b/crates/mtproto-engine/tests/support/cpu_time.rs
@@ -0,0 +1,109 @@
+//! CPU time in seconds for the tests' budgets: the user and system time of this whole process, the threads
+//! that already exited included, and on Windows also that of the engine's reactor threads alone.
+#![allow(dead_code, unsafe_code)]
+
+#[cfg(windows)]
+use windows_sys::Win32::Foundation::{FILETIME, GetLastError, HANDLE};
+
+#[cfg(not(windows))]
+pub fn cpu_seconds() -> f64 {
+    let mut usage: libc::rusage = unsafe { std::mem::zeroed() };
+    unsafe { libc::getrusage(libc::RUSAGE_SELF, &mut usage) };
+    let seconds = |time: libc::timeval| time.tv_sec as f64 + time.tv_usec as f64 / 1e6;
+    seconds(usage.ru_utime) + seconds(usage.ru_stime)
+}
+
+/// Windows charges thread time in whole clock ticks, 15.625 ms by default.
+#[cfg(windows)]
+pub fn cpu_seconds() -> f64 {
+    use windows_sys::Win32::System::Threading::{GetCurrentProcess, GetProcessTimes};
+    let mut times = [FILETIME::default(); 4];
+    let [created, exited, kernel, user] = &mut times;
+    let read = unsafe { GetProcessTimes(GetCurrentProcess(), created, exited, kernel, user) };
+    assert_ne!(read, 0, "GetProcessTimes: {}", std::io::Error::last_os_error());
+    (units(kernel) + units(user)) as f64 / 1e7
+}
+
+/// The CPU time of this process's engine reactor threads, `mtproto-main` and `mtproto-worker-N`, which must
+/// be `expected_workers` running threads, charged in clock ticks as by `cpu_seconds`. Windows test servers
+/// and middleboxes poll on threads of their own at a cost above some idle budgets; this leaves them out.
+/// Only for a fixture whose engine runs the same workers from before its first reading until after its
+/// last and nothing of its own elsewhere meanwhile: no name lookup, no engine started or shut down.
+#[cfg(windows)]
+pub fn reactor_cpu_seconds(expected_workers: usize) -> f64 {
+    use windows_sys::Win32::Foundation::{CloseHandle, ERROR_NO_MORE_FILES, INVALID_HANDLE_VALUE};
+    use windows_sys::Win32::System::Diagnostics::ToolHelp::{
+        CreateToolhelp32Snapshot, TH32CS_SNAPTHREAD, THREADENTRY32, Thread32First, Thread32Next,
+    };
+    use windows_sys::Win32::System::Threading::GetCurrentProcessId;
+    let snapshot = unsafe { CreateToolhelp32Snapshot(TH32CS_SNAPTHREAD, 0) };
+    assert_ne!(snapshot, INVALID_HANDLE_VALUE, "CreateToolhelp32Snapshot: {}", std::io::Error::last_os_error());
+    let process = unsafe { GetCurrentProcessId() };
+    let mut entry = THREADENTRY32 { dwSize: size_of::<THREADENTRY32>() as u32, ..Default::default() };
+    let mut workers = Vec::new();
+    let mut listed = unsafe { Thread32First(snapshot, &mut entry) } != 0;
+    while listed {
+        if entry.th32OwnerProcessID == process {
+            workers.extend(reactor_thread(entry.th32ThreadID, process));
+        }
+        listed = unsafe { Thread32Next(snapshot, &mut entry) } != 0;
+    }
+    let error = unsafe { GetLastError() };
+    unsafe { CloseHandle(snapshot) };
+    assert_eq!(error, ERROR_NO_MORE_FILES, "Thread32Next: {}", std::io::Error::from_raw_os_error(error as i32));
+    let names: Vec<&str> = workers.iter().map(|(name, _)| name.as_str()).collect();
+    assert_eq!(workers.len(), expected_workers, "engine reactor threads found: {names:?}");
+    workers.iter().map(|(_, units)| units).sum::<u64>() as f64 / 1e7
+}
+
+/// The name and CPU time, in 100 ns units, of thread `id` if it is a running reactor thread of `process`.
+#[cfg(windows)]
+fn reactor_thread(id: u32, process: u32) -> Option<(String, u64)> {
+    use windows_sys::Win32::Foundation::{CloseHandle, ERROR_INVALID_PARAMETER, STILL_ACTIVE};
+    use windows_sys::Win32::System::Threading::{
+        GetExitCodeThread, GetProcessIdOfThread, GetThreadTimes, OpenThread, THREAD_QUERY_LIMITED_INFORMATION,
+    };
+    let thread = unsafe { OpenThread(THREAD_QUERY_LIMITED_INFORMATION, 0, id) };
+    if thread.is_null() {
+        // A thread that ended after the snapshot was taken is no running worker.
+        let error = unsafe { GetLastError() };
+        let message = std::io::Error::from_raw_os_error(error as i32);
+        assert_eq!(error, ERROR_INVALID_PARAMETER, "OpenThread {id}: {message}");
+        return None;
+    }
+    // Another process's thread when the one listed ended and its id was given out again.
+    let name = if unsafe { GetProcessIdOfThread(thread) } == process { description(thread) } else { String::new() };
+    let mut reactor = None;
+    if name == "mtproto-main" || name.starts_with("mtproto-worker-") {
+        let (mut times, mut code) = ([FILETIME::default(); 4], 0);
+        let [created, exited, kernel, user] = &mut times;
+        let read = unsafe { GetThreadTimes(thread, created, exited, kernel, user) };
+        assert_ne!(read, 0, "GetThreadTimes {name}: {}", std::io::Error::last_os_error());
+        let read = unsafe { GetExitCodeThread(thread, &mut code) };
+        assert_ne!(read, 0, "GetExitCodeThread {name}: {}", std::io::Error::last_os_error());
+        assert_eq!(code, STILL_ACTIVE as u32, "{name} ({id}) has ended");
+        reactor = Some((name, units(kernel) + units(user)));
+    }
+    unsafe { CloseHandle(thread) };
+    reactor
+}
+
+/// The thread's name: std makes it the thread's description, a copy Windows allocates.
+#[cfg(windows)]
+fn description(thread: HANDLE) -> String {
+    use windows_sys::Win32::Foundation::LocalFree;
+    use windows_sys::Win32::System::Threading::GetThreadDescription;
+    let mut text: *mut u16 = std::ptr::null_mut();
+    let result = unsafe { GetThreadDescription(thread, &mut text) };
+    assert!(result >= 0 && !text.is_null(), "GetThreadDescription: HRESULT {result:#x}");
+    let length = (0..).take_while(|&index| unsafe { *text.add(index) } != 0).count();
+    let name = String::from_utf16_lossy(unsafe { std::slice::from_raw_parts(text, length) });
+    unsafe { LocalFree(text.cast()) };
+    name
+}
+
+/// A FILETIME duration in its 100 ns units.
+#[cfg(windows)]
+fn units(time: &FILETIME) -> u64 {
+    (u64::from(time.dwHighDateTime) << 32) | u64::from(time.dwLowDateTime)
+}
