diff --git a/crates/mtproto-ffi/tests/ffi_abi10.rs b/crates/mtproto-ffi/tests/ffi_abi10.rs
new file mode 100644
index 0000000..74be079
--- /dev/null
+++ b/crates/mtproto-ffi/tests/ffi_abi10.rs
@@ -0,0 +1,450 @@
+//! What ABI 10 added, through the C ABI with real callbacks: `MTEventKindTransportError`, the transport error
+//! code a connection got with the session's proxy serial, beside every event and recovery there was before.
+//! `Stats::client_proxies` reads on the server what `MTEnvironment` names as the session's proxy.
+
+use std::ffi::c_void;
+use std::sync::{Condvar, Mutex};
+use std::time::{Duration, Instant};
+
+use mtproto_engine::mtproto_core::auth_key::AuthKey;
+use mtproto_engine::mtproto_core::test_support::{ServerHandshakeBehavior, test_rsa_public_key_pem};
+use mtproto_engine_ffi::*;
+use mtproto_testserver::*;
+
+const COMPLETED: u32 = 1;
+const AUTH_KEY_INVALID: u32 = 20;
+const AUTH_KEY_CREATED: u32 = 21;
+const AUTH_KEY_CREATION_FAILED: u32 = 22;
+const TRANSPORT_FLOOD: u32 = 23;
+const ADDRESS_RESULT: u32 = 25;
+const CONNECTION_DROPPED: u32 = 29;
+const TRANSPORT_ERROR: u32 = 38;
+const WAIT: Duration = Duration::from_secs(20);
+/// A name no resolver answers (RFC 6761).
+const NAME: &str = "proxy.invalid";
+
+#[derive(Clone, Debug)]
+struct Seen {
+    session: u64,
+    kind: u32,
+    request: u64,
+    code: i32,
+    flags: u32,
+    text: String,
+}
+
+#[derive(Default)]
+struct Sink {
+    events: Mutex<Vec<Seen>>,
+    condvar: Condvar,
+}
+
+impl Sink {
+    fn wait(&self, predicate: impl Fn(&[Seen]) -> bool) -> bool {
+        let deadline = Instant::now() + WAIT;
+        let mut events = self.events.lock().unwrap();
+        while !predicate(&events) {
+            let now = Instant::now();
+            if now >= deadline {
+                return false;
+            }
+            events = self.condvar.wait_timeout(events, deadline - now).unwrap().0;
+        }
+        true
+    }
+
+    fn of_session(&self, session: u64) -> Vec<Seen> {
+        self.events.lock().unwrap().iter().filter(|event| event.session == session).cloned().collect()
+    }
+
+    fn of(&self, session: u64, kind: u32) -> Vec<Seen> {
+        self.of_session(session).into_iter().filter(|event| event.kind == kind).collect()
+    }
+
+    /// The kinds among `kinds` the session got, in order.
+    fn order(&self, session: u64, kinds: &[u32]) -> Vec<u32> {
+        self.of_session(session).iter().map(|event| event.kind).filter(|kind| kinds.contains(kind)).collect()
+    }
+
+    /// The code and the serial of each transport error of the session, in order.
+    fn errors(&self, session: u64) -> Vec<(i32, u64)> {
+        self.of(session, TRANSPORT_ERROR).iter().map(|event| (event.code, event.request)).collect()
+    }
+}
+
+fn text_of(value: MTString) -> String {
+    if value.data.is_null() {
+        return String::new();
+    }
+    String::from_utf8_lossy(unsafe { std::slice::from_raw_parts(value.data, value.length) }).into_owned()
+}
+
+/// Copies what the test needs, and only then frees the payload, as a host must for every event.
+unsafe extern "C" fn on_event(context: *mut c_void, session: u64, event: *const MTEvent) {
+    let sink = unsafe { &*(context as *const Sink) };
+    let event = unsafe { &*event };
+    let seen = Seen {
+        session,
+        kind: event.kind,
+        request: event.request_id,
+        code: event.code,
+        flags: event.flags,
+        text: text_of(event.text),
+    };
+    if !event.payload.is_null() {
+        unsafe { mt_buffer_free(event.payload) };
+    }
+    sink.events.lock().unwrap().push(seen);
+    sink.condvar.notify_all();
+}
+
+fn bytes(data: &[u8]) -> MTBytes {
+    MTBytes { data: data.as_ptr(), length: data.len() }
+}
+
+fn string(text: &str) -> MTString {
+    MTString { data: text.as_ptr(), length: text.len() }
+}
+
+fn proxy(kind: u8, host: &str, port: u16, secret: &[u8]) -> MTProxy {
+    MTProxy { kind, host: string(host), port, username: string(""), password: string(""), secret: bytes(secret) }
+}
+
+fn mtproxy(host: &str, port: u16, secret: &[u8]) -> MTProxy {
+    proxy(2, host, port, secret)
+}
+
+fn no_proxy() -> MTProxy {
+    proxy(0, "", 0, &[])
+}
+
+/// The kinds a host hands over as they are, framing abridged: the engine pads under `dd` and `ee` by itself.
+fn secrets() -> [(&'static str, Vec<u8>); 3] {
+    let prefixed = |first: u8, fill: u8, rest: &[u8]| {
+        let mut secret = vec![first];
+        secret.extend_from_slice(&[fill; 16]);
+        secret.extend_from_slice(rest);
+        secret
+    };
+    [("plain", vec![0x11; 16]), ("dd", prefixed(0xdd, 0x22, &[])), ("ee", prefixed(0xee, 0x33, b"www.example.com"))]
+}
+
+fn mtproxy_server(key: &AuthKey, secret: &[u8]) -> TestServer {
+    TestServer::start(vec![key.clone()], ServerOptions { secret: Some(secret.to_vec()), ..Default::default() })
+}
+
+fn generating_options(secret: Option<&[u8]>, fault: i32) -> ServerOptions {
+    ServerOptions {
+        secret: secret.map(<[u8]>::to_vec),
+        handshake: ServerHandshakeBehavior { live_time: true, ..Default::default() },
+        handshake_faults: vec![HandshakeFault::TransportError(fault)],
+        ..Default::default()
+    }
+}
+
+struct Rig {
+    engine: *mut MTEngine,
+    sink: &'static Sink,
+}
+
+impl Rig {
+    fn new() -> Self {
+        let sink: &'static Sink = Box::leak(Box::default());
+        let engine = unsafe { mt_engine_create(1, sink as *const Sink as *mut c_void, Some(on_event), None) };
+        assert!(!engine.is_null());
+        Self { engine, sink }
+    }
+
+    /// A main session; `pems` makes it generate its key.
+    fn session(
+        &self,
+        address: (&str, u16),
+        proxy: MTProxy,
+        key: &[u8],
+        pems: &[MTString],
+        environment: Option<&MTEnvironment>,
+        paused: u8,
+    ) -> u64 {
+        let address = MTAddress { host: string(address.0), port: address.1, secret: bytes(&[]) };
+        let now = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_secs_f64();
+        let salt = MTSaltEntry { salt: SERVER_SALT, valid_since: now - 60.0, valid_until: now + 3600.0 };
+        let setup = MTSessionSetup {
+            datacenter_id: 2,
+            obfuscation_dc_id: 2,
+            role: 0,
+            framing: 0,
+            addresses: &address,
+            address_count: 1,
+            proxy,
+            auth_key: bytes(key),
+            salts: &salt,
+            salt_count: 1,
+            has_init_hash: 0,
+            init_hash: string(""),
+            generate_key: u8::from(!pems.is_empty()),
+            public_keys_pem: pems.as_ptr(),
+            public_key_count: pems.len(),
+            temp_key_expires_in: 0,
+            environment: environment.map_or(std::ptr::null(), std::ptr::from_ref),
+            time_difference: 0.0,
+            online: 1,
+            paused,
+            keep_connected: 1,
+            idle_disconnect_after: 0.0,
+            request_timeout: 5.0,
+            pfs_lifetime: 0,
+            pfs_make_permanent_key: 0,
+            pfs_temporary_key: std::ptr::null(),
+        };
+        let session = unsafe { mt_session_create(self.engine, &setup) };
+        assert_ne!(session, 0);
+        session
+    }
+
+    /// A session behind an MTProxy: an MTProxy session takes host and port from the proxy and never dials
+    /// its datacenter address, which leads nowhere here (RFC 5737).
+    fn proxied_session(&self, proxy: MTProxy, key: &[u8], environment: Option<&MTEnvironment>) -> u64 {
+        self.session(("192.0.2.1", 443), proxy, key, &[], environment, 0)
+    }
+
+    /// Sends the call and waits until the session completed it.
+    fn run(&self, session: u64, body: &[u8]) {
+        let id = self.send(session, body);
+        self.wait_completed(session, id);
+    }
+
+    fn send(&self, session: u64, body: &[u8]) -> u64 {
+        let id = unsafe { mt_engine_next_request_id(self.engine) };
+        let request = MTRequest { id, body: bytes(body), flags: 0, expected_response_size: 0, invoke_after: 0 };
+        unsafe { mt_session_send(self.engine, session, &request) };
+        id
+    }
+
+    fn wait_completed(&self, session: u64, id: u64) {
+        let done = self.sink.wait(|events| {
+            events.iter().any(|event| event.session == session && event.kind == COMPLETED && event.request == id)
+        });
+        assert!(done, "call {id} did not complete: {:?}", self.sink.of_session(session));
+    }
+
+    fn set_proxy(&self, session: u64, proxy: MTProxy) {
+        unsafe { mt_session_set_proxy(self.engine, session, &proxy) };
+    }
+
+    fn set_proxy_addresses(&self, session: u64, host: &str, addresses: &[&str]) {
+        let addresses: Vec<MTString> = addresses.iter().map(|address| string(address)).collect();
+        unsafe {
+            mt_session_set_proxy_addresses(self.engine, session, string(host), addresses.as_ptr(), addresses.len())
+        };
+    }
+}
+
+impl Drop for Rig {
+    fn drop(&mut self) {
+        unsafe { mt_engine_destroy(self.engine) };
+    }
+}
+
+fn wait_for_connection(server: &TestServer) {
+    let deadline = Instant::now() + WAIT;
+    while server.with_stats(|stats| stats.connections) == 0 {
+        assert!(Instant::now() < deadline, "no connection came");
+        std::thread::sleep(Duration::from_millis(10));
+    }
+}
+
+#[test]
+fn the_header_declares_abi_10() {
+    let header = include_str!("../include/mtproto_engine.h");
+    for declared in ["MTEventKindTransportError = 38,", "The event only observes"] {
+        assert!(header.contains(declared), "{declared}");
+    }
+    assert_eq!(mt_engine_abi_version(), 10);
+}
+
+/// A real answer of each code through each kind of MTProxy, whose frames differ on the wire: the host gets
+/// exactly the code, -444 and -403 apart, with serial 0 of a proxy only ever given at setup, ahead of the events
+/// it got before ABI 10; and the session recovers as it did, sending the call again on a new connection.
+#[test]
+fn a_code_through_an_mtproxy_of_each_kind_comes_first_and_changes_nothing_else() {
+    for (kind, secret) in secrets() {
+        for code in [-444, -403] {
+            let key = random_key(1001);
+            let server = mtproxy_server(&key, &secret);
+            let rig = Rig::new();
+            let session = rig.proxied_session(mtproxy("127.0.0.1", server.address.port(), &secret), key.bytes(), None);
+            let started = Instant::now();
+            rig.run(session, &transport_error_call(code));
+            let what = format!("{kind} {code}: {:?}", rig.sink.of_session(session));
+            assert!(started.elapsed() < Duration::from_secs(4), "{what}");
+            assert_eq!(rig.sink.errors(session), [(code, 0)], "{what}");
+            let told = &rig.sink.of(session, TRANSPORT_ERROR)[0];
+            assert_eq!((told.flags, told.text.as_str()), (0, ""), "the code and the serial is all it says: {what}");
+            assert_eq!(
+                rig.sink.order(session, &[TRANSPORT_ERROR, CONNECTION_DROPPED, COMPLETED]),
+                [TRANSPORT_ERROR, CONNECTION_DROPPED, COMPLETED],
+                "{what}"
+            );
+            assert_eq!(rig.sink.of(session, CONNECTION_DROPPED)[0].text, "address_rejected", "{what}");
+            let legacy = rig.sink.order(session, &[AUTH_KEY_INVALID, AUTH_KEY_CREATION_FAILED, TRANSPORT_FLOOD]);
+            assert!(legacy.is_empty(), "{what}");
+            assert!(rig.sink.of(session, ADDRESS_RESULT).iter().all(|event| event.code == 1), "{what}");
+            assert_eq!(server.executions(TAG_TRANSPORT_ERROR_ONCE), 2, "{what}");
+            assert_eq!(server.with_stats(|stats| stats.transport_errors_sent), 1, "{what}");
+            assert!(server.with_stats(|stats| stats.connections) >= 2, "{what}");
+        }
+    }
+}
+
+/// During a handshake the code comes before the `AuthKeyCreationFailed` it leads to, and the next attempt makes
+/// the key.
+#[test]
+fn a_handshake_error_comes_before_the_failure_it_leads_to() {
+    let secrets = secrets();
+    let (_, secret) = &secrets[1];
+    let server = TestServer::start(Vec::new(), generating_options(Some(secret), -444));
+    let rig = Rig::new();
+    let pem = test_rsa_public_key_pem();
+    let pems = [string(&pem)];
+    let proxy = mtproxy("127.0.0.1", server.address.port(), secret);
+    let session = rig.session(("192.0.2.1", 443), proxy, &[], &pems, None, 0);
+    rig.run(session, &call(7, &[1]));
+    let what = format!("{:?}", rig.sink.of_session(session));
+    assert_eq!(rig.sink.errors(session), [(-444, 0)], "{what}");
+    assert_eq!(
+        rig.sink.order(session, &[TRANSPORT_ERROR, AUTH_KEY_CREATION_FAILED, AUTH_KEY_CREATED, COMPLETED]),
+        [TRANSPORT_ERROR, AUTH_KEY_CREATION_FAILED, AUTH_KEY_CREATED, COMPLETED],
+        "{what}"
+    );
+    assert_eq!(rig.sink.of(session, AUTH_KEY_CREATION_FAILED)[0].text, "transport error -444", "{what}");
+    assert_eq!(rig.sink.of(session, AUTH_KEY_INVALID).len(), 0, "{what}");
+    assert_eq!(server.with_stats(|stats| stats.handshakes), 1, "{what}");
+}
+
+/// The serial a host counts with its calls: an equal setter counts and does nothing else, another proxy counts,
+/// a switch of the secret alone counts, and no address list does. Each server answers one code, so the session
+/// moves on through three of them.
+#[test]
+fn the_serial_counts_every_proxy_setter_and_no_address_list() {
+    let key = random_key(1002);
+    let secret = [0x44u8; 16];
+    let wrong = [0x55u8; 16];
+    let first = mtproxy_server(&key, &secret);
+    let second = mtproxy_server(&key, &secret);
+    let third = mtproxy_server(&key, &secret);
+    let (first_port, second_port, third_port) = (first.address.port(), second.address.port(), third.address.port());
+    let rig = Rig::new();
+    let session = rig.proxied_session(mtproxy("127.0.0.1", first_port, &secret), key.bytes(), None);
+    let plain = call(7, &[1]);
+
+    rig.run(session, &plain);
+    rig.set_proxy(session, mtproxy("127.0.0.1", first_port, &secret));
+    rig.run(session, &plain);
+    assert_eq!(first.with_stats(|stats| stats.connections), 1, "an equal setter keeps the connection");
+    rig.run(session, &transport_error_call(-444));
+    assert_eq!(rig.sink.errors(session), [(-444, 1)]);
+
+    rig.set_proxy_addresses(session, NAME, &["127.0.0.1"]);
+    rig.set_proxy(session, mtproxy(NAME, second_port, &secret));
+    rig.run(session, &plain);
+    rig.set_proxy_addresses(session, NAME, &["127.0.0.1", "127.0.0.2"]);
+    rig.run(session, &transport_error_call(-403));
+    assert_eq!(rig.sink.errors(session), [(-444, 1), (-403, 2)], "neither list counted");
+
+    rig.set_proxy(session, mtproxy("127.0.0.1", third_port, &wrong));
+    wait_for_connection(&third);
+    assert_eq!(third.with_stats(|stats| stats.obfuscation_dc_ids.len()), 0, "the wrong secret gets no further");
+    rig.set_proxy(session, mtproxy("127.0.0.1", third_port, &secret));
+    rig.run(session, &transport_error_call(-444));
+    assert_eq!(
+        rig.sink.errors(session),
+        [(-444, 1), (-403, 2), (-444, 4)],
+        "a refusal without a code tells nothing, and each secret counted"
+    );
+}
+
+/// Over HTTP the status of a call, and the status of a handshake's plain request, come as their negatives.
+#[test]
+fn an_http_status_comes_as_its_negative_code() {
+    let key = random_key(1003);
+    let server = TestServer::start(vec![key.clone()], ServerOptions::default());
+    let rig = Rig::new();
+    let session = rig.session(("127.0.0.1", server.address.port()), no_proxy(), key.bytes(), &[], None, 1);
+    unsafe { mt_session_set_transport(rig.engine, session, 1, 0) };
+    let id = rig.send(session, &transport_error_call(-444));
+    unsafe { mt_session_set_paused(rig.engine, session, 0) };
+    rig.wait_completed(session, id);
+    let what = format!("{:?}", rig.sink.of_session(session));
+    assert_eq!(rig.sink.errors(session), [(-444, 0)], "{what}");
+    assert_eq!(server.with_stats(|stats| stats.http.status_errors), 1, "{what}");
+    assert_eq!(
+        rig.sink.order(session, &[TRANSPORT_ERROR, CONNECTION_DROPPED, COMPLETED]),
+        [TRANSPORT_ERROR, CONNECTION_DROPPED, COMPLETED],
+        "{what}"
+    );
+    assert_eq!(rig.sink.of(session, CONNECTION_DROPPED)[0].text, "address_rejected", "{what}");
+
+    let server = TestServer::start(Vec::new(), generating_options(None, -403));
+    let pem = test_rsa_public_key_pem();
+    let pems = [string(&pem)];
+    let session = rig.session(("127.0.0.1", server.address.port()), no_proxy(), &[], &pems, None, 1);
+    unsafe { mt_session_set_transport(rig.engine, session, 1, 0) };
+    let id = rig.send(session, &call(7, &[1]));
+    unsafe { mt_session_set_paused(rig.engine, session, 0) };
+    rig.wait_completed(session, id);
+    let what = format!("{:?}", rig.sink.of_session(session));
+    assert_eq!(rig.sink.errors(session), [(-403, 0)], "{what}");
+    assert_eq!(
+        rig.sink.order(session, &[TRANSPORT_ERROR, AUTH_KEY_CREATION_FAILED, AUTH_KEY_CREATED, COMPLETED]),
+        [TRANSPORT_ERROR, AUTH_KEY_CREATION_FAILED, AUTH_KEY_CREATED, COMPLETED],
+        "{what}"
+    );
+}
+
+fn environment(client_proxy: Option<(&str, i32)>, init_hash: &str) -> MTEnvironment {
+    let (address, port) = client_proxy.unwrap_or(("", 0));
+    MTEnvironment {
+        layer: 230,
+        api_id: 9,
+        device_model: string("Mac"),
+        system_version: string("26"),
+        app_version: string("1"),
+        system_lang_code: string("en"),
+        lang_pack: string("macos"),
+        lang_code: string("en"),
+        has_proxy: u8::from(client_proxy.is_some()),
+        proxy_address: string(address),
+        proxy_port: port,
+        has_params: 0,
+        params: bytes(&[]),
+        init_hash: string(init_hash),
+        disable_updates: 0,
+    }
+}
+
+/// The server reads the proxy `MTEnvironment` names in the `initConnection` of the next call, a name as a name;
+/// a call with nothing new adds nothing, and without the field the next one says so.
+#[test]
+fn the_environment_proxy_reaches_the_server_until_it_is_removed() {
+    let key = random_key(1004);
+    let secrets = secrets();
+    let (_, secret) = &secrets[0];
+    let server = mtproxy_server(&key, secret);
+    let rig = Rig::new();
+    let named = environment(Some(("proxy.example", 8443)), "named");
+    let port = server.address.port();
+    let session = rig.proxied_session(mtproxy("127.0.0.1", port, secret), key.bytes(), Some(&named));
+    let plain = call(7, &[1]);
+    let observed = || server.with_stats(|stats| (stats.init_connections, stats.client_proxies.clone()));
+    let present = Some(("proxy.example".to_string(), 8443));
+
+    rig.run(session, &plain);
+    assert_eq!(observed(), (1, vec![present.clone()]));
+    rig.run(session, &plain);
+    assert_eq!(observed(), (1, vec![present.clone()]), "nothing new, no new initConnection");
+
+    let removed = environment(None, "removed");
+    unsafe { mt_session_update_environment(rig.engine, session, &removed, std::ptr::null()) };
+    rig.run(session, &plain);
+    assert_eq!(observed(), (2, vec![present, None]));
+}
diff --git a/crates/mtproto-ffi/tests/ffi_abi6.rs b/crates/mtproto-ffi/tests/ffi_abi6.rs
new file mode 100644
index 0000000..cd2ef4e
--- /dev/null
+++ b/crates/mtproto-ffi/tests/ffi_abi6.rs
@@ -0,0 +1,298 @@
+//! What ABI 6 added, through the C ABI with real callbacks that free every payload: the session's own
+//! HTTP addresses (`mt_session_set_http_addresses`), dependency waits handed to the host
+//! (`MTRequestFlagSurfaceDependencyWaits`) and the reason of each `MTEventKindUpdatesReset`, with the
+//! server's `new_session_created` message as the payload of a server's new session.
+
+use std::ffi::c_void;
+use std::net::TcpListener;
+use std::sync::{Condvar, Mutex};
+use std::time::{Duration, Instant};
+
+use mtproto_engine_ffi::*;
+use mtproto_testserver::*;
+
+const COMPLETED: u32 = 1;
+const FAILED: u32 = 2;
+const UPDATES_RESET: u32 = 13;
+const SURFACE_DEPENDENCY_WAITS: u32 = 1 << 8;
+const NEW_SESSION_CREATED: u32 = 0x9ec2_0908;
+const WAIT: Duration = Duration::from_secs(15);
+
+#[derive(Clone, Debug)]
+struct Seen {
+    session: u64,
+    kind: u32,
+    request: u64,
+    code: i32,
+    text: String,
+    payload: Option<Vec<u8>>,
+}
+
+#[derive(Default)]
+struct Sink {
+    events: Mutex<Vec<Seen>>,
+    condvar: Condvar,
+}
+
+impl Sink {
+    fn wait(&self, timeout: Duration, predicate: impl Fn(&[Seen]) -> bool) -> bool {
+        let deadline = Instant::now() + timeout;
+        let mut events = self.events.lock().unwrap();
+        while !predicate(&events) {
+            let now = Instant::now();
+            if now >= deadline {
+                return false;
+            }
+            events = self.condvar.wait_timeout(events, deadline - now).unwrap().0;
+        }
+        true
+    }
+
+    fn of(&self, session: u64) -> Vec<Seen> {
+        self.events.lock().unwrap().iter().filter(|event| event.session == session).cloned().collect()
+    }
+}
+
+/// Copies what the test needs and frees the payload, as a host must for every event.
+unsafe extern "C" fn on_event(context: *mut c_void, session: u64, event: *const MTEvent) {
+    let sink = unsafe { &*(context as *const Sink) };
+    let event = unsafe { &*event };
+    let payload = (!event.payload.is_null()).then(|| {
+        let data =
+            unsafe { std::slice::from_raw_parts(mt_buffer_data(event.payload), mt_buffer_length(event.payload)) }
+                .to_vec();
+        unsafe { mt_buffer_free(event.payload) };
+        data
+    });
+    let text = if event.text.data.is_null() {
+        String::new()
+    } else {
+        String::from_utf8_lossy(unsafe { std::slice::from_raw_parts(event.text.data, event.text.length) }).into_owned()
+    };
+    sink.events.lock().unwrap().push(Seen {
+        session,
+        kind: event.kind,
+        request: event.request_id,
+        code: event.code,
+        text,
+        payload,
+    });
+    sink.condvar.notify_all();
+}
+
+fn bytes(data: &[u8]) -> MTBytes {
+    MTBytes { data: data.as_ptr(), length: data.len() }
+}
+
+fn string(text: &str) -> MTString {
+    MTString { data: text.as_ptr(), length: text.len() }
+}
+
+struct Rig {
+    server: TestServer,
+    key: mtproto_engine::mtproto_core::auth_key::AuthKey,
+    sink: &'static Sink,
+    engine: *mut MTEngine,
+    host: String,
+}
+
+impl Rig {
+    fn new(seed: u64) -> Self {
+        let key = random_key(seed);
+        let server = TestServer::start(vec![key.clone()], ServerOptions::default());
+        let sink: &'static Sink = Box::leak(Box::default());
+        let engine = unsafe { mt_engine_create(1, sink as *const Sink as *mut c_void, Some(on_event), None) };
+        assert!(!engine.is_null());
+        let host = server.address.ip().to_string();
+        Self { server, key, sink, engine, host }
+    }
+
+    /// A main session on `tcp_port`, created paused so that what is sent before `resume` goes out
+    /// together on its first connection.
+    fn paused_session(&self, tcp_port: u16) -> u64 {
+        let key = &self.key;
+        let address = MTAddress { host: string(&self.host), port: tcp_port, secret: bytes(&[]) };
+        let now = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_secs_f64();
+        let salt = MTSaltEntry { salt: SERVER_SALT, valid_since: now - 60.0, valid_until: now + 3600.0 };
+        let setup = MTSessionSetup {
+            datacenter_id: 2,
+            obfuscation_dc_id: 2,
+            role: 0,
+            framing: 0,
+            addresses: &address,
+            address_count: 1,
+            proxy: MTProxy {
+                kind: 0,
+                host: string(""),
+                port: 0,
+                username: string(""),
+                password: string(""),
+                secret: bytes(&[]),
+            },
+            auth_key: bytes(key.bytes()),
+            salts: &salt,
+            salt_count: 1,
+            has_init_hash: 0,
+            init_hash: string(""),
+            generate_key: 0,
+            public_keys_pem: std::ptr::null(),
+            public_key_count: 0,
+            temp_key_expires_in: 0,
+            environment: std::ptr::null(),
+            time_difference: 0.0,
+            online: 1,
+            paused: 1,
+            keep_connected: 1,
+            idle_disconnect_after: 0.0,
+            request_timeout: 5.0,
+            pfs_lifetime: 0,
+            pfs_make_permanent_key: 0,
+            pfs_temporary_key: std::ptr::null(),
+        };
+        let session = unsafe { mt_session_create(self.engine, &setup) };
+        assert_ne!(session, 0);
+        session
+    }
+
+    fn send(&self, session: u64, tag: u32, flags: u32, invoke_after: u64) -> u64 {
+        let id = unsafe { mt_engine_next_request_id(self.engine) };
+        self.send_body(session, id, &call(tag, &id.to_le_bytes()), flags, invoke_after);
+        id
+    }
+
+    fn send_body(&self, session: u64, id: u64, body: &[u8], flags: u32, invoke_after: u64) {
+        let request = MTRequest { id, body: bytes(body), flags, expected_response_size: 0, invoke_after };
+        unsafe { mt_session_send(self.engine, session, &request) };
+    }
+
+    fn resume(&self, session: u64) {
+        unsafe { mt_session_set_paused(self.engine, session, 0) };
+    }
+
+    fn finished(&self, session: u64, id: u64) -> Option<Seen> {
+        self.sink
+            .of(session)
+            .into_iter()
+            .find(|event| (event.kind == COMPLETED || event.kind == FAILED) && event.request == id)
+    }
+
+    fn wait_finished(&self, session: u64, id: u64) -> Option<Seen> {
+        self.sink.wait(WAIT, |events| {
+            events.iter().any(|e| e.session == session && e.request == id && (e.kind == COMPLETED || e.kind == FAILED))
+        });
+        self.finished(session, id)
+    }
+}
+
+impl Drop for Rig {
+    fn drop(&mut self) {
+        unsafe { mt_engine_destroy(self.engine) };
+    }
+}
+
+/// A local port nothing listens on.
+fn closed_port() -> u16 {
+    TcpListener::bind("127.0.0.1:0").unwrap().local_addr().unwrap().port()
+}
+
+#[test]
+fn the_header_declares_abi_6() {
+    let header = include_str!("../include/mtproto_engine.h");
+    for declared in [
+        "MTRequestFlagSurfaceDependencyWaits = 1 << 8,",
+        "MTUpdatesResetServerSession = 1,",
+        "MTUpdatesResetLocalSession = 2,",
+        "MTUpdatesResetUpdatesLost = 3,",
+        "MTUpdatesResetUpdatesTooLong = 4,",
+        "void mt_session_set_http_addresses(MTEngine *engine, MTSessionHandle session, const MTAddress *addresses, size_t count);",
+    ] {
+        assert!(header.contains(declared), "{declared}");
+    }
+    assert_eq!((UPDATES_RESET_SERVER_SESSION, UPDATES_RESET_LOCAL_SESSION, UPDATES_RESET_UPDATES_LOST), (1, 2, 3));
+    assert_eq!(UPDATES_RESET_UPDATES_TOO_LONG, 4);
+    assert_eq!(mt_engine_abi_version(), 10);
+}
+
+#[test]
+fn http_goes_to_the_addresses_the_host_gives() {
+    let rig = Rig::new(601);
+    // The TCP address leads nowhere, and HTTP derived from it would go there too.
+    let session = rig.paused_session(closed_port());
+    unsafe { mt_session_set_transport(rig.engine, session, 1, 0) };
+    let http = MTAddress { host: string(&rig.host), port: rig.server.address.port(), secret: bytes(&[]) };
+    unsafe { mt_session_set_http_addresses(rig.engine, session, &http, 1) };
+    let id = rig.send(session, 7, 0, 0);
+    rig.resume(session);
+    let finished = rig.wait_finished(session, id).expect("the call completes over the given HTTP address");
+    assert_eq!(finished.kind, COMPLETED, "{finished:?}");
+    let (tag, payload) = parse_result(finished.payload.as_deref().unwrap_or_default()).unwrap();
+    assert_eq!((tag, payload), (7, id.to_le_bytes().to_vec()));
+    assert!(rig.server.with_stats(|stats| stats.http.requests) > 0, "it went over HTTP");
+}
+
+#[test]
+fn a_dependent_of_a_failed_request_reaches_the_host_that_asks_for_it() {
+    let rig = Rig::new(602);
+    let port = rig.server.address.port();
+
+    // A floods; B, chained after it with invokeAfterMsg, hears MSG_WAIT_FAILED and the host gets it.
+    let host_ordered = rig.paused_session(port);
+    let first = rig.send(host_ordered, TAG_FLOOD_ONCE, 0, 0);
+    let dependent = rig.send(host_ordered, 7, SURFACE_DEPENDENCY_WAITS, first);
+    rig.resume(host_ordered);
+    let failed = rig.wait_finished(host_ordered, first).expect("A finished");
+    assert_eq!((failed.kind, failed.code, failed.text.as_str()), (FAILED, 420, "FLOOD_WAIT_1"));
+    let failed = rig.wait_finished(host_ordered, dependent).expect("B finished");
+    assert_eq!((failed.kind, failed.code, failed.text.as_str()), (FAILED, 400, "MSG_WAIT_FAILED"));
+    assert!(rig.server.with_stats(|stats| stats.invoke_after) >= 1, "B rode with invokeAfterMsg");
+    std::thread::sleep(Duration::from_millis(1500));
+    assert_eq!(rig.server.executions(7), 0, "B never ran: the host sends it again once A is through");
+    let finished_b = rig
+        .sink
+        .of(host_ordered)
+        .iter()
+        .filter(|e| e.request == dependent && (e.kind == COMPLETED || e.kind == FAILED))
+        .count();
+    assert_eq!(finished_b, 1, "B finished once, as failed");
+
+    // The control without the flag: the engine waits for A, which has left, and sends B again at once.
+    let engine_ordered = rig.paused_session(port);
+    let first = rig.send(engine_ordered, TAG_SERVER_ERROR_ONCE, 0, 0);
+    let dependent = rig.send(engine_ordered, 8, 0, first);
+    rig.resume(engine_ordered);
+    let failed = rig.wait_finished(engine_ordered, first).expect("A finished");
+    assert_eq!((failed.kind, failed.code), (FAILED, 500));
+    let completed = rig.wait_finished(engine_ordered, dependent).expect("B finished");
+    assert_eq!(completed.kind, COMPLETED, "{completed:?}");
+    assert_eq!(rig.server.with_stats(|stats| stats.msg_wait_failures), 2, "both Bs heard MSG_WAIT_FAILED first");
+    assert_eq!(rig.server.executions(8), 1, "B ran once, sent again without invokeAfterMsg");
+}
+
+#[test]
+fn a_reset_says_why_and_a_new_server_session_hands_over_its_notice() {
+    let rig = Rig::new(604);
+    let session = rig.paused_session(rig.server.address.port());
+    let fresh = rig.send(session, TAG_NEW_SESSION, 0, 0);
+    rig.resume(session);
+    assert_eq!(rig.wait_finished(session, fresh).map(|event| event.kind), Some(COMPLETED));
+    assert!(rig.sink.wait(WAIT, |events| events.iter().any(|e| e.kind == UPDATES_RESET)));
+    let resets: Vec<Seen> = rig.sink.of(session).into_iter().filter(|event| event.kind == UPDATES_RESET).collect();
+    assert_eq!(resets.len(), 1, "{resets:?}");
+    assert_eq!(resets[0].code, UPDATES_RESET_SERVER_SESSION);
+    let notice = resets[0].payload.clone().expect("the server's message");
+    assert_eq!(notice.len(), 28);
+    assert_eq!(u32::from_le_bytes(notice[..4].try_into().unwrap()), NEW_SESSION_CREATED);
+    assert_eq!(i64::from_le_bytes(notice[12..20].try_into().unwrap()), 77, "the test server's unique_id");
+    assert_eq!(i64::from_le_bytes(notice[20..28].try_into().unwrap()), SERVER_SALT);
+
+    // msg_seqno too low: the session starts a new session of its own and sends the call again.
+    let local = unsafe { mt_engine_next_request_id(rig.engine) };
+    rig.send_body(session, local, &bad_msg_call(32, false), 0, 0);
+    assert_eq!(rig.wait_finished(session, local).map(|event| event.kind), Some(COMPLETED));
+    assert!(rig.sink.wait(WAIT, |events| events.iter().filter(|e| e.kind == UPDATES_RESET).count() >= 2));
+    let resets: Vec<Seen> = rig.sink.of(session).into_iter().filter(|event| event.kind == UPDATES_RESET).collect();
+    assert_eq!(resets[1].code, UPDATES_RESET_LOCAL_SESSION, "{resets:?}");
+    for reset in &resets {
+        assert_eq!(reset.payload.is_some(), reset.code == UPDATES_RESET_SERVER_SESSION, "{reset:?}");
+    }
+}
diff --git a/crates/mtproto-ffi/tests/ffi_abi8.rs b/crates/mtproto-ffi/tests/ffi_abi8.rs
