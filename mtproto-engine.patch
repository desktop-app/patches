+        address_count: addresses.len(),
+        proxy: no_proxy(),
+        auth_key: bytes(&start.persistent_key),
+        salts: std::ptr::null(),
+        salt_count: 0,
+        has_init_hash: 0,
+        init_hash: string(""),
+        generate_key: 0,
+        public_keys_pem: pems.as_ptr(),
+        public_key_count: pems.len(),
+        temp_key_expires_in: 0,
+        environment: &environment,
+        time_difference: 0.0,
+        online: 0,
+        paused: 1,
+        keep_connected: 1,
+        idle_disconnect_after: 0.0,
+        request_timeout: 0.0,
