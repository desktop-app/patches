@@ -0,0 +1,387 @@
+//! What ABI 12 added, through the C ABI with real callbacks: `mt_route_check_start` and `mt_route_check_cancel`, a
+//! check of a route with one unauthenticated request outside any session, and `MTEventKindRouteChecked`, its one
+//! result. The test server's counters show how far a check got: `req_pqs` that its request arrived, `dh_requests`,
+//! `handshakes` and `client_packets` that no key was made or used. A client's close is counted as
+//! `closed_by_client + reset_by_client`, as Windows resets a socket closed with bytes unread.
+
+use std::ffi::c_void;
+use std::sync::{Condvar, Mutex};
+use std::time::{Duration, Instant, SystemTime, UNIX_EPOCH};
+
+use mtproto_engine_ffi::*;
+use mtproto_testserver::*;
+
+const ROUTE_CHECKED: u32 = 39;
+const WAIT: Duration = Duration::from_secs(20);
+/// How long a test waits to see that nothing more comes: twice the bound of a check's attempt where it sets one.
+const SILENCE: Duration = Duration::from_secs(2);
+/// The obfuscation id each check sends: a test datacenter's, as a host on the test servers gives it.
+const DC_ID: i16 = 10002;
+/// A name no resolver answers (RFC 6761).
+const NAME: &str = "proxy.invalid";
+/// A peer's close: clean, or a reset on Windows when the peer left the client's bytes unread.
+const CLOSED: [&str; 2] = ["closed", "io_error"];
+/// What a hello's time, truncated, may read beyond the wall clock around it.
+const SLACK: f64 = 2.0;
+
+#[derive(Clone, Debug, PartialEq)]
+struct Seen {
+    session: u64,
+    kind: u32,
+    code: i32,
+    text: String,
+    value: f64,
+    attempts: i64,
+}
+
+#[derive(Default)]
+struct Sink {
+    events: Mutex<Vec<Seen>>,
+    condvar: Condvar,
+}
+
+impl Sink {
+    fn wait(&self, timeout: Duration, predicate: impl Fn(&[Seen]) -> bool) -> bool {
+        let deadline = Instant::now() + timeout;
+        let mut events = self.events.lock().unwrap();
+        while !predicate(&events) {
+            let now = Instant::now();
+            if now >= deadline {
+                return false;
+            }
+            events = self.condvar.wait_timeout(events, deadline - now).unwrap().0;
+        }
+        true
+    }
+
+    fn all(&self) -> Vec<Seen> {
+        self.events.lock().unwrap().clone()
+    }
+
+    fn of(&self, check: u64) -> Vec<Seen> {
+        self.all().into_iter().filter(|event| event.session == check).collect()
+    }
+}
+
+fn text_of(value: MTString) -> String {
+    if value.data.is_null() {
+        return String::new();
+    }
+    String::from_utf8_lossy(unsafe { std::slice::from_raw_parts(value.data, value.length) }).into_owned()
+}
+
+/// Copies what the test needs, and only then frees the payload, as a host must for every event.
+unsafe extern "C" fn on_event(context: *mut c_void, session: u64, event: *const MTEvent) {
+    let sink = unsafe { &*(context as *const Sink) };
+    let event = unsafe { &*event };
+    let seen = Seen {
+        session,
+        kind: event.kind,
+        code: event.code,
+        text: text_of(event.text),
+        value: event.value1,
+        attempts: event.integer1,
+    };
+    if !event.payload.is_null() {
+        unsafe { mt_buffer_free(event.payload) };
+    }
+    sink.events.lock().unwrap().push(seen);
+    sink.condvar.notify_all();
+}
+
+fn bytes(data: &[u8]) -> MTBytes {
+    MTBytes { data: data.as_ptr(), length: data.len() }
+}
+
+fn string(text: &str) -> MTString {
+    MTString { data: text.as_ptr(), length: text.len() }
+}
+
+fn wall_clock() -> f64 {
+    SystemTime::now().duration_since(UNIX_EPOCH).unwrap().as_secs_f64()
+}
+
+fn eventually(predicate: impl Fn() -> bool) -> bool {
+    let deadline = Instant::now() + WAIT;
+    while !predicate() {
+        if Instant::now() >= deadline {
+            return false;
+        }
+        std::thread::sleep(Duration::from_millis(5));
+    }
+    true
+}
+
+/// A `dd` secret and one that is wrong for it.
+fn padded() -> (Vec<u8>, Vec<u8>) {
+    let of = |fill: u8| [&[0xdd][..], &[fill; 16]].concat();
+    (of(0x22), of(0x23))
+}
+
+fn fake_tls() -> Vec<u8> {
+    [&[0xee][..], &[0x33; 16], b"www.example.com"].concat()
+}
+
+/// A port nothing listens at.
+fn closed_port() -> u16 {
+    std::net::TcpListener::bind("127.0.0.1:0").unwrap().local_addr().unwrap().port()
+}
+
+/// How far the checks got at a server: connections, `req_pq_multi` packets, later handshake steps, finished
+/// handshakes and encrypted packets.
+fn progress(server: &TestServer) -> (usize, usize, usize, usize, usize) {
+    server.with_stats(|stats| {
+        (stats.connections, stats.req_pqs, stats.dh_requests, stats.handshakes, stats.client_packets)
+    })
+}
+
+fn closed_by_client(server: &TestServer) -> usize {
+    server.with_stats(|stats| stats.closed_by_client + stats.reset_by_client)
+}
+
+fn no_proxy() -> MTProxy {
+    MTProxy { kind: 0, host: string(""), port: 0, username: string(""), password: string(""), secret: bytes(&[]) }
+}
+
+fn mtproxy(host: MTString, port: u16, secret: MTBytes) -> MTProxy {
+    MTProxy { kind: 2, host, port, username: string(""), password: string(""), secret }
+}
+
+/// The datacenter address a tunnel would ask for, unused under an MTProxy (RFC 5737).
+fn behind() -> MTAddress {
+    MTAddress { host: string("192.0.2.1"), port: 443, secret: bytes(&[]) }
+}
+
+fn at(server: &TestServer) -> MTAddress {
+    MTAddress { host: string("127.0.0.1"), port: server.address.port(), secret: bytes(&[]) }
+}
+
+/// A check as a host fills it: no proxy addresses, no hello offset, the default bound.
+fn setup(address: MTAddress, proxy: MTProxy) -> MTRouteCheck {
+    MTRouteCheck {
+        address,
+        obfuscation_dc_id: DC_ID,
+        framing: 0,
+        proxy,
+        proxy_addresses: std::ptr::null(),
+        proxy_address_count: 0,
+        time_difference: 0.0,
+        tls_hello_time_offset: std::ptr::null(),
+        timeout: 0.0,
+    }
+}
+
+struct Rig {
+    engine: *mut MTEngine,
+    sink: &'static Sink,
+}
+
+impl Rig {
+    /// Two workers: checks run on worker 1, as sessions other than the main one do.
+    fn new() -> Self {
+        let sink: &'static Sink = Box::leak(Box::default());
+        let engine = unsafe { mt_engine_create(2, sink as *const Sink as *mut c_void, Some(on_event), None) };
+        assert!(!engine.is_null());
+        Self { engine, sink }
+    }
+
+    fn start(&self, check: &MTRouteCheck) -> u64 {
+        let handle = unsafe { mt_route_check_start(self.engine, check) };
+        assert_ne!(handle, 0, "the check did not start");
+        handle
+    }
+
+    /// The check's first event.
+    fn result(&self, check: u64) -> Seen {
+        let came = self.sink.wait(WAIT, |events| events.iter().any(|event| event.session == check));
+        assert!(came, "no result for the check: {:?}", self.sink.all());
+        self.sink.of(check)[0].clone()
+    }
+}
+
+impl Drop for Rig {
+    fn drop(&mut self) {
+        unsafe { mt_engine_destroy(self.engine) };
+    }
+}
+
+#[test]
+fn the_header_declares_abi_12() {
+    let header = include_str!("../include/mtproto_engine.h");
+    for declared in [
+        "typedef struct MTRouteCheck {",
+        "    const double *tls_hello_time_offset;",
+        "} MTRouteCheck;",
+        "uint64_t mt_route_check_start(MTEngine *engine, const MTRouteCheck *check);",
+        "void mt_route_check_cancel(MTEngine *engine, uint64_t check);",
+        "MTEventKindRouteChecked = 39,",
+    ] {
+        assert!(header.contains(declared), "{declared}");
+    }
+    let _: unsafe extern "C" fn(*mut MTEngine, *const MTRouteCheck) -> u64 = mt_route_check_start;
+    let _: unsafe extern "C" fn(*mut MTEngine, u64) = mt_route_check_cancel;
+    assert_eq!(mt_engine_abi_version(), 12);
+}
+
+/// Through a `dd` MTProxy the check answers with its first attempt: kind 39, code 1, the round trip in value1, no
+/// reason, after one plain request with the obfuscation id given and no key work. The client closes the connection,
+/// and nothing else comes for the handle.
+#[test]
+fn a_route_check_through_the_c_abi_reports_the_round_trip() {
+    let (secret, _) = padded();
+    let server = TestServer::start(Vec::new(), ServerOptions { secret: Some(secret.clone()), ..Default::default() });
+    let rig = Rig::new();
+    let started = Instant::now();
+    let handle = rig.start(&setup(behind(), mtproxy(string("127.0.0.1"), server.address.port(), bytes(&secret))));
+    let result = rig.result(handle);
+    let took = started.elapsed().as_secs_f64();
+    assert_eq!((result.kind, result.code, result.text.as_str(), result.attempts), (ROUTE_CHECKED, 1, "", 1));
+    assert!(0.0 <= result.value && result.value <= took, "{result:?} in {took} s");
+    assert_eq!(progress(&server), (1, 1, 0, 0, 0), "not one plain request alone");
+    assert_eq!(server.with_stats(|stats| stats.obfuscation_dc_ids.clone()), vec![DC_ID]);
+    assert!(eventually(|| closed_by_client(&server) == 1), "the client kept the connection");
+    assert_eq!(rig.sink.of(handle), vec![result]);
+}
+
+/// A wrong `dd` secret and a port nothing listens at: code 0, the reason in text, no round trip, one attempt, and
+/// nothing more for the handle afterwards. The closed port keeps the default bound, as Windows reports a refused
+/// loopback connection about 2 s late.
+#[test]
+fn a_refused_route_check_reports_its_reason_once() {
+    let (secret, wrong) = padded();
+    let server = TestServer::start(Vec::new(), ServerOptions { secret: Some(secret), ..Default::default() });
+    let rig = Rig::new();
+    let mut refused = setup(behind(), mtproxy(string("127.0.0.1"), server.address.port(), bytes(&wrong)));
+    refused.timeout = 1.0;
+    let closed = setup(MTAddress { port: closed_port(), ..at(&server) }, no_proxy());
+    let cases: [(&str, MTRouteCheck, &[&str]); 2] =
+        [("a wrong secret", refused, &CLOSED), ("a closed port", closed, &["io_error", "connect_failed"])];
+    for (what, check, reasons) in cases {
+        let handle = rig.start(&check);
+        let result = rig.result(handle);
+        assert_eq!((result.kind, result.code, result.value, result.attempts), (ROUTE_CHECKED, 0, 0.0, 1), "{what}");
+        assert!(reasons.contains(&result.text.as_str()), "{what}: {result:?}, expected one of {reasons:?}");
+        let more = rig.sink.wait(SILENCE, |events| events.iter().filter(|event| event.session == handle).count() > 1);
+        assert!(!more, "{what}: {:?}", rig.sink.of(handle));
+    }
+    assert_eq!(progress(&server), (1, 0, 0, 0, 0), "a request got past the wrong secret");
+}
+
+/// A null engine, a null setup and a WEB proxy start nothing and report nothing, and a cancel of no check, or without
+/// an engine, is ignored. The same route without the WEB proxy answers.
+#[test]
+fn a_web_proxy_or_no_setup_starts_no_check() {
+    let server = TestServer::start(Vec::new(), ServerOptions::default());
+    let rig = Rig::new();
+    let secret = fake_tls();
+    let web = MTProxy {
+        kind: 4,
+        host: string("127.0.0.1"),
+        port: server.address.port(),
+        ..mtproxy(string(""), 0, bytes(&secret))
+    };
+    let direct = setup(at(&server), no_proxy());
+    assert_eq!(unsafe { mt_route_check_start(rig.engine, &setup(at(&server), web)) }, 0, "a WEB proxy");
+    assert_eq!(unsafe { mt_route_check_start(rig.engine, std::ptr::null()) }, 0, "no setup");
+    assert_eq!(unsafe { mt_route_check_start(std::ptr::null_mut(), &direct) }, 0, "no engine");
+    unsafe { mt_route_check_cancel(rig.engine, 0) };
+    unsafe { mt_route_check_cancel(rig.engine, (1 << 8) | 1) };
+    unsafe { mt_route_check_cancel(std::ptr::null_mut(), 1) };
+    let came = rig.sink.wait(SILENCE, |events| !events.is_empty());
+    assert!(!came, "{:?}", rig.sink.all());
+    assert_eq!(progress(&server).0, 0, "something connected");
+
+    let handle = rig.start(&direct);
+    assert_eq!(rig.result(handle).code, 1, "{:?}", rig.sink.all());
+    assert_eq!(progress(&server), (1, 1, 0, 0, 0));
+}
+
+/// A check cancelled while its request stalls at the server reports nothing within twice its bound, and its
+/// connection is closed by the client.
+#[test]
+fn a_cancelled_route_check_reports_nothing() {
+    let server = TestServer::start(
+        Vec::new(),
+        ServerOptions { handshake_faults: vec![HandshakeFault::Stall], ..Default::default() },
+    );
+    let rig = Rig::new();
+    let mut check = setup(at(&server), no_proxy());
+    check.timeout = 1.0;
+    let handle = rig.start(&check);
+    assert!(eventually(|| progress(&server).1 == 1), "the request did not reach the server");
+    unsafe { mt_route_check_cancel(rig.engine, handle) };
+    assert!(eventually(|| closed_by_client(&server) == 1), "the cancel left the connection open");
+    let reported = rig.sink.wait(SILENCE, |events| !events.is_empty());
+    assert!(!reported, "a cancelled check reported {:?}", rig.sink.all());
+    assert_eq!(progress(&server), (1, 1, 0, 0, 0), "the cancelled check went on");
+}
+
+/// Writes `value` at the next odd offset of `arena` from `*next` on, and gives that offset.
+fn place(arena: &mut [u8], next: &mut usize, value: &[u8]) -> usize {
+    let offset = *next | 1;
+    arena[offset..offset + value.len()].copy_from_slice(value);
+    *next = offset + value.len();
+    offset
+}
+
+/// The setup itself copied out of a byte buffer at an offset of 4, where no struct holding an f64 may lie, every
+/// string at an odd address, and the hello offset at an address no f64 may have: all overwritten right after the
+/// call. The check still goes to the listed address of a proxy name that does not resolve, past a skipped entry and
+/// a repeat, with the `ee` secret given, and its hello says the offset (0) rather than the time difference (-600) a
+/// proxy that takes hellos within 120 s of its clock would refuse.
+#[test]
+fn the_setup_is_copied_during_the_call() {
+    let secret = fake_tls();
+    let options = ServerOptions { secret: Some(secret.clone()), tls_time_window: Some(120.0), ..Default::default() };
+    let server = TestServer::start(Vec::new(), options);
+    let rig = Rig::new();
+
+    let mut arena = vec![0u8; 256];
+    let mut next = 0;
+    let address_host = place(&mut arena, &mut next, b"192.0.2.1");
+    let proxy_host = place(&mut arena, &mut next, NAME.as_bytes());
+    let proxy_secret = place(&mut arena, &mut next, &secret);
+    let listed = ["not an address", "127.0.0.1", "[127.0.0.1]"]
+        .map(|entry| (place(&mut arena, &mut next, entry.as_bytes()), entry.len()));
+    let offset = (next..next + align_of::<f64>())
+        .find(|&offset| !(arena[offset..].as_ptr() as usize).is_multiple_of(align_of::<f64>()))
+        .unwrap();
+    arena[offset..offset + size_of::<f64>()].copy_from_slice(&0.0f64.to_ne_bytes());
+    let base = arena.as_ptr();
+    let view = |offset: usize, length: usize| MTString { data: unsafe { base.add(offset) }, length };
+    let mut addresses = listed.map(|(offset, length)| view(offset, length)).to_vec();
+    let mut check = setup(
+        MTAddress { host: view(address_host, 9), port: 443, secret: bytes(&[]) },
+        mtproxy(
+            view(proxy_host, NAME.len()),
+            server.address.port(),
+            MTBytes { data: unsafe { base.add(proxy_secret) }, length: secret.len() },
+        ),
+    );
+    check.proxy_addresses = addresses.as_ptr();
+    check.proxy_address_count = addresses.len();
+    check.time_difference = -600.0;
+    check.tls_hello_time_offset = unsafe { base.add(offset) }.cast();
+
+    let mut holder = vec![0u64; size_of::<MTRouteCheck>() / size_of::<u64>() + 2];
+    let placed = unsafe { holder.as_mut_ptr().cast::<u8>().add(4) }.cast::<MTRouteCheck>();
+    assert!(!(placed as usize).is_multiple_of(align_of::<MTRouteCheck>()), "the setup lies where it may");
+    unsafe { placed.write_unaligned(check) };
+    let since = wall_clock();
+    let handle = unsafe { mt_route_check_start(rig.engine, placed) };
+    holder.fill(u64::MAX);
+    arena.fill(0xff);
+    addresses.fill(MTString { data: std::ptr::null(), length: usize::MAX });
+    drop((holder, arena, addresses));
+    assert_ne!(handle, 0, "the check did not start");
+
+    let result = rig.result(handle);
+    assert_eq!((result.code, result.text.as_str(), result.attempts), (1, "", 1), "{result:?}");
+    let hellos = server.with_stats(|stats| stats.tls_hello_times.clone());
+    assert_eq!(hellos.len(), 1, "{hellos:?}");
+    let (low, high) = (since - SLACK, wall_clock() + SLACK);
+    let hello = f64::from(hellos[0]);
+    assert!(low <= hello && hello <= high, "the hello said {hello}, expected {low} to {high}");
+    assert_eq!(server.with_stats(|stats| stats.tls_time_refusals), 0);
+    assert_eq!(progress(&server), (1, 1, 0, 0, 0));
+}
diff --git a/crates/mtproto-ffi/tests/ffi_abi6.rs b/crates/mtproto-ffi/tests/ffi_abi6.rs
new file mode 100644
index 0000000..644c5fa
--- /dev/null
+++ b/crates/mtproto-ffi/tests/ffi_abi6.rs
@@ -0,0 +1,298 @@
+//! What ABI 6 added, through the C ABI with real callbacks that free every payload: the session's own
+//! HTTP addresses (`mt_session_set_http_addresses`), dependency waits handed to the host
+//! (`MTRequestFlagSurfaceDependencyWaits`) and the reason of each `MTEventKindUpdatesReset`, with the
+//! server's `new_session_created` message as the payload of a server's new session.
+
+use std::ffi::c_void;
+use std::net::TcpListener;
+use std::sync::{Condvar, Mutex};
+use std::time::{Duration, Instant};
+
+use mtproto_engine_ffi::*;
+use mtproto_testserver::*;
+
+const COMPLETED: u32 = 1;
+const FAILED: u32 = 2;
+const UPDATES_RESET: u32 = 13;
+const SURFACE_DEPENDENCY_WAITS: u32 = 1 << 8;
+const NEW_SESSION_CREATED: u32 = 0x9ec2_0908;
+const WAIT: Duration = Duration::from_secs(15);
+
+#[derive(Clone, Debug)]
+struct Seen {
+    session: u64,
+    kind: u32,
+    request: u64,
+    code: i32,
+    text: String,
+    payload: Option<Vec<u8>>,
+}
+
+#[derive(Default)]
+struct Sink {
+    events: Mutex<Vec<Seen>>,
+    condvar: Condvar,
+}
+
+impl Sink {
+    fn wait(&self, timeout: Duration, predicate: impl Fn(&[Seen]) -> bool) -> bool {
+        let deadline = Instant::now() + timeout;
+        let mut events = self.events.lock().unwrap();
+        while !predicate(&events) {
+            let now = Instant::now();
+            if now >= deadline {
+                return false;
+            }
+            events = self.condvar.wait_timeout(events, deadline - now).unwrap().0;
+        }
+        true
+    }
+
+    fn of(&self, session: u64) -> Vec<Seen> {
+        self.events.lock().unwrap().iter().filter(|event| event.session == session).cloned().collect()
+    }
+}
+
+/// Copies what the test needs and frees the payload, as a host must for every event.
+unsafe extern "C" fn on_event(context: *mut c_void, session: u64, event: *const MTEvent) {
+    let sink = unsafe { &*(context as *const Sink) };
+    let event = unsafe { &*event };
+    let payload = (!event.payload.is_null()).then(|| {
+        let data =
+            unsafe { std::slice::from_raw_parts(mt_buffer_data(event.payload), mt_buffer_length(event.payload)) }
+                .to_vec();
+        unsafe { mt_buffer_free(event.payload) };
+        data
+    });
+    let text = if event.text.data.is_null() {
+        String::new()
+    } else {
+        String::from_utf8_lossy(unsafe { std::slice::from_raw_parts(event.text.data, event.text.length) }).into_owned()
+    };
+    sink.events.lock().unwrap().push(Seen {
+        session,
+        kind: event.kind,
+        request: event.request_id,
+        code: event.code,
+        text,
+        payload,
+    });
+    sink.condvar.notify_all();
+}
+
+fn bytes(data: &[u8]) -> MTBytes {
+    MTBytes { data: data.as_ptr(), length: data.len() }
+}
+
+fn string(text: &str) -> MTString {
+    MTString { data: text.as_ptr(), length: text.len() }
+}
+
+struct Rig {
+    server: TestServer,
+    key: mtproto_engine::mtproto_core::auth_key::AuthKey,
+    sink: &'static Sink,
+    engine: *mut MTEngine,
+    host: String,
+}
+
+impl Rig {
+    fn new(seed: u64) -> Self {
+        let key = random_key(seed);
+        let server = TestServer::start(vec![key.clone()], ServerOptions::default());
+        let sink: &'static Sink = Box::leak(Box::default());
+        let engine = unsafe { mt_engine_create(1, sink as *const Sink as *mut c_void, Some(on_event), None) };
+        assert!(!engine.is_null());
+        let host = server.address.ip().to_string();
+        Self { server, key, sink, engine, host }
+    }
+
+    /// A main session on `tcp_port`, created paused so that what is sent before `resume` goes out
+    /// together on its first connection.
+    fn paused_session(&self, tcp_port: u16) -> u64 {
+        let key = &self.key;
+        let address = MTAddress { host: string(&self.host), port: tcp_port, secret: bytes(&[]) };
+        let now = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_secs_f64();
+        let salt = MTSaltEntry { salt: SERVER_SALT, valid_since: now - 60.0, valid_until: now + 3600.0 };
+        let setup = MTSessionSetup {
+            datacenter_id: 2,
+            obfuscation_dc_id: 2,
+            role: 0,
+            framing: 0,
+            addresses: &address,
+            address_count: 1,
+            proxy: MTProxy {
+                kind: 0,
+                host: string(""),
+                port: 0,
+                username: string(""),
+                password: string(""),
+                secret: bytes(&[]),
+            },
+            auth_key: bytes(key.bytes()),
+            salts: &salt,
+            salt_count: 1,
+            has_init_hash: 0,
+            init_hash: string(""),
+            generate_key: 0,
+            public_keys_pem: std::ptr::null(),
+            public_key_count: 0,
+            temp_key_expires_in: 0,
+            environment: std::ptr::null(),
+            time_difference: 0.0,
+            online: 1,
+            paused: 1,
+            keep_connected: 1,
+            idle_disconnect_after: 0.0,
+            request_timeout: 5.0,
+            pfs_lifetime: 0,
+            pfs_make_permanent_key: 0,
+            pfs_temporary_key: std::ptr::null(),
+        };
+        let session = unsafe { mt_session_create(self.engine, &setup) };
+        assert_ne!(session, 0);
+        session
+    }
+
+    fn send(&self, session: u64, tag: u32, flags: u32, invoke_after: u64) -> u64 {
+        let id = unsafe { mt_engine_next_request_id(self.engine) };
+        self.send_body(session, id, &call(tag, &id.to_le_bytes()), flags, invoke_after);
+        id
+    }
+
+    fn send_body(&self, session: u64, id: u64, body: &[u8], flags: u32, invoke_after: u64) {
+        let request = MTRequest { id, body: bytes(body), flags, expected_response_size: 0, invoke_after };
+        unsafe { mt_session_send(self.engine, session, &request) };
+    }
+
+    fn resume(&self, session: u64) {
+        unsafe { mt_session_set_paused(self.engine, session, 0) };
+    }
+
+    fn finished(&self, session: u64, id: u64) -> Option<Seen> {
+        self.sink
+            .of(session)
+            .into_iter()
+            .find(|event| (event.kind == COMPLETED || event.kind == FAILED) && event.request == id)
+    }
+
+    fn wait_finished(&self, session: u64, id: u64) -> Option<Seen> {
+        self.sink.wait(WAIT, |events| {
+            events.iter().any(|e| e.session == session && e.request == id && (e.kind == COMPLETED || e.kind == FAILED))
+        });
+        self.finished(session, id)
+    }
+}
+
+impl Drop for Rig {
+    fn drop(&mut self) {
+        unsafe { mt_engine_destroy(self.engine) };
+    }
+}
+
+/// A local port nothing listens on.
+fn closed_port() -> u16 {
+    TcpListener::bind("127.0.0.1:0").unwrap().local_addr().unwrap().port()
+}
+
+#[test]
+fn the_header_declares_abi_6() {
+    let header = include_str!("../include/mtproto_engine.h");
+    for declared in [
+        "MTRequestFlagSurfaceDependencyWaits = 1 << 8,",
+        "MTUpdatesResetServerSession = 1,",
+        "MTUpdatesResetLocalSession = 2,",
+        "MTUpdatesResetUpdatesLost = 3,",
+        "MTUpdatesResetUpdatesTooLong = 4,",
+        "void mt_session_set_http_addresses(MTEngine *engine, MTSessionHandle session, const MTAddress *addresses, size_t count);",
+    ] {
+        assert!(header.contains(declared), "{declared}");
+    }
+    assert_eq!((UPDATES_RESET_SERVER_SESSION, UPDATES_RESET_LOCAL_SESSION, UPDATES_RESET_UPDATES_LOST), (1, 2, 3));
+    assert_eq!(UPDATES_RESET_UPDATES_TOO_LONG, 4);
+    assert_eq!(mt_engine_abi_version(), 12);
+}
