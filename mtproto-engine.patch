+#[test]
+fn a_reset_says_why_and_a_new_server_session_hands_over_its_notice() {
+    let rig = Rig::new(604);
+    let session = rig.paused_session(rig.server.address.port());
+    let fresh = rig.send(session, TAG_NEW_SESSION, 0, 0);
+    rig.resume(session);
+    assert_eq!(rig.wait_finished(session, fresh).map(|event| event.kind), Some(COMPLETED));
+    assert!(rig.sink.wait(WAIT, |events| events.iter().any(|e| e.kind == UPDATES_RESET)));
+    let resets: Vec<Seen> = rig.sink.of(session).into_iter().filter(|event| event.kind == UPDATES_RESET).collect();
+    assert_eq!(resets.len(), 1, "{resets:?}");
+    assert_eq!(resets[0].code, UPDATES_RESET_SERVER_SESSION);
+    let notice = resets[0].payload.clone().expect("the server's message");
+    assert_eq!(notice.len(), 28);
+    assert_eq!(u32::from_le_bytes(notice[..4].try_into().unwrap()), NEW_SESSION_CREATED);
+    assert_eq!(i64::from_le_bytes(notice[12..20].try_into().unwrap()), 77, "the test server's unique_id");
+    assert_eq!(i64::from_le_bytes(notice[20..28].try_into().unwrap()), SERVER_SALT);
+
+    // msg_seqno too low: the session starts a new session of its own and sends the call again.
+    let local = unsafe { mt_engine_next_request_id(rig.engine) };
+    rig.send_body(session, local, &bad_msg_call(32, false), 0, 0);
+    assert_eq!(rig.wait_finished(session, local).map(|event| event.kind), Some(COMPLETED));
+    assert!(rig.sink.wait(WAIT, |events| events.iter().filter(|e| e.kind == UPDATES_RESET).count() >= 2));
+    let resets: Vec<Seen> = rig.sink.of(session).into_iter().filter(|event| event.kind == UPDATES_RESET).collect();
+    assert_eq!(resets[1].code, UPDATES_RESET_LOCAL_SESSION, "{resets:?}");
+    for reset in &resets {
+        assert_eq!(reset.payload.is_some(), reset.code == UPDATES_RESET_SERVER_SESSION, "{reset:?}");
+    }
+}
diff --git a/crates/mtproto-ffi/tests/ffi_abi8.rs b/crates/mtproto-ffi/tests/ffi_abi8.rs
new file mode 100644
index 0000000..6ae6797
--- /dev/null
+++ b/crates/mtproto-ffi/tests/ffi_abi8.rs
@@ -0,0 +1,326 @@
+//! What ABI 8 added, through the C ABI with real callbacks that free every payload: route admission
+//! (`mt_session_set_route_admission`), the `MTEventKindRouteRequired` a session reports for each
+//! connection it is about to open (the admission in `request_id`, the destination in `text` and `code`,
+//! what it carries in `flags`) and the host's answer (`mt_session_admit_route`), without which nothing
+//! connects.
+
+use std::ffi::c_void;
+use std::net::TcpListener;
+use std::sync::{Condvar, Mutex};
+use std::time::{Duration, Instant};
+
+use mtproto_engine_ffi::*;
+use mtproto_testserver::*;
+
+const COMPLETED: u32 = 1;
+const ROUTE_REQUIRED: u32 = 37;
+const WAIT: Duration = Duration::from_secs(20);
+/// How long a session waiting for its admission is watched for connections.
+const QUIET: Duration = Duration::from_millis(500);
+
+#[derive(Clone, Debug)]
+struct Seen {
+    session: u64,
+    kind: u32,
+    request: u64,
+    code: i32,
+    flags: u32,
+    text: String,
+}
+
+#[derive(Default)]
+struct Sink {
+    events: Mutex<Vec<Seen>>,
+    condvar: Condvar,
+}
+
+impl Sink {
+    fn wait(&self, timeout: Duration, predicate: impl Fn(&[Seen]) -> bool) -> bool {
+        let deadline = Instant::now() + timeout;
+        let mut events = self.events.lock().unwrap();
+        while !predicate(&events) {
+            let now = Instant::now();
+            if now >= deadline {
+                return false;
+            }
+            events = self.condvar.wait_timeout(events, deadline - now).unwrap().0;
+        }
+        true
+    }
+
+    fn of(&self, session: u64, kind: u32) -> Vec<Seen> {
+        seen(&self.events.lock().unwrap(), session, kind).cloned().collect()
+    }
+}
+
+fn seen(events: &[Seen], session: u64, kind: u32) -> impl Iterator<Item = &Seen> {
+    events.iter().filter(move |event| event.session == session && event.kind == kind)
+}
+
+/// Copies what the test needs and frees the payload, as a host must for every event.
+unsafe extern "C" fn on_event(context: *mut c_void, session: u64, event: *const MTEvent) {
+    let sink = unsafe { &*(context as *const Sink) };
+    let event = unsafe { &*event };
+    if !event.payload.is_null() {
+        unsafe { mt_buffer_free(event.payload) };
+    }
+    let text = if event.text.data.is_null() {
+        String::new()
+    } else {
+        String::from_utf8_lossy(unsafe { std::slice::from_raw_parts(event.text.data, event.text.length) }).into_owned()
+    };
+    sink.events.lock().unwrap().push(Seen {
+        session,
+        kind: event.kind,
+        request: event.request_id,
+        code: event.code,
+        flags: event.flags,
+        text,
+    });
+    sink.condvar.notify_all();
+}
+
+fn bytes(data: &[u8]) -> MTBytes {
+    MTBytes { data: data.as_ptr(), length: data.len() }
+}
+
+fn string(text: &str) -> MTString {
+    MTString { data: text.as_ptr(), length: text.len() }
+}
+
+struct Rig {
+    server: TestServer,
+    key: mtproto_engine::mtproto_core::auth_key::AuthKey,
+    sink: &'static Sink,
+    engine: *mut MTEngine,
+    host: String,
+}
+
+impl Rig {
+    fn new(seed: u64) -> Self {
+        let key = random_key(seed);
+        let server = TestServer::start(vec![key.clone()], ServerOptions::default());
+        let sink: &'static Sink = Box::leak(Box::default());
+        let engine = unsafe { mt_engine_create(1, sink as *const Sink as *mut c_void, Some(on_event), None) };
+        assert!(!engine.is_null());
+        let host = server.address.ip().to_string();
+        Self { server, key, sink, engine, host }
+    }
+
+    /// A main session on `tcp_port`, created paused with route admission required, as a host holds one
+    /// until it decided the route: it asks for its first connection once `resume` lets it go.
+    fn admitted_session(&self, tcp_port: u16) -> u64 {
+        let key = &self.key;
+        let address = MTAddress { host: string(&self.host), port: tcp_port, secret: bytes(&[]) };
+        let now = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_secs_f64();
+        let salt = MTSaltEntry { salt: SERVER_SALT, valid_since: now - 60.0, valid_until: now + 3600.0 };
+        let setup = MTSessionSetup {
+            datacenter_id: 2,
+            obfuscation_dc_id: 2,
+            role: 0,
+            framing: 0,
+            addresses: &address,
+            address_count: 1,
+            proxy: MTProxy {
+                kind: 0,
+                host: string(""),
+                port: 0,
+                username: string(""),
+                password: string(""),
+                secret: bytes(&[]),
+            },
+            auth_key: bytes(key.bytes()),
+            salts: &salt,
+            salt_count: 1,
+            has_init_hash: 0,
+            init_hash: string(""),
+            generate_key: 0,
+            public_keys_pem: std::ptr::null(),
+            public_key_count: 0,
+            temp_key_expires_in: 0,
+            environment: std::ptr::null(),
+            time_difference: 0.0,
+            online: 1,
+            paused: 1,
+            keep_connected: 1,
+            idle_disconnect_after: 0.0,
+            request_timeout: 5.0,
+            pfs_lifetime: 0,
+            pfs_make_permanent_key: 0,
+            pfs_temporary_key: std::ptr::null(),
+        };
+        let session = unsafe { mt_session_create(self.engine, &setup) };
+        assert_ne!(session, 0);
+        unsafe { mt_session_set_route_admission(self.engine, session, 1) };
+        session
+    }
+
+    fn send(&self, session: u64, tag: u32) -> u64 {
+        let id = unsafe { mt_engine_next_request_id(self.engine) };
+        let body = call(tag, &id.to_le_bytes());
+        let request = MTRequest { id, body: bytes(&body), flags: 0, expected_response_size: 0, invoke_after: 0 };
+        unsafe { mt_session_send(self.engine, session, &request) };
+        id
+    }
+
+    fn resume(&self, session: u64) {
+        unsafe { mt_session_set_paused(self.engine, session, 0) };
+    }
+
+    fn asks(&self, session: u64) -> Vec<Seen> {
+        self.sink.of(session, ROUTE_REQUIRED)
+    }
+
+    /// The session's `count`th ask, once it came.
+    fn ask(&self, session: u64, count: usize) -> Seen {
+        let came = self.sink.wait(WAIT, |events| seen(events, session, ROUTE_REQUIRED).count() >= count);
+        assert!(came, "the session never asked {count} times");
+        self.asks(session)[count - 1].clone()
+    }
+
+    fn completed(&self, session: u64, id: u64) -> bool {
+        self.sink.of(session, COMPLETED).iter().any(|event| event.request == id)
+    }
+
+    fn wait_completed(&self, session: u64, id: u64) -> bool {
+        self.sink.wait(WAIT, |events| seen(events, session, COMPLETED).any(|event| event.request == id))
+    }
+
+    /// Admits every ask of the session as it comes, until call `id` completes.
+    fn admit_until_completed(&self, session: u64, id: u64) -> bool {
+        let deadline = Instant::now() + WAIT;
+        let mut answered = 0;
+        loop {
+            let asks = self.asks(session);
+            for ask in &asks[answered..] {
+                unsafe { mt_session_admit_route(self.engine, session, ask.request, 1) };
+            }
+            answered = asks.len();
+            if self.completed(session, id) {
+                return true;
+            }
+            let now = Instant::now();
+            if now >= deadline {
+                return false;
+            }
+            self.sink.wait(deadline - now, |events| {
+                seen(events, session, COMPLETED).any(|event| event.request == id)
+                    || seen(events, session, ROUTE_REQUIRED).count() > answered
+            });
+        }
+    }
+
+    fn connections(&self) -> usize {
+        self.server.with_stats(|stats| stats.connections)
+    }
+}
+
+impl Drop for Rig {
+    fn drop(&mut self) {
+        unsafe { mt_engine_destroy(self.engine) };
+    }
+}
+
+/// A local port nothing listens on.
+fn closed_port() -> u16 {
+    TcpListener::bind("127.0.0.1:0").unwrap().local_addr().unwrap().port()
+}
+
+#[test]
+fn the_header_declares_abi_8() {
+    let header = include_str!("../include/mtproto_engine.h");
+    for declared in [
+        "MTEventKindRouteRequired = 37,",
+        "MTRouteTcp = 0,",
+        "MTRouteHttp = 1,",
+        "void mt_session_set_route_admission(MTEngine *engine, MTSessionHandle session, uint8_t required);",
+        "void mt_session_admit_route(MTEngine *engine, MTSessionHandle session, MTRequestId admission, uint8_t admitted);",
+    ] {
+        assert!(header.contains(declared), "{declared}");
+    }
+    let _: unsafe extern "C" fn(*mut MTEngine, u64, u8) = mt_session_set_route_admission;
+    let _: unsafe extern "C" fn(*mut MTEngine, u64, u64, u8) = mt_session_admit_route;
+    assert_eq!((ROUTE_TCP, ROUTE_HTTP), (0, 1));
+    assert_eq!(mt_engine_abi_version(), 12);
+    unsafe {
+        mt_session_set_route_admission(std::ptr::null_mut(), 1, 1);
+        mt_session_admit_route(std::ptr::null_mut(), 1, 1, 1);
+    }
+}
+
+/// A session that must ask names its datacenter address over TCP and opens nothing until the host
+/// admits it: a refusal opens nothing and the session asks again under a new id, and the admission it
+/// then gets opens the one connection its call completes on.
+#[test]
+fn only_an_admission_through_the_c_abi_opens_the_connection() {
+    let rig = Rig::new(801);
+    let port = rig.server.address.port();
+    let session = rig.admitted_session(port);
+    let id = rig.send(session, 7);
+    rig.resume(session);
+    let first = rig.ask(session, 1);
+    std::thread::sleep(QUIET);
+    let held = (rig.connections(), rig.completed(session, id));
+
+    unsafe { mt_session_admit_route(rig.engine, session, first.request, 0) };
+    let second = rig.ask(session, 2);
+    let refused = rig.connections();
+
+    unsafe { mt_session_admit_route(rig.engine, session, second.request, 1) };
+    let done = rig.wait_completed(session, id);
+    let after = rig.connections();
+    eprintln!(
+        "asked {first:?}, then {second:?}; held {held:?}; after the refusal {refused}, after the admission {after}"
+    );
+    assert_ne!(first.request, 0);
+    assert_eq!((first.text.as_str(), first.code, first.flags), (rig.host.as_str(), i32::from(port), ROUTE_TCP));
+    assert_eq!(held, (0, false), "the session connected before the host admitted it");
+    assert!(second.request > first.request, "the session asked again under an id it used before");
+    assert_eq!((second.text.as_str(), second.code, second.flags), (first.text.as_str(), first.code, first.flags));
+    assert_eq!(refused, 0, "the refusal opened a connection");
+    assert!(done, "the call did not complete after the admission");
+    assert_eq!(after, 1, "one admission opened other than one connection");
+}
+
+/// Over HTTP the session asks with `MTRouteHttp` for the HTTP address it was given, never its TCP
+/// address, and its call completes once the host admits what it asks (each HTTP link asks for itself).
+#[test]
+fn an_http_link_asks_for_its_http_address_with_mt_route_http() {
+    let rig = Rig::new(802);
+    let port = rig.server.address.port();
+    let session = rig.admitted_session(closed_port());
+    unsafe { mt_session_set_transport(rig.engine, session, 1, 0) };
+    let http = MTAddress { host: string(&rig.host), port, secret: bytes(&[]) };
+    unsafe { mt_session_set_http_addresses(rig.engine, session, &http, 1) };
+    let id = rig.send(session, 7);
+    rig.resume(session);
+    let first = rig.ask(session, 1);
+    std::thread::sleep(QUIET);
+    let held = (rig.server.with_stats(|stats| stats.http.requests), rig.completed(session, id));
+    let done = rig.admit_until_completed(session, id);
+    let asks = rig.asks(session);
+    eprintln!("asks {asks:?}; held {held:?}");
+    assert_eq!((first.text.as_str(), first.code, first.flags), (rig.host.as_str(), i32::from(port), ROUTE_HTTP));
+    assert_eq!(held, (0, false), "an HTTP request went out before the host admitted its link");
+    assert!(done, "the call did not complete over the admitted HTTP links");
+    let destination = (first.text.as_str(), first.code, ROUTE_HTTP);
+    assert!(asks.iter().all(|ask| (ask.text.as_str(), ask.code, ask.flags) == destination), "{asks:?}");
+}
+
+/// Admission turned off while the session waits for an answer: it connects at once without one and
+/// asks nothing more.
+#[test]
+fn turning_admission_off_lets_a_waiting_session_connect() {
+    let rig = Rig::new(803);
+    let session = rig.admitted_session(rig.server.address.port());
+    let id = rig.send(session, 7);
+    rig.resume(session);
+    rig.ask(session, 1);
+    std::thread::sleep(QUIET);
+    let held = (rig.connections(), rig.completed(session, id));
+    unsafe { mt_session_set_route_admission(rig.engine, session, 0) };
+    let done = rig.wait_completed(session, id);
+    assert_eq!(held, (0, false), "the session connected before the host admitted it");
+    assert!(done, "the call did not complete with admission off");
+    assert_eq!((rig.connections(), rig.asks(session).len()), (1, 1));
+}
diff --git a/crates/mtproto-ffi/tests/ffi_abi9.rs b/crates/mtproto-ffi/tests/ffi_abi9.rs
new file mode 100644
index 0000000..1a8a515
--- /dev/null
+++ b/crates/mtproto-ffi/tests/ffi_abi9.rs
@@ -0,0 +1,184 @@
+//! What ABI 9 added, through the C ABI with real callbacks that free every payload: the addresses a host gives
+//! for its proxy's host name (`mt_session_set_proxy_addresses`), which a session goes to instead of looking the
+//! name up, and the address of that name a connected session reached, in `text2` of
+//! `MTEventKindConnectionState`.
+
+use std::ffi::c_void;
+use std::sync::{Condvar, Mutex};
+use std::time::{Duration, Instant};
+
+use mtproto_engine_ffi::*;
+use mtproto_testserver::*;
+
+const COMPLETED: u32 = 1;
+const CONNECTION_STATE: u32 = 18;
+const CONNECTED: u32 = 1 << 1;
+const WAIT: Duration = Duration::from_secs(20);
+/// How long a session without the addresses of its proxy's name is watched for a connection.
+const QUIET: Duration = Duration::from_secs(1);
+/// A name no resolver answers (RFC 6761).
+const NAME: &str = "proxy.invalid";
+
+#[derive(Clone, Debug)]
+struct Seen {
+    session: u64,
+    kind: u32,
+    request: u64,
+    flags: u32,
+    text: String,
+    text2: String,
+}
+
+#[derive(Default)]
+struct Sink {
+    events: Mutex<Vec<Seen>>,
+    condvar: Condvar,
+}
+
+impl Sink {
+    fn wait(&self, timeout: Duration, predicate: impl Fn(&[Seen]) -> bool) -> bool {
+        let deadline = Instant::now() + timeout;
+        let mut events = self.events.lock().unwrap();
+        while !predicate(&events) {
+            let now = Instant::now();
+            if now >= deadline {
+                return false;
+            }
+            events = self.condvar.wait_timeout(events, deadline - now).unwrap().0;
+        }
+        true
+    }
+
+    fn of(&self, session: u64, kind: u32) -> Vec<Seen> {
+        seen(&self.events.lock().unwrap(), session, kind).cloned().collect()
+    }
+}
+
+fn seen(events: &[Seen], session: u64, kind: u32) -> impl Iterator<Item = &Seen> {
+    events.iter().filter(move |event| event.session == session && event.kind == kind)
+}
+
+fn text_of(value: MTString) -> String {
+    if value.data.is_null() {
+        return String::new();
+    }
+    String::from_utf8_lossy(unsafe { std::slice::from_raw_parts(value.data, value.length) }).into_owned()
+}
+
+/// Copies what the test needs and frees the payload, as a host must for every event.
+unsafe extern "C" fn on_event(context: *mut c_void, session: u64, event: *const MTEvent) {
+    let sink = unsafe { &*(context as *const Sink) };
+    let event = unsafe { &*event };
+    if !event.payload.is_null() {
+        unsafe { mt_buffer_free(event.payload) };
+    }
+    sink.events.lock().unwrap().push(Seen {
+        session,
+        kind: event.kind,
+        request: event.request_id,
+        flags: event.flags,
+        text: text_of(event.text),
+        text2: text_of(event.text2),
+    });
+    sink.condvar.notify_all();
+}
+
+fn bytes(data: &[u8]) -> MTBytes {
+    MTBytes { data: data.as_ptr(), length: data.len() }
+}
+
+fn string(text: &str) -> MTString {
+    MTString { data: text.as_ptr(), length: text.len() }
+}
+
+#[test]
+fn the_header_declares_abi_9() {
+    let header = include_str!("../include/mtproto_engine.h");
+    for declared in [
+        "MTEventKindConnectionState = 18,",
+        "void mt_session_set_proxy_addresses(MTEngine *engine, MTSessionHandle session, MTString host, const MTString *addresses, size_t count);",
+    ] {
+        assert!(header.contains(declared), "{declared}");
+    }
+    let _: unsafe extern "C" fn(*mut MTEngine, u64, MTString, *const MTString, usize) = mt_session_set_proxy_addresses;
+    assert_eq!(mt_engine_abi_version(), 12);
+    let addresses = [string("127.0.0.1")];
+    unsafe { mt_session_set_proxy_addresses(std::ptr::null_mut(), 1, string(NAME), addresses.as_ptr(), 1) };
+}
+
+/// A main session whose SOCKS5 proxy is a name no resolver answers reaches nothing until the host gives the
+/// name's address. Then its call completes through the proxy there, and each state that says it is connected
+/// names that address in `text2`, while `text` names the proxy as it was given.
+#[test]
+fn a_named_proxy_connects_only_through_the_addresses_the_host_gives() {
+    let key = random_key(901);
+    let server = TestServer::start(vec![key.clone()], ServerOptions { socks5: true, ..Default::default() });
+    let sink: &'static Sink = Box::leak(Box::default());
+    let engine = unsafe { mt_engine_create(1, sink as *const Sink as *mut c_void, Some(on_event), None) };
+    assert!(!engine.is_null());
+    let port = server.address.port();
+    // The SOCKS5 front takes any destination: the datacenter address only goes into its CONNECT.
+    let address = MTAddress { host: string("149.154.167.51"), port: 443, secret: bytes(&[]) };
+    let now = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_secs_f64();
+    let salt = MTSaltEntry { salt: SERVER_SALT, valid_since: now - 60.0, valid_until: now + 3600.0 };
+    let setup = MTSessionSetup {
+        datacenter_id: 2,
+        obfuscation_dc_id: 2,
+        role: 0,
+        framing: 0,
+        addresses: &address,
+        address_count: 1,
+        proxy: MTProxy {
+            kind: 1,
+            host: string(NAME),
+            port,
+            username: string(""),
+            password: string(""),
+            secret: bytes(&[]),
+        },
+        auth_key: bytes(key.bytes()),
+        salts: &salt,
+        salt_count: 1,
+        has_init_hash: 0,
+        init_hash: string(""),
+        generate_key: 0,
+        public_keys_pem: std::ptr::null(),
+        public_key_count: 0,
+        temp_key_expires_in: 0,
+        environment: std::ptr::null(),
+        time_difference: 0.0,
+        online: 1,
+        paused: 0,
+        keep_connected: 1,
+        idle_disconnect_after: 0.0,
+        request_timeout: 5.0,
+        pfs_lifetime: 0,
+        pfs_make_permanent_key: 0,
+        pfs_temporary_key: std::ptr::null(),
+    };
+    let session = unsafe { mt_session_create(engine, &setup) };
+    assert_ne!(session, 0);
+    let id = unsafe { mt_engine_next_request_id(engine) };
+    let body = call(7, &id.to_le_bytes());
+    let request = MTRequest { id, body: bytes(&body), flags: 0, expected_response_size: 0, invoke_after: 0 };
+    unsafe { mt_session_send(engine, session, &request) };
+    let completed = |events: &[Seen]| seen(events, session, COMPLETED).any(|event| event.request == id);
+    std::thread::sleep(QUIET);
+    let held = (server.with_stats(|stats| stats.connections), sink.wait(Duration::ZERO, completed));
+
+    let addresses = [string("127.0.0.1")];
+    unsafe { mt_session_set_proxy_addresses(engine, session, string(NAME), addresses.as_ptr(), addresses.len()) };
+    let done = sink.wait(WAIT, completed);
+    let states = sink.of(session, CONNECTION_STATE);
+    unsafe { mt_engine_destroy(engine) };
+    let shown: Vec<_> = states.iter().map(|state| (state.flags, state.text.as_str(), state.text2.as_str())).collect();
+    eprintln!("held {held:?}; states {shown:?}");
+    assert_eq!(held, (0, false), "the session got somewhere without the name's addresses");
+    assert!(done, "the call did not complete through the address the host gave");
+    let proxy = format!("{NAME}:{port}");
+    assert!(states.iter().all(|state| state.text == proxy), "{shown:?}");
+    let (connected, other): (Vec<_>, Vec<_>) = states.iter().partition(|state| state.flags & CONNECTED != 0);
+    assert!(!connected.is_empty(), "no state said the session was connected");
+    assert!(connected.iter().all(|state| state.text2 == "127.0.0.1"), "{shown:?}");
+    assert!(other.iter().all(|state| state.text2.is_empty()), "{shown:?}");
+}
