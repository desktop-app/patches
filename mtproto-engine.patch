diff --git a/crates/mtproto-engine/src/route_check.rs b/crates/mtproto-engine/src/route_check.rs
new file mode 100644
index 0000000..feba7c1
--- /dev/null
+++ b/crates/mtproto-engine/src/route_check.rs
@@ -0,0 +1,356 @@
+//! A check of a route (`Engine::start_route_check`): whether a connection by the route a session would take to a
+//! datacenter, through a proxy or without one, carries one unauthenticated `req_pq_multi` and brings back a whole
+//! `res_pq` with the nonce it sent. It is no session and no part of one: it holds no key, no RPC client, no handshake
+//! and no environment, the worker keeps it apart from its sessions, and no session command reaches it. It is unrelated
+//! to the HTTP link's own route check (`route_check_nonce` in `session_http.rs`), which a session runs on its links.
+//!
+//! Each attempt opens one connection to one candidate address and sends the request once the connection is ready (a
+//! tunnel made, a fake-TLS ServerHello verified). The attempt ends at that answer, at anything else the route sends
+//! or does, or at its bound; a failed one moves to the next candidate, and the check ends with the last. It never
+//! reads network availability, never asks for route admission, opens no host stream, reports nothing to the route
+//! hints and keeps nothing between attempts but the candidates.
+
+use std::net::SocketAddr;
+use std::sync::Arc;
+
+use mio::{Registry, Token};
+use mtproto_core::crypto::{OsRandom, SecureRandom};
+use mtproto_core::message::decode_plain_message;
+use mtproto_core::session::Now;
+use mtproto_core::tl::mtproto::ResPq;
+use mtproto_core::tl::{Reader, TlRead};
+use mtproto_core::transport::{Incoming, TransportConfig};
+
+use crate::connection::{ChunkStatus, Connection, ConnectionError};
+use crate::http_link::TOKENS_PER_SESSION;
+use crate::resolver::parse_literal;
+use crate::session_runtime::{Resolution, Resolve, hello_time, plain_req_pq_packet, proxy_tunnel};
+use crate::types::{
+    DropReason, EngineCallbacks, EngineEvent, ProxyConfig, ROUTE_CHECK_TIMEOUT, RouteCheckSetup, SessionHandle,
+    proxy_secret_for,
+};
+
+/// The attempt took its whole bound, or the lookup before the first one did.
+const TIMEOUT: &str = "timeout";
+/// No socket could be opened to the address.
+const CONNECT_FAILED: &str = "connect_failed";
+/// The name has no address.
+const UNRESOLVED: &str = "unresolved";
+/// A packet that is no whole `res_pq` with the nonce sent, or more bytes than an answer takes.
+const WRONG_ANSWER: &str = "wrong_answer";
+/// The route answered with a transport error code.
+const TRANSPORT_ERROR: &str = "transport_error";
+/// The most an attempt reads with no answer: a fake-TLS ServerHello and a `res_pq` take a few KB.
+const ANSWER_LIMIT: u64 = 64 * 1024;
+
+pub(crate) struct RouteCheck {
+    handle: SessionHandle,
+    /// The first token of the check's block: attempt n takes the block's token n modulo its size.
+    tokens: Token,
+    setup: RouteCheckSetup,
+    /// The addresses to try, in order, once known: the proxy's, or the datacenter's without one.
+    candidates: Option<Vec<SocketAddr>>,
+    next: usize,
+    /// The name and port a lookup was asked for.
+    awaiting: Option<(String, u16)>,
+    connection: Option<Box<Connection>>,
+    attempt_started_at: f64,
+    nonce: [u8; 16],
+    /// When the request went out on the attempt's connection.
+    sent_at: Option<f64>,
+    attempts: u32,
+    last_reason: &'static str,
+    finished: bool,
+}
+
+impl RouteCheck {
+    /// The first attempt's clock starts here: a lookup counts against it.
+    pub(crate) fn new(handle: SessionHandle, mut setup: RouteCheckSetup, tokens: Token, now: Now) -> Self {
+        if !(setup.timeout.is_finite() && setup.timeout > 0.0) {
+            setup.timeout = ROUTE_CHECK_TIMEOUT;
+        }
+        if !setup.time_difference.is_finite() {
+            setup.time_difference = 0.0;
+        }
+        if setup.tls_hello_time_offset.is_some_and(|offset| !offset.is_finite()) {
+            setup.tls_hello_time_offset = None;
+        }
+        Self {
+            handle,
+            tokens,
+            setup,
+            candidates: None,
+            next: 0,
+            awaiting: None,
+            connection: None,
+            attempt_started_at: now.mono,
+            nonce: [0; 16],
+            sent_at: None,
+            attempts: 0,
+            last_reason: "",
+            finished: false,
+        }
+    }
+
+    pub(crate) fn token(&self) -> Token {
+        self.tokens
+    }
+
+    pub(crate) fn finished(&self) -> bool {
+        self.finished
+    }
+
+    /// Where each attempt's socket goes: the proxy's host and port, or the address's without a proxy. None for a
+    /// WEB proxy, which only the host's carrier reaches.
+    fn target(&self) -> Option<(String, u16)> {
+        match &self.setup.proxy {
+            Some(ProxyConfig::Socks5 { host, port, .. })
+            | Some(ProxyConfig::Http { host, port, .. })
+            | Some(ProxyConfig::MtProxy { host, port, .. }) => Some((host.clone(), *port)),
+            Some(ProxyConfig::Web { .. }) => None,
+            None => Some((self.setup.address.host.clone(), self.setup.address.port)),
+        }
+    }
+
+    /// The candidates, or a lookup asked: an IP literal as it is, a proxy's name at the addresses given for it, any
+    /// other name through the resolver.
+    fn take_candidates(&mut self, host: String, port: u16, resolver: &mut dyn Resolve) {
+        if let Some(literal) = parse_literal(&host, port) {
+            self.candidates = Some(vec![literal]);
+        } else if self.setup.proxy.is_some() && !self.setup.proxy_addresses.is_empty() {
+            let listed = self.setup.proxy_addresses.iter().map(|ip| SocketAddr::new(*ip, port)).collect();
+            self.candidates = Some(listed);
+        } else {
+            match resolver.resolve(self.handle, &host, port) {
+                Resolution::Resolved(addresses) => self.candidates = Some(addresses),
+                Resolution::Pending => self.awaiting = Some((host, port)),
+            }
+        }
+    }
+
+    pub(crate) fn on_resolved(&mut self, host: &str, port: u16, addresses: Vec<SocketAddr>) {
+        let awaited =
+            self.awaiting.as_ref().is_some_and(|(awaited, awaited_port)| awaited == host && *awaited_port == port);
+        if self.finished || !awaited {
+            return;
+        }
+        self.awaiting = None;
+        self.candidates = Some(addresses);
+    }
+
+    /// The attempt's bound, or now while an attempt waits to start.
+    pub(crate) fn next_deadline(&self, now: Now) -> Option<f64> {
+        if self.finished {
+            None
+        } else if self.connection.is_none() && self.awaiting.is_none() {
+            Some(now.mono)
+        } else {
+            Some(self.attempt_started_at + self.setup.timeout + 0.001)
+        }
+    }
+
+    pub(crate) fn drive(
+        &mut self,
+        registry: &Registry,
+        now: Now,
+        resolver: &mut dyn Resolve,
+        callbacks: &Arc<dyn EngineCallbacks>,
+        rng: &mut OsRandom,
+    ) {
+        if self.finished {
+            return;
+        }
+        if self.candidates.is_none() && self.awaiting.is_none() {
+            let Some((host, port)) = self.target() else {
+                return self.finish(registry, None, CONNECT_FAILED, callbacks);
+            };
+            self.take_candidates(host, port, resolver);
+        }
+        if self.candidates.as_ref().is_some_and(Vec::is_empty) {
+            return self.finish(registry, None, UNRESOLVED, callbacks);
+        }
+        if now.mono >= self.attempt_started_at + self.setup.timeout {
+            if self.connection.is_some() {
+                self.fail_attempt(registry, TIMEOUT);
+            } else if self.attempts == 0 {
+                return self.finish(registry, None, TIMEOUT, callbacks);
+            }
+        }
+        if self.awaiting.is_some() || self.connection.is_some() {
+            return;
+        }
+        while self.connection.is_none()
+            && let Some(address) = self.candidates.as_ref().and_then(|candidates| candidates.get(self.next).copied())
+        {
+            self.next += 1;
+            self.start_attempt(address, registry, now, rng);
+        }
+        if self.connection.is_none() {
+            self.finish(registry, None, self.last_reason, callbacks);
+        }
+    }
+
+    fn start_attempt(&mut self, address: SocketAddr, registry: &Registry, now: Now, rng: &mut OsRandom) {
+        if self.attempts > 0 {
+            self.attempt_started_at = now.mono;
+        }
+        self.attempts += 1;
+        self.nonce = rng.array();
+        self.sent_at = None;
+        let proxy = self.setup.proxy.as_ref();
+        let transport = TransportConfig {
+            framing: self.setup.framing,
+            dc_id: self.setup.obfuscation_dc_id,
+            secret: proxy_secret_for(proxy, &self.setup.address),
+            unix_time: hello_time(now, self.setup.tls_hello_time_offset, self.setup.time_difference),
+        };
+        let tunnel = proxy_tunnel(proxy, &self.setup.address);
+        let token = Token(self.tokens.0 + self.attempts as usize % TOKENS_PER_SESSION);
+        match Connection::connect(registry, token, address, &transport, tunnel, self.next - 1, now.mono, rng) {
+            Ok(connection) => self.connection = Some(connection),
+            Err(_) => self.last_reason = CONNECT_FAILED,
+        }
+    }
+
+    #[allow(clippy::too_many_arguments)]
+    pub(crate) fn handle_io(
+        &mut self,
+        token: Token,
+        readable: bool,
+        writable: bool,
+        registry: &Registry,
+        scratch: &mut [u8],
+        now: Now,
+        callbacks: &Arc<dyn EngineCallbacks>,
+        rng: &mut OsRandom,
+    ) {
+        if self.finished || self.connection.as_ref().is_none_or(|connection| connection.token() != token) {
+            return;
+        }
+        match self.advance(readable, writable, registry, scratch, now, rng) {
+            Ok(None) => {}
+            Ok(Some(round_trip)) => self.finish(registry, Some(round_trip), "", callbacks),
+            Err(reason) => self.fail_attempt(registry, reason),
+        }
+    }
+
+    /// Moves the attempt on: Some with the round trip once answered, an error with the reason it failed.
+    fn advance(
+        &mut self,
+        readable: bool,
+        writable: bool,
+        registry: &Registry,
+        scratch: &mut [u8],
+        now: Now,
+        rng: &mut OsRandom,
+    ) -> Result<Option<f64>, &'static str> {
+        if writable && let Some(connection) = self.connection.as_mut() {
+            connection.handle_writable(registry, now.mono).map_err(|error| reason_of(&error))?;
+        }
+        self.send_once_ready(registry, now, rng)?;
+        if !readable {
+            return Ok(None);
+        }
+        loop {
+            let Some(connection) = self.connection.as_mut() else {
+                return Ok(None);
+            };
+            match connection.read_chunk(registry, scratch, now.mono).map_err(|error| reason_of(&error))? {
+                ChunkStatus::Data { .. } => {}
+                ChunkStatus::WouldBlock => return Ok(None),
+                ChunkStatus::Eof => return Err(DropReason::Closed.name()),
+            }
+            self.send_once_ready(registry, now, rng)?;
+            let Some(connection) = self.connection.as_mut() else {
+                return Ok(None);
+            };
+            while let Some(incoming) = connection.next_incoming().map_err(|error| reason_of(&error))? {
+                match incoming {
+                    Incoming::Packet(packet) => {
+                        return match self.sent_at {
+                            Some(sent_at) if is_answer(&packet, &self.nonce) => Ok(Some(now.mono - sent_at)),
+                            _ => Err(WRONG_ANSWER),
+                        };
+                    }
+                    Incoming::TransportError(_) => return Err(TRANSPORT_ERROR),
+                    Incoming::QuickAck(_) | Incoming::Nop => {}
+                }
+            }
+            if connection.bytes_in > ANSWER_LIMIT {
+                return Err(WRONG_ANSWER);
+            }
+        }
+    }
+
+    /// The request, the first time the attempt's connection is ready.
+    fn send_once_ready(&mut self, registry: &Registry, now: Now, rng: &mut OsRandom) -> Result<(), &'static str> {
+        let Some(connection) = self.connection.as_mut() else {
+            return Ok(());
+        };
+        if self.sent_at.is_some() || !connection.is_established() {
+            return Ok(());
+        }
+        let packet = plain_req_pq_packet(self.nonce, now.unix + self.setup.time_difference);
+        connection
+            .send_packet(registry, &packet, false, rng)
+            .and_then(|()| connection.flush(registry))
+            .map_err(|error| reason_of(&error))?;
+        self.sent_at = Some(now.mono);
+        Ok(())
+    }
+
+    /// The attempt's connection goes; the next drive starts the next attempt or ends the check with `reason`.
+    fn fail_attempt(&mut self, registry: &Registry, reason: &'static str) {
+        if let Some(mut connection) = self.connection.take() {
+            connection.deregister(registry);
+        }
+        self.last_reason = reason;
+    }
+
+    fn finish(
+        &mut self,
+        registry: &Registry,
+        round_trip: Option<f64>,
+        reason: &'static str,
+        callbacks: &Arc<dyn EngineCallbacks>,
+    ) {
+        if let Some(mut connection) = self.connection.take() {
+            connection.deregister(registry);
+        }
+        self.finished = true;
+        let event = EngineEvent::RouteChecked {
+            answered: round_trip.is_some(),
+            round_trip: round_trip.unwrap_or(0.0),
+            reason: if round_trip.is_some() { "" } else { reason },
+            attempts: self.attempts,
+        };
+        callbacks.on_event(self.handle, event);
+    }
+
+    /// Ends the check with no event: a cancel, or the engine shutting down.
+    pub(crate) fn shutdown(&mut self, registry: &Registry) {
+        if let Some(mut connection) = self.connection.take() {
+            connection.deregister(registry);
+        }
+        self.finished = true;
+    }
+}
+
+/// Whether `packet` is a whole `res_pq` with `nonce`: its server nonce, `pq` and fingerprint vector read as the key
+/// handshake reads them, the vector's count bounded, so a reply cut short or malformed answers nothing.
+fn is_answer(packet: &[u8], nonce: &[u8; 16]) -> bool {
+    decode_plain_message(packet).is_ok_and(|message| {
+        ResPq::read_from(&mut Reader::new(message.body)).is_ok_and(|res_pq| res_pq.nonce == *nonce)
+    })
+}
+
+fn reason_of(error: &ConnectionError) -> &'static str {
+    match error {
+        ConnectionError::Io(_) => DropReason::IoError.name(),
+        ConnectionError::Closed => DropReason::Closed.name(),
+        ConnectionError::Transport(_)
+        | ConnectionError::Socks(_)
+        | ConnectionError::Proxy(_)
+        | ConnectionError::WebSocket(_) => DropReason::Protocol.name(),
+    }
+}
