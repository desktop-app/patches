diff --git a/crates/mtproto-core/src/crypto/aes_schedule.rs b/crates/mtproto-core/src/crypto/aes_schedule.rs
new file mode 100644
index 0000000..a5dc576
--- /dev/null
+++ b/crates/mtproto-core/src/crypto/aes_schedule.rs
@@ -0,0 +1,47 @@
+use aes::Aes256;
+use aes::cipher::{KeyInit, generic_array::GenericArray};
+use zeroize::Zeroize;
+
+/// An `Aes256` whose every byte is wiped when it is dropped.
+///
+/// aes 0.8's autodetecting `Aes256` is a union of the hardware (AES-NI or ARMv8) and the software key
+/// schedules: `new` writes and `Drop` wipes only the one it selected, so the rest of the union keeps the
+/// stack bytes it was built over, which were seen to hold proxy secrets and derived keys. On drop the
+/// cipher is dropped where it lies and a byte array laid over all of its space is zeroized.
+/// `Option::zeroize` is not used: it ends by writing a `None` copied from a stack temporary whose payload
+/// bytes are uninitialized, which puts stack bytes back over the wiped space.
+pub(super) struct WipedAes256(Schedule);
+
+/// `repr(u8)` puts the tag first and each variant's fields after it, so `Wiped` lies over every byte
+/// after the tag: the cipher's and the padding in front of it.
+#[repr(u8)]
+enum Schedule {
+    Cipher(Aes256),
+    Wiped([u8; WIPED_LEN]),
+}
+
+const WIPED_LEN: usize = align_of::<Aes256>() - 1 + size_of::<Aes256>();
+const _: () = assert!(size_of::<Schedule>() == 1 + WIPED_LEN);
+
+impl WipedAes256 {
+    pub(super) fn new(key: &[u8; 32]) -> Self {
+        Self(Schedule::Cipher(Aes256::new(GenericArray::from_slice(key))))
+    }
+
+    pub(super) fn cipher(&self) -> &Aes256 {
+        match &self.0 {
+            Schedule::Cipher(cipher) => cipher,
+            Schedule::Wiped(_) => unreachable!("the cipher is wiped only on drop"),
+        }
+    }
+}
+
+impl Drop for WipedAes256 {
+    fn drop(&mut self) {
+        // The assignment drops the cipher in place (its own drop wipes the member it selected).
+        self.0 = Schedule::Wiped([0; WIPED_LEN]);
+        if let Schedule::Wiped(bytes) = &mut self.0 {
+            bytes.zeroize();
+        }
+    }
+}
