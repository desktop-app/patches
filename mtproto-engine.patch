+//! A query the server leaves without an answer on a connection that stays up, while it answers the queries
+//! around it and every ping: the liveness checks see a healthy link, so only the session's own question about
+//! the query, msgs_state_req after mtproto-core's `ANSWER_WAIT`, brings it back. Over real sockets against the
+//! test server, a query lost on its way (`TAG_SWALLOW_ONCE`) and one whose answer the server sent on a second
+//! connection of the session that then closed (`TAG_ANSWER_ELSEWHERE_ONCE`) each complete once, within the
+//! wait and a few round trips, on the one connection the session opened, and the server runs each once.
+
+use std::io::{ErrorKind, Read, Write};
+use std::net::TcpStream;
+use std::sync::{Arc, Condvar, Mutex};
+use std::time::{Duration, Instant};
+
+use mtproto_engine::mtproto_core::auth_key::AuthKey;
+use mtproto_engine::mtproto_core::crypto::{Side, XorShiftRandom};
+use mtproto_engine::mtproto_core::message::{MessageHeader, PaddingPolicy, decrypt_message, encrypt_message};
+use mtproto_engine::mtproto_core::msg_id::msg_id_for_time;
+use mtproto_engine::mtproto_core::rpc::{RequestFlags, RequestId, RpcEvent, RpcRequest, SessionRole};
+use mtproto_engine::mtproto_core::session::ServerSalt;
+use mtproto_engine::mtproto_core::tl::Writer;
+use mtproto_engine::mtproto_core::tl::mtproto::{ServiceMessage, write_ping};
+use mtproto_engine::mtproto_core::transport::{Framing, Incoming, TransportConfig, TransportStream};
+use mtproto_engine::{
+    AuthKeyMaterial, DcAddress, DropReason, Engine, EngineCallbacks, EngineConfig, EngineEvent, SessionHandle,
+    SessionSetup, unix_seconds,
+};
+use mtproto_testserver::*;
+
+#[path = "support/eventually.rs"]
+mod eventually;
+use eventually::eventually;
+
+/// mtproto-core's `ANSWER_WAIT`, in seconds: how long a query waits for an answer or an acknowledgement
+/// before the session asks the server about it.
+const ANSWER_WAIT: f64 = 10.0;
+/// Beyond the wait: the question, the server's reply and the copy that brings the answer back are a few
+/// round trips on loopback.
+const SLACK: f64 = 3.0;
+const WAIT: Duration = Duration::from_secs(30);
+/// An ordinary call, run and answered at once.
+const PLAIN: u32 = 5;
+
+#[derive(Default)]
+struct Collector {
+    events: Mutex<Vec<EngineEvent>>,
+    condvar: Condvar,
+}
+
+impl EngineCallbacks for Collector {
+    fn on_event(&self, _session: SessionHandle, event: EngineEvent) {
+        self.events.lock().unwrap().push(event);
+        self.condvar.notify_all();
+    }
+
+    fn on_log(&self, _level: mtproto_engine::LogLevel, message: &str) {
+        if std::env::var_os("MTPROTO_TEST_LOG").is_some() {
+            eprintln!("LOG {message}");
+        }
+    }
+}
+
+fn completed(events: &[EngineEvent], id: u64) -> usize {
+    let done =
+        |event: &&EngineEvent| matches!(event, EngineEvent::Rpc(RpcEvent::Completed { id: done, .. }) if done.0 == id);
+    events.iter().filter(done).count()
+}
+
+impl Collector {
+    fn wait_completed(&self, id: u64) {
+        let deadline = Instant::now() + WAIT;
+        let mut events = self.events.lock().unwrap();
+        while completed(&events, id) == 0 {
+            let now = Instant::now();
+            assert!(now < deadline, "call {id} did not complete in {WAIT:?}; drops {:?}", drops_in(&events));
+            events = self.condvar.wait_timeout(events, deadline - now).unwrap().0;
+        }
+    }
+
+    fn completions(&self, id: u64) -> usize {
+        completed(&self.events.lock().unwrap(), id)
+    }
+
+    fn drops(&self) -> Vec<DropReason> {
+        drops_in(&self.events.lock().unwrap())
+    }
+}
+
+fn drops_in(events: &[EngineEvent]) -> Vec<DropReason> {
+    events
+        .iter()
+        .filter_map(|event| match event {
+            EngineEvent::ConnectionDropped { reason, .. } => Some(*reason),
+            _ => None,
+        })
+        .collect()
+}
+
+fn setup(server: &TestServer, key: &AuthKey) -> SessionSetup {
+    let now = unix_seconds();
+    let mut setup = SessionSetup::new(
+        2,
+        SessionRole::Main,
+        vec![DcAddress { host: server.address.ip().to_string(), port: server.address.port(), secret: None }],
+    );
+    let salts = vec![ServerSalt { salt: SERVER_SALT, valid_since: now - 60.0, valid_until: now + 3600.0 }];
+    setup.auth_key = Some(AuthKeyMaterial { key: key.clone(), salts, init_hash: None });
+    setup
+}
+
+fn request(id: u64, tag: u32) -> RpcRequest {
+    RpcRequest {
+        id: RequestId(id),
+        body: call(tag, &id.to_le_bytes()),
+        flags: RequestFlags::default(),
+        invoke_after: None,
+    }
+}
+
+/// An engine with a session whose first call has completed: its connection is up and has answered.
+fn live_session(server: &TestServer, key: &AuthKey, collector: &Arc<Collector>) -> (Engine, SessionHandle) {
+    let engine =
+        Engine::new(EngineConfig { worker_threads: 1, ..EngineConfig::default() }, collector.clone()).unwrap();
+    let session = engine.create_session(setup(server, key));
+    engine.send(session, request(1, PLAIN));
+    collector.wait_completed(1);
+    (engine, session)
+}
+
+/// What the server and the session went through, for a failed assertion.
+fn record(server: &TestServer, collector: &Collector) -> String {
+    let stats = server.with_stats(|stats| {
+        format!(
+            "connections {} state_requests {} duplicate_msg_ids {} redelivered_answers {} duplicate_executions {} \
+             swallowed {} answers_elsewhere {}",
+            stats.connections,
+            stats.state_requests,
+            stats.duplicate_msg_ids,
+            stats.redelivered_answers,
+            stats.duplicate_executions,
+            stats.swallowed,
+            stats.answers_elsewhere
+        )
+    });
+    format!("{stats}; drops {:?}", collector.drops())
+}
+
+#[test]
+fn a_query_lost_on_a_live_connection_completes_once_within_the_wait() {
+    let key = random_key(81);
+    let server = TestServer::start(vec![key.clone()], ServerOptions::default());
+    let collector = Arc::new(Collector::default());
+    let (engine, session) = live_session(&server, &key, &collector);
+    let lost = 5;
+    let burst: Vec<u64> = (2..=9).collect();
+    let sent = Instant::now();
+    for id in &burst {
+        engine.send(session, request(*id, if *id == lost { TAG_SWALLOW_ONCE } else { PLAIN }));
+    }
+    for id in burst.iter().filter(|id| **id != lost) {
+        collector.wait_completed(*id);
+    }
+    assert!(sent.elapsed().as_secs_f64() < SLACK, "the rest of the burst is answered at once");
+    collector.wait_completed(lost);
+    let took = sent.elapsed().as_secs_f64();
+    std::thread::sleep(Duration::from_millis(500));
+    let record = record(&server, &collector);
+    assert!(took >= ANSWER_WAIT, "{took:.2} s: brought back by the question after the wait; {record}");
+    assert!(took < ANSWER_WAIT + SLACK, "{took:.2} s: within the wait and a few round trips; {record}");
+    for id in std::iter::once(1).chain(burst.iter().copied()) {
+        assert_eq!(collector.completions(id), 1, "call {id} completes once; {record}");
+    }
+    assert_eq!(server.with_stats(|stats| stats.swallowed), 1, "{record}");
+    assert_eq!(server.executions(TAG_SWALLOW_ONCE), 1, "the copy after the question ran, once; {record}");
+    assert_eq!(server.executions(PLAIN), 8, "{record}");
+    assert_eq!(server.with_stats(|stats| stats.duplicate_executions), 0, "{record}");
+    assert!(server.with_stats(|stats| stats.state_requests) >= 1, "{record}");
+    assert_eq!(server.with_stats(|stats| stats.connections), 1, "the one connection stayed up; {record}");
+    assert!(collector.drops().is_empty(), "no liveness check fired; {record}");
+    engine.shutdown();
+}
+
+/// A second connection of `session_id` the test opens itself: it sends a ping, reads until the answer to a
+/// `TAG_ANSWER_ELSEWHERE_ONCE` call has come, and closes without acknowledging anything. Returns whether it
+/// came.
+fn answer_on_a_second_connection(server: &TestServer, key: &AuthKey, session_id: i64) -> bool {
+    let mut rng = XorShiftRandom::new(0x5eed);
+    let mut socket = TcpStream::connect(server.address).expect("connect");
+    socket.set_read_timeout(Some(Duration::from_millis(50))).unwrap();
+    let unix_time = unix_seconds() as i32;
+    let config = TransportConfig { framing: Framing::PaddedIntermediate, dc_id: 2, secret: None, unix_time };
+    let mut stream = TransportStream::new(&config, &mut rng);
+    let mut ping = Writer::new();
+    write_ping(&mut ping, 0x0b5e_55ed);
+    let msg_id = (msg_id_for_time(unix_seconds()) & !3) + 4;
+    let header = MessageHeader { salt: SERVER_SALT, session_id, msg_id, seq_no: 0 };
+    let packet = encrypt_message(key, &header, &ping.into_inner(), Side::Client, PaddingPolicy::default(), &mut rng);
+    stream.send_packet(&packet.data, false, &mut rng);
+    socket.write_all(&stream.take_outgoing()).expect("write");
+    let deadline = Instant::now() + Duration::from_secs(5);
+    let mut buffer = [0u8; 65536];
+    while Instant::now() < deadline {
+        match socket.read(&mut buffer) {
+            Ok(0) => return false,
+            Ok(read) => stream.receive(&buffer[..read]).expect("receive"),
+            Err(error) if matches!(error.kind(), ErrorKind::WouldBlock | ErrorKind::TimedOut) => {}
+            Err(error) => panic!("read: {error}"),
+        }
+        while let Some(incoming) = stream.next_incoming().expect("frame") {
+            let Incoming::Packet(data) = incoming else {
+                continue;
+            };
+            let message = decrypt_message(key, &data, Side::Server).expect("decrypt");
+            if carries_the_answer(message.body()) {
+                return true;
+            }
+        }
+    }
+    false
+}
+
+fn carries_the_answer(body: &[u8]) -> bool {
+    match ServiceMessage::parse(body) {
+        Ok(ServiceMessage::Container(children)) => children.iter().any(|child| carries_the_answer(child.body)),
+        Ok(ServiceMessage::RpcResult { result, .. }) => {
+            parse_result(result).is_some_and(|(tag, _)| tag == TAG_ANSWER_ELSEWHERE_ONCE)
+        }
+        _ => false,
+    }
+}
+
+#[test]
+fn an_answer_sent_on_a_second_connection_that_closed_completes_the_query_once() {
+    let key = random_key(82);
+    let server = TestServer::start(vec![key.clone()], ServerOptions::default());
+    let collector = Arc::new(Collector::default());
+    let (engine, session) = live_session(&server, &key, &collector);
+    let elsewhere = 2;
+    let sent = Instant::now();
+    engine.send(session, request(elsewhere, TAG_ANSWER_ELSEWHERE_ONCE));
+    engine.send(session, request(3, PLAIN));
+    collector.wait_completed(3);
+    assert!(eventually(WAIT, || server.executions(TAG_ANSWER_ELSEWHERE_ONCE) == 1), "{}", record(&server, &collector));
+    let sessions: Vec<i64> = server.with_stats(|stats| stats.session_ids.iter().copied().collect());
+    assert_eq!(sessions.len(), 1, "the engine's one session");
+    assert!(answer_on_a_second_connection(&server, &key, sessions[0]), "the second connection got the answer");
+    assert_eq!(collector.completions(elsewhere), 0, "the answer never reached the session's own connection");
+    collector.wait_completed(elsewhere);
+    let took = sent.elapsed().as_secs_f64();
+    std::thread::sleep(Duration::from_millis(500));
+    let record = record(&server, &collector);
+    assert!(took >= ANSWER_WAIT, "{took:.2} s: brought back by the question after the wait; {record}");
+    assert!(took < ANSWER_WAIT + SLACK, "{took:.2} s: within the wait and a few round trips; {record}");
+    for id in 1..=3 {
+        assert_eq!(collector.completions(id), 1, "call {id} completes once; {record}");
+    }
+    assert_eq!(server.executions(TAG_ANSWER_ELSEWHERE_ONCE), 1, "the server ran it once; {record}");
+    assert_eq!(server.with_stats(|stats| stats.answers_elsewhere), 1, "{record}");
+    let redelivered = server.with_stats(|stats| stats.redelivered_answers);
+    assert!(redelivered >= 1, "the copy under its msg_id fetched it; {record}");
+    assert!(server.with_stats(|stats| stats.state_requests) >= 1, "{record}");
+    assert_eq!(server.with_stats(|stats| stats.connections), 2, "the session's one and the test's own; {record}");
+    assert!(collector.drops().is_empty(), "no liveness check fired; {record}");
+    engine.shutdown();
+}
