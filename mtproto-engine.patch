+//! What ABI 11 added, through the C ABI with real callbacks: `mt_session_set_tls_hello_time_offset`, the time a
+//! fake-TLS hello says, and `MTConnectionDroppedFakeTlsUnverified`, the bit that tells a host a connection's hello
+//! never verified. `Stats::tls_hello_times` reads each hello on the server, `Stats::first_executions` each call's
+//! msg id.
+
+use std::ffi::c_void;
+use std::sync::{Condvar, Mutex};
+use std::time::{Duration, Instant, SystemTime, UNIX_EPOCH};
+
+use mtproto_engine::mtproto_core::auth_key::AuthKey;
+use mtproto_engine_ffi::*;
+use mtproto_testserver::*;
+
+const COMPLETED: u32 = 1;
+const TIME_DIFFERENCE_UPDATED: u32 = 15;
+const CONNECTION_STATE: u32 = 18;
+const CONNECTION_DROPPED: u32 = 29;
+/// `MTConnectionStateConnected`.
+const CONNECTED: u32 = 1 << 1;
+/// `MTConnectionDroppedAnswered`.
+const ANSWERED: u32 = 1 << 0;
+const WAIT: Duration = Duration::from_secs(20);
+/// What the proxy allows either way, and a clock far outside it.
+const WINDOW: f64 = 120.0;
+const SKEW: f64 = -600.0;
+const FORWARD: f64 = 3600.0;
+/// What a hello's time or a msg id's seconds, truncated, may read beyond the wall clock around it.
+const SLACK: f64 = 2.0;
+
+#[derive(Clone, Debug)]
+struct Seen {
+    kind: u32,
+    request: u64,
+    flags: u32,
+    text: String,
+    value: f64,
+}
+
+#[derive(Default)]
+struct Sink {
+    events: Mutex<Vec<Seen>>,
+    condvar: Condvar,
+}
+
+impl Sink {
+    fn wait(&self, predicate: impl Fn(&[Seen]) -> bool) -> bool {
+        let deadline = Instant::now() + WAIT;
+        let mut events = self.events.lock().unwrap();
+        while !predicate(&events) {
+            let now = Instant::now();
+            if now >= deadline {
+                return false;
+            }
+            events = self.condvar.wait_timeout(events, deadline - now).unwrap().0;
+        }
+        true
+    }
+
+    fn of(&self, kind: u32) -> Vec<Seen> {
+        self.events.lock().unwrap().iter().filter(|event| event.kind == kind).cloned().collect()
+    }
+}
+
+fn text_of(value: MTString) -> String {
+    if value.data.is_null() {
+        return String::new();
+    }
+    String::from_utf8_lossy(unsafe { std::slice::from_raw_parts(value.data, value.length) }).into_owned()
+}
+
+/// Copies what the test needs, and only then frees the payload, as a host must for every event.
+unsafe extern "C" fn on_event(context: *mut c_void, _session: u64, event: *const MTEvent) {
+    let sink = unsafe { &*(context as *const Sink) };
+    let event = unsafe { &*event };
+    let seen = Seen {
+        kind: event.kind,
+        request: event.request_id,
+        flags: event.flags,
+        text: text_of(event.text),
+        value: event.value1,
+    };
+    if !event.payload.is_null() {
+        unsafe { mt_buffer_free(event.payload) };
+    }
+    sink.events.lock().unwrap().push(seen);
+    sink.condvar.notify_all();
+}
+
+fn bytes(data: &[u8]) -> MTBytes {
+    MTBytes { data: data.as_ptr(), length: data.len() }
+}
+
+fn string(text: &str) -> MTString {
+    MTString { data: text.as_ptr(), length: text.len() }
+}
+
+fn wall_clock() -> f64 {
+    SystemTime::now().duration_since(UNIX_EPOCH).unwrap().as_secs_f64()
+}
+
+/// The kinds a host hands over as they are, each with a secret that is wrong for it.
+fn secrets() -> [(&'static str, Vec<u8>, Vec<u8>); 3] {
+    let prefixed = |first: u8, fill: u8, rest: &[u8]| [&[first][..], &[fill; 16], rest].concat();
+    [
+        ("plain", vec![0x11; 16], vec![0x12; 16]),
+        ("dd", prefixed(0xdd, 0x22, &[]), prefixed(0xdd, 0x23, &[])),
+        ("ee", prefixed(0xee, 0x33, b"www.example.com"), prefixed(0xee, 0x34, b"www.example.com")),
+    ]
+}
+
+fn fake_tls() -> Vec<u8> {
+    let [.., (_, secret, _)] = secrets();
+    secret
+}
+
+fn proxy_server(key: &AuthKey, secret: &[u8]) -> TestServer {
+    TestServer::start(vec![key.clone()], ServerOptions { secret: Some(secret.to_vec()), ..Default::default() })
+}
+
+/// A port nothing listens at.
+fn closed_port() -> u16 {
+    std::net::TcpListener::bind("127.0.0.1:0").unwrap().local_addr().unwrap().port()
+}
+
+struct Rig {
+    engine: *mut MTEngine,
+    sink: &'static Sink,
+    session: u64,
+}
+
+impl Rig {
+    /// One main session behind the MTProxy at `port`, whose datacenter address leads nowhere (RFC 5737).
+    fn new(port: u16, secret: &[u8], key: &AuthKey, time_difference: f64) -> Self {
+        let sink: &'static Sink = Box::leak(Box::default());
+        let engine = unsafe { mt_engine_create(1, sink as *const Sink as *mut c_void, Some(on_event), None) };
+        assert!(!engine.is_null());
+        let address = MTAddress { host: string("192.0.2.1"), port: 443, secret: bytes(&[]) };
+        let now = wall_clock();
+        // Valid over every clock the tests use: a salt out of range is another way to hold a call.
+        let (valid_since, valid_until) = (now - 2.0 * FORWARD, now + 2.0 * FORWARD);
+        let salt = MTSaltEntry { salt: SERVER_SALT, valid_since, valid_until };
+        let setup = MTSessionSetup {
+            datacenter_id: 2,
+            obfuscation_dc_id: 2,
+            role: 0,
+            framing: 0,
+            addresses: &address,
+            address_count: 1,
+            proxy: MTProxy {
+                kind: 2,
+                host: string("127.0.0.1"),
+                port,
+                username: string(""),
+                password: string(""),
+                secret: bytes(secret),
+            },
+            auth_key: bytes(key.bytes()),
+            salts: &salt,
+            salt_count: 1,
+            has_init_hash: 0,
+            init_hash: string(""),
+            generate_key: 0,
+            public_keys_pem: std::ptr::null(),
+            public_key_count: 0,
+            temp_key_expires_in: 0,
+            environment: std::ptr::null(),
+            time_difference,
+            online: 1,
+            paused: 0,
+            keep_connected: 1,
+            idle_disconnect_after: 0.0,
+            request_timeout: 5.0,
+            pfs_lifetime: 0,
+            pfs_make_permanent_key: 0,
+            pfs_temporary_key: std::ptr::null(),
+        };
+        let session = unsafe { mt_session_create(engine, &setup) };
+        assert_ne!(session, 0);
+        Self { engine, sink, session }
+    }
+
+    /// Sends a call of the `tag` whose payload is its id, as `first_executions` keys it.
+    fn send(&self, tag: u32) -> u64 {
+        let id = unsafe { mt_engine_next_request_id(self.engine) };
+        let body = call(tag, &id.to_le_bytes());
+        let request = MTRequest { id, body: bytes(&body), flags: 0, expected_response_size: 0, invoke_after: 0 };
+        unsafe { mt_session_send(self.engine, self.session, &request) };
+        id
+    }
+
+    fn wait_completed(&self, id: u64) {
+        let done = self.sink.wait(|events| events.iter().any(|event| event.kind == COMPLETED && event.request == id));
+        assert!(done, "call {id} did not complete: {:?}", self.sink.of(CONNECTION_DROPPED));
+    }
+
+    fn wait_drops(&self, count: usize) {
+        let dropped = |event: &&Seen| event.kind == CONNECTION_DROPPED;
+        let came = self.sink.wait(|events| events.iter().filter(dropped).count() >= count);
+        assert!(came, "fewer than {count} drops: {:?}", self.sink.of(CONNECTION_DROPPED));
+    }
+
+    /// Whether any state said connected.
+    fn said_connected(&self) -> bool {
+        self.sink.of(CONNECTION_STATE).iter().any(|state| state.flags & CONNECTED != 0)
+    }
+
+    /// The exported setter, as a host calls it: the value in its own local, or NULL.
+    fn set_offset(&self, offset: *const f64) {
+        unsafe { mt_session_set_tls_hello_time_offset(self.engine, self.session, offset) };
+    }
+
+    /// A new connection, and what its hello says.
+    fn reconnect(&self, server: &TestServer) -> f64 {
+        let hellos = hello_times(server).len();
+        unsafe { mt_engine_reset_connections(self.engine) };
+        let deadline = Instant::now() + WAIT;
+        while hello_times(server).len() <= hellos {
+            assert!(Instant::now() < deadline, "no hello after the reset");
+            std::thread::sleep(Duration::from_millis(5));
+        }
+        f64::from(hello_times(server)[hellos])
+    }
+
+    /// The seconds of the msg id of a new call, once it completed.
+    fn call_seconds(&self, server: &TestServer) -> f64 {
+        let id = self.send(1);
+        self.wait_completed(id);
+        let (_, msg_id, _) = server.with_stats(|stats| stats.first_executions[&(1, id)]);
+        (msg_id >> 32) as f64
+    }
+
+    fn assert_no_correction(&self) {
+        let reports = self.sink.of(TIME_DIFFERENCE_UPDATED);
+        assert!(reports.iter().all(|report| report.value.abs() < 60.0), "the RPC clock moved: {reports:?}");
+    }
+}
+
+impl Drop for Rig {
+    fn drop(&mut self) {
+        unsafe { mt_engine_destroy(self.engine) };
+    }
+}
+
+fn hello_times(server: &TestServer) -> Vec<i32> {
+    server.with_stats(|stats| stats.tls_hello_times.clone())
+}
+
+/// `reading` is the clock plus `offset`, the clock taken from `since` until now.
+fn assert_says(what: &str, reading: f64, offset: f64, since: f64) {
+    let (low, high) = (since + offset - SLACK, wall_clock() + offset + SLACK);
+    assert!(low <= reading && reading <= high, "{what}: {reading}, expected {low} to {high}");
+}
+
+#[test]
+fn the_header_declares_abi_11() {
+    let header = include_str!("../include/mtproto_engine.h");
+    for declared in [
+        "void mt_session_set_tls_hello_time_offset(MTEngine *engine, MTSessionHandle session, const double *offset);",
+        "MTConnectionDroppedAnswered = 1 << 0,",
+        "MTConnectionDroppedFakeTlsUnverified = 1 << 1,",
+    ] {
+        assert!(header.contains(declared), "{declared}");
+    }
+    assert_eq!(mt_engine_abi_version(), 12);
+    assert_eq!(CONNECTION_DROPPED_FAKE_TLS_UNVERIFIED, 1 << 1);
+}
+
+/// The setter copies the value during the call: the local it read is gone by the next connection, whose hello says
+/// it. A non-finite value is ignored, an address no double may sit at is read all the same, and NULL clears. Msg ids
+/// and reports stay at the RPC clock's throughout, and no setter touches the connection.
+#[test]
+fn the_exported_offset_moves_the_hello_and_no_msg_id() {
+    let key = random_key(1101);
+    let secret = fake_tls();
+    let server = proxy_server(&key, &secret);
+    let rig = Rig::new(server.address.port(), &secret, &key, 0.0);
+    let since = wall_clock();
+    assert_says("the first msg id", rig.call_seconds(&server), 0.0, since);
+    assert_says("the first hello", f64::from(hello_times(&server)[0]), 0.0, since);
+    let connections = server.with_stats(|stats| stats.connections);
+
+    let mut local = FORWARD;
+    rig.set_offset(&local);
+    local = -9.0e9;
+    std::hint::black_box(&mut local);
+    assert_says("a msg id on the same connection", rig.call_seconds(&server), 0.0, since);
+    assert_eq!(server.with_stats(|stats| stats.connections), connections, "the setter touched the connection");
+    assert_says("the copied offset", rig.reconnect(&server), FORWARD, since);
+    assert_says("a msg id under it", rig.call_seconds(&server), 0.0, since);
+
+    for value in [f64::NAN, f64::INFINITY, f64::NEG_INFINITY] {
+        rig.set_offset(&value);
+    }
+    assert_says("non-finite values", rig.reconnect(&server), FORWARD, since);
+
+    let mut unaligned = [0u8; 2 * size_of::<f64>()];
+    let misplaced = unaligned.iter().position(|byte| !(byte as *const u8 as usize).is_multiple_of(align_of::<f64>()));
+    let misplaced = misplaced.unwrap();
+    unaligned[misplaced..misplaced + size_of::<f64>()].copy_from_slice(&SKEW.to_ne_bytes());
+    rig.set_offset(unaligned[misplaced..].as_ptr().cast());
+    assert_says("an unaligned offset", rig.reconnect(&server), SKEW, since);
+
+    rig.set_offset(std::ptr::null());
+    assert_says("NULL", rig.reconnect(&server), 0.0, since);
+    assert_says("the last msg id", rig.call_seconds(&server), 0.0, since);
+    rig.assert_no_correction();
+}
+
+/// A hello outside the window, refused: the drop says unverified and not answered, and the session is not connected.
+/// The offset through the C ABI, on the same handle, and the call completes; the server's correction reaches the host.
+#[test]
+fn a_refused_hello_is_flagged_and_recovers_through_the_exported_offset() {
+    let key = random_key(1102);
+    let secret = fake_tls();
+    let options = ServerOptions {
+        secret: Some(secret.clone()),
+        tls_time_window: Some(WINDOW),
+        validate_msg_id_time: true,
+        ..Default::default()
+    };
+    let server = TestServer::start(vec![key.clone()], options);
+    let rig = Rig::new(server.address.port(), &secret, &key, SKEW);
+    let since = wall_clock();
+    let id = rig.send(1);
+    rig.wait_drops(1);
+    assert!(server.with_stats(|stats| stats.tls_time_refusals) > 0);
+    assert!(!rig.said_connected(), "connected while refused");
+    for dropped in rig.sink.of(CONNECTION_DROPPED) {
+        assert_eq!(dropped.flags, CONNECTION_DROPPED_FAKE_TLS_UNVERIFIED, "{dropped:?}");
+        assert!(["closed", "io_error"].contains(&dropped.text.as_str()), "{dropped:?}");
+    }
+    assert_says("a refused hello", f64::from(hello_times(&server)[0]), SKEW, since);
+
+    let correct = 0.0f64;
+    rig.set_offset(&correct);
+    rig.wait_completed(id);
+    assert_says("the hello that got through", f64::from(*hello_times(&server).last().unwrap()), 0.0, since);
+    assert!(rig.said_connected(), "completed without saying connected");
+    let corrected = |event: &Seen| event.kind == TIME_DIFFERENCE_UPDATED && event.value.abs() < 60.0;
+    let reported = rig.sink.wait(|events| events.iter().any(corrected));
+    assert!(reported, "the server's correction was not reported: {:?}", rig.sink.of(TIME_DIFFERENCE_UPDATED));
+}
+
+/// A connection that had taken a packet reads the first bit and not the second, whatever the secret.
+#[test]
+fn a_connection_that_took_a_packet_reads_answered_alone() {
+    for (kind, secret, _) in secrets() {
+        let key = random_key(1103);
+        let server = proxy_server(&key, &secret);
+        let rig = Rig::new(server.address.port(), &secret, &key, 0.0);
+        let id = rig.send(1);
+        rig.wait_completed(id);
+        let id = rig.send(TAG_DROP_CONNECTION_ONCE);
+        rig.wait_completed(id);
+        let drops = rig.sink.of(CONNECTION_DROPPED);
+        assert!(!drops.is_empty(), "{kind}: the server's close dropped nothing");
+        assert!(drops.iter().all(|dropped| dropped.flags == ANSWERED), "{kind}: {drops:?}");
+    }
+}
+
+/// Plain and `dd` never set the second bit: at a wrong secret, and before TCP connected, where `ee` sets it.
+#[test]
+fn only_ee_sets_the_second_bit_before_anything_answered() {
+    for (kind, secret, wrong) in secrets() {
+        let key = random_key(1104);
+        let server = proxy_server(&key, &secret);
+        let wrong_secret = Rig::new(server.address.port(), &wrong, &key, 0.0);
+        let closed = Rig::new(closed_port(), &secret, &key, 0.0);
+        let expected = if kind == "ee" { CONNECTION_DROPPED_FAKE_TLS_UNVERIFIED } else { 0 };
+        for (what, rig) in [("a wrong secret", &wrong_secret), ("a closed port", &closed)] {
+            rig.send(1);
+            rig.wait_drops(2);
+            let drops = rig.sink.of(CONNECTION_DROPPED);
+            assert!(drops.iter().all(|dropped| dropped.flags == expected), "{kind}, {what}: {drops:?}");
+        }
+        assert!(hello_times(&server).is_empty(), "{kind}: {:?}", hello_times(&server));
+    }
+}
