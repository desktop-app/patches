+                .filter(|event| matches!(event, EngineEvent::Rpc(RpcEvent::Completed { id: done, .. }) if done.0 == id))
+                .count()
+        }
+
+        fn failures(&self, id: u64) -> Vec<(i32, String)> {
+            self.events()
+                .iter()
+                .filter_map(|event| match event {
+                    EngineEvent::Rpc(RpcEvent::Failed { id: failed, code, message, .. }) if failed.0 == id => {
+                        Some((*code, message.clone()))
+                    }
+                    _ => None,
+                })
+                .collect()
+        }
+
+        /// The temporary key the session made, bound and talks under, as the host's slot keeps it.
+        fn bound_key(&self) -> BoundTemporaryKey {
+            let events = self.events();
+            let (key_id, expires_at, permanent_key_id) = events
+                .iter()
+                .rev()
+                .find_map(|event| match event {
+                    EngineEvent::TemporaryKeyInUse { key_id, expires_at, adopted: false, permanent_key_id, .. } => {
+                        Some((*key_id as u64, *expires_at, *permanent_key_id as u64))
+                    }
+                    _ => None,
+                })
+                .expect("a temporary key in use");
+            let (key, salt) = events
+                .iter()
+                .find_map(|event| match event {
+                    EngineEvent::AuthKeyCreated { key, salt, expires_at: Some(_), .. } => {
+                        let key = AuthKey::from_slice(key).expect("256 bytes");
+                        (key.id() == key_id).then_some((key, *salt))
+                    }
+                    _ => None,
+                })
+                .expect("the key's AuthKeyCreated");
+            let now = crate::clock::now().unix;
+            BoundTemporaryKey {
+                material: AuthKeyMaterial {
+                    key,
+                    salts: vec![ServerSalt { salt, valid_since: now - 60.0, valid_until: now + 1800.0 }],
+                    init_hash: None,
+                },
+                expires_at,
+                bound_to: Some(permanent_key_id),
+            }
+        }
+
+        /// Another day-long key bound to the session's permanent key, as another slot of the host holds
+        /// one. It never goes out in these tests.
+        fn other_key(&self, seed: u64) -> BoundTemporaryKey {
+            let now = crate::clock::now().unix;
+            BoundTemporaryKey {
+                material: AuthKeyMaterial {
+                    key: random_key(seed),
+                    salts: vec![ServerSalt { salt: SERVER_SALT, valid_since: now - 60.0, valid_until: now + 1800.0 }],
+                    init_hash: None,
+                },
+                expires_at: (now + 86_400.0) as i32,
+                bound_to: Some(self.perm.id()),
+            }
+        }
+    }
+
+    fn live_server(perm: &AuthKey) -> TestServer {
+        TestServer::start(
+            vec![perm.clone()],
+            ServerOptions {
+                handshake: ServerHandshakeBehavior { live_time: true, ..Default::default() },
+                ..Default::default()
+            },
+        )
+    }
+
+    /// A worker talking under the Regular key K it made and bound, the key the host's Regular slot
+    /// then holds.
+    fn bound_worker(server: &TestServer, perm: &AuthKey) -> (Live, BoundTemporaryKey) {
+        let mut live = Live::new(server, perm);
+        live.send(1, 1);
+        assert!(live.until(|live| live.completions(1) == 1), "the first call never completed: {:?}", live.in_use());
+        let key = live.bound_key();
+        assert_eq!(live.key_in_use(), Some(key.material.key.id()));
+        (live, key)
+    }
+
+    /// Moves a paused worker to the media class and back as the host's `refresh` does, each move
+    /// followed by the offer of the new class's slot key (`media`, when the media slot has one, then
+    /// `back`): one batch before a single drive, or a drive after every command when `separated`.
+    fn move_and_back(live: &mut Live, media: Option<BoundTemporaryKey>, back: BoundTemporaryKey, separated: bool) {
+        let step = |live: &mut Live| {
+            if separated {
+                live.drive();
+            }
+        };
+        live.set_class(MEDIA);
+        step(live);
+        if let Some(media) = media {
+            live.offer(media);
+            step(live);
+        }
+        live.set_class(REGULAR);
+        step(live);
+        live.offer(back);
+        live.drive();
+    }
+
+    /// Two refreshes of the host reach the worker in one drain of its queue, as when its reactor was
+    /// busy: to the media class with the media slot's key, and back with the Regular slot's key K, the
+    /// key the session talked under. K is taken back at once for the Regular class, without a
+    /// handshake. The call the server had fails once as TEMP_KEY_ROTATED, the one sent during the pause
+    /// runs once, under K, and nothing connects before the pause ends.
+    #[test]
+    fn a_move_to_the_media_class_and_back_in_one_batch_takes_the_regular_key_again() {
+        let perm = random_key(4401);
+        let server = live_server(&perm);
+        let (mut live, regular) = bound_worker(&server, &perm);
+        let regular_id = regular.material.key.id();
+        let media = live.other_key(4402);
+        let media_id = media.material.key.id();
+        live.send(2, TAG_NEVER);
+        assert!(live.until(|_| server.executions(TAG_NEVER) == 1), "call 2 never reached the server");
+        live.pause(true);
+        live.send(3, 3);
+        let (handshakes, connections) = server.with_stats(|stats| (stats.handshakes, stats.connections));
+
+        move_and_back(&mut live, Some(media), regular, false);
+
+        let in_use = live.in_use();
+        assert_eq!(live.key_in_use(), Some(regular_id), "K was not taken back; keys in use {in_use:x?}");
+        assert_eq!(
+            in_use[1..],
+            [(media_id, true, i32::from(MEDIA), perm.id()), (regular_id, true, i32::from(REGULAR), perm.id())],
+            "each move took its class's key"
+        );
+        assert_eq!(live.failures(2), [(500, "TEMP_KEY_ROTATED".to_string())], "the call in flight fails once");
+        assert!(live.failures(3).is_empty(), "the call sent during the pause failed: {:?}", live.failures(3));
+        for _ in 0..50 {
+            live.turn();
+        }
+        assert!(live.runtime.connection.is_none(), "a paused session connected");
+        assert_eq!(server.with_stats(|stats| stats.connections), connections, "a paused session connected");
+
+        live.pause(false);
+        assert!(live.until(|live| live.completions(3) == 1), "call 3 never completed: {:?}", live.failures(3));
+        let (made, ran) = server.with_stats(|stats| (stats.handshakes, stats.executed_with_key.clone()));
+        let ran3: Vec<u64> = ran.iter().filter(|(tag, _)| *tag == 3).map(|(_, key)| *key).collect();
+        assert_eq!(made, handshakes, "a key was made instead of taking K back");
+        assert_eq!(ran3, [regular_id], "call 3 ran other than once under K");
+        assert_eq!(live.failures(2).len(), 1);
+        assert_eq!(server.executions(TAG_NEVER), 1);
+        assert_eq!(live.created_keys(), 1);
+        live.shutdown();
+    }
+
+    /// The same batch while the media slot is empty: the move back offers K right after the move away.
+    #[test]
+    fn a_move_to_the_media_class_and_back_in_one_batch_without_a_media_key_takes_the_regular_key_again() {
+        let perm = random_key(4401);
