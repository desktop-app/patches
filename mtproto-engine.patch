+/// The server acknowledged the query and then says it never received it: it lost its record of a query
+/// it had, which may have run. The query fails once as possibly run, without a new msg_id.
+#[test]
+fn a_query_the_server_acknowledged_and_then_does_not_know_fails_once_as_possibly_run() {
+    let mut h = Harness::new();
+    h.session.send(QueryId(1), query_body(1), QueryOptions::default(), h.now);
+    let packet = h.flush().unwrap();
+    let sent = copies(std::slice::from_ref(&packet), 1)[0];
+    h.answer_pings(&packet);
+    h.deliver(vec![Outgoing::Service(msgs_ack(&[sent.0]))]).unwrap();
+    let asked = state_requests(&live(&mut h, ANSWER_WAIT + 1.0));
+    assert_eq!(asked.len(), 1, "{asked:x?}");
+    h.deliver(vec![Outgoing::Service(msgs_state_info(asked[0].0, &[2]))]).unwrap();
+    let later = live(&mut h, 2.0 * ANSWER_WAIT);
+    assert!(copies(&later, 1).is_empty(), "no copy under any msg_id");
+    let events = h.events();
+    assert_eq!(forgotten(&events, QueryId(1)), 1, "{events:?}");
+    assert_eq!(terminal_events(&events, QueryId(1)), 1);
+}
