+/// Bytes sent that the peer has not acknowledged, from `SIO_TCP_INFO` (Windows 10 1703 and later; None
+/// before, where the call fails). Unlike Darwin's `SO_NWRITE` it leaves out what Winsock holds unsent.
+#[cfg(windows)]
+#[allow(unsafe_code)]
+pub(crate) fn kernel_send_queue(socket: &mio::net::TcpStream) -> Option<usize> {
+    use std::os::windows::io::AsRawSocket;
+    use windows_sys::Win32::Networking::WinSock::{SIO_TCP_INFO, SOCKET, TCP_INFO_v0, WSAIoctl};
+    let version: u32 = 0;
+    let mut info = TCP_INFO_v0::default();
+    let mut returned: u32 = 0;
+    let result = unsafe {
+        WSAIoctl(
+            socket.as_raw_socket() as SOCKET,
+            SIO_TCP_INFO,
+            (&version as *const u32).cast(),
+            std::mem::size_of::<u32>() as u32,
+            (&mut info as *mut TCP_INFO_v0).cast(),
+            std::mem::size_of::<TCP_INFO_v0>() as u32,
+            &mut returned,
+            std::ptr::null_mut(),
+            None,
+        )
+    };
+    let needed = std::mem::offset_of!(TCP_INFO_v0, BytesInFlight) + std::mem::size_of::<u32>();
+    (result == 0 && returned as usize >= needed).then_some(info.BytesInFlight as usize)
+}
