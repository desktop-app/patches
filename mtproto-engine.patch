+
+    use crate::types::TransportPreference;
+
+    /// How long a listener is watched for connections still on their way.
+    const SETTLE: Duration = Duration::from_millis(150);
+
+    /// A local listener that takes connections and never answers, keeping each open: what a session opens
+    /// to it is counted.
+    struct Sink {
+        listener: std::net::TcpListener,
+        taken: Vec<std::net::TcpStream>,
+    }
+
+    impl Sink {
+        fn new() -> Self {
+            let listener = std::net::TcpListener::bind("127.0.0.1:0").unwrap();
+            listener.set_nonblocking(true).unwrap();
+            Self { listener, taken: Vec::new() }
+        }
+
+        fn port(&self) -> u16 {
+            self.listener.local_addr().unwrap().port()
+        }
+
+        fn address(&self) -> DcAddress {
+            DcAddress { host: "127.0.0.1".into(), port: self.port(), secret: None }
+        }
+
+        /// The connections taken so far, after `SETTLE` for those on their way.
+        fn taken(&mut self) -> usize {
+            let deadline = Instant::now() + SETTLE;
+            loop {
+                while let Ok((stream, _)) = self.listener.accept() {
+                    self.taken.push(stream);
+                }
+                if Instant::now() >= deadline {
+                    return self.taken.len();
+                }
+                std::thread::sleep(Duration::from_millis(5));
+            }
+        }
+    }
+
+    /// A main session with a key on a virtual clock, driven as the worker drives it: I/O, the host's
+    /// commands, then `drive`. Commands between two drives are one batch.
+    struct Gate {
+        poll: mio::Poll,
+        events: mio::Events,
+        scratch: Vec<u8>,
+        rng: OsRandom,
+        recorded: Arc<Recorded>,
+        callbacks: Arc<dyn EngineCallbacks>,
+        config: EngineConfig,
+        start: Now,
+        elapsed: f64,
+        runtime: SessionRuntime,
+    }
+
+    fn gate_setup(tcp: Vec<DcAddress>, http: Vec<DcAddress>, transport: TransportPreference) -> SessionSetup {
+        let mut setup = SessionSetup::new(2, SessionRole::Main, tcp);
+        setup.transport = transport;
+        setup.http_port = None;
+        setup.http_addresses = Some(http);
+        setup
+    }
+
+    impl Gate {
+        fn new(mut setup: SessionSetup, required: bool) -> Self {
+            let start = Now { mono: 1000.0, unix: 1_727_000_000.0 };
+            setup.auth_key = Some(AuthKeyMaterial {
+                key: AuthKey::new([7u8; 256]),
+                salts: vec![ServerSalt { salt: 1, valid_since: start.unix - 60.0, valid_until: start.unix + 3600.0 }],
+                init_hash: None,
+            });
+            let mut rng = OsRandom::new();
+            let mut runtime = SessionRuntime::new(SessionHandle(1), setup, Token(16), start, &mut rng);
+            runtime.set_route_admission(required, start);
+            let recorded = Arc::new(Recorded::default());
+            Self {
+                poll: mio::Poll::new().unwrap(),
+                events: mio::Events::with_capacity(64),
+                scratch: vec![0u8; 256 * 1024],
+                rng,
+                callbacks: recorded.clone(),
+                recorded,
+                config: EngineConfig::default(),
+                start,
+                elapsed: 0.0,
+                runtime,
+            }
+        }
+
+        fn now(&self) -> Now {
+            Now { mono: self.start.mono + self.elapsed, unix: self.start.unix + self.elapsed }
+        }
+
+        fn drive(&mut self) {
+            let now = self.now();
+            self.runtime.drive(self.poll.registry(), now, &mut NoLookups, &self.config, &self.callbacks, &mut self.rng);
+        }
+
+        /// A drive every `step` seconds for `seconds`.
+        fn drive_for(&mut self, seconds: f64, step: f64) {
+            let end = self.elapsed + seconds;
+            while self.elapsed < end {
+                self.elapsed += step;
+                self.drive();
+            }
+        }
+
+        /// I/O, then a drive, a millisecond later on the virtual clock.
+        fn turn(&mut self) {
+            self.poll.poll(&mut self.events, Some(Duration::from_millis(2))).unwrap();
+            self.elapsed += 0.001;
+            let now = self.now();
+            for event in self.events.iter() {
+                let readable = event.is_readable() || event.is_read_closed() || event.is_error();
+                let writable = event.is_writable() || event.is_write_closed();
+                self.runtime.handle_io(
+                    event.token(),
+                    readable,
+                    writable,
+                    self.poll.registry(),
+                    &mut self.scratch,
+                    now,
+                    &self.callbacks,
+                    &mut self.rng,
+                );
+            }
+            self.drive();
+        }
+
+        /// Turns until `done`, for 3 s at most.
+        fn turn_until(&mut self, done: impl Fn(&Self) -> bool) -> bool {
+            let started = Instant::now();
+            while !done(self) {
+                if started.elapsed() > Duration::from_secs(3) {
+                    return false;
+                }
+                self.turn();
+            }
+            true
+        }
+
+        fn admit(&mut self, id: u64, admitted: bool) {
+            let now = self.now();
+            self.runtime.admit_route(id, admitted, now);
+        }
+
+        fn send(&mut self, id: u64) {
+            let request = RpcRequest {
+                id: RequestId(id),
+                body: vec![1, 2, 3, 4, 5, 6, 7, 8],
+                flags: RequestFlags::default(),
+                invoke_after: None,
+            };
+            let now = self.now();
+            self.runtime.send(request, now);
+        }
+
+        /// Every `RouteRequired` so far: its id, transport, host and port.
+        fn asked(&self) -> Vec<(u64, RouteTransport, String, u16)> {
+            self.recorded
+                .0
+                .lock()
+                .unwrap()
+                .iter()
+                .filter_map(|event| match event {
+                    EngineEvent::RouteRequired { id, transport, host, port } => {
+                        Some((*id, *transport, host.clone(), *port))
+                    }
+                    _ => None,
+                })
+                .collect()
+        }
+
+        /// The ids asked for `transport` to the local listener at `port`.
+        fn asked_for(&self, transport: RouteTransport, port: u16) -> Vec<u64> {
+            self.asked()
+                .into_iter()
+                .filter(|(_, asked, host, at)| *asked == transport && host == "127.0.0.1" && *at == port)
+                .map(|(id, ..)| id)
+                .collect()
+        }
+
+        fn http_links(&self) -> usize {
+            self.runtime.http.as_ref().map_or(0, |http| http.conns.len())
+        }
+
+        fn auto(&self) -> String {
+            self.runtime.auto.describe(self.now().mono)
+        }
+
+        fn shutdown(mut self) {
+            let now = self.now();
+            self.runtime.shutdown(self.poll.registry(), now);
+        }
+    }
+
+    /// Nothing opens before the host admits it, however long the session waits, and waiting is no
+    /// failure; one unanswered admission is asked again after `ROUTE_ADMISSION_WAIT`, and an answer to
+    /// the earlier one is then ignored. The answer to the current one opens exactly one connection.
+    #[test]
+    fn a_required_session_asks_once_per_destination_and_an_admission_opens_one_connection() {
+        let mut tcp = Sink::new();
+        let mut gate = Gate::new(gate_setup(vec![tcp.address()], Vec::new(), TransportPreference::Tcp), true);
+        gate.drive();
+        gate.drive_for(29.5, 0.25);
+        assert_eq!(gate.asked(), [(1, RouteTransport::Tcp, "127.0.0.1".to_string(), tcp.port())]);
+        assert!(gate.runtime.connection.is_none());
+        assert_eq!(tcp.taken(), 0, "a connection opened before the host admitted it");
+        assert_eq!(gate.runtime.failures, 0, "waiting counted as a failure");
+
+        gate.drive_for(0.5, 0.25);
+        assert_eq!(gate.asked_for(RouteTransport::Tcp, tcp.port()), [1, 2], "not asked again after the wait");
+        gate.admit(1, true);
+        gate.drive();
+        assert!(gate.runtime.connection.is_none(), "an answer to an admission asked again opened a connection");
+
+        gate.admit(2, true);
+        gate.drive();
+        assert!(gate.runtime.connection.is_some(), "the admitted connection did not open");
+        gate.drive_for(0.75, 0.25);
+        assert_eq!(tcp.taken(), 1, "one admission opened other than one connection");
+        assert_eq!(gate.asked().len(), 2);
+        gate.shutdown();
+    }
+
+    /// A grant is spent on the connection it opened: the next connection to the same address, after a
+    /// reset, asks again and opens nothing before its own answer.
+    #[test]
+    fn a_connection_after_a_close_asks_again() {
+        let mut tcp = Sink::new();
+        let mut gate = Gate::new(gate_setup(vec![tcp.address()], Vec::new(), TransportPreference::Tcp), true);
+        gate.drive();
+        gate.admit(1, true);
+        gate.drive();
+        assert!(gate.runtime.connection.is_some());
+        let now = gate.now();
+        gate.runtime.reset_connection(now, gate.poll.registry());
+        gate.drive_for(0.5, 0.25);
+        assert_eq!(gate.asked_for(RouteTransport::Tcp, tcp.port()), [1, 2]);
+        assert!(gate.runtime.connection.is_none(), "the connection after the reset opened without an admission");
+        assert_eq!(tcp.taken(), 1);
+        gate.admit(2, true);
+        gate.drive();
+        assert!(gate.runtime.connection.is_some());
+        assert_eq!(tcp.taken(), 2);
+        gate.shutdown();
+    }
+
+    /// A grant is for exactly its destination and for the drive after its answer: an attempt to another
+    /// address neither takes it nor opens, and one the session does not make in that drive (offline)
+    /// leaves nothing for later.
+    #[test]
+    fn an_admission_opens_only_its_destination_and_only_in_the_drive_after_it() {
+        let (mut first, mut second) = (Sink::new(), Sink::new());
+        let mut gate =
+            Gate::new(gate_setup(vec![first.address(), second.address()], Vec::new(), TransportPreference::Tcp), true);
+        gate.drive();
+        assert_eq!(gate.asked_for(RouteTransport::Tcp, first.port()), [1]);
+        let now = gate.now();
+        gate.runtime.note_address(0, false, now);
+        gate.admit(1, true);
+        gate.drive();
+        assert!(gate.runtime.connection.is_none(), "the admission for the first address opened another");
+        assert_eq!(gate.asked_for(RouteTransport::Tcp, second.port()), [2]);
+
+        gate.admit(2, true);
+        let now = gate.now();
+        gate.runtime.set_network_available(false, now, gate.poll.registry());
+        gate.drive();
+        assert!(gate.runtime.connection.is_none());
+        gate.elapsed += 1.0;
+        let now = gate.now();
+        gate.runtime.set_network_available(true, now, gate.poll.registry());
+        gate.drive();
+        assert!(gate.runtime.connection.is_none(), "an admission left from an earlier drive opened a connection");
+        assert_eq!(gate.asked_for(RouteTransport::Tcp, second.port()), [2, 3]);
+        assert_eq!(first.taken() + second.taken(), 0);
+
+        gate.admit(3, true);
+        gate.drive();
+        assert_eq!(gate.runtime.connection.as_ref().map(|connection| connection.address_index), Some(1));
+        assert_eq!((first.taken(), second.taken()), (0, 1));
+        gate.shutdown();
+    }
