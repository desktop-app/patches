+/// Windows refuses SYNs to a full accept queue. A conditional-accept listener nothing accepts from leaves
+/// them unanswered instead, as on a route that goes nowhere.
+#[cfg(windows)]
+fn blackhole(port: u16) -> (TcpListener, Vec<TcpStream>) {
+    use std::os::windows::io::{AsRawSocket, FromRawSocket, RawSocket};
+    use windows_sys::Win32::Networking::WinSock::{
+        AF_INET, IN_ADDR, IN_ADDR_0, INVALID_SOCKET, IPPROTO_TCP, SO_CONDITIONAL_ACCEPT, SOCK_STREAM, SOCKADDR,
+        SOCKADDR_IN, SOCKET, SOL_SOCKET, WSAGetLastError, bind, listen, setsockopt, socket,
+    };
+    let last_error = || std::io::Error::from_raw_os_error(unsafe { WSAGetLastError() });
+    std::net::UdpSocket::bind((Ipv4Addr::LOCALHOST, 0)).expect("std starts Winsock");
+    let raw = unsafe { socket(AF_INET.into(), SOCK_STREAM, IPPROTO_TCP) };
+    assert_ne!(raw, INVALID_SOCKET, "socket: {}", last_error());
+    let listener = unsafe { TcpListener::from_raw_socket(raw as RawSocket) };
+    let raw = listener.as_raw_socket() as SOCKET;
+    let on: i32 = 1;
+    let set = unsafe {
+        setsockopt(
+            raw,
+            SOL_SOCKET,
+            SO_CONDITIONAL_ACCEPT,
+            &on as *const i32 as *const u8,
+            std::mem::size_of::<i32>() as i32,
+        )
+    };
+    assert_eq!(set, 0, "SO_CONDITIONAL_ACCEPT: {}", last_error());
+    let address = SOCKADDR_IN {
+        sin_family: AF_INET,
+        sin_port: port.to_be(),
+        sin_addr: IN_ADDR { S_un: IN_ADDR_0 { S_addr: u32::from(Ipv4Addr::LOCALHOST).to_be() } },
+        sin_zero: [0; 8],
+    };
+    let bound = unsafe {
+        bind(raw, &address as *const SOCKADDR_IN as *const SOCKADDR, std::mem::size_of::<SOCKADDR_IN>() as i32)
+    };
+    assert_eq!(bound, 0, "bind 127.0.0.1:{port}: {}", last_error());
+    assert_eq!(unsafe { listen(raw, 200) }, 0, "listen: {}", last_error());
+    let target = SocketAddr::from((Ipv4Addr::LOCALHOST, port));
+    let probe = TcpStream::connect_timeout(&target, Duration::from_millis(300));
+    assert!(
+        probe.as_ref().is_err_and(|error| error.kind() == std::io::ErrorKind::TimedOut),
+        "127.0.0.1:{port} answered: {probe:?}"
+    );
+    (listener, Vec::new())
+}
