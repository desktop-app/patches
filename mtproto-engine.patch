@@ -0,0 +1,225 @@
+use std::cell::{Cell, OnceCell};
+use std::io;
+use std::marker::PhantomData;
+use std::panic::PanicHookInfo;
+use std::sync::{Mutex, Once, PoisonError};
+use std::thread::{Builder, JoinHandle};
+
+/// Starts one of the engine's threads. A panic on it ends the process, as the engine's own `panic = "abort"`
+/// profile does: in a host built with `panic = "unwind"` the thread would otherwise end alone and leave the engine
+/// without its worker or resolver, with requests that never complete. The whole thread runs as engine code: a panic
+/// on it goes to the reporter of [`report_panics_to`] under the name `builder` gave it.
+pub fn spawn(builder: Builder, body: impl FnOnce() + Send + 'static) -> io::Result<JoinHandle<()>> {
+    builder.spawn(move || {
+        let name = std::thread::current().name().unwrap_or_default().to_owned();
+        let _ = SCOPE.try_with(|scope| scope.thread.set(name));
+        let _engine = enter_engine_code();
+        // Kept until the abort: a payload whose drop panics would otherwise end only this thread.
+        let result = std::panic::catch_unwind(std::panic::AssertUnwindSafe(body));
+        if result.is_err() {
+            std::process::abort();
+        }
+    })
+}
+
+/// The engine code running on a thread: how many scopes of [`enter_engine_code`] are open on it, and its name if
+/// [`spawn`] started it.
+struct Scope {
+    depth: Cell<usize>,
+    thread: OnceCell<String>,
+}
+
+thread_local! {
+    static SCOPE: Scope = const { Scope { depth: Cell::new(0), thread: OnceCell::new() } };
+}
+
+/// Runs the calling thread as engine code until the returned guard is dropped, unwinding included: a panic on it
+/// until then goes to the reporter of [`report_panics_to`], under an empty thread name unless the engine started the
+/// thread. Each C entry point of the engine holds one for its whole body. Scopes nest; a nested one keeps the name.
+pub fn enter_engine_code() -> EngineCode {
+    let _ = SCOPE.try_with(|scope| scope.depth.set(scope.depth.get() + 1));
+    EngineCode(PhantomData)
+}
+
+/// An open scope of [`enter_engine_code`]. Not `Send`: it closes on the thread that opened it.
+#[must_use = "the thread leaves engine code when this is dropped"]
+pub struct EngineCode(PhantomData<*const ()>);
+
+impl Drop for EngineCode {
+    fn drop(&mut self) {
+        let _ = SCOPE.try_with(|scope| scope.depth.set(scope.depth.get() - 1));
+    }
+}
+
+/// The reporter of [`report_panics_to`].
+static REPORTER: Mutex<Option<fn(&str, &str)>> = Mutex::new(None);
+
+/// Installs the engine's panic hook once.
+static HOOK: Once = Once::new();
+
+/// Reports each panic of engine code, on a thread the engine started or in a scope of [`enter_engine_code`], to
+/// `report`; `None` stops the reports. `report` gets the name of the panicking thread, empty for a thread the engine
+/// did not start, and `<message> at <file>:<line>:<column>`. It is called on the panicking thread before any unwinding,
+/// and it may end the process itself; if it returns, the panic hook set before runs as it did and the panic goes on.
+/// Panics outside engine code, such as another Rust library's on a host thread, are not reported. Nothing changes until
+/// the first reporter installs the engine's panic hook in front of the one already set.
+pub fn report_panics_to(report: Option<fn(thread: &str, message: &str)>) {
+    *REPORTER.lock().unwrap_or_else(PoisonError::into_inner) = report;
+    if report.is_some() {
+        HOOK.call_once(|| {
+            let previous = std::panic::take_hook();
+            std::panic::set_hook(Box::new(move |info| {
+                report_engine_panic(info);
+                previous(info);
+            }));
+        });
+    }
+}
+
+/// Calls the reporter if the panicking thread runs engine code. A panic inside it needs no guard: std aborts on a panic
+/// inside a panic hook.
+fn report_engine_panic(info: &PanicHookInfo<'_>) {
+    let _ = SCOPE.try_with(|scope| {
+        if scope.depth.get() == 0 {
+            return;
+        }
+        let Some(report) = *REPORTER.lock().unwrap_or_else(PoisonError::into_inner) else {
+            return;
+        };
+        let message = info.payload_as_str().unwrap_or("Box<dyn Any>");
+        let message = match info.location() {
+            Some(location) => format!("{message} at {location}"),
+            None => message.to_owned(),
+        };
+        report(scope.thread.get().map_or("", String::as_str), &message);
+    });
+}
+
+#[cfg(test)]
+mod tests {
+    use std::process::{Command, ExitStatus};
