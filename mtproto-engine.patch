diff --git a/crates/mtproto-engine/tests/proxy_addresses.rs b/crates/mtproto-engine/tests/proxy_addresses.rs
new file mode 100644
index 0000000..dd3c76e
--- /dev/null
+++ b/crates/mtproto-engine/tests/proxy_addresses.rs
@@ -0,0 +1,313 @@
+//! The addresses a host gives for its proxy's host name (`Engine::set_proxy_addresses`), over real sockets: a
+//! session tries them in their order, one per attempt, while its reconnect delay climbs the ladder across them;
+//! once one starts accepting, the session's next attempt there connects, and the state it reports names the
+//! address it reached. An HTTP link names it too; a proxy given as an IP literal names none.
+
+use std::io::{Read, Write};
+use std::net::{IpAddr, Ipv4Addr, Ipv6Addr, Shutdown, SocketAddr, TcpListener, TcpStream};
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::{Arc, Condvar, Mutex};
+use std::time::{Duration, Instant};
+
+use mtproto_engine::mtproto_core::auth_key::AuthKey;
+use mtproto_engine::mtproto_core::rpc::{RequestFlags, RequestId, RpcEvent, RpcRequest, SessionRole};
+use mtproto_engine::mtproto_core::session::ServerSalt;
+use mtproto_engine::mtproto_core::transport::{RECONNECT_DELAYS, RECONNECT_JITTER};
+use mtproto_engine::{
+    AuthKeyMaterial, DcAddress, Engine, EngineCallbacks, EngineConfig, EngineEvent, ProxyConfig, SessionHandle,
+    SessionSetup, TransportPreference, unix_seconds,
+};
+use mtproto_testserver::*;
+
+#[path = "support/eventually.rs"]
+mod eventually;
+use eventually::eventually;
+
+const WAIT: Duration = Duration::from_secs(20);
+/// A name no resolver answers (RFC 6761).
+const NAME: &str = "proxy.invalid";
+/// What a delay between two attempts, measured at the proxy, may take beyond the engine's own: the refusal's
+/// round trip and the timers' granularity.
+const SLACK: f64 = 0.25;
+
+#[derive(Default)]
+struct Collector {
+    events: Mutex<Vec<(SessionHandle, EngineEvent)>>,
+    condvar: Condvar,
+}
+
+impl EngineCallbacks for Collector {
+    fn on_event(&self, session: SessionHandle, event: EngineEvent) {
+        self.events.lock().unwrap().push((session, event));
+        self.condvar.notify_all();
+    }
+
+    fn on_log(&self, _level: mtproto_engine::LogLevel, message: &str) {
+        if std::env::var_os("MTPROTO_TEST_LOG").is_some() {
+            eprintln!("LOG {message}");
+        }
+    }
+}
+
+impl Collector {
+    fn wait<F: Fn(&[(SessionHandle, EngineEvent)]) -> bool>(&self, timeout: Duration, predicate: F) -> bool {
+        let deadline = Instant::now() + timeout;
+        let mut events = self.events.lock().unwrap();
+        loop {
+            if predicate(&events) {
+                return true;
+            }
+            let now = Instant::now();
+            if now >= deadline {
+                return false;
+            }
+            events = self.condvar.wait_timeout(events, deadline - now).unwrap().0;
+        }
+    }
+
+    fn states(&self, session: SessionHandle) -> Vec<State> {
+        states(&self.events.lock().unwrap(), session)
+    }
+}
+
+fn completed(events: &[(SessionHandle, EngineEvent)], session: SessionHandle, id: u64) -> usize {
+    events
+        .iter()
+        .filter(|(handle, event)| {
+            *handle == session
+                && matches!(event, EngineEvent::Rpc(RpcEvent::Completed { id: completed, .. }) if completed.0 == id)
+        })
+        .count()
+}
+
+/// A state the session reported: whether it was connected, its proxy, and the address it says it reached.
+type State = (bool, Option<String>, Option<IpAddr>);
+
+fn states(events: &[(SessionHandle, EngineEvent)], session: SessionHandle) -> Vec<State> {
+    events
+        .iter()
+        .filter_map(|(handle, event)| match event {
+            EngineEvent::ConnectionState { state, proxy_address, proxy_reached } if *handle == session => {
+                Some((state.connected, proxy_address.clone(), *proxy_reached))
+            }
+            _ => None,
+        })
+        .collect()
+}
+
+/// A connection a proxy address took: when, at which address, and whether it was relayed.
+#[derive(Clone, Copy, Debug)]
+struct Accepted {
+    at: Instant,
+    address: IpAddr,
+    relayed: bool,
+}
+
+/// One address of a SOCKS5 proxy. It refuses every CONNECT (reply 5, connection refused) and closes, as a
+/// proxy whose way out is down does, until it is switched to relay: from then on it passes every byte of the
+/// connections it takes both ways to the upstream SOCKS5 server. Each connection is recorded in a list it
+/// shares with the proxy's other addresses.
+struct Front {
+    relay: Arc<AtomicBool>,
+}
+
+impl Front {
+    fn start(listener: TcpListener, upstream: SocketAddr, accepted: &Arc<Mutex<Vec<Accepted>>>) -> Self {
+        let address = listener.local_addr().unwrap().ip();
+        let relay = Arc::new(AtomicBool::new(false));
+        let (relaying, accepted) = (relay.clone(), accepted.clone());
+        std::thread::spawn(move || {
+            for stream in listener.incoming() {
+                let Ok(client) = stream else { continue };
+                let relayed = relaying.load(Ordering::SeqCst);
+                accepted.lock().unwrap().push(Accepted { at: Instant::now(), address, relayed });
+                std::thread::spawn(move || {
+                    if relayed {
+                        relay_to(client, upstream);
+                    } else {
+                        let _ = refuse(client);
+                    }
+                });
+            }
+        });
+        Self { relay }
+    }
+
+    fn switch_to_relay(&self) {
+        self.relay.store(true, Ordering::SeqCst);
+    }
+}
+
+fn read(stream: &mut TcpStream, count: usize) -> std::io::Result<Vec<u8>> {
+    let mut buffer = vec![0u8; count];
+    stream.read_exact(&mut buffer)?;
+    Ok(buffer)
+}
+
+/// Takes the greeting without authentication, reads the CONNECT and refuses it.
+fn refuse(mut client: TcpStream) -> std::io::Result<()> {
+    client.set_read_timeout(Some(WAIT))?;
+    let greeting = read(&mut client, 2)?;
+    read(&mut client, greeting[1].into())?;
+    client.write_all(&[5, 0])?;
+    let request = read(&mut client, 4)?;
+    let length = match request[3] {
+        1 => 4,
+        4 => 16,
+        _ => usize::from(read(&mut client, 1)?[0]),
+    };
+    read(&mut client, length + 2)?;
+    client.write_all(&[5, 5, 0, 1, 0, 0, 0, 0, 0, 0])
+}
+
+/// Passes every byte both ways between the client and the upstream server.
+fn relay_to(client: TcpStream, upstream: SocketAddr) {
+    let Ok(server) = TcpStream::connect(upstream) else { return };
+    let _ = (client.set_nodelay(true), server.set_nodelay(true));
+    let (Ok(mut client_read), Ok(mut server_write)) = (client.try_clone(), server.try_clone()) else { return };
+    std::thread::spawn(move || {
+        let _ = std::io::copy(&mut client_read, &mut server_write);
+        let _ = server_write.shutdown(Shutdown::Both);
+    });
+    let (mut server_read, mut client_write) = (server, client);
+    let _ = std::io::copy(&mut server_read, &mut client_write);
+    let _ = client_write.shutdown(Shutdown::Both);
+}
+
+/// Listeners on 127.0.0.1 and ::1 at one port.
+fn listeners() -> (TcpListener, TcpListener) {
+    for _ in 0..20 {
+        let v4 = TcpListener::bind((Ipv4Addr::LOCALHOST, 0)).unwrap();
+        let port = v4.local_addr().unwrap().port();
+        if let Ok(v6) = TcpListener::bind((Ipv6Addr::LOCALHOST, port)) {
+            return (v4, v6);
+        }
+    }
+    panic!("no port is free on both 127.0.0.1 and ::1");
+}
+
+fn salts() -> Vec<ServerSalt> {
+    let now = unix_seconds();
+    vec![ServerSalt { salt: SERVER_SALT, valid_since: now - 60.0, valid_until: now + 3600.0 }]
+}
+
+fn request(id: u64, tag: u32) -> RpcRequest {
+    RpcRequest {
+        id: RequestId(id),
+        body: call(tag, &id.to_le_bytes()),
+        flags: RequestFlags::default(),
+        invoke_after: None,
+    }
+}
+
+fn engine(collector: &Arc<Collector>) -> Engine {
+    Engine::new(EngineConfig { worker_threads: 1, ..EngineConfig::default() }, collector.clone()).unwrap()
+}
+
+fn socks5(host: &str, port: u16) -> ProxyConfig {
+    ProxyConfig::Socks5 { host: host.into(), port, username: None, password: None }
+}
+
+/// A main session through `proxy`, created paused, given a datacenter address the proxy takes it to.
+fn paused_session(engine: &Engine, key: &AuthKey, proxy: ProxyConfig, transport: TransportPreference) -> SessionHandle {
+    let address = DcAddress { host: "149.154.167.51".into(), port: 443, secret: None };
+    let mut setup = SessionSetup::new(2, SessionRole::Main, vec![address]);
+    setup.auth_key = Some(AuthKeyMaterial { key: key.clone(), salts: salts(), init_hash: None });
+    setup.proxy = Some(proxy);
+    setup.transport = transport;
+    setup.http_port = Some(80);
+    setup.paused = true;
+    engine.create_session(setup)
+}
+
+/// The proxy's name stands for 127.0.0.1, which refuses until it is switched to relay, and ::1, which keeps
+/// refusing. The session tries them in turn, a call waiting, while its delay climbs the reconnect ladder. Right
+/// after an attempt to 127.0.0.1 was refused, 127.0.0.1 relays: the next attempt goes to ::1, and one ordinary
+/// delay later the next goes to 127.0.0.1, connects and completes the call; no attempt to 127.0.0.1 fails after
+/// the switch, and the session says it reached 127.0.0.1.
+#[test]
+fn an_address_that_starts_accepting_carries_the_session_at_its_next_turn() {
+    let key = random_key(9101);
+    let server = TestServer::start(vec![key.clone()], ServerOptions { socks5: true, ..Default::default() });
+    let (v4, v6) = listeners();
+    let port = v4.local_addr().unwrap().port();
+    let accepted = Arc::new(Mutex::new(Vec::new()));
+    let switching = Front::start(v4, server.address, &accepted);
+    let _refusing = Front::start(v6, server.address, &accepted);
+    let collector = Arc::new(Collector::default());
+    let engine = engine(&collector);
+    let session = paused_session(&engine, &key, socks5(NAME, port), TransportPreference::Tcp);
+    engine.set_proxy_addresses(session, NAME.into(), vec!["127.0.0.1".into(), "::1".into()]);
+    engine.send(session, request(1, 1));
+    engine.set_paused(session, false);
+
+    let refused = 5;
+    let came = eventually(WAIT, || accepted.lock().unwrap().len() >= refused);
+    switching.switch_to_relay();
+    let done = came && collector.wait(WAIT, |events| completed(events, session, 1) == 1);
+    let accepts = accepted.lock().unwrap().clone();
+    let states = collector.states(session);
+    engine.shutdown();
+    let start = accepts.first().map(|accept| accept.at);
+    let shown: Vec<_> = accepts
+        .iter()
+        .map(|accept| (accept.at.duration_since(start.unwrap()).as_secs_f64(), accept.address, accept.relayed))
+        .collect();
+    eprintln!("accepted (s, address, relayed): {shown:?}; states: {states:?}");
+    assert!(came, "the session made fewer than {refused} attempts");
+    assert!(done, "the call did not complete once 127.0.0.1 relayed");
+
+    let [first, second] = [IpAddr::from(Ipv4Addr::LOCALHOST), IpAddr::from(Ipv6Addr::LOCALHOST)];
+    let order: Vec<_> = accepts.iter().map(|accept| (accept.address, accept.relayed)).collect();
+    let expected = [first, second, first, second, first, second, first];
+    let expected: Vec<_> = expected.iter().enumerate().map(|(n, address)| (*address, n == 6)).collect();
+    assert_eq!(order, expected, "other than one attempt per address in turn, the last one relayed");
+    for (n, pair) in accepts.windows(2).enumerate() {
+        let delay = pair[1].at.duration_since(pair[0].at).as_secs_f64();
+        let step = RECONNECT_DELAYS[n.min(RECONNECT_DELAYS.len() - 1)];
+        let (low, high) = (step * (1.0 - RECONNECT_JITTER) - 0.05, step * (1.0 + RECONNECT_JITTER) + SLACK);
+        assert!(low <= delay && delay <= high, "{delay} s after failure {}, the ladder's step {step} s", n + 1);
+    }
+
+    let proxy = Some(format!("{NAME}:{port}"));
+    assert!(states.iter().all(|(_, address, _)| *address == proxy), "{states:?}");
+    assert!(states.iter().any(|(connected, ..)| *connected), "no state said the session was connected");
+    for (connected, _, reached) in &states {
+        assert_eq!(*reached, connected.then_some(first), "{states:?}");
+    }
+}
+
+/// Through a proxy address that relays from the start: an HTTP session through the proxy's name says it
+/// reached the address the host gave, once a link answered, and a session whose proxy is the IP literal
+/// 127.0.0.1 connects to it as it is and names no address reached.
+#[test]
+fn an_http_link_names_the_address_reached_and_an_ip_literal_proxy_names_none() {
+    let key = random_key(9102);
+    let server = TestServer::start(vec![key.clone()], ServerOptions { socks5: true, ..Default::default() });
+    let listener = TcpListener::bind((Ipv4Addr::LOCALHOST, 0)).unwrap();
+    let port = listener.local_addr().unwrap().port();
+    let accepted = Arc::new(Mutex::new(Vec::new()));
+    Front::start(listener, server.address, &accepted).switch_to_relay();
+    let collector = Arc::new(Collector::default());
+    let engine = engine(&collector);
+    let http = paused_session(&engine, &key, socks5(NAME, port), TransportPreference::Http);
+    engine.set_proxy_addresses(http, NAME.into(), vec!["127.0.0.1".into()]);
+    let literal = paused_session(&engine, &key, socks5("127.0.0.1", port), TransportPreference::Tcp);
+    for (id, session) in [(1, http), (2, literal)] {
+        engine.send(session, request(id, 1));
+        engine.set_paused(session, false);
+    }
+    let local = IpAddr::from(Ipv4Addr::LOCALHOST);
+    let done = collector.wait(WAIT, |events| completed(events, http, 1) == 1 && completed(events, literal, 2) == 1);
+    let reached = (true, Some(format!("{NAME}:{port}")), Some(local));
+    let named = collector.wait(WAIT, |events| states(events, http).contains(&reached));
+    let (over_http, through_literal) = (collector.states(http), collector.states(literal));
+    engine.shutdown();
+    eprintln!("over HTTP: {over_http:?}; through the IP literal: {through_literal:?}");
+    assert!(done, "the calls did not complete through the proxy");
+    assert!(named, "no state of the HTTP session named the address it reached");
+    assert!(over_http.iter().all(|(_, _, reached)| reached.is_none() || *reached == Some(local)), "{over_http:?}");
+    assert!(through_literal.iter().any(|(connected, ..)| *connected), "{through_literal:?}");
+    let proxy = Some(format!("127.0.0.1:{port}"));
+    assert!(through_literal.iter().all(|(_, address, reached)| *address == proxy && reached.is_none()));
+}
diff --git a/crates/mtproto-engine/tests/route_admission.rs b/crates/mtproto-engine/tests/route_admission.rs
new file mode 100644
index 0000000..ba084b3
--- /dev/null
+++ b/crates/mtproto-engine/tests/route_admission.rs
@@ -0,0 +1,242 @@
+//! Route admission (`Engine::set_route_admission`) as a host sees it: a session opens no connection before
+//! the host admits it, directly or through its SOCKS5 proxy, and asks for its destination, never the
+//! proxy. After a reset it asks again before it reconnects, and an answer given before the proxy changed
+//! opens nothing.
+
+use std::sync::{Arc, Condvar, Mutex};
+use std::time::{Duration, Instant};
+
+use mtproto_engine::mtproto_core::auth_key::AuthKey;
+use mtproto_engine::mtproto_core::rpc::{RequestFlags, RequestId, RpcEvent, RpcRequest, SessionRole};
+use mtproto_engine::mtproto_core::session::ServerSalt;
+use mtproto_engine::{
+    AuthKeyMaterial, DcAddress, Engine, EngineCallbacks, EngineConfig, EngineEvent, ProxyConfig, RouteTransport,
+    SessionHandle, SessionSetup, unix_seconds,
+};
+use mtproto_testserver::*;
+
+const WAIT: Duration = Duration::from_secs(20);
+/// How long a session waiting for its admission is watched for connections.
+const QUIET: Duration = Duration::from_millis(500);
+
+type Asked = (u64, RouteTransport, String, u16);
+
+#[derive(Default)]
+struct Collector {
+    events: Mutex<Vec<(SessionHandle, EngineEvent)>>,
+    condvar: Condvar,
+}
+
+impl EngineCallbacks for Collector {
+    fn on_event(&self, session: SessionHandle, event: EngineEvent) {
+        self.events.lock().unwrap().push((session, event));
+        self.condvar.notify_all();
+    }
+
+    fn on_log(&self, _level: mtproto_engine::LogLevel, message: &str) {
+        if std::env::var_os("MTPROTO_TEST_LOG").is_some() {
+            eprintln!("LOG {message}");
+        }
+    }
+}
+
+impl Collector {
+    fn wait<F: Fn(&[(SessionHandle, EngineEvent)]) -> bool>(&self, timeout: Duration, predicate: F) -> bool {
+        let deadline = Instant::now() + timeout;
+        let mut events = self.events.lock().unwrap();
+        loop {
+            if predicate(&events) {
+                return true;
+            }
+            let now = Instant::now();
+            if now >= deadline {
+                return false;
+            }
+            events = self.condvar.wait_timeout(events, deadline - now).unwrap().0;
+        }
+    }
+
+    fn completed(&self, session: SessionHandle, id: u64) -> usize {
+        completed(&self.events.lock().unwrap(), session, id)
+    }
+
+    fn asked(&self, session: SessionHandle) -> Vec<Asked> {
+        asked(&self.events.lock().unwrap(), session)
+    }
+
+    /// The session's `count`th ask, once it came.
+    fn ask(&self, session: SessionHandle, count: usize) -> Asked {
+        let came = self.wait(WAIT, |events| asked(events, session).len() >= count);
+        assert!(came, "the session never asked {count} times");
+        self.asked(session)[count - 1].clone()
+    }
+}
+
+fn completed(events: &[(SessionHandle, EngineEvent)], session: SessionHandle, id: u64) -> usize {
+    events
+        .iter()
+        .filter(|(handle, event)| {
+            *handle == session
+                && matches!(event, EngineEvent::Rpc(RpcEvent::Completed { id: completed, .. }) if completed.0 == id)
+        })
+        .count()
+}
+
+fn asked(events: &[(SessionHandle, EngineEvent)], session: SessionHandle) -> Vec<Asked> {
+    events
+        .iter()
+        .filter_map(|(handle, event)| match event {
+            EngineEvent::RouteRequired { id, transport, host, port } if *handle == session => {
+                Some((*id, *transport, host.clone(), *port))
+            }
+            _ => None,
+        })
+        .collect()
+}
+
+fn salts() -> Vec<ServerSalt> {
+    let now = unix_seconds();
+    vec![ServerSalt { salt: SERVER_SALT, valid_since: now - 60.0, valid_until: now + 3600.0 }]
+}
+
+fn request(id: u64, tag: u32) -> RpcRequest {
+    RpcRequest {
+        id: RequestId(id),
+        body: call(tag, &id.to_le_bytes()),
+        flags: RequestFlags::default(),
+        invoke_after: None,
+    }
+}
+
+fn engine(collector: &Arc<Collector>) -> Engine {
+    Engine::new(EngineConfig { worker_threads: 1, ..EngineConfig::default() }, collector.clone()).unwrap()
+}
+
+/// A main session created paused, as a host holds one until it decided the route, and let go with
+/// admission required.
+fn admitted_session(engine: &Engine, key: &AuthKey, address: DcAddress, proxy: Option<ProxyConfig>) -> SessionHandle {
+    let mut setup = SessionSetup::new(2, SessionRole::Main, vec![address]);
+    setup.auth_key = Some(AuthKeyMaterial { key: key.clone(), salts: salts(), init_hash: None });
+    setup.proxy = proxy;
+    setup.paused = true;
+    let session = engine.create_session(setup);
+    engine.set_route_admission(session, true);
+    engine.set_paused(session, false);
+    session
+}
+
+fn direct(server: &TestServer) -> DcAddress {
+    DcAddress { host: "127.0.0.1".into(), port: server.address.port(), secret: None }
+}
+
+/// The address a session behind the test server's SOCKS5 front is given: the front takes any destination.
+fn behind_proxy() -> DcAddress {
+    DcAddress { host: "149.154.167.51".into(), port: 443, secret: None }
+}
+
+fn socks5(server: &TestServer) -> ProxyConfig {
+    ProxyConfig::Socks5 { host: "127.0.0.1".into(), port: server.address.port(), username: None, password: None }
+}
+
+fn connections(server: &TestServer) -> usize {
+    server.with_stats(|stats| stats.connections)
+}
+
+fn nothing_connects_before_the_admission(proxied: bool) {
+    let key = random_key(if proxied { 8202 } else { 8201 });
+    let server = TestServer::start(vec![key.clone()], ServerOptions { socks5: proxied, ..Default::default() });
+    let collector = Arc::new(Collector::default());
+    let engine = engine(&collector);
+    let (address, proxy) = if proxied { (behind_proxy(), Some(socks5(&server))) } else { (direct(&server), None) };
+    let session = admitted_session(&engine, &key, address.clone(), proxy);
+    engine.send(session, request(1, 1));
+    let (id, transport, host, port) = collector.ask(session, 1);
+    std::thread::sleep(QUIET);
+    let held = (connections(&server), collector.completed(session, 1));
+    engine.admit_route(session, id, true);
+    let done = collector.wait(WAIT, |events| completed(events, session, 1) == 1);
+    let (after, asks) = (connections(&server), collector.asked(session).len());
+    engine.shutdown();
+    eprintln!(
+        "proxied {proxied}: asked #{id} for {transport:?} {host}:{port}; (connections, completions) while waiting {held:?}; connections after {after}, asks {asks}"
+    );
+    assert_eq!((transport, host.as_str(), port), (RouteTransport::Tcp, address.host.as_str(), address.port));
+    assert_eq!(held, (0, 0), "the session connected before the host admitted it");
+    assert!(done, "the call did not complete after the admission");
+    assert_eq!((after, asks), (1, 1), "one admission opened other than one connection");
+}
+
+#[test]
+fn nothing_connects_directly_before_the_admission() {
+    nothing_connects_before_the_admission(false);
+}
+
+#[test]
+fn nothing_connects_through_a_socks5_proxy_before_the_admission() {
+    nothing_connects_before_the_admission(true);
+}
+
+/// The host resets the connections: the session asks for its route again, and reconnects only once
+/// that admission came.
+#[test]
+fn a_reset_asks_again_before_the_session_reconnects() {
+    let key = random_key(8203);
+    let server = TestServer::start(vec![key.clone()], ServerOptions::default());
+    let collector = Arc::new(Collector::default());
+    let engine = engine(&collector);
+    let session = admitted_session(&engine, &key, direct(&server), None);
+    engine.send(session, request(1, 1));
+    let (first, ..) = collector.ask(session, 1);
+    engine.admit_route(session, first, true);
+    assert!(collector.wait(WAIT, |events| completed(events, session, 1) == 1), "the first call did not complete");
+    assert_eq!(connections(&server), 1);
+
+    engine.reset_connections();
+    let (second, transport, host, port) = collector.ask(session, 2);
+    engine.send(session, request(2, 2));
+    std::thread::sleep(QUIET);
+    let held = (connections(&server), collector.completed(session, 2));
+    engine.admit_route(session, second, true);
+    let done = collector.wait(WAIT, |events| completed(events, session, 2) == 1);
+    let after = connections(&server);
+    engine.shutdown();
+    eprintln!(
+        "after the reset asked #{second} for {transport:?} {host}:{port}; held {held:?}; connections after {after}"
+    );
+    assert!(second > first);
+    assert_eq!((transport, port), (RouteTransport::Tcp, server.address.port()));
+    assert_eq!(held, (1, 0), "the session reconnected after the reset before the host admitted it");
+    assert!(done, "the call after the reset did not complete");
+    assert_eq!(after, 2);
+}
