+    /// Behind a proxy on Auto, a session whose admission goes unanswered for 70 s asks again every
+    /// `ROUTE_ADMISSION_WAIT`, for the datacenter address and never the proxy, counts no failure, starts
+    /// no HTTP probe and does not report proxy trouble. Three refusals do, as three failed connections.
+    #[test]
+    fn waiting_for_an_admission_is_no_failure() {
+        let mut proxy = Sink::new();
+        let dc = DcAddress { host: "149.154.167.51".into(), port: 443, secret: None };
+        let http = DcAddress { host: "149.154.167.51".into(), port: 80, secret: None };
+        let mut setup = gate_setup(vec![dc], vec![http], TransportPreference::Auto);
+        setup.proxy =
+            Some(ProxyConfig::Socks5 { host: "127.0.0.1".into(), port: proxy.port(), username: None, password: None });
+        let mut gate = Gate::new(setup, true);
