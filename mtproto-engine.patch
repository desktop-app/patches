+#[cfg(windows)]
+pub fn monotonic_seconds() -> f64 {
+    static ORIGIN: std::sync::OnceLock<(std::time::Instant, f64)> = std::sync::OnceLock::new();
+    let (origin, base) = ORIGIN.get_or_init(|| (std::time::Instant::now(), unix_seconds().max(1.0)));
+    base + origin.elapsed().as_secs_f64()
