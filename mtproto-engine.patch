+/// The engine names its threads `mtproto-main`, `mtproto-worker-N` and `mtproto-resolver`, and std makes
+/// a name the thread's description. Windows allocates the copy it hands back, outside the Rust allocator.
+#[cfg(windows)]
+pub fn is_engine_thread() -> bool {
+    use windows_sys::Win32::Foundation::LocalFree;
+    use windows_sys::Win32::System::Threading::{GetCurrentThread, GetThreadDescription};
+    let mut description: *mut u16 = core::ptr::null_mut();
+    if unsafe { GetThreadDescription(GetCurrentThread(), &mut description) } < 0 || description.is_null() {
+        return false;
+    }
+    // The description ends with a NUL, which differs from every prefix byte, so the comparison stops there.
+    let engine =
+        b"mtproto-".iter().enumerate().all(|(index, byte)| unsafe { *description.add(index) } == u16::from(*byte));
+    unsafe { LocalFree(description.cast()) };
+    engine
+}
