+            }
+            let one = failing_attempts(&ips[..1], port, JITTER, urgent, window);
+            assert_eq!(three.len(), one.len(), "urgent {urgent}: other than as many attempts as against one address");
+            let delays = |attempts: &[Attempt]| attempts.iter().map(|attempt| attempt.2).collect::<Vec<_>>();
+            assert_eq!(delays(&three), delays(&one), "urgent {urgent}");
+        }
