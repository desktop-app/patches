+
+/// Distinct bytes, so that each of the 16 rotations is a needle of its own.
+const STACK_SECRET: [u8; 16] = {
+    let mut secret = [0u8; 16];
+    let mut index = 0;
+    while index < 16 {
+        secret[index] = 0x3du8.wrapping_add((index as u8).wrapping_mul(29));
+        index += 1;
+    }
+    secret
+};
+
+const PROXY_SECRET: [u8; 17] =
+    [0xdd, 0x0b, 0x8e, 0x25, 0xc4, 0x71, 0x13, 0xfa, 0x66, 0x39, 0xd2, 0x84, 0x4f, 0xe0, 0x17, 0xab, 0x58];
+
+/// Fills 64 KiB of stack below the caller's frame with the secret: the frames of the caller's next call lie there,
+/// so a value built in them keeps the secret wherever it leaves bytes unused.
+#[inline(never)]
+fn paint_the_stack(secret: &[u8; 16]) {
+    let mut painted = [0u8; 64 * 1024];
+    for (index, byte) in painted.iter_mut().enumerate() {
+        *byte = secret[index % secret.len()];
+    }
+    std::hint::black_box(&mut painted);
+}
+
+/// Every rotation of the secret, so that any 16 painted bytes in a freed block match, whatever their alignment.
+fn watch_the_stack_secret(watch: &mut freed_memory::Watch) {
+    let twice: [u8; 32] = core::array::from_fn(|index| STACK_SECRET[index % STACK_SECRET.len()]);
+    for rotation in 0..STACK_SECRET.len() {
+        watch.secret("host stack secret", &twice[rotation..rotation + STACK_SECRET.len()]);
+    }
+}
+
+/// Runs a leg on a thread of its own, as a host's thread calls the engine: unnamed, so not an engine thread, and
+/// with room for the paint.
+fn on_a_host_thread<T: Send + 'static>(leg: impl FnOnce() -> T + Send + 'static) -> T {
+    std::thread::Builder::new().stack_size(2 * 1024 * 1024).spawn(leg).unwrap().join().unwrap()
+}
+
+/// What a leg left in freed memory up to the engine's free, and whether its calibration found the paint after.
+struct Leg {
+    found: Vec<&'static str>,
+    calibrated: bool,
+}
+
+/// The leg's result, read once the engine is freed and its threads joined; then the calibration: a value built over
+/// a fresh paint and freed unwiped must be found. It comes last, so its block is freed after the result is read.
+fn finish(watch: &freed_memory::Watch) -> Leg {
+    let found = watch.found();
+    paint_the_stack(&STACK_SECRET);
+    free_a_value_built_over_the_paint();
+    let calibrated = watch.found().contains(&"host stack secret");
+    watch.stop();
+    Leg { found, calibrated }
+}
+
+/// A `None` whose payload type has no niche, built in this frame over the paint: 71 of its 72 bytes are unused.
+#[inline(never)]
+fn free_a_value_built_over_the_paint() {
+    let value = std::hint::black_box(Option::<[u64; 8]>::None);
+    freed_memory::free_unwiped_copy(&value);
+}
