+bool QPlatformBackingStore::checkRhiDevice(QWindow *window)
+{
+    const auto it = d_ptr->surfaceSupport.find(window->surfaceType());
+    if (it == d_ptr->surfaceSupport.end())
+        return false;
+    auto &support = it->second;
+    if (!support.needsRecovery && support.rhiSupport.checkDevice()) {
+        support.recovering = support.needsRecovery = true;
+        return true;
+    }
+    return false;
+}
