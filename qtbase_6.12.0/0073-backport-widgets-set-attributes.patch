+    QVERIFY(menuElement);
+    ComPtr<IUIAutomationTreeWalker> walker;
+    QVERIFY(SUCCEEDED(automation->get_RawViewWalker(&walker)));
+    QVERIFY(walker);
+    ComPtr<IUIAutomationElement> itemElement;
