+// Limits, on this thread while the outermost budget lives, the dash loop
+// iterations of QDashStroker and of the raster engine's dashed lines and the
+// geometry their dashes add downstream: outline vertices of the dash pieces
+// QStroker builds, or 256 pixels of square cap per unit for raster dashes.
+// A budget created while another one is current stays inert, so nested
+// painting spends the outer allowances.
+class Q_GUI_EXPORT QDashBudget
+{
+    Q_DISABLE_COPY_MOVE(QDashBudget)
+public:
+    QDashBudget(qint64 steps, qint64 geometry);
+    ~QDashBudget();
+
+    static QDashBudget *current();
+
+    qint64 remainingSteps() const { return m_steps; }
+    qint64 remainingGeometry() const { return m_geometry; }
+    void consume(qint64 steps, qint64 geometry)
+    {
+        Q_ASSERT(steps >= 0 && steps <= m_steps);
+        Q_ASSERT(geometry >= 0 && geometry <= m_geometry);
+        m_steps -= steps;
+        m_geometry -= geometry;
+    }
+
+private:
+    qint64 m_steps;
+    qint64 m_geometry;
+    bool m_owner;
+};
