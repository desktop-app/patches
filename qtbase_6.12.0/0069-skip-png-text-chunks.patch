Skip PNG text chunks when reading images.

diff --git a/src/gui/image/qpnghandler.cpp b/src/gui/image/qpnghandler.cpp
--- a/src/gui/image/qpnghandler.cpp
+++ b/src/gui/image/qpnghandler.cpp
@@ -404,6 +404,14 @@
     // Trade off a little bit of memory for better compatibility with existing images
     // Ref. "invalid distance too far back" explanation in libpng-manual.txt
     png_set_option(png_ptr, PNG_MAXIMUM_INFLATE_WINDOW, PNG_OPTION_ON);
+#endif
+
+#if defined(PNG_SET_UNKNOWN_CHUNKS_SUPPORTED) && defined(PNG_HANDLE_AS_UNKNOWN_SUPPORTED)
+    // Text chunks are never used, and each zTXt or iTXt chunk inflates up to
+    // libpng's per-chunk limit, so a small file could expand into hundreds of
+    // megabytes of QString data. Skip them without decompressing.
+    static const png_byte textChunks[] = "tEXt\0zTXt\0iTXt";
+    png_set_keep_unknown_chunks(png_ptr, PNG_HANDLE_CHUNK_NEVER, textChunks, 3);
 #endif
 
     info_ptr = png_create_info_struct(png_ptr);
