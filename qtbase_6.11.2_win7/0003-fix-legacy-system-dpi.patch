Subject: [PATCH] Preserve system DPI in the legacy Windows shims

Follow up desktop-app/qt6_windows7_patches at
4366991164017d68c0dfc32e01c603da0e5c50e9. GetDeviceCaps already returns
system-scaled DPI; applying the inverse scale factor reduced it to 96.
Report that DPI directly and compute monitor scale in the forward direction.
Normalize existing system metrics and font dimensions by their source DPI
before scaling to the requested DPI, preserving them when both match.

diff --git a/src/corelib/global/qlegacyshims_win_p.h b/src/corelib/global/qlegacyshims_win_p.h
index e61b322..a80c423 100644
--- a/src/corelib/global/qlegacyshims_win_p.h
+++ b/src/corelib/global/qlegacyshims_win_p.h
@@ -24,6 +24,8 @@
 #define MDT_MAXIMUM_DPI 3
 
 namespace QLegacyShims {
+	static UINT WINAPI GetDpiForSystem(VOID);
+
 	static INT WINAPI GetSystemMetricsForDpi(
 		IN  INT     Index,
 		IN  UINT    Dpi)
@@ -50,8 +52,10 @@ namespace QLegacyShims {
 		case SM_CYMIN:
 		case SM_CYMINTRACK:
 		case SM_CXSIZE:
+		case SM_CYSIZE:
 		case SM_CXFRAME:
 		case SM_CYFRAME:
+		case SM_CXPADDEDBORDER:
 		case SM_CXICONSPACING:
 		case SM_CYICONSPACING:
 		case SM_CXSMICON:
@@ -64,8 +68,7 @@ namespace QLegacyShims {
 		case SM_CXMENUCHECK:
 		case SM_CYMENUCHECK:
 			// These are pixel values that have to be scaled according to DPI.
-			Value *= Dpi;
-			Value /= USER_DEFAULT_SCREEN_DPI;
+			Value = MulDiv(Value, Dpi, QLegacyShims::GetDpiForSystem());
 			break;
 		}
 
@@ -79,9 +82,21 @@ namespace QLegacyShims {
 		IN      UINT    WinIni,
 		IN      UINT    Dpi)
 	{
+		const UINT SystemDpi = QLegacyShims::GetDpiForSystem();
+		const auto Scale = [=](int Value) { return MulDiv(Value, Dpi, SystemDpi); };
+		const auto ScaleFont = [&](LOGFONT &Font) {
+			Font.lfHeight = Scale(Font.lfHeight);
+			Font.lfWidth = Scale(Font.lfWidth);
+		};
+
 		switch (Action) {
 		case SPI_GETICONTITLELOGFONT:
-			return SystemParametersInfo(Action, Parameter, Data, 0);
+			{
+				const BOOL Success = SystemParametersInfo(Action, Parameter, Data, 0);
+				if (Success)
+					ScaleFont(*static_cast<LOGFONT *>(Data));
+				return Success;
+			}
 		case SPI_GETICONMETRICS:
 			{
 				BOOL Success;
@@ -92,10 +107,9 @@ namespace QLegacyShims {
 				if (Success) {
 					IconMetrics = (PICONMETRICS) Data;
 
-					IconMetrics->iHorzSpacing *= Dpi;
-					IconMetrics->iVertSpacing *= Dpi;
-					IconMetrics->iHorzSpacing /= USER_DEFAULT_SCREEN_DPI;
-					IconMetrics->iVertSpacing /= USER_DEFAULT_SCREEN_DPI;
+					IconMetrics->iHorzSpacing = Scale(IconMetrics->iHorzSpacing);
+					IconMetrics->iVertSpacing = Scale(IconMetrics->iVertSpacing);
+					ScaleFont(IconMetrics->lfFont);
 				}
 
 				return Success;
@@ -110,27 +124,21 @@ namespace QLegacyShims {
 				if (Success) {
 					NonClientMetrics = (PNONCLIENTMETRICS) Data;
 
-					NonClientMetrics->iBorderWidth          *= Dpi;
-					NonClientMetrics->iScrollWidth          *= Dpi;
-					NonClientMetrics->iScrollHeight         *= Dpi;
-					NonClientMetrics->iCaptionWidth         *= Dpi;
-					NonClientMetrics->iCaptionHeight        *= Dpi;
-					NonClientMetrics->iSmCaptionWidth       *= Dpi;
-					NonClientMetrics->iSmCaptionHeight      *= Dpi;
-					NonClientMetrics->iMenuWidth            *= Dpi;
-					NonClientMetrics->iMenuHeight           *= Dpi;
-					NonClientMetrics->iPaddedBorderWidth    *= Dpi;
-
-					NonClientMetrics->iBorderWidth          /= USER_DEFAULT_SCREEN_DPI;
-					NonClientMetrics->iScrollWidth          /= USER_DEFAULT_SCREEN_DPI;
-					NonClientMetrics->iScrollHeight         /= USER_DEFAULT_SCREEN_DPI;
-					NonClientMetrics->iCaptionWidth         /= USER_DEFAULT_SCREEN_DPI;
-					NonClientMetrics->iCaptionHeight        /= USER_DEFAULT_SCREEN_DPI;
-					NonClientMetrics->iSmCaptionWidth       /= USER_DEFAULT_SCREEN_DPI;
-					NonClientMetrics->iSmCaptionHeight      /= USER_DEFAULT_SCREEN_DPI;
-					NonClientMetrics->iMenuWidth            /= USER_DEFAULT_SCREEN_DPI;
-					NonClientMetrics->iMenuHeight           /= USER_DEFAULT_SCREEN_DPI;
-					NonClientMetrics->iPaddedBorderWidth    /= USER_DEFAULT_SCREEN_DPI;
+					NonClientMetrics->iBorderWidth = Scale(NonClientMetrics->iBorderWidth);
+					NonClientMetrics->iScrollWidth = Scale(NonClientMetrics->iScrollWidth);
+					NonClientMetrics->iScrollHeight = Scale(NonClientMetrics->iScrollHeight);
+					NonClientMetrics->iCaptionWidth = Scale(NonClientMetrics->iCaptionWidth);
+					NonClientMetrics->iCaptionHeight = Scale(NonClientMetrics->iCaptionHeight);
+					NonClientMetrics->iSmCaptionWidth = Scale(NonClientMetrics->iSmCaptionWidth);
+					NonClientMetrics->iSmCaptionHeight = Scale(NonClientMetrics->iSmCaptionHeight);
+					NonClientMetrics->iMenuWidth = Scale(NonClientMetrics->iMenuWidth);
+					NonClientMetrics->iMenuHeight = Scale(NonClientMetrics->iMenuHeight);
+					NonClientMetrics->iPaddedBorderWidth = Scale(NonClientMetrics->iPaddedBorderWidth);
+					ScaleFont(NonClientMetrics->lfCaptionFont);
+					ScaleFont(NonClientMetrics->lfSmCaptionFont);
+					ScaleFont(NonClientMetrics->lfMenuFont);
+					ScaleFont(NonClientMetrics->lfStatusFont);
+					ScaleFont(NonClientMetrics->lfMessageFont);
 				}
 
 				return Success;
@@ -157,7 +165,7 @@ namespace QLegacyShims {
 		LogPixelsX = GetDeviceCaps(DeviceContext, LOGPIXELSX);
 		ReleaseDC(NULL, DeviceContext);
 
-		*ScaleFactor = (DEVICE_SCALE_FACTOR) (9600 / LogPixelsX);
+		*ScaleFactor = (DEVICE_SCALE_FACTOR) MulDiv(LogPixelsX, 100, USER_DEFAULT_SCREEN_DPI);
 		return S_OK;
 	}
 
@@ -193,18 +201,6 @@ namespace QLegacyShims {
 		*DpiX = GetDeviceCaps(DeviceContext, LOGPIXELSX);
 		*DpiY = GetDeviceCaps(DeviceContext, LOGPIXELSY);
 
-		if (DpiType == MDT_EFFECTIVE_DPI) {
-			DEVICE_SCALE_FACTOR ScaleFactor;
-
-			// We have to multiply the DPI values by the scaling factor.
-			QLegacyShims::GetScaleFactorForMonitor(Monitor, &ScaleFactor);
-
-			*DpiX *= ScaleFactor;
-			*DpiY *= ScaleFactor;
-			*DpiX /= 100;
-			*DpiY /= 100;
-		}
-
 		ReleaseDC(NULL, DeviceContext);
 		return S_OK;
 	}
@@ -227,7 +223,7 @@ namespace QLegacyShims {
 		LogPixelsX = GetDeviceCaps(DeviceContext, LOGPIXELSX);
 		ReleaseDC(NULL, DeviceContext);
 
-		return LogPixelsX;
+		return LogPixelsX ? LogPixelsX : USER_DEFAULT_SCREEN_DPI;
 	}
 
 	static UINT WINAPI GetDpiForWindow(
