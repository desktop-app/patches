Subject: [PATCH] Propagate backing-store presentation failures

QRhi can report device loss from endFrame when D3D11 Present fails.
Propagate its result using the same mapping as beginFrame so the existing
QWidgetRepaintManager recovery path receives FlushFailedDueToLostDevice.
Other presentation errors remain FlushFailed, including an out-of-date
swapchain; this does not introduce a backend switch or a retry policy.

diff --git a/src/gui/painting/qbackingstoredefaultcompositor.cpp b/src/gui/painting/qbackingstoredefaultcompositor.cpp
index 09628fc..2e2a9b9 100644
--- a/src/gui/painting/qbackingstoredefaultcompositor.cpp
+++ b/src/gui/painting/qbackingstoredefaultcompositor.cpp
@@ -532,7 +532,11 @@ QBackingStoreDefaultCompositor::clearSurface(QRhi *rhi,
     } else
         render();
 
-    rhi->endFrame(swapchain);
+    frameResult = rhi->endFrame(swapchain);
+    if (frameResult == QRhi::FrameOpDeviceLost)
+        return QPlatformBackingStore::FlushFailedDueToLostDevice;
+    if (frameResult != QRhi::FrameOpSuccess)
+        return QPlatformBackingStore::FlushFailed;
 
     return QPlatformBackingStore::FlushSuccess;
 }
@@ -798,7 +802,11 @@ QPlatformBackingStore::FlushResult QBackingStoreDefaultCompositor::flush(QPlatfo
     if (gotNativeTexture)
         backingStore->nativeTextureWasComposited(backingStoreTextureUsed ? cb : nullptr);
 
-    rhi->endFrame(swapchain);
+    frameResult = rhi->endFrame(swapchain);
+    if (frameResult == QRhi::FrameOpDeviceLost)
+        return QPlatformBackingStore::FlushFailedDueToLostDevice;
+    if (frameResult != QRhi::FrameOpSuccess)
+        return QPlatformBackingStore::FlushFailed;
 
     return QPlatformBackingStore::FlushSuccess;
 }
