+
+static bool angleMessageReportsDeviceLoss(const char *message)
+{
+    return message
+        && (std::strstr(message, "device was removed")
+            || std::strstr(message, "Device was removed")
+            || std::strstr(message, "device lost")
+            || std::strstr(message, "Device lost"));
+}
+
+static void markAngleDeviceLostFromLog(const char *message)
+{
+    if (!angleMessageReportsDeviceLoss(message))
