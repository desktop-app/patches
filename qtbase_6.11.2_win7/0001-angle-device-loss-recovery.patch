+static void installAnglePlatformLogging(EGLDisplay display)
+{
+    resetAngleDeviceLoss();
+    angle::PlatformMethods *platform = nullptr;
+    if (!ANGLEGetDisplayPlatform(
+            display,
+            angle::g_PlatformMethodNames,
+            angle::g_NumPlatformMethods,
+            nullptr,
+            &platform)
+        || !platform) {
+        qCWarning(lcQpaGl) << "Failed to install ANGLE platform logging for display" << display
+            << "ANGLE display key" << currentAngleDisplayKey();
+        return;
