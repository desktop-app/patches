+    if (angleDeviceLost.testAndSetRelaxed(0, 1)) {
+        qCWarning(lcQpaGl) << "ANGLE device loss detected, invalidating ANGLE display key"
+            << currentAngleDisplayKey() << "message" << message;
+        advanceAngleDisplayKey(currentAngleDisplayKey());
+    }
+}
+
+static bool angleDeviceLossPending()
