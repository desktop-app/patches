+QRect QWaylandWindow::geometry() const
+{
+    if (sizedByCompositor() || qFuzzyCompare(mGeometryScale, QHighDpiScaling::factor(window())))
+        return QPlatformWindow::geometry();
+    return QHighDpi::toNativeWindowGeometry(mGeometry, window());
+}
