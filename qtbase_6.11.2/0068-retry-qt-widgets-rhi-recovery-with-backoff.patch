 {
     Q_ASSERT(store);
+    rhiRecoveryTimer.setSingleShot(true);
+    QObject::connect(&rhiRecoveryTimer, &QTimer::timeout, tlw, [this] { recoverRhi(); });
 
     // Ensure all existing subsurfaces and static widgets are added to their respective lists.
@@ -986,4 +988,56 @@ void QWidgetRepaintManager::markNeedsFlush(QWidget *widget, const QRegion &regio
 }
 
+void QWidgetRepaintManager::scheduleRhiRecovery(QWidget *widget)
+{
+    const auto type = widget->windowHandle()->surfaceType();
+    recoveringRhiSurfaces.insert(type);
+    pendingRhiRecoveries.insert(type, widget);
+    if (!rhiRecoveryTimer.isActive())
+        rhiRecoveryTimer.start(rhiRecoveryDelay);
+}
+
+void QWidgetRepaintManager::recoverRhi()
+{
+    auto pending = std::exchange(pendingRhiRecoveries, {});
+    for (auto it = pending.begin(); it != pending.end();) {
+        const auto widget = it.value();
+        if (!widget || widget->window() != tlw || !widget->windowHandle()
+                || widget->windowHandle()->surfaceType() != it.key()) {
+            recoveringRhiSurfaces.remove(it.key());
+            it = pending.erase(it);
+        } else {
+            ++it;
+        }
+    }
+    if (pending.isEmpty()) {
+        if (recoveringRhiSurfaces.isEmpty())
+            rhiRecoveryDelay = 0;
+        return;
+    }
+
+    rhiRecoveryDelay = qMin(2000, qMax(100, rhiRecoveryDelay * 2));
+    const QPointer<QWidget> guard(tlw);
+    qSendWindowChangeToTextureChildrenRecursively(tlw, QEvent::WindowAboutToChangeInternal);
+    if (!guard)
+        return;
+    for (const auto &widget : std::as_const(pending)) {
+        if (widget && widget->window() == tlw && widget->windowHandle())
+            store->handle()->graphicsDeviceReportedLost(widget->windowHandle());
+        if (!guard)
+            return;
+    }
+    qSendWindowChangeToTextureChildrenRecursively(tlw, QEvent::WindowChangeInternal);
+    if (!guard)
+        return;
+    if (tlw->isVisible() && tlw->updatesEnabled())
+        markDirty(tlw->rect(), tlw, UpdateLater, BufferInvalid);
+    for (const auto &widget : std::as_const(pending)) {
+        if (widget && widget->window() == tlw && widget->windowHandle()
+                && widget->windowHandle()->isExposed()
+                && !store->handle()->rhi(widget->windowHandle()))
+            scheduleRhiRecovery(widget);
+    }
+}
+
