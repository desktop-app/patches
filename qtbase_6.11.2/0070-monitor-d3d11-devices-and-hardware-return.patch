+
+bool QBackingStoreRhiSupport::checkDevice()
+{
+    if (!m_rhi)
+        return false;
+    if (m_rhi->isDeviceLost())
+        return true;
+#ifdef Q_OS_WIN
+    if (m_rhi->backend() != QRhi::D3D11)
+        return false;
+    const auto handles = static_cast<const QRhiD3D11NativeHandles *>(m_rhi->nativeHandles());
+    const auto device = static_cast<ID3D11Device *>(handles->dev);
+    if (!device || FAILED(device->GetDeviceRemovedReason()))
+        return true;
+    if (qEnvironmentVariableIntValue("QSG_RHI_PREFER_SOFTWARE_RENDERER")
+            || qEnvironmentVariableIsSet("QT_D3D_ADAPTER_INDEX") || !m_adapterFactory)
+        return false;
+    if (m_replacementRhi)
+        return true;
+    if (m_adapterFactory->IsCurrent() && !m_softwareFallback && !m_adapterChangePending)
+        return false;
+    if (m_adapterCheckTimer.isValid() && m_adapterCheckTimer.elapsed() < m_adapterRetryDelay)
+        return false;
+    m_adapterCheckTimer.restart();
+    m_adapterRetryDelay = qMin(qint64(30000), m_adapterRetryDelay * 2);
+
+    ComPtr<IDXGIFactory1> factory;
+    ComPtr<IDXGIAdapter1> adapter;
+    DXGI_ADAPTER_DESC1 desc = {};
+    if (FAILED(CreateDXGIFactory1(IID_PPV_ARGS(&factory)))
+            || FAILED(factory->EnumAdapters1(0, &adapter))
+            || FAILED(adapter->GetDesc1(&desc)))
+        return false;
+    m_adapterFactory = factory;
+    LARGE_INTEGER version = {};
+    const auto versionKnown = SUCCEEDED(adapter->CheckInterfaceSupport(__uuidof(IDXGIDevice), &version));
+    const auto sameAdapter = desc.AdapterLuid.LowPart == m_adapterLuid.LowPart
+            && desc.AdapterLuid.HighPart == m_adapterLuid.HighPart;
+    if (!m_softwareFallback && sameAdapter
+            && (!versionKnown || !m_driverVersionKnown || version.QuadPart == m_driverVersion.QuadPart)) {
+        m_adapterChangePending = false;
+        m_adapterRetryDelay = 1000;
+        return false;
+    }
+    m_adapterChangePending = true;
+    if (desc.Flags & DXGI_ADAPTER_FLAG_SOFTWARE)
+        return false;
+
+    const DriverCallScope driverCall;
+    QRhiD3D11InitParams params;
+    params.enableDebugLayer = m_config.isDebugLayerEnabled();
+    QRhi::Flags flags;
+    if (qEnvironmentVariableIntValue("QSG_RHI_PROFILE"))
+        flags |= QRhi::EnableDebugMarkers | QRhi::EnableTimestamps;
+    std::unique_ptr<QRhi> replacement(QRhi::create(QRhi::D3D11, &params, flags));
+    if (!replacement || replacement->driverInfo().deviceType == QRhiDriverInfo::CpuDevice)
+        return false;
+    m_replacementRhi = std::move(replacement);
     return true;
+#else
+    return false;
+#endif
 }
 
