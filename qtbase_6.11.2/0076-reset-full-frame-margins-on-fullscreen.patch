@@ -3087,8 +3089,16 @@ void QWindowsWindow::calculateFullFrameMargins()
     setFullFrameMargins(adjustedMargins);
 }
 
+[[nodiscard]] static bool isFullScreenPopupStyle(HWND hwnd)
+{
+    const LONG_PTR style = GetWindowLongPtr(hwnd, GWL_STYLE);
+    return (style & WS_POPUP) && !(style & (WS_CAPTION | WS_THICKFRAME));
+}
+
 QMargins QWindowsWindow::frameMargins() const
 {
+    if (m_isFullScreen || isFullScreenPopupStyle(m_data.hwnd))
+        return {};
     QMargins result = fullFrameMargins();
     if (isTopLevel() && m_data.hasFrame)
         result -= invisibleMargins(m_data.hwnd);
@@ -3099,6 +3109,8 @@ QMargins QWindowsWindow::fullFrameMargins() const
 {
     if (shouldOmitFrameAdjustment(m_data.flags, m_data.hwnd))
         return {};
+    if (m_isFullScreen || isFullScreenPopupStyle(m_data.hwnd))
+        return {};
     return m_data.fullFrameMargins;
 }
 
