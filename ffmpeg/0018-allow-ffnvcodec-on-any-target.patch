Subject: Allow ffnvcodec on any target

Windows on ARM and the armhf and riscv64 snaps enable ffnvcodec explicitly.

diff --git a/configure b/configure
index 86a2437265..0afe2a9c9f 100755
--- a/configure
+++ b/configure
@@ -7801,26 +7801,6 @@ else
     disable libglslang libshaderc spirv_library spirv_compiler
 fi
 
-if enabled x86; then
-    case $target_os in
-        freebsd|mingw32*|mingw64*|win32|win64|linux|cygwin*)
-            ;;
-        *)
-            disable ffnvcodec cuvid nvdec nvenc
-            ;;
-    esac
-elif enabled_any aarch64 ppc64 && ! enabled bigendian; then
-    case $target_os in
-        linux)
-            ;;
-        *)
-            disable ffnvcodec cuvid nvdec nvenc
-            ;;
-    esac
-else
-    disable ffnvcodec cuvid nvdec nvenc
-fi
-
 enabled ffnvcodec && enable cuda
 
 enabled nvenc &&
