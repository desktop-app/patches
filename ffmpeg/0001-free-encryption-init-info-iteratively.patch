Subject: Free encryption initialization lists without recursion

Upstream: https://github.com/FFmpeg/FFmpeg/commit/969c7eb091989a664cb7bf66a1f02051cc46cb52
Backport to n8.1.3 (CVE-2026-107678).

diff --git a/libavutil/encryption_info.c b/libavutil/encryption_info.c
index a3eb955..6fc3e33 100644
--- a/libavutil/encryption_info.c
+++ b/libavutil/encryption_info.c
@@ -218,16 +218,19 @@ AVEncryptionInitInfo *av_encryption_init_info_alloc(
 
 void av_encryption_init_info_free(AVEncryptionInitInfo *info)
 {
-    uint32_t i;
-    if (info) {
+    while (info) {
+        AVEncryptionInitInfo *next = info->next;
+        uint32_t i;
+
         for (i = 0; i < info->num_key_ids; i++) {
             av_free(info->key_ids[i]);
         }
-        av_encryption_init_info_free(info->next);
         av_free(info->system_id);
         av_free(info->key_ids);
         av_free(info->data);
         av_free(info);
+
+        info = next;
     }
 }
 
