Subject: Publish the USAC element count after parsing.
From: Michael Niedermayer <michael@niedermayer.cc>
Date: Mon, 5 Oct 2026 22:13:56 +0200

Upstream: https://github.com/FFmpeg/FFmpeg/commit/694934cc05a58cc9ed8116f79cca4cf8e8ad7cf2

diff --git a/libavcodec/aac/aacdec_usac.c b/libavcodec/aac/aacdec_usac.c
--- a/libavcodec/aac/aacdec_usac.c
+++ b/libavcodec/aac/aacdec_usac.c
@@ -365,6 +365,7 @@
     MPEG4AudioConfig *m4ac = &oc->m4ac;
     AACUSACConfig *usac = &oc->usac;
     int elem_id[3 /* SCE, CPE, LFE */];
+    int nb_elems;
 
     int map_pos_set = 0;
     int nb_elements = 0;
@@ -460,15 +461,14 @@
 
     /* UsacDecoderConfig */
     elem_id[0] = elem_id[1] = elem_id[2] = 0;
-    usac->nb_elems = get_escaped_value(gb, 4, 8, 16) + 1;
-    if (usac->nb_elems > 64) {
+    nb_elems = get_escaped_value(gb, 4, 8, 16) + 1;
+    if (nb_elems > 64) {
         av_log(ac->avctx, AV_LOG_ERROR, "Too many elements: %i\n",
