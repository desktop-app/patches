+++ b/libavcodec/vvc/refs.c
@@ -51,6 +51,7 @@ void ff_vvc_unref_frame(VVCFrameContext *fc, VVCFrame *frame, int flags)
     if (!(frame->flags & ~VVC_FRAME_FLAG_CORRUPT))
