Subject: Free the VDPAU bitstream buffer table when a picture is released

Upstream: https://github.com/FFmpeg/FFmpeg/commit/2c6cd8098844f2367f8ba0a3a483e405c8f76449
Backport to release/8.1 (CVE-2026-125242).

diff --git a/libavcodec/vdpau.c b/libavcodec/vdpau.c
index e99ac5338d..2c13113551 100644
--- a/libavcodec/vdpau.c
+++ b/libavcodec/vdpau.c
@@ -349,6 +349,13 @@ int ff_vdpau_common_end_frame(AVCodecContext *avctx, AVFrame *frame,
     return vdpau_error(status);
 }
 
+void ff_vdpau_free_frame_priv(AVRefStructOpaque hwctx, void *data)
+{
+    struct vdpau_picture_context *pic_ctx = data;
+
+    av_freep(&pic_ctx->bitstream_buffers);
+}
+
 #if CONFIG_MPEG1_VDPAU_HWACCEL || \
     CONFIG_MPEG2_VDPAU_HWACCEL || CONFIG_MPEG4_VDPAU_HWACCEL || \
     CONFIG_VC1_VDPAU_HWACCEL   || CONFIG_WMV3_VDPAU_HWACCEL
diff --git a/libavcodec/vdpau_av1.c b/libavcodec/vdpau_av1.c
index b7e7fa8b0c..aaf8cd57c0 100644
--- a/libavcodec/vdpau_av1.c
+++ b/libavcodec/vdpau_av1.c
@@ -362,6 +362,7 @@ const FFHWAccel ff_av1_vdpau_hwaccel = {
     .end_frame      = vdpau_av1_end_frame,
     .decode_slice   = vdpau_av1_decode_slice,
     .frame_priv_data_size = sizeof(struct vdpau_picture_context),
+    .free_frame_priv = ff_vdpau_free_frame_priv,
     .init           = vdpau_av1_init,
     .uninit         = ff_vdpau_common_uninit,
     .frame_params   = ff_vdpau_common_frame_params,
