Subject: Preserve the current MOV fragment on insertion.
From: Michael Niedermayer <michael@niedermayer.cc>
Date: Fri, 2 Oct 2026 17:53:35 +0200

Upstream: https://github.com/FFmpeg/FFmpeg/commit/5647739dddb2679ebfe488d6745f0fa1f405bc5d

diff --git a/libavformat/mov.c b/libavformat/mov.c
index e3e0100e11613..77402ad2ece1b 100644
--- a/libavformat/mov.c
+++ b/libavformat/mov.c
@@ -1917,6 +1917,8 @@ static int update_frag_index(MOVContext *c, int64_t offset)
     if (index < c->frag_index.nb_items)
         memmove(c->frag_index.item + index + 1, c->frag_index.item + index,
                 (c->frag_index.nb_items - index) * sizeof(*c->frag_index.item));
+    if (index <= c->frag_index.current)
+        c->frag_index.current++;
 
     item = &c->frag_index.item[index];
     item->headers_read = 0;
