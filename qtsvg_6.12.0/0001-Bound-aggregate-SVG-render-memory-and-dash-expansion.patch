+class QSvgRenderBudgetData : public QSharedData
+{
+public:
+    // Never exceeds renderingMaxMemoryBudget, so it fits qsizetype atomics on every platform.
+    QAtomicInteger<qsizetype> live;
+};
+
+namespace {
+
+struct QSvgImageReservation
+{
+    QExplicitlySharedDataPointer<QSvgRenderBudgetData> data;
+    qsizetype bytes;
+};
+
+// Runs from ~QImageData of the last alias, on whichever thread drops it.
+void releaseImageReservation(void *info)
+{
+    QSvgImageReservation *reservation = static_cast<QSvgImageReservation *>(info);
+    reservation->data->live.fetchAndSubRelaxed(reservation->bytes);
+    delete reservation;
+}
+
+}
+
+QSvgRenderBudget::QSvgRenderBudget()
+    : m_allowance(QtSvg::renderingMinMemoryBudget)
+{
+}
+
+QSvgRenderBudget::~QSvgRenderBudget()
+    = default;
+
+void QSvgRenderBudget::raiseAllowance(const QPaintDevice *rootDevice)
+{
+    if (!rootDevice)
+        return;
+    const qint64 width = rootDevice->width();
+    const qint64 height = rootDevice->height();
+    if (width <= 0 || height <= 0)
+        return;
+
+    constexpr qint64 bytesPerPixel = 4;
+    constexpr qint64 factor = bytesPerPixel * QtSvg::renderingMemoryBudgetDeviceFactor;
+    const qint64 area = width * height;
+    const qint64 allowance = area >= QtSvg::renderingMaxMemoryBudget / factor
+            ? QtSvg::renderingMaxMemoryBudget
+            : area * factor;
+    m_allowance = qMax(m_allowance, allowance);
+}
+
+qint64 QSvgRenderBudget::imageBytes(QSize size, QImage::Format format)
+{
+    if (size.isEmpty() || format <= QImage::Format_Invalid || format >= QImage::NImageFormats)
+        return -1;
+    const QImageData::ImageSizeParameters params = QImageData::calculateImageParameters(
+            size.width(), size.height(), qt_depthForFormat(format));
+    return params.isValid() ? qint64(params.totalSize) : -1;
+}
+
+bool QSvgRenderBudget::allocateImage(const QSvgExtraStates &states, QSize size,
+                                     QImage::Format format, QImage *image)
+{
+    QSvgRenderLease lease(states);
+    if (!lease.reserve(imageBytes(size, format))
+            || !QImageIOHandler::allocateImage(size, format, image)
+            || !lease.attach(*image)) {
+        *image = QImage();
+        return false;
+    }
+    return true;
+}
+
+bool QSvgRenderBudget::reserve(qint64 bytes)
+{
+    if (bytes == 0)
+        return true;
+    if (bytes > m_allowance)
+        return false;
+    if (!m_data)
+        m_data.reset(new QSvgRenderBudgetData);
+
+    qsizetype live = m_data->live.loadRelaxed();
+    do {
+        if (bytes > m_allowance - live)
+            return false;
+    } while (!m_data->live.testAndSetRelaxed(live, live + qsizetype(bytes), live));
+    return true;
+}
+
+void QSvgRenderBudget::release(qint64 bytes)
+{
+    if (bytes > 0)
+        m_data->live.fetchAndSubRelaxed(qsizetype(bytes));
+}
+
+QSvgRenderBudget::DrawScope::DrawScope(const QSvgExtraStates &states)
+{
+    // Only untrusted documents have a render budget; trusted ones start no allowance.
+    if (states.renderBudget)
+        m_dashBudget.emplace(QtSvg::renderingMaxDashSteps, QtSvg::renderingMaxDashGeometry);
+}
+
+QSvgRenderLease::QSvgRenderLease(const QSvgExtraStates &states)
+    : m_budget(states.trustedSource ? nullptr : states.renderBudget)
+{
+}
+
+QSvgRenderLease::~QSvgRenderLease()
+{
+    if (m_budget)
+        m_budget->release(m_reserved);
+}
+
+bool QSvgRenderLease::reserve(qint64 bytes)
+{
+    if (!m_budget)
+        return true;
+    if (bytes < 0 || !m_budget->reserve(bytes))
+        return false;
+    m_reserved += bytes;
+    return true;
+}
+
+bool QSvgRenderLease::attach(QImage &image)
+{
+    QImageData *d = QImageData::get(image);
+    if (!d || d->nbytes <= 0)
+        return false;
+    if (!m_budget || d->cleanupFunction == releaseImageReservation)
+        return true;
+    if (d->cleanupFunction)
+        return false; // never replace a foreign cleanup hook
+
+    const qint64 bytes = d->nbytes;
+    if (bytes > m_reserved && !reserve(bytes - m_reserved))
+        return false;
+    d->cleanupInfo = new QSvgImageReservation{ m_budget->m_data, d->nbytes };
+    d->cleanupFunction = releaseImageReservation;
+    m_reserved -= bytes;
+    return true;
+}
