+#[test]
+fn empty_tangent_points_parse_as_zero_corners() {
+  // Optimized .tgs files write `[]` for every straight-line tangent, and
+  // rlottie zero-fills a point it cannot read; rejecting them loses the
+  // whole animation (Telegram's "21_heart_white" typing sticker).
+  let json = br#"{"i":[[],[]],"o":[[],[]],"v":[[2,0],[4,0]],"c":true}"#;
+  let limits = Limits::default();
+  let path = parse_path_value(&mut Cursor::new(json.as_slice(), 128), &limits).unwrap();
+  assert_eq!(path.vertices, alloc::vec![Vec2::new(2.0, 0.0), Vec2::new(4.0, 0.0)]);
+  assert!(path.in_tangents.iter().all(|t| *t == Vec2::ZERO));
+  assert!(path.out_tangents.iter().all(|t| *t == Vec2::ZERO));
+}
