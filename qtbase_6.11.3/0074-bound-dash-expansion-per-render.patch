+/*
+    Outline vertices QOutlineMapper stores for one dash piece: both sides, the
+    closing line and the two caps QStroker::joinPoints() adds. A round cap is
+    two quarter circles of radius r that QBezier::addToPolygon() flattens at
+    half the dash threshold (QOutlineMapper and QPaintEngineEx::stroke() use
+    0.25 and 0.5 over the scale of the same transform), splitting a curve until
+    a piece passes its flatness test, at most 9 times. A piece of parameter
+    length h has its control points within 0.92 r h^2 of its chord, Manhattan
+    control offsets below r h (2.35 + 1.96 h) and a chord longer than 1.3 r h,
+    so the first depth at which either branch of the test holds for every
+    piece bounds the points; an unknown consumer gets the largest round cap.
+*/
+static qint64 dashPieceGeometry(const QStroker *stroker, qreal width, qreal dashThreshold)
+{
+    int capPoints = 2 * 512;
+    if (stroker && stroker->capStyleMode() == QStroker::FlatJoin) {
+        capPoints = 2;
+    } else if (stroker && stroker->capStyleMode() == QStroker::SquareJoin) {
+        capPoints = 3;
+    } else if (stroker) {
+        const qreal r = qAbs(width) / 2;
+        const qreal t = dashThreshold / 2;
+        for (int depth = 0; depth < 9; ++depth) {
+            const qreal h = qreal(1) / (1 << depth);
+            if (r * h * (qreal(2.35) + qreal(1.96) * h) < t
+                || (qreal(0.92) * r * h * h < t && qreal(1.3) * r * h > 1)) {
+                capPoints = 2 * (1 << depth);
+                break;
+            }
+        }
+    }
+    return 4 + 2 * capPoints;
+}
