index 2519bbadc22..9fff46775c9 100644
--- a/src/gui/painting/qstroker_p.h
+++ b/src/gui/painting/qstroker_p.h
@@ -364,6 +364,37 @@ inline void QDashStroker::end()
         m_stroker->end();
